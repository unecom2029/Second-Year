<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Jeevs edition _ summative review</title>
<style>
:root{
  --navy:#12203C;--navy2:#1B2A4A;
  --teal:#1A7A6D;--teal-glow:#3EC4B2;--teal-mid:#2BA393;--teal-light:#E3F5F2;--teal-deep:#125E54;
  --green:#2D8659;--green-bg:#E8F5EE;
  --red:#C44040;--red-bg:#FDF0F0;
  --amber:#C07B1A;--amber-bg:#FEF5E6;
  --gold-bg:#FDF6E3;
  --coral:#E07A5F;
  --ink:#1E1E20;--ink2:#3E4555;--slate:#6B7689;--mist:#A0AAB8;
  --rule:#DBD5C9;--cream:#F6F3EC;--warm:#FBF8F3;--white:#FFFFFF;
  --sh:0 8px 24px rgba(18,32,60,.08);--sh2:0 14px 34px rgba(18,32,60,.10);--sh3:0 28px 70px rgba(18,32,60,.12);
  --tr:0.25s cubic-bezier(.4,0,.2,1);--r:14px;--rs:8px;
  --stem-size:25px;--choice-size:15.5px;
  --app-vh:100dvh;--app-vw:100vw;--viewport-scale:1;--ui-title-size:26px;--ui-control-size:13px;--ui-meta-size:12px;--ui-micro-size:10px;
  --font-ui:Arial,Helvetica,sans-serif;--font-mono:Consolas,"Courier New",monospace;
}
*,*::before,*::after{margin:0;padding:0;box-sizing:border-box}
body{font-family:var(--font-ui);background:var(--cream);color:var(--ink);min-height:var(--app-vh);-webkit-font-smoothing:antialiased}
body.nbme-lock{overflow:hidden}
.view{display:none}.view.active{display:block}
#viewQuizNbme{height:var(--app-vh);overflow:hidden}
#viewQuizNbme.active{position:fixed;inset:0;z-index:40}

/* ══ SETUP VIEW ══ */
.setup-page{min-height:var(--app-vh);display:flex;flex-direction:column;align-items:center;justify-content:center;padding:32px 20px}
.setup-card{background:var(--white);border-radius:24px;border:1px solid var(--rule);box-shadow:var(--sh3);width:min(680px,100%);overflow:hidden}
.setup-top{background:linear-gradient(135deg,var(--navy) 0%,#1B2A4A 100%);padding:36px 36px 30px;text-align:center}
.setup-emoji{font-size:48px;margin-bottom:14px}
.setup-title{font-family:var(--font-ui);font-size:34px;font-weight:700;color:#fff;letter-spacing:-.15px;margin-bottom:6px}
.setup-title em{font-style:normal;color:var(--teal-glow)}
.setup-sub{font-size:15px;color:rgba(255,255,255,.65);line-height:1.6}

.setup-body{padding:32px 36px 36px}

/* instruction steps */
.how-title{font-size:11px;font-weight:800;letter-spacing:2px;text-transform:uppercase;color:var(--mist);margin-bottom:16px}
.steps{display:flex;flex-direction:column;gap:12px;margin-bottom:28px}
.step{display:flex;gap:14px;align-items:flex-start;padding:14px 16px;border-radius:12px;background:var(--warm);border:1px solid var(--rule)}
.step-num{width:28px;height:28px;border-radius:50%;background:var(--navy);color:#fff;font-size:12px;font-weight:700;display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:1px;font-family:var(--font-ui)}
.step-text{font-size:14px;color:var(--ink2);line-height:1.6}
.step-text strong{color:var(--ink);display:block;margin-bottom:2px}
.how-visual{margin:-12px 0 28px;padding:12px;border-radius:12px;background:var(--warm);border:1px solid var(--rule)}
.how-visual img{display:block;width:100%;height:auto;border-radius:8px;border:1px solid rgba(18,32,60,.1);background:#fff}
.how-visual-caption{margin-top:9px;font-size:12.5px;line-height:1.55;color:var(--ink2)}

/* prompt copy box */
.prompt-wrap{background:var(--navy);border-radius:12px;padding:16px 18px;position:relative;margin-bottom:8px}
.prompt-meta{display:flex;align-items:center;gap:10px;margin-bottom:10px;padding-right:82px}
.prompt-chip{display:inline-flex;align-items:center;min-height:28px;padding:0 10px;border-radius:999px;background:rgba(62,196,178,.14);border:1px solid rgba(62,196,178,.28);color:#D6ECFA;font-size:11.5px;font-weight:700;letter-spacing:.03em}
.prompt-inner{font-family:var(--font-ui);font-size:12.5px;line-height:1.68;color:#D6ECFA;white-space:pre-wrap;word-break:break-word;max-height:220px;overflow-y:auto;scrollbar-width:thin;scrollbar-color:rgba(255,255,255,.1) transparent;padding-right:70px}
.copy-prompt-btn{position:absolute;top:12px;right:12px;padding:6px 12px;background:rgba(62,196,178,.15);border:1px solid rgba(62,196,178,.35);border-radius:7px;color:var(--teal-glow);font-size:12px;font-weight:700;cursor:pointer;font-family:var(--font-ui);transition:all .18s;white-space:nowrap}
.copy-prompt-btn:hover{background:rgba(62,196,178,.28)}
.copy-prompt-btn.ok{background:rgba(45,134,89,.2);border-color:rgba(45,134,89,.4);color:#5EC490}

.divider{height:1px;background:var(--rule);margin:24px 0}

/* paste area */
.field{display:flex;flex-direction:column;gap:7px;margin-bottom:16px}
.field:last-child{margin-bottom:0}
.field-note{font-size:12px;line-height:1.55;color:var(--mist)}
.paste-tabs{display:flex;flex-wrap:wrap;gap:8px;margin-top:4px}
.paste-tab{padding:11px 14px;border-radius:12px;border:1.5px solid rgba(18,32,60,.1);background:#fff;color:var(--slate);font-family:var(--font-ui);font-size:13px;font-weight:700;cursor:pointer;transition:var(--tr);box-shadow:0 6px 16px rgba(18,32,60,.05)}
.paste-tab:hover{transform:translateY(-1px);border-color:rgba(26,122,109,.34);color:var(--teal)}
.paste-tab.active{background:linear-gradient(135deg,var(--navy),#2A3562);border-color:transparent;color:#fff;box-shadow:0 12px 24px rgba(18,32,60,.18)}
.paste-tab.has-content:not(.active){background:rgba(26,122,109,.08);border-color:rgba(26,122,109,.18);color:var(--teal-deep)}
.paste-panels{margin-top:12px}
.paste-panel{display:none}
.paste-panel.active{display:flex;flex-direction:column;gap:7px}
.paste-panel .ta{min-height:180px}
.lbl{font-size:11px;font-weight:800;letter-spacing:1.5px;text-transform:uppercase;color:var(--slate)}
.inp{padding:10px 14px;border-radius:var(--rs);border:1.5px solid var(--rule);font-family:var(--font-ui);font-size:14px;font-weight:400;color:var(--ink);background:var(--warm);outline:none;transition:border-color .18s;width:100%}
.inp:focus{border-color:var(--teal);box-shadow:0 0 0 3px rgba(62,196,178,.12);background:#fff}
.ta{width:100%;padding:13px 15px;border-radius:var(--rs);border:1.5px solid var(--rule);font-family:var(--font-ui);font-size:13px;line-height:1.65;color:var(--ink);background:var(--warm);resize:vertical;min-height:160px;outline:none;transition:border-color .18s}
.ta:focus{border-color:var(--teal);box-shadow:0 0 0 3px rgba(62,196,178,.12);background:#fff}
.ta::placeholder{color:var(--mist)}
.setup-actions{display:flex;gap:12px;margin-top:18px}
.launch-btn{width:100%;padding:16px;border-radius:16px;border:none;background:linear-gradient(135deg,var(--teal-glow),var(--teal-mid));color:var(--navy);font-family:var(--font-ui);font-size:17px;font-weight:700;cursor:pointer;letter-spacing:.15px;transition:all .2s;box-shadow:0 8px 22px rgba(62,196,178,.3);margin-top:18px}
.launch-btn:hover{transform:translateY(-2px);box-shadow:0 14px 30px rgba(62,196,178,.38)}
.setup-actions .launch-btn{margin-top:0;flex:1}
.ghost-btn{padding:16px 18px;border-radius:16px;border:1.5px solid rgba(18,32,60,.12);background:#fff;color:var(--navy);font-family:var(--font-ui);font-size:15px;font-weight:700;cursor:pointer;letter-spacing:.1px;transition:all .2s;box-shadow:0 8px 22px rgba(18,32,60,.08)}
.ghost-btn:hover{transform:translateY(-2px);border-color:rgba(26,122,109,.34);color:var(--teal);box-shadow:0 14px 30px rgba(18,32,60,.12)}
.setup-ui-toggle{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.setup-ui-btn{padding:15px 16px;border-radius:16px;border:1.5px solid rgba(18,32,60,.1);background:var(--warm);color:var(--ink);cursor:pointer;text-align:left;font-family:var(--font-ui);transition:var(--tr);box-shadow:0 8px 18px rgba(18,32,60,.05)}
.setup-ui-btn:hover{transform:translateY(-1px);border-color:rgba(26,122,109,.34);background:#fff}
.setup-ui-btn.active{background:linear-gradient(135deg,var(--navy),#2A3562);border-color:transparent;color:#fff;box-shadow:0 14px 30px rgba(18,32,60,.18)}
.setup-ui-name{display:block;font-size:14px;font-weight:900;line-height:1.2}
.setup-ui-meta{display:block;font-size:12px;line-height:1.5;color:inherit;opacity:.72;margin-top:6px}
.err-msg{padding:10px 14px;border-radius:var(--rs);font-size:13px;font-weight:700;display:none;align-items:center;gap:8px;margin-top:10px;background:var(--red-bg);color:var(--red);border:1px solid rgba(196,64,64,.2)}
.err-msg.show{display:flex}

/* ══ QUIZ VIEW ══ */
.quiz-page{min-height:var(--app-vh);display:flex;flex-direction:column}

/* top bar */
.qt-bar{background:linear-gradient(180deg,var(--navy) 0%,var(--navy2) 100%);display:flex;align-items:center;gap:14px;padding:0 22px;height:52px;flex-shrink:0;box-shadow:0 2px 12px rgba(18,32,60,.22)}
.qt-name{font-family:var(--font-ui);font-size:calc(var(--ui-title-size) * .67);font-weight:700;color:#fff;flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;letter-spacing:-.1px}
.qt-btn{padding:8px 14px;border-radius:10px;border:1.5px solid rgba(255,255,255,.2);background:transparent;color:rgba(255,255,255,.75);font-family:var(--font-ui);font-size:var(--ui-control-size);font-weight:700;cursor:pointer;transition:all .18s}
.qt-btn:hover{background:rgba(255,255,255,.1);color:#fff}
.qt-btn.active{background:rgba(255,255,255,.16);color:#fff;border-color:rgba(255,255,255,.34)}

/* grid */
.qin{width:min(1800px,calc(100vw - 24px));margin:0 auto;padding:22px 20px 72px;display:grid;grid-template-columns:clamp(270px,19vw,330px) minmax(0,1fr);gap:18px 26px;align-items:start}

/* sidebar panels */
.score-panel{display:grid;grid-template-columns:1fr 1fr 1fr;gap:10px;margin-bottom:0}
.score-box{position:relative;overflow:hidden;background:color-mix(in srgb,var(--white) 88%,var(--warm) 12%);border-radius:20px;padding:16px 12px 13px;text-align:center;box-shadow:var(--sh2);border:1px solid rgba(18,32,60,.08);transition:var(--tr)}
.score-box::before{content:'';position:absolute;left:14px;right:14px;top:0;height:4px;border-radius:0 0 999px 999px;background:linear-gradient(90deg,rgba(26,122,109,.16),rgba(62,196,178,.5));opacity:.75}
.score-box.correct{background:linear-gradient(180deg,rgba(255,255,255,.92),rgba(232,245,238,.98))}.score-box.correct::before{background:linear-gradient(90deg,rgba(45,134,89,.2),rgba(45,134,89,.72))}
.score-box.incorrect{background:linear-gradient(180deg,rgba(255,255,255,.92),rgba(253,240,240,.98))}.score-box.incorrect::before{background:linear-gradient(90deg,rgba(196,64,64,.18),rgba(196,64,64,.68))}
.sv{font-family:var(--font-ui);font-size:34px;font-weight:700;color:var(--navy);line-height:1}
.sl{font-size:9px;text-transform:uppercase;letter-spacing:2px;color:var(--mist);font-weight:800;margin-top:7px}
.score-box.correct .sv{color:var(--green)}.score-box.incorrect .sv{color:var(--red)}

.mode-toggle{display:flex;gap:7px;padding:7px;border-radius:22px;background:rgba(255,255,255,.76);backdrop-filter:blur(8px);border:1px solid rgba(18,32,60,.08);box-shadow:var(--sh2)}
.mode-btn{flex:1;padding:12px 14px;border-radius:16px;text-align:center;font-family:var(--font-ui);font-size:13.5px;font-weight:700;cursor:pointer;border:none;background:transparent;color:var(--slate);transition:all .22s}
.mode-btn:hover{color:var(--navy);background:rgba(18,32,60,.04)}
.mode-btn.active{background:linear-gradient(135deg,var(--navy),#2A3562);color:#fff;box-shadow:0 10px 22px rgba(27,42,74,.18)}
.mode-btn .mode-icon{display:block;font-size:19px;margin-bottom:3px}

.timer-card{position:relative;display:flex;align-items:center;gap:10px;flex-wrap:wrap;padding:42px 16px 16px;background:rgba(255,255,255,.84);border-radius:22px;border:1px solid rgba(18,32,60,.08);box-shadow:var(--sh2);transition:var(--tr)}
.timer-card.run{border-color:rgba(26,122,109,.34);box-shadow:0 0 0 4px rgba(26,122,109,.08),var(--sh2)}
.timer-card.warn{border-color:rgba(224,122,95,.4);box-shadow:0 0 0 4px rgba(224,122,95,.08),var(--sh2)}
.timer-lbl{position:absolute;top:13px;left:15px;font-size:10px;text-transform:uppercase;letter-spacing:2px;color:var(--mist);font-weight:800;padding:5px 9px;border-radius:999px;background:rgba(18,32,60,.04)}
.timer-time{font-family:var(--font-ui);font-size:38px;font-weight:700;color:var(--navy);min-width:110px;text-align:center;letter-spacing:1px}
.timer-card.warn .timer-time{color:var(--coral)}
.tbtn{width:40px;height:40px;border-radius:50%;border:1.8px solid rgba(27,42,74,.24);background:rgba(255,255,255,.9);cursor:pointer;display:flex;align-items:center;justify-content:center;font-size:15px;transition:var(--tr);color:var(--navy);flex-shrink:0;box-shadow:0 6px 18px rgba(18,32,60,.08)}
.tbtn:hover{background:var(--navy);color:#fff;transform:translateY(-1px) scale(1.04);border-color:var(--navy)}

.tool-panel{display:flex;flex-wrap:wrap;gap:9px;padding:9px;border-radius:22px;background:rgba(255,255,255,.76);backdrop-filter:blur(8px);border:1px solid rgba(18,32,60,.08);box-shadow:var(--sh2)}
.q-tool{flex:1 1 120px;min-width:0;padding:11px 14px;border-radius:14px;font-size:12.5px;font-weight:700;border:1.5px solid rgba(18,32,60,.08);background:rgba(255,255,255,.86);cursor:pointer;transition:var(--tr);font-family:var(--font-ui);color:var(--ink2);box-shadow:0 6px 16px rgba(18,32,60,.06);text-align:left}
.q-tool:hover{border-color:rgba(26,122,109,.32);color:var(--teal);transform:translateY(-1px);background:#fff}
.q-tool.active.hl-tool{background:#FFF8B8;border-color:#D3AF2B;color:#6B5C00;box-shadow:0 0 0 3px rgba(211,175,43,.12)}
.q-tool.active.st-tool{background:var(--red-bg);border-color:rgba(196,64,64,.44);color:var(--red);box-shadow:0 0 0 3px rgba(196,64,64,.08)}
.q-tool.lab-tool{flex-basis:100%}
.font-tools{display:flex;align-items:center;gap:8px;flex:1 1 100%;padding:12px 14px;border-radius:14px;border:1.5px solid rgba(18,32,60,.08);background:rgba(255,255,255,.86);box-shadow:0 6px 16px rgba(18,32,60,.06)}
.font-tools-label{font-size:12px;font-weight:900;letter-spacing:.08em;text-transform:uppercase;color:var(--slate)}
.font-tools-group{display:flex;gap:8px;margin-left:auto}
.font-btn{min-width:42px;padding:9px 12px;border-radius:12px;border:1.5px solid rgba(18,32,60,.1);background:#fff;color:var(--navy);font-family:var(--font-ui);font-size:13px;font-weight:700;cursor:pointer;transition:var(--tr);box-shadow:0 6px 14px rgba(18,32,60,.05)}
.font-btn:hover{transform:translateY(-1px);border-color:rgba(26,122,109,.34);color:var(--teal)}
.font-btn.reset{min-width:54px}

/* sidebar stack */
.sidebar{display:flex;flex-direction:column;gap:14px;position:sticky;top:18px}

/* question card — pixel-perfect hub match */
.qcd{background:color-mix(in srgb,var(--white) 94%,var(--warm) 6%);border-radius:28px;overflow:hidden;box-shadow:var(--sh3);border:1px solid rgba(18,32,60,.08);animation:cardIn .42s cubic-bezier(.4,0,.2,1) both}
@keyframes cardIn{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:translateY(0)}}
.qpg{height:6px;background:color-mix(in srgb,var(--teal) 10%,transparent)}
.qpf{height:100%;background:linear-gradient(90deg,var(--teal),var(--teal-glow));transition:width .5s cubic-bezier(.4,0,.2,1);border-radius:0 999px 999px 0}
.qbd{padding:28px 34px 26px}
.q-review-grid{display:grid;gap:24px}
.q-review-grid.has-feedback{grid-template-columns:minmax(0,.94fr) minmax(0,1.06fr);align-items:start}
.q-feedback{min-width:0;align-self:start}
.q-feedback .exb{margin-top:0;max-height:calc(var(--app-vh) - clamp(180px,24vh,260px));overflow:auto;overscroll-behavior:auto;scrollbar-width:thin;scrollbar-color:rgba(18,32,60,.28) rgba(18,32,60,.08)}
.q-feedback .exb::-webkit-scrollbar{width:10px}
.q-feedback .exb::-webkit-scrollbar-track{background:rgba(18,32,60,.08);border-radius:999px}
.q-feedback .exb::-webkit-scrollbar-thumb{background:rgba(18,32,60,.28);border-radius:999px}
.qnum{display:inline-flex;align-items:center;padding:6px 11px;border-radius:999px;background:rgba(18,32,60,.045);font-family:var(--font-ui);font-size:11px;color:var(--mist);letter-spacing:1.2px;text-transform:uppercase;margin-bottom:14px;font-weight:700}
.qnum.marked{background:var(--gold-bg);color:var(--amber)}
.qstem{font-family:var(--font-ui);font-size:var(--stem-size);line-height:1.45;margin-bottom:22px;font-weight:400;color:var(--ink);letter-spacing:0;white-space:pre-wrap;overflow-wrap:anywhere}
.lab-panel{display:grid;margin:14px 0 18px;border:1px solid rgba(18,32,60,.13);border-radius:14px;overflow:hidden;background:color-mix(in srgb,var(--white) 88%,var(--warm) 12%);font-size:.86em;line-height:1.35;white-space:normal;box-shadow:0 5px 16px rgba(18,32,60,.04)}
.lab-head,.lab-row{display:grid;grid-template-columns:minmax(0,1.35fr) minmax(96px,.65fr) minmax(118px,.8fr);align-items:baseline;gap:18px;padding:9px 14px}
.lab-head{background:rgba(18,32,60,.075);font-family:var(--font-mono);font-size:.72em;font-weight:800;letter-spacing:.08em;text-transform:uppercase;color:var(--mist)}
.lab-row+.lab-row{border-top:1px solid rgba(18,32,60,.08)}
.lab-row:nth-child(even){background:rgba(18,32,60,.025)}
.lab-name{min-width:0;font-weight:600}
.lab-value,.lab-reference{text-align:right;font-variant-numeric:tabular-nums;white-space:nowrap;font-weight:500}
.lab-reference{color:color-mix(in srgb,var(--ink) 68%,var(--mist) 32%);font-size:.92em}
.lab-note{padding:7px 14px;border-top:1px solid rgba(18,32,60,.08);background:rgba(18,32,60,.02);color:var(--mist);font-size:.72em;line-height:1.35}
.qstem mark{
  background:linear-gradient(180deg,transparent 12%,var(--mark-color,#FFFAAD) 12%,var(--mark-color,#FFFAAD) 88%,transparent 88%);
  padding:0;
  margin:0;
  border-radius:.1em;
  color:inherit;
  -webkit-box-decoration-break:clone;
  box-decoration-break:clone;
}
.qstem s{color:var(--mist);text-decoration:line-through}
.ach{display:grid;gap:10px}
.ac{display:flex;align-items:flex-start;gap:14px;padding:15px 18px;border:1.5px solid rgba(18,32,60,.09);border-radius:18px;cursor:pointer;transition:var(--tr);background:color-mix(in srgb,var(--warm) 78%,var(--white) 22%);box-shadow:0 6px 18px rgba(18,32,60,.04)}
.ac:hover:not(.dis){border-color:rgba(26,122,109,.4);background:linear-gradient(180deg,#fff,#F0F7F5);transform:translateY(-1px)}
.ac.sel{border-color:rgba(26,122,109,.5)!important;background:linear-gradient(180deg,#fff,#EFF7F5)!important;transform:translateY(-1px)}
.ac.cor{border-color:rgba(45,134,89,.44)!important;background:linear-gradient(180deg,#fff,#EDF8F1)!important}
.ac.inc{border-color:rgba(196,64,64,.4)!important;background:linear-gradient(180deg,#fff,#FDF2F2)!important}
.ac.dis{cursor:default;transform:none!important}
.cl{width:42px;height:42px;border-radius:50%;border:1.8px solid rgba(18,32,60,.12);display:flex;align-items:center;justify-content:center;font-family:var(--font-ui);font-size:15px;font-weight:700;flex-shrink:0;transition:var(--tr);background:#fff;box-shadow:0 6px 14px rgba(18,32,60,.05)}
.ac.sel .cl{background:var(--teal)!important;border-color:var(--teal)!important;color:#fff!important}
.ac.cor .cl{background:var(--green)!important;border-color:var(--green)!important;color:#fff!important}
.ac.inc .cl{background:var(--red)!important;border-color:var(--red)!important;color:#fff!important}
.ac-txt{font-size:var(--choice-size);font-weight:400;line-height:1.55;color:var(--ink);padding-top:9px}
.ac-txt mark{
  background:linear-gradient(180deg,transparent 12%,var(--mark-color,#FFFAAD) 12%,var(--mark-color,#FFFAAD) 88%,transparent 88%);
  padding:0;
  margin:0;
  border-radius:.1em;
  color:inherit;
  -webkit-box-decoration-break:clone;
  box-decoration-break:clone;
}
.ac-txt s{color:var(--mist);text-decoration:line-through}
.submit-row{margin-top:24px;text-align:center}
.submit-btn{padding:15px 54px;border-radius:18px;background:linear-gradient(135deg,var(--teal),var(--teal-mid));color:#fff;font-family:var(--font-ui);font-size:17px;font-weight:700;cursor:pointer;border:none;transition:var(--tr);box-shadow:0 10px 24px rgba(26,122,109,.24);letter-spacing:.15px}
.submit-btn:hover{transform:translateY(-2px);box-shadow:0 16px 30px rgba(26,122,109,.3)}
.submit-btn:disabled{opacity:.25;cursor:not-allowed;transform:none;box-shadow:none}
.exb{margin-top:26px;border-radius:22px;overflow:hidden;display:none;border:1px solid rgba(18,32,60,.08);background:#fff}
.exb.vis{display:block;animation:fadeUp .38s cubic-bezier(.4,0,.2,1)}
@keyframes fadeUp{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}
.exs{padding:20px 24px}.exs+.exs{border-top:1px solid rgba(18,32,60,.06)}
.exs.exc{background:var(--green-bg);border-left:5px solid var(--green)}
.exs.exw{background:var(--red-bg);border-left:5px solid var(--red)}
.exs.exo{background:var(--amber-bg);border-left:5px solid var(--amber)}
.exs.exe{background:var(--teal-light);border-left:5px solid var(--teal)}
.exl{font-family:'IBM Plex Mono',monospace;font-size:10px;font-weight:700;letter-spacing:1.8px;text-transform:uppercase;margin-bottom:10px}
.exs.exc .exl{color:var(--green)}.exs.exw .exl{color:var(--red)}.exs.exo .exl{color:var(--amber)}.exs.exe .exl{color:var(--teal)}
.ext{font-size:calc(var(--choice-size) * .97);line-height:1.65;color:var(--ink2)}
.wce{margin-top:10px;padding-top:10px;border-top:1px solid rgba(196,64,64,.12)}
.wce strong{color:var(--red);font-family:'IBM Plex Mono',monospace;font-size:12.5px}
.qnv{display:flex;justify-content:space-between;align-items:center;gap:14px;padding:16px 24px 20px;border-top:1px solid rgba(18,32,60,.08);background:linear-gradient(180deg,color-mix(in srgb,var(--warm) 32%,transparent),color-mix(in srgb,var(--cream) 82%,transparent))}
.nb{padding:12px 22px;border:1.8px solid rgba(27,42,74,.2);background:#fff;border-radius:16px;cursor:pointer;font-family:var(--font-ui);font-size:15px;font-weight:700;color:var(--navy);transition:var(--tr);box-shadow:0 8px 18px rgba(18,32,60,.06)}
.nb:hover{background:var(--navy);color:#fff;transform:translateY(-1px);border-color:var(--navy)}
.nb.pr{background:linear-gradient(135deg,var(--navy),#2A3562);color:#fff;border-color:transparent}
.nb.pr:hover{background:linear-gradient(135deg,var(--navy2),var(--navy))}
.nb:disabled{opacity:.22;cursor:not-allowed;transform:none!important;box-shadow:none}
.nav-dots{display:flex;gap:5px;flex-wrap:wrap;justify-content:center;flex:1}
.qd{width:10px;height:10px;border-radius:50%;background:rgba(18,32,60,.1);cursor:pointer;border:none;padding:0;transition:var(--tr)}
.qd:hover{background:rgba(18,32,60,.28);transform:scale(1.25)}
.qd.on{background:var(--teal-glow);box-shadow:0 0 0 3px rgba(62,196,178,.22)}
.qd.dc{background:var(--green)}.qd.di{background:var(--red)}
.qd.asel{background:rgba(18,32,60,.46)}
.qd.mk{box-shadow:0 0 0 2px rgba(192,123,26,.28)}

/* NBME / NBOME VIEW */
.nb-wrap{height:var(--app-vh);min-height:var(--app-vh);display:flex;flex-direction:column;overflow:hidden;background:#0d1117}
.nb-util{flex-shrink:0;display:flex;align-items:center;justify-content:space-between;gap:14px;padding:12px 18px;background:#0d1117;color:#fff}
.nb-util-name{font-family:var(--font-ui);font-size:var(--ui-title-size);line-height:1;letter-spacing:-.1px;font-weight:700}
.nb-util-actions{display:flex;flex-wrap:wrap;gap:8px}
.nb-util-btn{padding:8px 12px;border-radius:10px;border:1px solid rgba(255,255,255,.16);background:rgba(255,255,255,.06);color:#fff;font-family:var(--font-ui);font-size:var(--ui-control-size);font-weight:700;cursor:pointer;transition:var(--tr)}
.nb-util-btn:hover{background:rgba(255,255,255,.14);transform:translateY(-1px)}
.nb-app{flex:1;min-height:0;width:100%;display:grid;grid-template-rows:auto minmax(0,1fr) auto;background:#fff;overflow:hidden}
.nb-header,.nb-footer{background:#004976;color:#fff;border-color:#003653;user-select:none}
.nb-header{min-height:78px;display:grid;grid-template-columns:190px 1fr auto;align-items:stretch;border-bottom:3px solid #003653}
.nb-status-box{padding:10px 14px;display:flex;flex-direction:column;justify-content:center;border-right:1px solid rgba(255,255,255,.28);line-height:1.15}
.nb-status-box strong{font-size:calc(var(--ui-title-size) * .66)}
.nb-status-box span{margin-top:6px;font-size:calc(var(--ui-meta-size) * 1.08);color:rgba(255,255,255,.82)}
.nb-header-center{display:flex;align-items:center;gap:8px;padding:8px 12px;flex-wrap:wrap}
.nb-action-btn,.nb-mode-pill{min-height:52px;padding:6px 11px;border:1px solid rgba(255,255,255,.5);border-radius:3px;display:flex;align-items:center;justify-content:center;gap:6px;background:transparent;color:#fff;cursor:pointer;font-family:Arial,Helvetica,sans-serif;font-size:var(--ui-control-size);font-weight:700;line-height:1.2;transition:background .16s ease,border-color .16s ease}
.nb-action-btn:hover,.nb-mode-pill:hover,.nb-mode-pill.active,.nb-action-btn.active{background:#356f94}
.nb-action-btn:disabled,.nb-mode-pill:disabled{opacity:.45;cursor:default;background:transparent}
.nb-action-btn:disabled:hover,.nb-mode-pill:disabled:hover{background:transparent}
.nb-action-btn.active.hl{background:#f5c84b;border-color:#fff;color:#17212b}
.nb-action-btn.active.st{background:#f9d8de;border-color:#fff;color:#7d1830}
.nb-item-picker{display:flex;align-items:center;gap:7px;white-space:nowrap}
.nb-item-picker label{font-size:calc(var(--ui-meta-size) * 1.02);opacity:.86}
.nb-item-picker select{min-width:68px;padding:7px 5px;border-radius:3px;border:1px solid rgba(255,255,255,.25);background:#fff;color:#111;font-family:Arial,Helvetica,sans-serif;font-size:var(--ui-control-size)}
.nb-nav-controls{display:flex;align-items:stretch}
.nb-nav-btn{min-width:88px;border:0;border-left:1px solid rgba(255,255,255,.22);background:transparent;color:#fff;padding:8px 10px;font-family:Arial,Helvetica,sans-serif;cursor:pointer;transition:background .16s ease}
.nb-nav-btn:hover{background:#356f94}
.nb-nav-btn:disabled{opacity:.45;cursor:default;background:transparent}
.nb-nav-btn .icon{display:block;font-size:1.4rem;margin-bottom:4px}
.nb-body{min-height:0;display:grid;grid-template-columns:84px minmax(0,1fr);background:#fff;overflow:hidden}
.nb-rail{min-height:0;display:flex;flex-direction:column;gap:6px;padding:7px 6px;background:#e8edf1;border-right:1px solid #8b969f;overflow:hidden}
.nb-rail-title{margin:3px 0 1px;color:#35424e;text-align:center;font-size:calc(var(--ui-micro-size) * 1.12);font-weight:700;text-transform:uppercase;letter-spacing:.04em}
.nb-rail-scroll{flex:1;min-height:0;overflow-y:auto;overscroll-behavior:contain;padding-right:1px;scrollbar-width:thin;scrollbar-color:#8b969f #dce4ea}
.nb-rail-scroll::-webkit-scrollbar{width:8px}
.nb-rail-scroll::-webkit-scrollbar-track{background:#dce4ea;border-radius:999px}
.nb-rail-scroll::-webkit-scrollbar-thumb{background:#8b969f;border-radius:999px}
.nb-rail-arrow{display:inline-flex;align-items:center;justify-content:center;width:100%;height:28px;border:1px solid #8d98a1;border-radius:3px;background:#f7fafc;color:#22313d;font-size:.9rem;font-weight:900;cursor:pointer;transition:background .16s ease,border-color .16s ease,color .16s ease}
.nb-rail-arrow:hover:not(:disabled){background:#d9e5ee;border-color:#647280}
.nb-rail-arrow:disabled{opacity:.38;cursor:default}
.nb-rail-btn{width:100%;height:35px;margin-bottom:5px;position:relative;border:1px solid #8d98a1;border-radius:2px;background:#fff;color:#1d2933;font-size:calc(var(--ui-control-size) * 1.06);font-weight:700;cursor:pointer}
.nb-rail-btn:hover{background:#f4f8fb}
.nb-rail-btn.current{background:#004976;color:#fff;border-color:#004976}
.nb-rail-btn.incorrect{color:var(--red);border-color:#bd6570;background:#fff8f8}
.nb-rail-btn.current.incorrect{color:var(--red);background:#fff8f8;border-color:#a51d2d;box-shadow:inset 0 0 0 2px rgba(165,29,45,.18)}
.nb-rail-btn.answered::after{content:'';position:absolute;right:4px;bottom:4px;width:7px;height:7px;border-radius:50%;background:#257a43;box-shadow:0 0 0 1px #fff}
.nb-rail-btn.incorrect.answered::after{background:#a51d2d}
.nb-rail-btn.marked::before{content:'⚑';position:absolute;left:3px;top:1px;color:#bd7400;font-size:.78rem}
.nb-rail-btn.current.marked::before{color:#ffd75e}
.nb-stage{position:relative;display:flex;flex-direction:column;min-width:0;min-height:0;overflow:hidden;background:#fff}
#nbFinishBanner{flex-shrink:0}
.nb-question-scroll{flex:1;min-height:0;overflow:auto;overscroll-behavior:contain;padding:26px clamp(24px,6vw,92px) 112px}
.nb-question-card,.nb-review-wrap{width:min(980px,100%);margin:0 auto}
.nb-question-card.has-feedback{width:min(1580px,100%)}
.nb-question-layout{display:grid;gap:24px}
.nb-question-layout.has-feedback{grid-template-columns:minmax(0,.95fr) minmax(0,1.05fr);align-items:start}
.nb-question-side{min-width:0;align-self:start}
.nb-question-side .exb{margin-top:0;max-height:calc(var(--app-vh) - clamp(260px,34vh,380px));overflow:auto;overscroll-behavior:auto;scroll-padding-bottom:clamp(88px,12vh,136px);scrollbar-width:thin;scrollbar-color:rgba(18,32,60,.28) rgba(18,32,60,.08)}
.nb-question-side .exb::-webkit-scrollbar{width:10px}
.nb-question-side .exb::-webkit-scrollbar-track{background:rgba(18,32,60,.08);border-radius:999px}
.nb-question-side .exb::-webkit-scrollbar-thumb{background:rgba(18,32,60,.28);border-radius:999px}
.nb-question-side .exb::after{content:'';display:block;height:clamp(88px,12vh,136px);background:transparent}
.nb-question-label{margin-bottom:16px;color:#5b6570;font-weight:700;font-size:calc(var(--ui-meta-size) * 1.16);letter-spacing:.02em}
.nb-question-stem{font-size:calc(var(--stem-size) * .72);line-height:1.58;user-select:text;white-space:pre-wrap;overflow-wrap:anywhere}
.nb-question-stem mark,.nb-answer-copy mark{
  background:linear-gradient(180deg,transparent 16%,var(--mark-color,#fff173) 16%,var(--mark-color,#fff173) 86%,transparent 86%);
  color:inherit;
  padding:0;
  margin:0;
  border-radius:.08em;
  -webkit-box-decoration-break:clone;
  box-decoration-break:clone;
}
.nb-question-stem s,.nb-answer-copy s{color:#717a82;text-decoration:line-through}
.nb-stage-note{margin-top:18px;color:#5b6570;font-size:calc(var(--ui-meta-size) * 1.12);line-height:1.5}
.nb-answers{margin-top:24px;display:grid;gap:11px}
.nb-answer-row{display:grid;grid-template-columns:32px 1fr;align-items:start;gap:9px;padding:8px 9px;border:1px solid transparent;border-radius:3px;cursor:pointer;transition:background .16s ease,border-color .16s ease}
.nb-answer-row:hover{background:#f3f7fa;border-color:#d7e0e7}
.nb-answer-row.selected{background:#d9ebf7;border-color:#7fa9c4}
.nb-answer-row.correct{background:#dff2e5;border-color:#4d9b68}
.nb-answer-row.incorrect{background:#f8dfe2;border-color:#bd6570}
.nb-answer-row.locked{cursor:default}
.nb-answer-glyph{width:24px;height:24px;border:1px solid #8d98a1;border-radius:50%;display:flex;align-items:center;justify-content:center;font-family:'IBM Plex Mono',monospace;font-size:calc(var(--ui-control-size) * 1.05);font-weight:700;background:#fff;color:#1d2933;margin-top:1px}
.nb-answer-row.selected .nb-answer-glyph{background:#004976;border-color:#004976;color:#fff}
.nb-answer-row.correct .nb-answer-glyph{background:#257a43;border-color:#257a43;color:#fff}
.nb-answer-row.incorrect .nb-answer-glyph{background:#a51d2d;border-color:#a51d2d;color:#fff}
.nb-answer-copy{font-size:calc(var(--choice-size) * 1.02);line-height:1.52;user-select:text}
.nb-submit-row{margin-top:24px}
.nb-submit-btn{min-width:165px;padding:10px 18px;border:1px solid #003653;border-radius:3px;background:#004976;color:#fff;font-weight:700;font-family:Arial,Helvetica,sans-serif;cursor:pointer}
.nb-submit-btn:disabled{opacity:.55;cursor:default}
.nb-review-wrap h2{color:#004976;font-size:1.55rem;font-family:Arial,Helvetica,sans-serif}
.nb-review-wrap p{font-size:calc(var(--choice-size) * .95);line-height:1.5;color:#33404a}
.nb-review-summary{display:flex;flex-wrap:wrap;gap:14px;margin:16px 0 24px}
.nb-summary-chip{min-width:145px;padding:12px 15px;border:1px solid #aeb8c0;border-radius:3px;background:#f3f6f8}
.nb-summary-chip strong{display:block;margin-top:5px;font-size:calc(var(--ui-title-size) * .82);color:#004976}
.nb-review-table{width:100%;border-collapse:collapse}
.nb-review-table th,.nb-review-table td{padding:11px;border:1px solid #aeb8c0;text-align:left;font-size:calc(var(--choice-size) * .9)}
.nb-review-table th{background:#004976;color:#fff}
.nb-review-table tr:nth-child(even){background:#f3f6f8}
.nb-review-jump{color:#004976;text-decoration:underline;border:0;background:transparent;font-weight:700;padding:0;cursor:pointer}
.nb-review-actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:18px}
.nb-review-back{padding:10px 16px;border:1px solid #8d99a3;border-radius:3px;background:#f3f5f7;color:#17212b;font-weight:700;cursor:pointer}
.nb-footer{min-height:72px;display:grid;grid-template-columns:auto 1fr auto;align-items:stretch;border-top:3px solid #003653}
.nb-timer-box{min-width:245px;display:grid;grid-template-columns:1fr auto;gap:4px 14px;align-content:center;padding:10px 18px;border-right:1px solid rgba(255,255,255,.28);font-variant-numeric:tabular-nums}
.nb-timer-box strong{text-align:right}
.nb-timer-box small{grid-column:1 / -1;text-align:center;opacity:.82;font-size:.68rem}
.nb-timer-actions{grid-column:1 / -1;display:flex;gap:8px;justify-content:center;margin-top:2px}
.nb-timer-mini{padding:7px 12px;border:1px solid rgba(255,255,255,.75);border-radius:3px;background:transparent;color:#fff;font-weight:700;cursor:pointer}
.nb-timer-mini:hover{background:#356f94}
.nb-timer-box.warn strong{color:#ffd45b}
.nb-footer-center{display:flex;align-items:center;justify-content:center;gap:10px;padding:8px 12px;flex-wrap:wrap}
.nb-score-chip{display:flex;align-items:center;gap:12px;padding:10px 12px;border:1px solid rgba(255,255,255,.2);border-radius:3px;background:rgba(255,255,255,.08);font-size:calc(var(--ui-control-size) * .98)}
.nb-score-chip span{display:inline-flex;align-items:center;gap:4px;white-space:nowrap}
.nb-score-chip strong{font-size:calc(var(--ui-control-size) * 1.16)}
.nb-font-cluster{display:flex;align-items:center;gap:7px;padding:8px 10px;border:1px solid rgba(255,255,255,.2);border-radius:3px;background:rgba(255,255,255,.08)}
.nb-font-cluster label{font-size:calc(var(--ui-meta-size) * 1.02);font-weight:700}
.nb-font-btn{padding:7px 10px;border:1px solid rgba(255,255,255,.72);border-radius:3px;background:transparent;color:#fff;font-size:var(--ui-control-size);font-weight:700;cursor:pointer}
.nb-font-btn:hover{background:#356f94}
.nb-footer-tool{padding:8px 12px;border:1px solid rgba(255,255,255,.72);border-radius:3px;background:rgba(255,255,255,.08);color:#fff;font-size:var(--ui-control-size);font-weight:700;cursor:pointer;font-family:Arial,Helvetica,sans-serif}
.nb-footer-tool:hover{background:#356f94}
.nb-end-wrap{display:flex;align-items:center;padding:10px 13px}
.nb-end-btn{padding:0 20px;min-height:44px;border:1px solid rgba(255,255,255,.8);border-radius:3px;background:#7d1830;color:#fff;font-size:var(--ui-control-size);font-weight:700;cursor:pointer}
.nb-end-btn:hover:not(:disabled){background:#a82745}
.nb-end-btn:disabled{opacity:.45;cursor:default;background:rgba(255,255,255,.14)}

/* Lab values */
.lab-modal{position:fixed;inset:0;z-index:1200;display:none;align-items:center;justify-content:center;padding:24px;background:rgba(9,17,28,.58);backdrop-filter:blur(9px)}
.lab-modal.open{display:flex}
.lab-shell{width:min(1100px,96vw);max-height:92vh}
.lab-card{display:flex;flex-direction:column;max-height:92vh;border-radius:26px;background:linear-gradient(180deg,rgba(255,255,255,.98),rgba(246,243,236,.98));border:1px solid rgba(18,32,60,.08);box-shadow:0 28px 80px rgba(0,0,0,.22);overflow:hidden}
.lab-header{display:flex;align-items:flex-start;justify-content:space-between;gap:18px;padding:22px 24px 18px;border-bottom:1px solid rgba(18,32,60,.08)}
.lab-kicker{font-family:var(--font-ui);font-size:11px;letter-spacing:1.3px;text-transform:uppercase;color:var(--mist);margin-bottom:8px;font-weight:700}
.lab-title{font-family:var(--font-ui);font-size:calc(var(--stem-size) * 1.02);line-height:1.08;color:var(--navy);margin:0 0 8px;font-weight:700}
.lab-sub{font-size:calc(var(--choice-size) * .92);line-height:1.6;color:var(--slate);max-width:68ch}
.lab-close{display:inline-flex;align-items:center;justify-content:center;min-height:44px;padding:0 16px;border-radius:14px;border:1px solid rgba(18,32,60,.12);background:#fff;color:var(--navy);font-family:var(--font-ui);font-size:14px;font-weight:700;cursor:pointer;transition:var(--tr)}
.lab-close:hover{transform:translateY(-1px);border-color:rgba(26,122,109,.34);color:var(--teal)}
.lab-controls{display:flex;align-items:center;justify-content:space-between;gap:14px;flex-wrap:wrap;padding:16px 24px;border-bottom:1px solid rgba(18,32,60,.08);background:rgba(255,255,255,.72)}
.lab-toggle{display:inline-flex;gap:8px;padding:6px;border-radius:999px;background:rgba(18,32,60,.05)}
.lab-toggle-btn{padding:10px 16px;border:none;border-radius:999px;background:transparent;color:var(--slate);font-family:var(--font-ui);font-size:calc(var(--choice-size) * .86);font-weight:700;cursor:pointer;transition:var(--tr)}
.lab-toggle-btn.active{background:linear-gradient(135deg,var(--navy),#2A3562);color:#fff;box-shadow:0 10px 22px rgba(27,42,74,.16)}
.lab-note{font-size:calc(var(--choice-size) * .78);line-height:1.6;color:var(--mist)}
.lab-body{padding:18px 24px 24px;overflow:auto}
.lab-table{width:100%;margin-bottom:18px;border-collapse:collapse;font-size:calc(var(--choice-size) * .92);background:#fff}
.lab-table thead th{padding:9px 10px;background:#dbe6ed;border:1px solid #9eabb4;text-align:left}
.lab-table thead th:first-child{width:48%}
.lab-table tbody td{padding:6px 9px;border:1px solid #c6cdd3;text-align:left;vertical-align:top}
.lab-table tbody tr:nth-child(even):not(.lab-group){background:#f6f8f9}
.lab-table .lab-group td{padding:8px 9px;background:#edf1f4;font-weight:700}
.lab-table .continuation{color:transparent}

/* finish overlay */
.fin{position:relative;background:linear-gradient(135deg,var(--navy),#2A3562);border-radius:24px;padding:22px 24px;text-align:center;color:#fff;box-shadow:var(--sh3);margin:0 auto 14px;max-width:min(780px,100%);transition:padding .2s ease,box-shadow .2s ease}
.fin.min{padding:56px 24px 22px}
.fin-toggle{position:absolute;top:14px;left:14px;display:inline-flex;align-items:center;justify-content:center;min-width:40px;height:34px;padding:0 12px;border-radius:12px;border:1.5px solid rgba(255,255,255,.25);background:rgba(255,255,255,.04);color:rgba(255,255,255,.86);font-family:var(--font-ui);font-size:18px;font-weight:700;cursor:pointer;transition:all .18s}
.fin-toggle:hover{background:rgba(255,255,255,.12);color:#fff}
.fin-main{display:grid;justify-items:center}
.fin-pct{font-family:var(--font-ui);font-size:46px;font-weight:700;color:var(--teal-glow);line-height:1}
.fin-pct-lbl{font-size:11px;letter-spacing:2px;text-transform:uppercase;color:rgba(255,255,255,.45);margin:4px 0 14px}
.fin-msg{font-family:var(--font-ui);font-size:24px;font-weight:700;margin-bottom:6px}
.fin-sub{font-size:13px;color:rgba(255,255,255,.6);margin-bottom:18px}
.fin-btns{display:flex;gap:10px;justify-content:center;flex-wrap:wrap}
.fin-btn{padding:10px 16px;border-radius:12px;border:1.5px solid rgba(255,255,255,.25);background:transparent;color:rgba(255,255,255,.8);font-family:var(--font-ui);font-size:13px;font-weight:700;cursor:pointer;transition:all .18s}
.fin-btn:hover{background:rgba(255,255,255,.12);color:#fff}

/* final review sheet */
.sum-sheet{margin-top:18px;background:rgba(255,255,255,.96);border:1px solid rgba(18,32,60,.08);border-radius:28px;box-shadow:var(--sh3);overflow:hidden;scroll-margin-top:20px}
.sum-head{display:flex;align-items:flex-start;justify-content:space-between;gap:18px;padding:26px 28px 22px;border-bottom:1px solid rgba(18,32,60,.08);background:linear-gradient(180deg,color-mix(in srgb,var(--warm) 48%,transparent),#fff)}
.sum-kicker{font-family:var(--font-ui);font-size:11px;font-weight:700;letter-spacing:1.3px;text-transform:uppercase;color:var(--mist);margin-bottom:8px}
.sum-title{font-family:var(--font-ui);font-size:34px;line-height:1.08;color:var(--navy);margin:0 0 8px;font-weight:700}
.sum-sub{font-size:14px;line-height:1.6;color:var(--slate);max-width:66ch}
.sum-actions{display:flex;gap:10px;flex-wrap:wrap}
.sum-btn{padding:11px 16px;border-radius:14px;border:1.5px solid rgba(18,32,60,.12);background:#fff;color:var(--navy);font-family:var(--font-ui);font-size:14px;font-weight:700;cursor:pointer;transition:var(--tr);white-space:nowrap}
.sum-btn:hover{transform:translateY(-1px);border-color:rgba(26,122,109,.34);color:var(--teal)}
.sum-btn.primary{background:linear-gradient(135deg,var(--teal),var(--teal-mid));border-color:transparent;color:#fff;box-shadow:0 10px 24px rgba(26,122,109,.2)}
.sum-btn.primary:hover{color:#fff;box-shadow:0 14px 28px rgba(26,122,109,.26)}
.sum-stats{display:flex;gap:12px;flex-wrap:wrap;padding:18px 28px;border-bottom:1px solid rgba(18,32,60,.08);background:rgba(246,243,236,.72)}
.sum-stat{min-width:150px;padding:14px 16px;border-radius:18px;border:1px solid rgba(18,32,60,.08);background:#fff;box-shadow:0 8px 20px rgba(18,32,60,.05)}
.sum-stat-label{font-size:10px;font-weight:900;letter-spacing:1.6px;text-transform:uppercase;color:var(--mist);margin-bottom:8px}
.sum-stat-value{font-family:var(--font-ui);font-size:32px;line-height:1;color:var(--navy);font-weight:700}
.sum-list{display:grid;gap:14px;padding:22px 24px 26px}
.sum-item{display:grid;grid-template-columns:150px minmax(0,1fr);gap:18px;padding:20px;border-radius:22px;border:1px solid rgba(18,32,60,.08);background:#fff;box-shadow:0 8px 22px rgba(18,32,60,.05)}
.sum-item.correct{border-color:rgba(45,134,89,.24);background:linear-gradient(180deg,#fff,#f6fcf8)}
.sum-item.incorrect{border-color:rgba(196,64,64,.18);background:linear-gradient(180deg,#fff,#fff8f8)}
.sum-item.unanswered{border-color:rgba(192,123,26,.24);background:linear-gradient(180deg,#fff,#fffaf1)}
.sum-meta{display:flex;flex-direction:column;gap:10px}
.sum-num{display:inline-flex;align-items:center;justify-content:center;min-height:42px;padding:0 16px;border-radius:999px;background:rgba(18,32,60,.06);font-family:var(--font-ui);font-size:12px;font-weight:700;letter-spacing:1px;text-transform:uppercase;color:var(--navy);width:max-content}
.sum-state{display:inline-flex;align-items:center;justify-content:center;min-height:34px;padding:0 14px;border-radius:999px;font-size:12px;font-weight:900;letter-spacing:.08em;text-transform:uppercase;width:max-content}
.sum-item.correct .sum-state{background:var(--green-bg);color:var(--green)}
.sum-item.incorrect .sum-state{background:var(--red-bg);color:var(--red)}
.sum-item.unanswered .sum-state{background:var(--amber-bg);color:var(--amber)}
.sum-answer{font-size:13px;font-weight:900;letter-spacing:.04em;text-transform:uppercase;color:var(--slate)}
.sum-body{display:grid;gap:14px}
.sum-section{padding:16px 18px;border-radius:18px;border:1px solid rgba(18,32,60,.06);background:rgba(246,243,236,.56)}
.sum-label{font-family:'IBM Plex Mono',monospace;font-size:10px;font-weight:800;letter-spacing:1.7px;text-transform:uppercase;color:var(--mist);margin-bottom:9px}
.sum-text{font-size:calc(var(--choice-size) * .97);line-height:1.65;color:var(--ink2)}
.sum-view{display:grid;gap:18px}

/* responsive */
/* iPad portrait & narrow laptops — stack feedback next-to layouts before they cramp */
@media(max-width:1180px){
  .q-review-grid.has-feedback,.nb-question-layout.has-feedback{grid-template-columns:1fr}
  .q-feedback .exb,.nb-question-side .exb{max-height:none;overflow:visible}
  .qin{grid-template-columns:clamp(230px,24vw,290px) minmax(0,1fr);gap:16px 18px}
}
@media(max-width:820px){
  .qin{grid-template-columns:1fr;padding:16px 14px 64px}
  .sidebar{position:static;flex-direction:row;flex-wrap:wrap}
  .score-panel{flex:1 1 200px}
  .mode-toggle,.tool-panel{flex:1 1 100%}
  .timer-card{flex:1 1 160px}
  .nb-header{grid-template-columns:1fr}
  .nb-status-box{border-right:none;border-bottom:1px solid rgba(255,255,255,.2)}
  .nb-nav-controls{border-top:1px solid rgba(255,255,255,.18)}
  .nb-nav-btn{flex:1;min-height:52px}
  .nb-nav-btn .icon{display:inline;font-size:1.05rem;margin:0 6px 0 0}
  /* rail becomes a horizontal question strip instead of disappearing */
  .nb-body{grid-template-columns:1fr;grid-template-rows:auto minmax(0,1fr)}
  .nb-rail{flex-direction:row;align-items:center;gap:4px;padding:6px 8px;border-right:none;border-bottom:1px solid #8b969f}
  .nb-rail-title{display:none}
  .nb-rail-arrow{display:none}
  .nb-rail-scroll{flex:1;overflow-y:hidden;overflow-x:auto;padding:2px 0;scrollbar-width:thin}
  #nbRailItems{display:flex;flex-direction:row;gap:5px;width:max-content}
  .nb-rail-btn{width:44px;min-width:44px;height:38px;margin-bottom:0}
  .nb-question-scroll{padding:18px clamp(14px,4vw,32px) 96px}
  .nb-footer{grid-template-columns:1fr}
  .nb-timer-box{border-right:none;border-bottom:1px solid rgba(255,255,255,.18)}
  .nb-end-wrap{justify-content:center}
  .setup-ui-toggle{grid-template-columns:1fr}
}
@media(max-width:480px){.qbd{padding:20px 16px}.qstem{font-size:max(21px,var(--stem-size))}.qnv{flex-direction:column;padding:14px 16px 18px}.nb{width:100%}.font-tools{flex-direction:column;align-items:stretch}.font-tools-group{margin-left:0;justify-content:space-between}.sum-head{padding:22px 18px 18px;flex-direction:column}.sum-title{font-size:28px}.sum-stats{padding:16px 18px}.sum-list{padding:18px 16px 22px}.sum-item{grid-template-columns:1fr;padding:16px}.cl{width:36px;height:36px;font-size:13.5px}.ac{gap:10px;padding:13px 14px}}
@media(max-width:560px){.setup-actions{flex-direction:column}.qt-bar{height:auto;flex-wrap:wrap;padding:12px 16px}.nb-util{flex-direction:column;align-items:flex-start}}

/* touch devices — comfortable hit targets everywhere */
@media(pointer:coarse){
  .qt-btn,.nb-util-btn,.nb-action-btn,.nb-mode-pill,.nb-footer-tool,.nb-font-btn,.nb-timer-mini,.font-btn,.q-tool,.paste-tab{min-height:44px}
  .nb-answer-row{padding:12px 11px;gap:11px}
  .nb-rail-btn{min-height:42px}
  .qd{width:14px;height:14px}
  .lab-toggle-btn{min-height:44px}
}

/* big screens — 16" MBP maximized, 4K monitors, TVs: widen the stage and let type scale */
@media(min-width:2000px){
  .qin{width:min(2400px,calc(100vw - 48px));gap:22px 34px;grid-template-columns:clamp(300px,17vw,400px) minmax(0,1fr)}
  .nb-question-card,.nb-review-wrap{width:min(1240px,100%)}
  .nb-question-card.has-feedback{width:min(2000px,100%)}
  .nb-body{grid-template-columns:104px minmax(0,1fr)}
  .nb-rail-btn{height:44px}
  .nb-header{min-height:88px}
  .nb-footer{min-height:82px}
  .qd{width:13px;height:13px}
  .setup-card{width:min(820px,100%)}
}
@media(min-width:3000px){
  .qin{width:min(2900px,calc(100vw - 64px))}
  .nb-question-card,.nb-review-wrap{width:min(1500px,100%)}
  .nb-question-card.has-feedback{width:min(2500px,100%)}
  .nb-body{grid-template-columns:120px minmax(0,1fr)}
}

/* notch / home-indicator safe areas (iPhone, iPad) */
.nb-footer{padding-bottom:env(safe-area-inset-bottom,0)}
.nb-util{padding-left:max(18px,env(safe-area-inset-left,0));padding-right:max(18px,env(safe-area-inset-right,0))}
.qt-bar{padding-left:max(22px,env(safe-area-inset-left,0));padding-right:max(22px,env(safe-area-inset-right,0))}

/* timer display-mode + expiry */
.timer-lbl{cursor:pointer;user-select:none;transition:background .15s}
.timer-lbl:hover{background:rgba(18,32,60,.1)}
.nb-timer-mode{padding:0;border:0;background:transparent;color:inherit;font:inherit;cursor:pointer;text-align:left;text-decoration:underline dotted rgba(255,255,255,.5);text-underline-offset:3px}
.timer-card.expired,.nb-timer-box.expired strong{animation:timerBlink 1s steps(2,start) 6}
.nb-timer-box.expired strong{color:#ff8f8f}
.timer-card.expired{border-color:rgba(196,64,64,.6);box-shadow:0 0 0 4px rgba(196,64,64,.12),var(--sh2)}
@keyframes timerBlink{50%{opacity:.35}}

@media(max-width:600px){.lab-head{display:none}.lab-row{grid-template-columns:1fr auto;gap:2px 12px}.lab-value{text-align:right;white-space:normal}.lab-reference{grid-column:1/-1;text-align:left;white-space:normal}.lab-reference::before{content:'Reference: ';font-weight:700}.lab-note{font-size:.68em}}
@media (prefers-reduced-motion: reduce){
  *,*::before,*::after{animation:none !important;transition:none !important}
}

/* toast */
.toast-wrap{position:fixed;bottom:24px;left:50%;transform:translateX(-50%);z-index:999;pointer-events:none}
.toast{padding:11px 20px;border-radius:999px;font-size:13.5px;font-weight:700;box-shadow:0 8px 28px rgba(0,0,0,.15);animation:toastIn .28s cubic-bezier(.2,.8,.2,1) both;white-space:nowrap}
@keyframes toastIn{from{opacity:0;transform:translateY(14px) scale(.94)}to{opacity:1;transform:translateY(0) scale(1)}}
@keyframes toastOut{to{opacity:0;transform:translateY(8px) scale(.95)}}
.toast.ok{background:var(--navy);color:var(--teal-glow)}.toast.err{background:var(--red);color:#fff}

.annotation-menu{position:fixed;z-index:10000;display:flex;align-items:center;gap:10px;padding:10px 12px;background:#242424;border-radius:9px;box-shadow:0 6px 24px #0004}
.annotation-menu[hidden]{display:none}
.annotation-swatch{width:28px;height:28px;border:2px solid transparent;border-radius:50%;cursor:pointer;flex-shrink:0}
.annotation-swatch[aria-pressed="true"]{outline:2px solid white;outline-offset:2px}
.annotation-menu button:focus-visible{outline:2px solid white;outline-offset:3px}
.annotation-strike{border:0;border-left:1px solid #777;background:transparent;color:white;padding:5px 9px;font-size:16px;cursor:pointer;text-decoration:line-through}
.highlight-color-button{width:28px;height:28px;flex-shrink:0;align-self:center;border:2px solid #777;border-radius:50%;background:var(--active-highlight,#fff173);cursor:pointer}


/* Reading themes and study tools */
:root{--reading-accent:#1a7a6d;--reading-selected:#d9ebf7}
:root[data-theme="dark"]{color-scheme:dark;--cream:#141a20;--warm:#202932;--white:#1b232b;--ink:#e4e9ed;--ink2:#cbd4db;--slate:#aebbc5;--mist:#a4b3bf;--rule:#46535f;--teal:#78c9ba;--teal-deep:#9cded1;--teal-light:#223c3a;--green:#89d5a4;--green-bg:#233c30;--red:#ffaaaa;--red-bg:#452c32;--amber:#e7bf7a;--amber-bg:#3d3528;--gold-bg:#3d3528;--reading-accent:#9bd4e8;--reading-selected:#294454}
:root[data-theme="soft"]{color-scheme:light;--cream:#e6dfd1;--warm:#eee7d9;--white:#f3eddf;--ink:#393e35;--ink2:#4c5348;--slate:#60685b;--mist:#697260;--rule:#bbb7a5;--teal:#496e58;--teal-deep:#3e604a;--teal-light:#dfe7d8;--green:#376047;--green-bg:#e0e8d9;--red:#943f3b;--red-bg:#f0dfd4;--amber:#795823;--amber-bg:#ece2cc;--gold-bg:#ece2cc;--reading-accent:#45644d;--reading-selected:#d6dfcc}
:root[data-theme] :is(.nb-app,.nb-body,.nb-stage,.nb-answer-glyph,.nb-rail-btn,.cl,.exb,.sum-sheet,.sum-item,.sum-stat,.lab-card,.lab-table,.mode-toggle,.timer-card,.tool-panel,.font-tools,.score-box,.q-tool,.font-btn,.tbtn,.nb,.ghost-btn,.paste-tab,.lab-close,.sum-btn){background:var(--white);color:var(--ink);border-color:var(--rule)}
:root[data-theme] :is(.nb-rail,.nb-rail-arrow,.nb-summary-chip,.nb-review-back,.sum-head,.sum-stats,.sum-section,.lab-controls,.lab-table thead th,.lab-table .lab-group td,.lab-table tbody tr:nth-child(even):not(.lab-group),.nb-review-table tr:nth-child(even)){background:var(--warm);color:var(--ink);border-color:var(--rule)}
:root[data-theme] :is(.nb-question-label,.nb-stage-note,.nb-rail-title,.nb-review-wrap p){color:var(--slate)}
:root[data-theme] :is(.sv,.timer-time,.sum-num,.sum-title,.sum-stat-value,.lab-title,.nb-review-wrap h2,.nb-summary-chip strong,.nb-review-jump){color:var(--reading-accent)}
:root[data-theme] :is(.inp,.ta):focus{background:var(--white)}
:root[data-theme] :is(.nb-answer-row:hover,.ac:hover:not(.dis)){background:var(--warm);border-color:var(--rule)}
:root[data-theme] :is(.ac.sel,.nb-answer-row.selected,.nb-rail-btn.current){background:var(--reading-selected)!important;color:var(--ink);border-color:var(--reading-accent)!important}
:root[data-theme] :is(.ac.cor,.nb-answer-row.correct,.sum-item.correct,.score-box.correct){background:var(--green-bg)!important;border-color:var(--green)!important}
:root[data-theme] :is(.ac.inc,.nb-answer-row.incorrect,.sum-item.incorrect,.score-box.incorrect,.nb-rail-btn.incorrect){background:var(--red-bg)!important;border-color:var(--red)!important}
:root[data-theme="dark"] .ac:is(.sel,.cor,.inc) .cl{color:#17212b!important}
:root[data-theme] mark{color:#17212b!important}
:root[data-theme] :is(.nb-header,.nb-footer){background:#253c45;border-color:var(--rule)}
:root[data-theme="soft"] :is(.nb-header,.nb-footer){background:#4a5c4b}
:root[data-theme] :is(.nb-review-table td,.lab-table td,.lab-table th){border-color:var(--rule)}
.reading-theme{display:flex;align-items:center;gap:8px;font-size:13px;font-weight:700;flex-wrap:wrap}
.reading-theme select{padding:8px;border:1px solid var(--rule);border-radius:8px;background:var(--white);color:var(--ink);font:inherit;max-width:100%}
.setup-body>.reading-theme{margin-bottom:22px}
.tool-panel>.reading-theme{padding:6px;flex-basis:100%}

.study-notes-text{white-space:pre-wrap;overflow-wrap:anywhere}
/* Compact, theme-matched chrome and movable study windows. */
:root{--chrome:#163a50;--chrome-text:#f3f7f9;--chrome-border:#527184;--tool-accent:#236d68;--tool-on-accent:#fff;--tool-hover:#e4eeeb}
:root[data-theme="dark"]{--chrome:#222e37;--chrome-text:#dce5ea;--chrome-border:#53626d;--tool-accent:#86c8b7;--tool-on-accent:#162b25;--tool-hover:#304139}
:root[data-theme="soft"]{color-scheme:light;--cream:#ccd3ca;--warm:#d5dcd2;--white:#e0e5dc;--ink:#29352f;--ink2:#35443b;--slate:#4c5d52;--mist:#506155;--rule:#9ba99c;--teal:#3c6654;--teal-deep:#315342;--teal-light:#cbdacb;--green:#315d3c;--green-bg:#c7dac4;--red:#853e3e;--red-bg:#e3ceca;--amber:#755322;--amber-bg:#ded5bc;--gold-bg:#ded5bc;--reading-accent:#355e4e;--reading-selected:#c1d4c4;--chrome:#bdc9bc;--chrome-text:#293d31;--chrome-border:#8c9e8e;--tool-accent:#3c6654;--tool-on-accent:#f0f4ed;--tool-hover:#c7d5c7}
.nb-util{min-height:38px;padding:5px 14px;gap:10px;background:var(--chrome);color:var(--chrome-text);border-bottom:1px solid var(--chrome-border)}
.nb-util-name{font-size:16px;line-height:1.25;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.nb-util-actions{gap:5px;flex-shrink:0}
.nb-util-btn{padding:5px 9px;border-radius:6px;font-size:12px;color:inherit;border-color:var(--chrome-border);background:transparent}
:root .nb-header,:root .nb-footer,:root .qt-bar,:root[data-theme] .nb-header,:root[data-theme] .nb-footer,:root[data-theme] .qt-bar{background:var(--chrome);color:var(--chrome-text);border-color:var(--chrome-border)}
.nb-header-center .nb-action-btn,.nb-header-center .nb-mode-pill{min-height:36px;padding:6px 9px}
:root .nb-footer{border-top-width:1px}
:root :is(.nb-action-btn,.nb-mode-pill,.nb-nav-btn,.nb-timer-mini,.nb-font-btn,.nb-footer-tool,.nb-util-btn,.qt-btn){color:var(--chrome-text);border-color:var(--chrome-border)}
:root :is(.nb-action-btn:hover,.nb-mode-pill:hover,.nb-mode-pill.active,.nb-action-btn.active,.nb-nav-btn:hover,.nb-font-btn:hover,.nb-timer-mini:hover){background:color-mix(in srgb,var(--chrome-text) 13%,var(--chrome));color:var(--chrome-text)}
:root .nb-status-box span{color:var(--chrome-text);opacity:.85}
:root .nb-item-picker select{background:var(--white);color:var(--ink);border-color:var(--rule)}
:root[data-theme] :is(.qfig,.exs.exf){background:var(--white);border-color:var(--rule)}
:root[data-theme] .qfig-cap{color:var(--slate)}
:root[data-theme] .sum-item.unanswered{background:var(--amber-bg)}
.study-toolbar{display:flex;align-items:center;flex-wrap:wrap;gap:6px}
.study-toolbar .reading-theme{font-size:12px;gap:6px;flex-wrap:nowrap;padding:0}
.study-toolbar .reading-theme select{padding:7px 8px;max-width:158px;font-size:12px;border-radius:7px}
.study-tool-button{display:inline-flex;align-items:center;justify-content:center;gap:6px;min-height:33px;padding:7px 10px;border:1px solid var(--chrome-border);border-radius:7px;background:transparent;color:var(--chrome-text);font:600 12px var(--font-ui);cursor:pointer;white-space:nowrap}
.study-tool-button:hover{background:color-mix(in srgb,var(--chrome-text) 12%,transparent)}
.study-tool-button[aria-pressed="true"]{background:var(--reading-selected);color:var(--ink);border-color:var(--reading-accent)}
.study-tool-button.has-note::after{content:'';width:6px;height:6px;border-radius:50%;background:currentColor}
.tool-panel>.study-toolbar{flex-basis:100%;padding:6px;color:var(--ink)}
.tool-panel .study-tool-button{color:var(--ink);border-color:var(--rule);background:var(--warm)}
.study-window{position:fixed;inset:74px 22px auto auto;margin:0;width:min(322px,calc(100vw - 24px));max-height:calc(100dvh - 24px);padding:0;border:1px solid var(--rule);border-radius:15px;overflow:auto;background:var(--white);color:var(--ink);box-shadow:0 16px 48px #0004;font-family:var(--font-ui);z-index:1400}
.study-window.notes-window{width:min(410px,calc(100vw - 24px));inset:104px auto auto 24px}
.study-window-head{display:flex;align-items:center;justify-content:space-between;gap:10px;position:sticky;top:0;padding:11px 14px;background:var(--warm);border-bottom:1px solid var(--rule);cursor:grab;touch-action:none;user-select:none;z-index:1}
.study-window-head:active{cursor:grabbing}
.study-window-title{display:flex;align-items:center;gap:9px;font-size:14px;font-weight:700}
.study-drag-dots{color:var(--slate);letter-spacing:-3px;font-size:18px;padding-right:4px}
.study-window-close{display:flex;align-items:center;justify-content:center;width:28px;height:28px;padding:0;border:0;border-radius:6px;background:transparent;color:var(--ink);font:20px var(--font-ui);cursor:pointer}
.study-window-close:hover{background:var(--tool-hover)}
.study-window-body{padding:14px}
.study-window label{display:block;font-size:12px;font-weight:600;margin-bottom:7px;color:var(--slate)}
.calc-display{padding:12px;border:1px solid var(--rule);border-radius:10px;background:var(--warm);margin-bottom:12px}
.calc-history{min-height:19px;font:12px/1.4 var(--font-mono);color:var(--slate);text-align:right;overflow-wrap:anywhere}
.calc-display input{width:100%;border:0;background:transparent;color:var(--ink);font:28px/1.5 var(--font-mono);text-align:right;padding:4px 0;outline:none}
.calc-display:focus-within{outline:2px solid var(--reading-accent);outline-offset:2px}
.calculator-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:7px}
.calculator-grid button,.calc-parentheses button{border:1px solid var(--rule);border-radius:9px;background:var(--warm);color:var(--ink);font:500 19px var(--font-ui);min-height:43px;cursor:pointer;box-shadow:0 1px 1px #0001}
.calculator-grid button:hover,.calc-parentheses button:hover{background:var(--tool-hover)}
.calculator-grid .calc-operation{color:var(--reading-accent);background:var(--reading-selected);font-weight:700}
.calculator-grid .calc-equals{background:var(--tool-accent);color:var(--tool-on-accent);border-color:var(--tool-accent);font-weight:700}
.calculator-grid .calc-equals:hover{filter:brightness(.94)}
.calculator-grid .calc-clear{font-size:14px;font-weight:700}
.calc-parentheses{display:flex;gap:6px;margin-bottom:8px;align-items:center}
.calc-parentheses button{min-height:28px;width:36px;font-size:14px;border-radius:6px}
.calc-parentheses span{font-size:11px;color:var(--slate);margin-left:auto}
.calc-result{display:block;min-height:27px;margin-top:10px;font-size:12px;line-height:1.4;color:var(--slate);overflow-wrap:anywhere}
.calc-result[data-error="true"]{color:var(--red)}
.notes-window textarea{width:100%;min-height:210px;max-height:55vh;resize:vertical;padding:12px;border:1px solid var(--rule);border-radius:9px;background:var(--warm);color:var(--ink);font:15px/1.65 var(--font-ui)}
.notes-window .notes-status{margin:8px 0 0;min-height:32px;color:var(--slate);font-size:12px;line-height:1.5}
.study-window :is(button,textarea):focus-visible,.study-window-head:focus-visible,.study-tool-button:focus-visible{outline:2px solid var(--reading-accent);outline-offset:2px}
@media(max-width:700px){.nb-util{flex-wrap:wrap;padding:5px 9px}.nb-util-name{font-size:14px}.nb-util-actions{gap:4px}.nb-util-btn{font-size:11px;padding:4px 6px}.nb-footer-center{padding:6px;gap:6px}.study-toolbar{gap:5px}.study-window{max-height:calc(100dvh - 16px)}}
@media print{.study-window,.study-toolbar{display:none!important}}


:root{
  /* Key Findings (post-submit vignette highlights) — case-note token palette */
  --vh-coral:#C85A3E;--vh-coral-bg:#F7E4DB;
  --vh-teal:#256B63;--vh-teal-bg:#DFEDE8;
  --vh-gold:#A47A1F;--vh-gold-bg:#F3E7C6;
  --vh-violet:#6B5390;--vh-violet-bg:#E9E2F1;
  --vh-sky:#2F6485;--vh-sky-bg:#DEE9EF;
}
/* ══ KEY FINDINGS — vignette highlights, revealed on submit ══ */
mark.vh{cursor:pointer;padding:0 .08em;border-radius:.2em;text-decoration:none;color:inherit;box-decoration-break:clone;-webkit-box-decoration-break:clone;border-bottom:2px solid transparent;transition:filter .15s;animation:vhFadeIn .35s ease both}
mark.vh:hover{filter:brightness(0.96)}
@keyframes vhFadeIn{from{background-color:transparent;border-bottom-color:transparent}}
mark.vh.vh-cat-finding{background:var(--vh-coral-bg);border-bottom-color:var(--vh-coral)}
mark.vh.vh-cat-mechanism{background:var(--vh-teal-bg);border-bottom-color:var(--vh-teal)}
mark.vh.vh-cat-term{background:var(--vh-gold-bg);border-bottom-color:var(--vh-gold)}
mark.vh.vh-cat-pattern{background:var(--vh-violet-bg);border-bottom-color:var(--vh-violet)}
mark.vh.vh-cat-workup{background:var(--vh-sky-bg);border-bottom-color:var(--vh-sky)}
.vh-legend{display:flex;flex-wrap:wrap;align-items:center;gap:8px 14px;margin:14px 0 0;padding:10px 14px;border-radius:10px;background:var(--warm);border:1px solid var(--rule);animation:vhFadeIn .35s ease both}
.vh-legend-label{font-family:var(--font-mono);font-size:12px;font-weight:700;letter-spacing:1.4px;text-transform:uppercase;color:var(--mist)}
.vh-legend-item{display:inline-flex;align-items:center;gap:6px;font-size:13.5px;font-weight:700;color:var(--ink2);letter-spacing:.02em}
.vh-legend-dot{width:11px;height:11px;border-radius:3px;flex-shrink:0}
.vh-legend-hint{font-size:13.5px;color:var(--slate);font-weight:400}
.vh-tooltip{position:fixed;z-index:900;max-width:380px;padding:14px 17px;border-radius:12px;background:var(--navy);color:#fff;font-family:var(--font-ui);font-size:17px;line-height:1.6;box-shadow:0 14px 34px rgba(18,32,60,.28);opacity:0;pointer-events:none;transition:opacity .12s;transform:translateY(2px)}
.vh-tooltip.show{opacity:1}
.vh-tooltip .vht-eyebrow{font-family:var(--font-mono);font-size:12px;font-weight:700;letter-spacing:1.4px;text-transform:uppercase;color:var(--teal-glow);margin-bottom:4px}
.vh-tooltip .vht-title{font-weight:700;font-size:18px;margin-bottom:6px}
.vh-tooltip .vht-teaser{color:rgba(255,255,255,.86);font-size:16px}
.vh-panel{position:fixed;z-index:950;background:var(--white);box-shadow:0 -10px 40px rgba(18,32,60,.22);opacity:0;pointer-events:none;transition:transform .28s cubic-bezier(.4,0,.2,1),opacity .2s;display:flex;flex-direction:column;top:0;right:0;bottom:0;width:min(360px,86vw);border-left:1px solid rgba(18,32,60,.1);transform:translateX(16px);padding:22px 22px 26px}
.vh-panel.open{opacity:1;pointer-events:auto;transform:translateX(0)}
.vh-panel-close{position:absolute;top:14px;right:14px;width:30px;height:30px;border-radius:50%;border:none;background:rgba(18,32,60,.06);color:var(--navy);font-size:18px;line-height:1;cursor:pointer}
.vh-panel-close:hover{background:rgba(18,32,60,.12)}
.vh-panel-eyebrow{font-family:var(--font-mono);font-size:13px;font-weight:700;letter-spacing:1.5px;text-transform:uppercase;margin:6px 0 8px;color:var(--vh-violet)}
.vh-panel-title{font-family:var(--font-ui);font-size:24px;font-weight:800;color:var(--navy);margin-bottom:12px;padding-right:26px;line-height:1.3}
.vh-panel-body{font-size:18px;line-height:1.7;color:var(--ink2);overflow-y:auto}
.vh-panel.vh-panel-finding .vh-panel-eyebrow{color:var(--vh-coral)}.vh-panel.vh-panel-finding{border-top:4px solid var(--vh-coral)}
.vh-panel.vh-panel-mechanism .vh-panel-eyebrow{color:var(--vh-teal)}.vh-panel.vh-panel-mechanism{border-top:4px solid var(--vh-teal)}
.vh-panel.vh-panel-term .vh-panel-eyebrow{color:var(--vh-gold)}.vh-panel.vh-panel-term{border-top:4px solid var(--vh-gold)}
.vh-panel.vh-panel-pattern .vh-panel-eyebrow{color:var(--vh-violet)}.vh-panel.vh-panel-pattern{border-top:4px solid var(--vh-violet)}
.vh-panel.vh-panel-workup .vh-panel-eyebrow{color:var(--vh-sky)}.vh-panel.vh-panel-workup{border-top:4px solid var(--vh-sky)}
@media (max-width:1000px){
  .vh-panel{top:auto;left:0;right:0;bottom:0;width:auto;max-height:62vh;border-left:none;border-top:1px solid rgba(18,32,60,.1);border-radius:20px 20px 0 0;transform:translateY(100%)}
  .vh-panel.open{transform:translateY(0)}
}

mark.vh:focus-visible{outline:2px solid var(--vh-sky);outline-offset:3px}
.vh-panel[aria-hidden="true"]{visibility:hidden}
.exs.exlo{background:var(--gold-bg,#FDF6E3);border-left:5px solid var(--coral,#E07A5F)}
.exs.exlo .exl{color:var(--coral,#E07A5F)}
.exb .exs .ext{white-space:pre-line}
.exs.exlo .ext{white-space:normal}
.lo-row{display:flex;gap:10px;align-items:flex-start}
.lo-row+.lo-row{margin-top:9px;padding-top:9px;border-top:1px solid rgba(224,122,95,.18)}
.lo-chip{flex:0 0 auto;display:inline-block;font-family:'IBM Plex Mono',Consolas,monospace;font-size:11px;font-weight:700;letter-spacing:.6px;padding:3px 9px;border-radius:999px;background:var(--coral,#E07A5F);color:#fff;text-decoration:none;white-space:nowrap}
.lo-chip:hover{filter:brightness(1.12)}
.lo-text{font-size:.9em;line-height:1.55;color:var(--ink2,#3E4555)}
.lo-sec{display:inline-block;margin-left:7px;font-family:'IBM Plex Mono',Consolas,monospace;font-size:10.5px;color:var(--slate,#6B7689)}
.qfig{margin:18px 0 4px;padding:10px;border:1px solid rgba(18,32,60,.14);border-radius:14px;background:#fff;overflow-x:auto}
.qfig img{display:block;width:100%;min-width:520px;height:auto;border-radius:8px}
.qfig.photo{max-width:640px;margin-left:auto;margin-right:auto}
.qfig.photo img{min-width:0}
.qfig-cap{margin-top:9px;font-size:.86em;line-height:1.5;color:#5a6a85;font-style:italic}
.qfig.exfig{margin:10px 0 0;padding:0;border:1px solid rgba(18,32,60,.12)}
.qfig.exfig img{min-width:420px}
.exs.exf{background:#fff}
@media print{.qfig{break-inside:avoid;page-break-inside:avoid}.qfig img{min-width:0}}
</style>
<script>
(function(){
  var NOTE_AUTH_KEY='une-study-hub-remembered-auth-v1';
  var NOTE_LOGIN_URL='../../../../index.html?login=notes';

  function readCookie(name){
    try{
      var prefix=encodeURIComponent(name)+'=';
      var parts=String(document.cookie||'').split(';');
      for(var i=0;i<parts.length;i++){
        var part=parts[i].trim();
        if(part.indexOf(prefix)===0)return decodeURIComponent(part.slice(prefix.length));
      }
    }catch(err){}
    return null;
  }
  function readAuthPayload(){
    try{
      var stored=localStorage.getItem(NOTE_AUTH_KEY);
      if(stored)return stored;
    }catch(err){}
    return readCookie(NOTE_AUTH_KEY);
  }
  function hasValidNoteAuth(){
    var raw=readAuthPayload();
    if(!raw)return false;
    try{
      var parsed=JSON.parse(raw);
      var email=String(parsed&&parsed.email||'').trim().toLowerCase();
      var expiresAt=Number(parsed&&parsed.expiresAt);
      return /@une\.edu$/.test(email)&&expiresAt&&Date.now()<expiresAt;
    }catch(err){return false}
  }
  function syncNoteAuth(){
    document.documentElement.setAttribute('data-note-auth',hasValidNoteAuth()?'unlocked':'locked');
  }
  window.openNoteLogin=function(){
    var loginWindow=window.open(NOTE_LOGIN_URL,'uneStudyHubLogin');
    if(!loginWindow)window.location.href=NOTE_LOGIN_URL;
  };
  window.refreshNoteAuth=syncNoteAuth;
  window.addEventListener('message',function(event){
    if(event&&event.data&&event.data.type==='une-study-hub-auth-complete')syncNoteAuth();
  });
  window.addEventListener('storage',function(event){
    if(!event||event.key===NOTE_AUTH_KEY)syncNoteAuth();
  });
  window.addEventListener('focus',syncNoteAuth);
  window.addEventListener('DOMContentLoaded',syncNoteAuth);
  window.setInterval(syncNoteAuth,1000);
  syncNoteAuth();
})();
</script>
<style>
#noteAuthGate{display:none}
html[data-note-auth="locked"] body{min-height:100vh;overflow:hidden;background:#f4f5f7;color:#1f2937}
html[data-note-auth="locked"] body>*:not(#noteAuthGate){display:none!important}
html[data-note-auth="locked"] #noteAuthGate{position:fixed;inset:0;z-index:2147483647;display:flex;align-items:center;justify-content:center;padding:24px;background:linear-gradient(135deg,#f4f5f7,#fff 52%,#eef2f7);font-family:Arial,sans-serif}
.note-auth-card{box-sizing:border-box;width:min(460px,100%);padding:30px;border:1px solid rgba(31,41,55,.14);border-radius:14px;background:rgba(255,255,255,.96);box-shadow:0 22px 70px rgba(31,41,55,.16);text-align:center}
.note-auth-kicker{margin-bottom:12px;color:#a5142a;font-size:11px;font-weight:700;letter-spacing:.14em;text-transform:uppercase}
.note-auth-card h1{margin:0 0 12px;color:#263241;font-size:clamp(28px,6vw,42px);line-height:1.05}
.note-auth-card p{margin:0 0 22px;color:#556070;font-size:16px;line-height:1.55}
.note-auth-btn{border:0;border-radius:999px;padding:12px 20px;color:#fff;background:#263241;font-size:15px;font-weight:700;cursor:pointer;box-shadow:0 12px 28px rgba(38,50,65,.22)}
.note-auth-btn:hover{background:#a5142a}
</style>
</head>
<body>
<div id="noteAuthGate" role="dialog" aria-modal="true" aria-labelledby="noteAuthTitle">
  <div class="note-auth-card">
    <div class="note-auth-kicker">2nd Year Study Hub</div>
    <h1 id="noteAuthTitle">Please log in to continue.</h1>
    <p>Open the Study Hub login, enter your approved UNE email, and this page will unlock automatically.</p>
    <button class="note-auth-btn" type="button" onclick="openNoteLogin()">Log in to continue</button>
  </div>
</div>
<div class="toast-wrap" id="toastWrap"></div>

<!-- ══════════ SETUP VIEW ══════════ -->
<div class="view active" id="viewSetup">
<div class="setup-page">
<div class="setup-card">

  <div class="setup-top">
    <div class="setup-emoji">🧪</div>
    <div class="setup-title">Custom <em>Quiz Builder</em></div>
    <div class="setup-sub">Generate a quiz from any AI and run it in the same exam format as the study hub.</div>
  </div>

  <div class="setup-body">
<label class="reading-theme">Theme <select aria-label="Theme" data-reading-theme onchange="setReadingTheme(this.value)"><option value="light">Light</option><option value="dark">Dark</option><option value="soft">Easy on the eyes</option></select></label>

    <div class="how-title">How it works</div>
    <div class="steps">
      <div class="step">
        <div class="step-num">1</div>
        <div class="step-text">
          <strong>Set your question count</strong>
          Choose how many questions you want the AI to make. Smaller batches usually give better questions.
        </div>
      </div>
      <div class="step">
        <div class="step-num">2</div>
        <div class="step-text">
          <strong>Add it to your AI of choice</strong>
          Go to the "Your AI prompt" section below and click Copy prompt. Paste it into Claude for best results, ChatGPT Sol with a Pro account for strong results, or Gemini if needed. Add your notes after MY CONTENT:, then send.
        </div>
      </div>
      <div class="step">
        <div class="step-num">3</div>
        <div class="step-text">
          <strong>Paste the AI response into a Set tab</strong>
          Copy the entire JSON response from the AI and paste it into Set 1. For multiple batches, use Sets 2-4 too.
        </div>
      </div>
      <div class="step">
        <div class="step-num">4</div>
        <div class="step-text">
          <strong>Name it, choose the interface, and launch</strong>
          Add an optional quiz name, choose the study-hub or NBME / NBOME interface, then hit Launch Quiz.
        </div>
      </div>
    </div>
    <div class="how-visual">
      <img src="assets/copy-generated-question-sets.png" alt="Screenshot showing the AI response copy button below a generated question set.">
      <div class="how-visual-caption">After the AI finishes, use its copy button to grab the full generated response before pasting it below.</div>
    </div>

    <div class="field">
      <label class="lbl">Target question count</label>
      <input class="inp" id="questionCount" type="number" min="1" max="25" step="1" value="15" oninput="handleQuestionCountInput()" onblur="handleQuestionCountBlur()">
      <div class="field-note">Cap: 25 questions. Increasing the number of questions may cause degraded question quality from your AI.</div>
    </div>

    <!-- Prompt to copy -->
    <div class="lbl" style="margin-bottom:8px">Your AI prompt</div>
    <div class="prompt-wrap">
      <button class="copy-prompt-btn" id="copyPromptBtn" onclick="copyPrompt()">📋 Copy prompt</button>
      <div class="prompt-meta">
        <div class="prompt-chip" id="promptCountChip">Target: 15 questions</div>
      </div>
      <div class="prompt-inner" id="promptText"></div>
    </div>
    <p style="font-size:12px;color:var(--mist);margin-bottom:24px;margin-top:6px">Paste your notes or existing questions <em>after</em> this prompt before sending to your AI. The prompt is calibrated on the released NBME Step 1 sample items — full USMLE / COMLEX item-writing guide, distractor architecture, and quality gate.</p>

    <div class="divider"></div>

    <div class="field">
      <label class="lbl">Quiz name (optional)</label>
      <input class="inp" id="quizName" placeholder="e.g. Ferland — Confidence Intervals — Bank 1" oninput="refreshPromptText()">
    </div>
    <div class="field">
      <label class="lbl">Quiz interface</label>
      <div class="setup-ui-toggle">
        <button class="setup-ui-btn active" id="uiModeClassicBtn" type="button" onclick="selectLaunchUI('classic')">
          <span class="setup-ui-name">UNE Study Hub Style</span>
          <span class="setup-ui-meta">The current layout with score cards, sidebar tools, and the original study-hub feel.</span>
        </button>
        <button class="setup-ui-btn" id="uiModeNbmeBtn" type="button" onclick="selectLaunchUI('nbme')">
          <span class="setup-ui-name">NBME / NBOME Style</span>
          <span class="setup-ui-meta">Header navigation, question rail, footer timer, and an exam-stage layout modeled after the simulator.</span>
        </button>
      </div>
    </div>
    <div class="field">
      <label class="lbl">Paste AI responses here</label>
      <div class="field-note">Paste the AI's full copied response into Set 1. If you ask the AI to make questions in smaller groups, paste each extra group into Set 2, Set 3, or Set 4. Launch Quiz will put all filled sets together.</div>
      <div class="paste-tabs" role="tablist" aria-label="AI response sets">
        <button class="paste-tab active" id="pasteTab1" type="button" role="tab" aria-selected="true" aria-controls="pastePanel1" onclick="showPasteSetTab(1)">Set 1</button>
        <button class="paste-tab" id="pasteTab2" type="button" role="tab" aria-selected="false" aria-controls="pastePanel2" onclick="showPasteSetTab(2)">Set 2</button>
        <button class="paste-tab" id="pasteTab3" type="button" role="tab" aria-selected="false" aria-controls="pastePanel3" onclick="showPasteSetTab(3)">Set 3</button>
        <button class="paste-tab" id="pasteTab4" type="button" role="tab" aria-selected="false" aria-controls="pastePanel4" onclick="showPasteSetTab(4)">Set 4</button>
      </div>
      <div class="paste-panels">
        <div class="paste-panel active" id="pastePanel1" role="tabpanel" aria-labelledby="pasteTab1">
          <label class="lbl" for="pasteArea1">Set 1</label>
          <div class="field-note">Use this for your first AI batch.</div>
          <textarea class="ta" id="pasteArea1" placeholder="Paste AI response for Set 1…" oninput="syncPasteSetTabs()"></textarea>
        </div>
        <div class="paste-panel" id="pastePanel2" role="tabpanel" aria-labelledby="pasteTab2" hidden>
          <label class="lbl" for="pasteArea2">Set 2</label>
          <div class="field-note">Use this for your second AI batch.</div>
          <textarea class="ta" id="pasteArea2" placeholder="Paste AI response for Set 2…" oninput="syncPasteSetTabs()"></textarea>
        </div>
        <div class="paste-panel" id="pastePanel3" role="tabpanel" aria-labelledby="pasteTab3" hidden>
          <label class="lbl" for="pasteArea3">Set 3</label>
          <div class="field-note">Use this for your third AI batch.</div>
          <textarea class="ta" id="pasteArea3" placeholder="Paste AI response for Set 3…" oninput="syncPasteSetTabs()"></textarea>
        </div>
        <div class="paste-panel" id="pastePanel4" role="tabpanel" aria-labelledby="pasteTab4" hidden>
          <label class="lbl" for="pasteArea4">Set 4</label>
          <div class="field-note">Use this for your fourth AI batch.</div>
          <textarea class="ta" id="pasteArea4" placeholder="Paste AI response for Set 4…" oninput="syncPasteSetTabs()"></textarea>
        </div>
      </div>
    </div>
    <div class="setup-actions">
      <button class="launch-btn" onclick="launchQuiz()">🚀 Launch Quiz</button>
      <button class="ghost-btn" onclick="downloadQuiz()">⬇ Download My Quiz</button>
    </div>
    <div class="err-msg" id="errMsg"></div>
  </div>

</div>
</div>
</div>

<!-- ══════════ QUIZ VIEW ══════════ -->
<div class="view" id="viewQuiz">
<div class="quiz-page">

  <!-- top bar -->
  <div class="qt-bar">
    <div class="qt-name" id="qtName">Quiz</div>
    <button class="qt-btn" id="qtClassicUiBtn" onclick="switchQuizUI('nbme')">⇄ NBME UI</button>
    <button class="qt-btn" id="qtMarkBtn" onclick="toggleMark()">⚑ Mark</button>
    <button class="qt-btn" id="qtSubmitBtn" onclick="submitExam()">🧾 Submit Exam</button>
    <button class="qt-btn" onclick="downloadQuiz()">⬇ Download Quiz</button>
    <button class="qt-btn" onclick="resetQuiz()">↺ Reset</button>
    <button class="qt-btn" onclick="exitQuiz()">✕ Close</button>
  </div>

  <!-- grid -->
  <div class="qin">

    <!-- LEFT SIDEBAR -->
    <div class="sidebar">

      <!-- score boxes -->
      <div class="score-panel">
        <div class="score-box correct"><div class="sv" id="sC">0</div><div class="sl">Correct</div></div>
        <div class="score-box incorrect"><div class="sv" id="sI">0</div><div class="sl">Incorrect</div></div>
        <div class="score-box"><div class="sv" id="sP">—</div><div class="sl">Score</div></div>
      </div>

      <!-- mode toggle -->
      <div class="mode-toggle">
        <button class="mode-btn active" id="modeLearn" onclick="setMode('learn')"><span class="mode-icon">📚</span>Learn Mode</button>
        <button class="mode-btn" id="modeExam" onclick="setMode('exam')"><span class="mode-icon">📝</span>Exam Mode</button>
      </div>

      <!-- timer -->
      <div class="timer-card" id="timerCard">
        <div class="timer-lbl" id="timerModeLbl" onclick="toggleTimerDisplay()" title="Click to switch between elapsed and remaining time">TIMER · ELAPSED</div>
        <div class="timer-time" id="timerTime">00:00</div>
        <button class="tbtn" id="timerPlayBtn" onclick="toggleTimer()">▶</button>
        <button class="tbtn" onclick="resetTimer()">↺</button>
      </div>

      <!-- tools -->
      <div class="tool-panel">
<div class="study-toolbar"><label class="reading-theme">Theme <select aria-label="Theme" data-reading-theme onchange="setReadingTheme(this.value)"><option value="light">Light</option><option value="dark">Dark</option><option value="soft">Easy on the eyes</option></select></label><button class="study-tool-button" type="button" data-study-tool="studyCalculator" aria-pressed="false" aria-controls="studyCalculator" onclick="openCalculator()">Calculator</button><button class="study-tool-button" type="button" data-study-tool="studyNotes" aria-pressed="false" aria-controls="studyNotes" onclick="openNotes()">Notes</button></div>

        <button class="q-tool hl-tool" id="hlTool" onclick="toggleTool('hl')">🖊 Highlight</button>
        <button class="q-tool st-tool" id="stTool" onclick="toggleTool('st')">✂ Strikethrough</button>
        <button class="q-tool" onclick="clearMarks()">✖ Clear Marks</button>
        <button class="q-tool lab-tool" onclick="openLabs()">🧪 Lab Values</button>
        <div class="font-tools">
          <span class="font-tools-label">Text Size</span>
          <div class="font-tools-group">
            <button class="font-btn" onclick="adjustFontSize(-1)" aria-label="Decrease question and answer text size">A-</button>
            <button class="font-btn reset" onclick="resetFontSize()" aria-label="Reset question and answer text size">A</button>
            <button class="font-btn" onclick="adjustFontSize(1)" aria-label="Increase question and answer text size">A+</button>
          </div>
        </div>
      </div>

    </div>

    <!-- RIGHT: QUESTION -->
    <div>
      <div id="finBanner"></div>
      <div id="qArea"></div>
    </div>

  </div>
</div>
</div>

<!-- ══════════ NBME / NBOME VIEW ══════════ -->
<div class="view" id="viewQuizNbme">
<div class="nb-wrap">
  <div class="nb-util">
    <div class="nb-util-name" id="nbQuizTitle">Quiz</div>
    <div class="nb-util-actions">

      <button class="nb-util-btn" onclick="toggleFullscreen()" id="nbFsBtn">⛶ Fullscreen</button>
      <button class="nb-util-btn" onclick="switchQuizUI('classic')">UNE UI</button>
      <button class="nb-util-btn" onclick="downloadQuiz()">Download</button>
      <button class="nb-util-btn" onclick="resetQuiz()">Reset</button>
      <button class="nb-util-btn" onclick="exitQuiz()">Close</button>
    </div>
  </div>

  <div class="nb-app">
    <header class="nb-header">
      <div class="nb-status-box">
        <strong id="nbItemIndicator">Question: 1 of 1</strong>
        <span id="nbStatusMeta">Answered 0 of 1</span>
      </div>

      <div class="nb-header-center">
        <button class="nb-action-btn" id="nbMarkBtn" type="button" onclick="toggleMark()">⚑ Mark</button>
        <button class="nb-action-btn" id="nbHighlightBtn" type="button" onclick="toggleTool('hl')">Highlight</button>
        <button class="nb-action-btn" id="nbStrikeBtn" type="button" onclick="toggleTool('st')">Strikeout</button>
        <button class="nb-action-btn" type="button" onclick="clearMarks()">Clear</button>
<div class="study-toolbar"><label class="reading-theme">Theme <select aria-label="Theme" data-reading-theme onchange="setReadingTheme(this.value)"><option value="light">Light</option><option value="dark">Dark</option><option value="soft">Easy on the eyes</option></select></label><button class="study-tool-button" type="button" data-study-tool="studyCalculator" aria-pressed="false" aria-controls="studyCalculator" onclick="openCalculator()">Calculator</button><button class="study-tool-button" type="button" data-study-tool="studyNotes" aria-pressed="false" aria-controls="studyNotes" onclick="openNotes()">Notes</button></div>
        <button class="nb-mode-pill active" id="nbModeLearn" type="button" onclick="setMode('learn')">Learn</button>
        <button class="nb-mode-pill" id="nbModeExam" type="button" onclick="setMode('exam')">Testing</button>
        <button class="nb-action-btn" id="nbSummaryBtn" type="button" onclick="toggleSummaryPanel()" disabled>See Score &amp; Summary</button>
        <div class="nb-item-picker">
          <label for="nbItemSelect">Question</label>
          <select id="nbItemSelect" aria-label="Jump to a question" onchange="goQ(parseInt(this.value,10))"></select>
        </div>
      </div>

      <div class="nb-nav-controls">
        <button class="nb-nav-btn" id="nbPrevBtn" type="button" onclick="prevQ()">
          <span class="icon">◀</span><span>Previous</span>
        </button>
        <button class="nb-nav-btn" id="nbNextBtn" type="button" onclick="nextQ()">
          <span class="icon">▶</span><span>Next</span>
        </button>
      </div>
    </header>

    <main class="nb-body">
      <aside class="nb-rail" aria-label="Question navigator">
        <div class="nb-rail-title">Questions</div>
        <button class="nb-rail-arrow" id="nbRailUpBtn" type="button" aria-label="Scroll question list up" onclick="scrollNbmeRail(-1)">▲</button>
        <div class="nb-rail-scroll" id="nbRailScroll" onscroll="syncNbmeRailArrows()">
          <div id="nbRailItems"></div>
        </div>
        <button class="nb-rail-arrow" id="nbRailDownBtn" type="button" aria-label="Scroll question list down" onclick="scrollNbmeRail(1)">▼</button>
      </aside>

      <section class="nb-stage">
        <div id="nbFinishBanner"></div>
        <div class="nb-question-scroll">
          <div id="nbContent"></div>
        </div>
      </section>
    </main>

    <footer class="nb-footer">
      <div class="nb-timer-box" id="nbTimerCard">
        <button class="nb-timer-mode" id="nbTimerModeLbl" type="button" onclick="toggleTimerDisplay()" title="Click to switch between elapsed and remaining time">Elapsed Time:</button><strong id="nbTimerTime">00:00</strong>
        <span>Status:</span><strong id="nbTimerStatus">Paused</strong>
        <small id="nbTimerNote">Same timer as the original interface</small>
        <div class="nb-timer-actions">
          <button class="nb-timer-mini" id="nbTimerToggle" type="button" onclick="toggleTimer()">Start</button>
          <button class="nb-timer-mini" type="button" onclick="resetTimer()">Reset</button>
        </div>
      </div>

      <div class="nb-footer-center">
        <div class="nb-score-chip">
          <span>Correct <strong id="nbScoreCorrect">0</strong></span>
          <span>Incorrect <strong id="nbScoreIncorrect">0</strong></span>
          <span>Score <strong id="nbScorePercent">—</strong></span>
        </div>
        <button class="nb-footer-tool" type="button" onclick="openLabs()">▤ Lab Values</button>
        <div class="nb-font-cluster">
          <label>Text</label>
          <button class="nb-font-btn" type="button" onclick="adjustFontSize(-1)">A-</button>
          <button class="nb-font-btn" type="button" onclick="resetFontSize()">A</button>
          <button class="nb-font-btn" type="button" onclick="adjustFontSize(1)">A+</button>
        </div>
      </div>

      <div class="nb-end-wrap">
        <button class="nb-end-btn" id="nbReviewBtn" type="button" onclick="handleNbmeEndAction()">Testing Mode Only</button>
      </div>
    </footer>
  </div>
</div>
</div>

<div class="lab-modal" id="labModal" onclick="if(event.target===this)closeLabs()">
  <div class="lab-shell">
    <div class="lab-card">
      <div class="lab-header">
        <div>
          <div class="lab-kicker">Reference Table</div>
          <h2 class="lab-title">Laboratory Values</h2>
          <div class="lab-sub">Shared lab reference for both quiz interfaces, imported from the NBME-style simulator so the values stay consistent.</div>
        </div>
        <button class="lab-close" type="button" onclick="closeLabs()">Close</button>
      </div>
      <div class="lab-controls">
        <div class="lab-toggle">
          <button class="lab-toggle-btn active" id="labUnitsUs" type="button" onclick="setLabUnits('us')">U.S. Units</button>
          <button class="lab-toggle-btn" id="labUnitsSi" type="button" onclick="setLabUnits('si')">SI Units</button>
        </div>
        <div class="lab-note">Switch units without leaving the question.</div>
      </div>
      <div class="lab-body">
        <div id="labTables"></div>
      </div>
    </div>
  </div>
</div>


<dialog class="study-window" id="studyCalculator" aria-labelledby="studyCalculatorTitle"><header class="study-window-head" tabindex="0" aria-label="Move calculator. Drag or use arrow keys."><span class="study-window-title"><span class="study-drag-dots" aria-hidden="true">⠿</span><span id="studyCalculatorTitle">Calculator</span></span><button class="study-window-close" type="button" aria-label="Close calculator" onclick="closeStudyWindow('studyCalculator')">×</button></header><div class="study-window-body"><label for="calculatorInput">Expression</label><div class="calc-display"><div class="calc-history" id="calculatorHistory"></div><input id="calculatorInput" type="text" autocomplete="off" spellcheck="false" placeholder="0" maxlength="300"></div><div class="calc-parentheses"><button type="button" onclick="calculatorKey('(')">(</button><button type="button" onclick="calculatorKey(')')">)</button><span>% divides by 100</span></div><div class="calculator-grid"><button type="button" class="calc-clear" aria-label="Clear calculator" onclick="calculatorKey('C')">AC</button><button type="button" class="calc-clear" aria-label="Backspace" onclick="calculatorKey('⌫')">⌫</button><button type="button" class="calc-operation"  onclick="calculatorKey('%')">%</button><button type="button" class="calc-operation"  onclick="calculatorKey('÷')">÷</button><button type="button" class=""  onclick="calculatorKey('7')">7</button><button type="button" class=""  onclick="calculatorKey('8')">8</button><button type="button" class=""  onclick="calculatorKey('9')">9</button><button type="button" class="calc-operation"  onclick="calculatorKey('×')">×</button><button type="button" class=""  onclick="calculatorKey('4')">4</button><button type="button" class=""  onclick="calculatorKey('5')">5</button><button type="button" class=""  onclick="calculatorKey('6')">6</button><button type="button" class="calc-operation"  onclick="calculatorKey('−')">−</button><button type="button" class=""  onclick="calculatorKey('1')">1</button><button type="button" class=""  onclick="calculatorKey('2')">2</button><button type="button" class=""  onclick="calculatorKey('3')">3</button><button type="button" class="calc-operation"  onclick="calculatorKey('+')">+</button><button type="button" class="" aria-label="Change sign" onclick="calculatorKey('±')">±</button><button type="button" class=""  onclick="calculatorKey('0')">0</button><button type="button" class=""  onclick="calculatorKey('.')">.</button><button type="button" class="calc-equals"  onclick="calculatorKey('=')">=</button></div><output class="calc-result" id="calculatorResult" aria-live="polite">Enter = calculate · Esc = close</output></div></dialog>
<dialog class="study-window notes-window" id="studyNotes" aria-labelledby="studyNotesTitle"><header class="study-window-head" tabindex="0" aria-label="Move notes. Drag or use arrow keys."><span class="study-window-title"><span class="study-drag-dots" aria-hidden="true">⠿</span><span id="studyNotesTitle">Notes</span></span><button class="study-window-close" type="button" aria-label="Close notes" onclick="closeStudyWindow('studyNotes')">×</button></header><div class="study-window-body"><label for="studyNotesInput" id="studyNotesLabel">Current question</label><textarea id="studyNotesInput" placeholder="Your reasoning, reminders, and takeaways…" oninput="saveQuestionNote(Number(this.dataset.question),this.value)"></textarea><p class="notes-status" id="studyNotesStatus" role="status">Saved with your quiz progress · Included in summary exports.</p></div></dialog>

<script>

// Themes are shared across quizzes; notes belong to the saved question order.
var questionNotes={};
function escapeStudyText(value){return String(value==null?'':value).replace(/[&<>"']/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];});}
function setReadingTheme(theme){
  if(['light','dark','soft'].indexOf(theme)<0)theme='light';
  if(theme==='light')document.documentElement.removeAttribute('data-theme');
  else document.documentElement.setAttribute('data-theme',theme);
  document.querySelectorAll('[data-reading-theme]').forEach(function(el){el.value=theme;});
  try{localStorage.setItem('quiz-builder-reading-theme',theme);}catch(e){}
}
function exportSummarySheet(){
  var html='<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>'+escapeStudyText(getQuizTitle())+' — Summary</title><style>'+getSummaryPrintStyles()+'</style></head><body>'+buildReviewSheetHTML(true)+'</body></html>';
  triggerQuizDownload(new Blob([html],{type:'text/html;charset=utf-8'}),buildDownloadFileName(getQuizTitle()).replace(/\.html$/i,' Summary.html'));
}
function calculateExpression(source){
  var text=source.replace(/\s+/g,'').replace(/×/g,'*').replace(/÷/g,'/').replace(/−/g,'-');
  if(!text||text.length>300)throw Error('Enter an expression (up to 300 characters).');
  var pos=0;
  function primary(){
    if(text[pos]==='+'){pos++;return primary();}
    if(text[pos]==='-'){pos++;return -primary();}
    var value;
    if(text[pos]==='('){pos++;value=sum();if(text[pos++]!==')')throw Error('Check your parentheses.');}
    else{var m=text.slice(pos).match(/^(?:\d+(?:\.\d*)?|\.\d+)(?:e[+-]?\d+)?/i);if(!m)throw Error('Enter numbers and arithmetic operators only.');pos+=m[0].length;value=Number(m[0]);}
    while(text[pos]==='%'){pos++;value/=100;}
    return value;
  }
  function product(){var value=primary();while(text[pos]==='*'||text[pos]==='/'){var op=text[pos++],right=primary();if(op==='/'&&right===0)throw Error('Cannot divide by zero.');value=op==='*'?value*right:value/right;}return value;}
  function sum(){var value=product();while(text[pos]==='+'||text[pos]==='-'){var op=text[pos++],right=product();value=op==='+'?value+right:value-right;}return value;}
  var value=sum();if(pos!==text.length)throw Error('Check the expression.');if(!Number.isFinite(value))throw Error('Result is outside the supported range.');return Number(value.toPrecision(12));
}
var studyWindowZ=1400, studyWindowOpeners={}, calculatorFinished=false;
function openStudyWindow(id){
  var win=document.getElementById(id);
  studyWindowOpeners[id]=document.activeElement;
  if(!win.open)win.show();
  win.style.zIndex=++studyWindowZ;
  clampStudyWindow(win);
  syncStudyTools();
}
function closeStudyWindow(id){
  document.getElementById(id).close();
  syncStudyTools();
  var opener=studyWindowOpeners[id];
  if(opener&&opener.isConnected&&opener.getClientRects().length)opener.focus();
}
function openCalculator(){openStudyWindow('studyCalculator');document.getElementById('calculatorInput').focus();}
function closeCalculator(){closeStudyWindow('studyCalculator');}
function openNotes(){
  if(!questions.length)return;
  syncStudyTools();openStudyWindow('studyNotes');document.getElementById('studyNotesInput').focus();
}
function syncStudyTools(){
  var input=document.getElementById('studyNotesInput');
  if(!input)return;
  var value=questionNotes[CQ]||'';
  // Do not reset selection or the caret while the user is typing.
  if(input.value!==value)input.value=value;
  input.dataset.question=String(CQ);
  document.getElementById('studyNotesLabel').textContent='Question '+(CQ+1)+' of '+questions.length;
  document.querySelectorAll('[data-study-tool]').forEach(function(btn){
    var id=btn.dataset.studyTool;
    btn.setAttribute('aria-pressed',String(document.getElementById(id).open));
    if(id==='studyNotes')btn.classList.toggle('has-note',!!value);
  });
}
function saveQuestionNote(index,value){
  if(value)questionNotes[index]=value;else delete questionNotes[index];
  var saved=saveSession();
  document.getElementById('studyNotesStatus').textContent=saved?'Saved in this browser · Included in summary exports.':'Browser storage unavailable. Export your summary to keep these notes.';
  syncStudyTools();
  if(summaryVisible){if(uiMode==='nbme')renderNbmeView();else renderClassicView();}
}
function clampStudyWindow(win,left,top){
  var rect=win.getBoundingClientRect(),edge=8;
  left=left==null?rect.left:left;top=top==null?rect.top:top;
  win.style.left=Math.max(edge,Math.min(left,window.innerWidth-rect.width-edge))+'px';
  win.style.top=Math.max(edge,Math.min(top,window.innerHeight-rect.height-edge))+'px';
  win.style.right='auto';win.style.bottom='auto';
}
function initStudyWindows(){
  document.querySelectorAll('.study-window').forEach(function(win){
    var head=win.querySelector('.study-window-head'),drag=null;
    win.addEventListener('pointerdown',function(){win.style.zIndex=++studyWindowZ;});
    head.addEventListener('pointerdown',function(event){
      if(event.button!==0||event.target.closest('button'))return;
      var rect=win.getBoundingClientRect();
      drag={x:event.clientX,y:event.clientY,left:rect.left,top:rect.top};
      head.setPointerCapture(event.pointerId);event.preventDefault();
    });
    head.addEventListener('pointermove',function(event){
      if(drag)clampStudyWindow(win,drag.left+event.clientX-drag.x,drag.top+event.clientY-drag.y);
    });
    function endDrag(){drag=null;}
    head.addEventListener('pointerup',endDrag);head.addEventListener('pointercancel',endDrag);head.addEventListener('lostpointercapture',endDrag);
    head.addEventListener('keydown',function(event){
      if(event.target!==head||!/^Arrow/.test(event.key))return;
      event.preventDefault();event.stopPropagation();
      var rect=win.getBoundingClientRect(),step=event.shiftKey?40:10;
      clampStudyWindow(win,rect.left+(event.key==='ArrowRight'?step:event.key==='ArrowLeft'?-step:0),rect.top+(event.key==='ArrowDown'?step:event.key==='ArrowUp'?-step:0));
    });
    win.addEventListener('keydown',function(event){
      event.stopPropagation();
      if(event.key==='Escape'){event.preventDefault();closeStudyWindow(win.id);}
      if(win.id==='studyCalculator'&&event.key==='Enter'&&event.target.tagName==='INPUT'){event.preventDefault();calculatorKey('=');}
    });
    win.addEventListener('close',syncStudyTools);
    if(window.ResizeObserver)new ResizeObserver(function(){if(win.open)clampStudyWindow(win);}).observe(win);
  });
  window.addEventListener('resize',function(){document.querySelectorAll('.study-window[open]').forEach(function(win){clampStudyWindow(win);});});
  document.getElementById('calculatorInput').addEventListener('input',function(){calculatorFinished=false;document.getElementById('calculatorResult').textContent='Enter = calculate · Esc = close';});
}
function calculatorKey(key){
  var input=document.getElementById('calculatorInput'),result=document.getElementById('calculatorResult'),history=document.getElementById('calculatorHistory');
  result.removeAttribute('data-error');
  if(key==='='){
    try{var expression=input.value,value=calculateExpression(expression);history.textContent=expression+' =';input.value=String(value);result.textContent='Result: '+value;calculatorFinished=true;}
    catch(e){result.textContent=e.message;result.dataset.error='true';calculatorFinished=false;}
  }else if(key==='C'){
    input.value='';history.textContent='';result.textContent='Enter = calculate · Esc = close';calculatorFinished=false;
  }else if(key==='±'){
    if(input.value)input.value=input.value.startsWith('-(')&&input.value.endsWith(')')?input.value.slice(2,-1):'-('+input.value+')';
    calculatorFinished=false;
  }else{
    if(calculatorFinished&&/^[0-9.(]$/.test(key))input.value='';
    var start=input.selectionStart==null?input.value.length:input.selectionStart,end=input.selectionEnd==null?start:input.selectionEnd;
    if(key==='⌫')input.setRangeText('',start===end?Math.max(0,start-1):start,end,'end');
    else if(input.value.length-(end-start)+key.length<=300)input.setRangeText(key,start,end,'end');
    calculatorFinished=false;
  }
  input.focus();
}

// ── STATE ──
var questions=[],questionBank=[],answers={},selected={},marked={},stemMarkup={},choiceMarkup={},NC=0,NI=0,CQ=0;
var quizMode='learn';
var uiMode='classic';
var examSubmitted=false;
var reviewOpen=false;
var summaryVisible=false;
var finishBannerMinimized=false;
var toolMode='';
var highlightColor='#fff173', annotationRange=null, annotationRoot=null, suppressChoiceUntil=0;
var labUnitMode='us';
var timerSec=0,timerRunning=false,timerInterval=null;
var fontStep=0;
var LETTERS=['A','B','C','D','E','F','G','H'];
var MAX_ANSWER_CHOICES=8;
var PRELOADED_QUIZ_NAME="Jeevs edition _ summative review";
var PRELOADED_QUESTIONS_JSON="[{\"stem\": \"An investigator is studying blood cell production in human fetal tissues obtained at autopsy. Specimens are taken at 4 weeks', 10 weeks', 20 weeks', and 36 weeks' gestation. At 4 weeks' gestation, nucleated erythroid precursors are confined to blood islands outside the embryo proper. At 20 weeks' gestation, the tissue containing the greatest number of erythroid and granulocytic precursors is a large, solid intra-abdominal organ. By 36 weeks' gestation, that organ contains almost no precursors, and precursors are instead found within the medullary cavities of the long bones.\\n\\nThe organ containing the greatest number of hematopoietic precursors at 20 weeks' gestation is which of the following?\", \"choices\": [\"A. Bone marrow\", \"B. Liver\", \"C. Lymph node\", \"D. Spleen\", \"E. Thymus\", \"F. Yolk sac\"], \"correct\": 1, \"explanation\": \"Hematopoiesis migrates in a fixed sequence, and the question gives you the two ends of it so you can place the middle. Yolk sac blood islands (about weeks 3–8) → LIVER (about week 6 through birth, and the dominant site for the whole second trimester) → bone marrow (begins about the 5th month, dominant by birth and thereafter).\\n\\nThe two anchors in the stem do the work: extraembryonic blood islands at 4 weeks = yolk sac phase, and medullary cavities at 36 weeks = marrow phase. At 20 weeks the fetus sits between them, in the hepatic phase → the liver. The spleen contributes during the same window but is a minor partner, never the dominant site.\", \"wrongExplanations\": {\"0\": \"Bone marrow is correct for 36 weeks' gestation and for every point afterwards — the stem explicitly places precursors in the medullary cavities by then. Marrow only begins contributing around the 5th month, so at 20 weeks it is not yet the dominant site.\", \"2\": \"Lymph nodes would be correct if the question asked where lymphocytes undergo antigen-dependent maturation. They make a minor contribution to fetal hematopoiesis and never house the bulk of erythroid and granulocytic precursors.\", \"3\": \"The spleen does participate in fetal hematopoiesis during the same window, and would be correct if the question asked which organ is a secondary or accessory site. It is always a minor partner to the liver, and it is not a 'large solid organ containing the greatest number' of precursors.\", \"4\": \"The thymus would be correct if the question asked where T-cell precursors mature. It is a lymphoid training organ, not a site of erythroid or granulocytic production, at any stage of life.\", \"5\": \"The yolk sac is correct for 4 weeks' gestation — the stem describes it as the blood islands outside the embryo proper. It has involuted well before 20 weeks.\"}, \"eli5\": \"Blood gets made in different places as a baby grows: first in the yolk sac, then in the liver for most of pregnancy, then finally in the bones. At 20 weeks the liver is doing the job.\", \"explanationImage\": \"fig_hematopoiesis\", \"explanationImageCaption\": \"Hematopoiesis: the pluripotent hematopoietic stem cell gives rise to myeloid and lymphoid precursors, and from those to every mature blood cell.\", \"los\": [{\"n\": 81, \"t\": \"Understand the embryologic progression of hematopoiesis and the hematopoietic stem cells (HSCs) from early embryonic life through adulthood.\", \"a\": \"s1-hematopoiesis\", \"s\": \"§1\"}]}, {\"stem\": \"A 58-year-old man comes to the office because of a 3-month history of fatigue and easy bruising. He has no history of serious illness and takes no medications. His temperature is 36.9°C (98.4°F), pulse is 88/min, respirations are 16/min, and blood pressure is 126/78 mm Hg. Physical examination shows scattered ecchymoses over the forearms and no lymphadenopathy or splenomegaly.\\n\\nLaboratory studies show:\\n  Hemoglobin  8.6 g/dL (N=13.5–17.5 g/dL)\\n  Hematocrit  26% (N=41%–53%)\\n  Mean corpuscular volume  92 µm3 (N=80–100 µm3)\\n  Leukocyte count  2,100/mm3 (N=4,500–11,000/mm3)\\n  Platelet count  38,000/mm3 (N=150,000–400,000/mm3)\\n  Reticulocyte count  0.3% (N=0.5%–1.5%)\\nA bone marrow examination is planned. Which of the following is the most appropriate site from which to obtain the specimen?\", \"choices\": [\"A. Distal radius\", \"B. Mid-shaft of the femur\", \"C. Mid-shaft of the tibia\", \"D. Posterior superior iliac crest\", \"E. Sternal body\"], \"correct\": 3, \"explanation\": \"Three cytopenias with a LOW reticulocyte count point to a production failure, so the marrow must be sampled — and the site is determined by where red (hematopoietically active) marrow still exists in an adult.\\n\\nRed marrow retreats centripetally with age. In a child it fills essentially the whole skeleton; by adulthood it has withdrawn to the AXIAL skeleton and the proximal ends of the long bones, and the peripheral long-bone cavities are filled with yellow (fatty) marrow. The POSTERIOR SUPERIOR ILIAC CREST is the standard site because it reliably contains red marrow, offers a thick cortical window with no vital structure beneath it, and permits both an aspirate and an adequate core biopsy through one entry.\", \"wrongExplanations\": {\"0\": \"The distal radius would be correct in an infant, in whom red marrow still occupies the peripheral skeleton. In a 58-year-old it contains yellow fatty marrow and would yield a non-diagnostic specimen.\", \"1\": \"The mid-shaft of the femur is fatty marrow in an adult. The PROXIMAL femur retains some red marrow, so moving the needle to the proximal end would change the answer — but the shaft itself will not give a representative specimen.\", \"2\": \"The mid-shaft of the tibia is the most peripheral option here and the earliest to convert to yellow marrow. It is used in infants for emergency intraosseous ACCESS, which is a different purpose from sampling hematopoietic tissue.\", \"4\": \"The sternum does contain red marrow and was historically used, so the tissue would be adequate — but only an ASPIRATE can be taken there. A core biopsy is unsafe at the sternum because the great vessels and right atrium lie immediately deep to it, and this patient with pancytopenia needs the cellularity assessment that only a core provides.\"}, \"eli5\": \"As you get older, the bone marrow that still makes blood pulls back toward the center of the body. The back of the hip bone is where there is plenty of it and nothing dangerous underneath.\", \"los\": [{\"n\": 2, \"t\": \"Categorize the adult stem cell hierarchy and identify the primary sites of adult hematopoiesis.\", \"a\": \"s1-hematopoiesis\", \"s\": \"§1\"}, {\"n\": 29, \"t\": \"Given a clinical vignette with a presentation of anemia, differentiate clinical presentations based upon laboratory + bone marrow findings and correlate with the underlying pathophysiologic mechanisms.\", \"a\": \"s2-marrow\", \"s\": \"§2\"}]}, {\"stem\": \"An investigator isolates a single cell from murine bone marrow and injects it into a lethally irradiated recipient mouse. Sixteen weeks later, the recipient's blood contains donor-derived erythrocytes, granulocytes, monocytes, platelets, B lymphocytes, and T lymphocytes. Marrow is then harvested from this first recipient and transplanted into a second lethally irradiated mouse, and the process is repeated through four successive recipients. Each recipient survives with full donor-derived blood production.\\n\\nThe survival of the FOURTH successive recipient most specifically demonstrates which of the following properties?\", \"choices\": [\"A. Clonal selection\", \"B. Lineage commitment\", \"C. Pluripotency\", \"D. Self-renewal\", \"E. Terminal differentiation\", \"F. Transdifferentiation\"], \"correct\": 3, \"explanation\": \"This item separates the two defining properties of a hematopoietic stem cell, which are commonly blurred together.\\n\\nPRODUCING ALL SIX LINEAGES demonstrates PLURIPOTENCY — but that is shown by the FIRST recipient, and the question does not ask about the first recipient.\\n\\nSURVIVING SERIAL TRANSPLANTATION demonstrates SELF-RENEWAL. For the fourth mouse to be reconstituted, the original cell must have divided in a way that generated differentiating daughters AND regenerated an identical stem cell, over and over, without exhausting the pool. That is the definition of self-renewal, and serial transplantation is the classic assay for it. The buried clue is the word 'fourth' — it shifts the testing point from what the cell can BECOME to whether the cell can REPLACE ITSELF.\", \"wrongExplanations\": {\"0\": \"Clonal selection would be correct if the experiment showed expansion of a lymphocyte clone in response to a specific antigen. This is an adaptive-immunity term and has nothing to do with stem cell kinetics.\", \"1\": \"Lineage commitment is the step in which a multipotent progenitor becomes restricted to the myeloid or lymphoid branch and LOSES options. It would be correct if donor cells produced only granulocytes and monocytes — the opposite of the multilineage result described.\", \"2\": \"Pluripotency is genuinely demonstrated here, and would be correct if the question had asked about the first recipient's six donor-derived lineages. It describes what the cell can turn into, not whether it can perpetuate itself through four transplants.\", \"4\": \"Terminal differentiation describes a cell that has reached its final form and can no longer divide, such as a mature neutrophil. A terminally differentiated cell cannot reconstitute anything, let alone four successive recipients.\", \"5\": \"Transdifferentiation is the conversion of one differentiated cell type directly into another, and would require, for example, a mature lymphocyte becoming a hepatocyte. Nothing in the experiment crosses lineage boundaries after differentiation.\"}, \"eli5\": \"A stem cell can do two special things: turn into every kind of blood cell, and make copies of itself. Transplanting it over and over again into four mice proves the copying part.\", \"los\": [{\"n\": 83, \"t\": \"Using your knowledge of adult stem cell hierarchy, identify common functions and pathophysiology of hematopoietic stem cells (HSCs), multipotent regulators and myeloid + lymphoid lineage.\", \"a\": \"s1-hematopoiesis\", \"s\": \"§1\"}, {\"n\": 2, \"t\": \"Categorize the adult stem cell hierarchy and identify the primary sites of adult hematopoiesis.\", \"a\": \"s1-hematopoiesis\", \"s\": \"§1\"}]}, {\"stem\": \"A 44-year-old woman with acute myeloid leukemia is treated with an induction regimen containing cytarabine, which is incorporated into DNA during the S phase of the cell cycle. Her leukocyte count falls to 400/mm3 by day 10, and she becomes transfusion-dependent for erythrocytes and platelets. By day 28, her neutrophil count, hemoglobin concentration, and platelet count have all recovered without stem cell transplantation.\\n\\nWhich of the following properties of hematopoietic stem cells best explains the recovery of all three cell lines?\", \"choices\": [\"A. Expression of multidrug efflux transporters on committed progenitors\", \"B. Localization of stem cells within a hypoxic, quiescent marrow niche\", \"C. Preferential apoptosis of lymphoid rather than myeloid progenitors\", \"D. Rapid proliferation of stem cells that outpaces drug clearance\", \"E. Sequestration of stem cells within the peripheral circulation\"], \"correct\": 1, \"explanation\": \"Cytarabine is S-phase specific: it can only injure a cell that is actively synthesizing DNA. The reason the marrow is not permanently destroyed is that the cells at the TOP of the hierarchy are not cycling.\\n\\nHematopoietic stem cells reside in a HYPOXIC niche at the endosteal surface and are largely QUIESCENT, sitting in G0. Because they are not in S phase, cycle-specific chemotherapy passes over them. What the drug kills is the rapidly dividing committed progenitor and precursor compartment — which is exactly why the counts fall at day 10, when the existing mature cells reach the end of their lifespan and are not replaced. The spared quiescent stem cells then re-enter the cycle and repopulate all three lineages by day 28.\\n\\nQuiescence is therefore not an incidental feature; it is the property that makes the marrow survivable as a chemotherapy target.\", \"wrongExplanations\": {\"0\": \"Efflux transporters are indeed enriched on stem cells (the basis of the 'side population' phenotype), but the option places them on COMMITTED PROGENITORS — the very compartment that is destroyed here, as the day-10 nadir proves. Put the transporters on the stem cell and this becomes a defensible contributing mechanism.\", \"2\": \"This would be correct if the recovery had been limited to the myeloid lineage while lymphocytes stayed suppressed. All three lineages recovered, so a lineage-selective effect cannot be the explanation.\", \"3\": \"Rapid proliferation is precisely what makes a cell VULNERABLE to an S-phase agent, not protected from it. This option inverts the mechanism; it describes the leukemic blasts and the progenitor pool that were killed.\", \"4\": \"A small number of stem cells do circulate, and mobilizing them into the blood is the basis of apheresis collection — but circulating cells are no less exposed to an intravenous drug than marrow cells. Location in the blood confers no pharmacologic protection.\"}, \"eli5\": \"The chemotherapy only kills cells that are busy copying their DNA. The master stem cells are resting, so they survive and rebuild everything afterwards.\", \"los\": [{\"n\": 29, \"t\": \"Given a clinical vignette with a presentation of anemia, differentiate clinical presentations based upon laboratory + bone marrow findings and correlate with the underlying pathophysiologic mechanisms.\", \"a\": \"s2-marrow\", \"s\": \"§2\"}, {\"n\": 83, \"t\": \"Using your knowledge of adult stem cell hierarchy, identify common functions and pathophysiology of hematopoietic stem cells (HSCs), multipotent regulators and myeloid + lymphoid lineage.\", \"a\": \"s1-hematopoiesis\", \"s\": \"§1\"}]}, {\"stem\": \"A 33-year-old man is evaluated for a 6-week history of recurrent sinus infections. Flow cytometry of a bone marrow aspirate identifies a progenitor population that is capable of producing erythrocytes, granulocytes, monocytes, and platelets, but that produces no cells expressing CD19 or CD3 under any culture condition.\\n\\nA cell derived from this progenitor population is most likely to be which of the following?\", \"choices\": [\"A. B lymphocyte\", \"B. Megakaryocyte\", \"C. Natural killer cell\", \"D. Plasma cell\", \"E. T lymphocyte\"], \"correct\": 1, \"explanation\": \"The progenitor described is the COMMON MYELOID PROGENITOR. The stem tells you what it makes (erythrocytes, granulocytes, monocytes, platelets) and what it cannot make (CD19 = B cells, CD3 = T cells), which is the myeloid/lymphoid branch point stated in marker terms.\\n\\nThe MEGAKARYOCYTE is the marrow cell that sheds platelets, and it is myeloid. Every other option belongs to the lymphoid branch, which descends from the common LYMPHOID progenitor.\\n\\nThe branch point to carry: MYELOID = erythrocyte, megakaryocyte/platelet, neutrophil, eosinophil, basophil, monocyte/macrophage, and mast cell. LYMPHOID = B cell (and its plasma cell end-product), T cell, and NK cell.\", \"wrongExplanations\": {\"0\": \"A B lymphocyte is lymphoid and expresses CD19, which the stem explicitly excludes. It arises from the common lymphoid progenitor.\", \"2\": \"The natural killer cell is the easiest lymphoid cell to misplace because it is an innate effector that kills without antigen presentation — behaviourally it feels myeloid. Its LINEAGE, however, is lymphoid, from the common lymphoid progenitor.\", \"3\": \"The plasma cell is the terminally differentiated antibody-secreting form of a B lymphocyte, so it sits at the end of the lymphoid branch. It would be correct only if the progenitor had produced CD19-positive cells.\", \"4\": \"A T lymphocyte expresses CD3, which the stem explicitly excludes. It also requires thymic education, which no marrow culture condition supplies.\"}, \"eli5\": \"Blood cells come from two family trees. This progenitor belongs to the myeloid tree, and the platelet-making giant cell — the megakaryocyte — is on that tree.\", \"explanationImage\": \"fig_hematopoiesis\", \"explanationImageCaption\": \"The myeloid branch yields erythrocytes, megakaryocytes/platelets, granulocytes and monocytes; the lymphoid branch yields B cells, T cells and NK cells.\", \"los\": [{\"n\": 83, \"t\": \"Using your knowledge of adult stem cell hierarchy, identify common functions and pathophysiology of hematopoietic stem cells (HSCs), multipotent regulators and myeloid + lymphoid lineage.\", \"a\": \"s1-hematopoiesis\", \"s\": \"§1\"}, {\"n\": 2, \"t\": \"Categorize the adult stem cell hierarchy and identify the primary sites of adult hematopoiesis.\", \"a\": \"s1-hematopoiesis\", \"s\": \"§1\"}]}, {\"stem\": \"A 62-year-old woman with a 12-year history of type 2 diabetes mellitus comes to the office for follow-up. Her only medications are metformin and lisinopril. Her pulse is 78/min and blood pressure is 138/84 mm Hg. Physical examination shows conjunctival pallor and trace bilateral ankle edema.\\n\\nLaboratory studies show:\\n  Hemoglobin  9.2 g/dL (N=12.0–16.0 g/dL)\\n  Hematocrit  28% (N=36%–46%)\\n  Mean corpuscular volume  89 µm3 (N=80–100 µm3)\\n  Reticulocyte count  0.4% (N=0.5%–1.5%)\\n  Leukocyte count  7,300/mm3 (N=4,500–11,000/mm3)\\n  Platelet count  246,000/mm3 (N=150,000–400,000/mm3)\\n  Serum creatinine  3.4 mg/dL (N=0.6–1.2 mg/dL)\\n  Serum ferritin  180 ng/mL (N=20–250 ng/mL)\\n  Transferrin saturation  28% (N=20%–50%)\\nDeficient production of the hormone responsible for this patient's anemia occurs in which of the following locations?\", \"choices\": [\"A. Hepatocytes of the periportal zone\", \"B. Juxtaglomerular cells of the afferent arteriole\", \"C. Peritubular interstitial cells of the renal cortex\", \"D. Principal cells of the renal collecting duct\", \"E. Proximal convoluted tubular epithelium\", \"F. Zona glomerulosa of the adrenal cortex\"], \"correct\": 2, \"explanation\": \"Normocytic anemia with a LOW reticulocyte count and NORMAL iron studies in a patient with a creatinine of 3.4 mg/dL is the anemia of chronic kidney disease: the kidney has lost its endocrine function, not its filtering function alone.\\n\\nErythropoietin is produced by PERITUBULAR INTERSTITIAL CELLS (fibroblast-like cells) of the RENAL CORTEX, which sit in the interstitium between the tubules and the capillaries. That position is the point of the design — it lets the cell sense the oxygen content of blood that has already passed through the glomerulus and is being delivered to the energy-hungry tubules, making it a true tissue-oxygen sensor rather than a blood-pressure sensor.\\n\\nThe low reticulocyte count is the buried clue: it establishes a production failure, which is what an absent hormonal signal produces.\", \"wrongExplanations\": {\"0\": \"The liver is a genuine secondary source of erythropoietin, and is the DOMINANT source in the fetus — which is why anephric fetuses are not severely anemic. In adults the liver supplies only about 10% of erythropoietin and cannot compensate; the question asks where the deficient production normally occurs.\", \"1\": \"Juxtaglomerular cells synthesize RENIN, not erythropoietin, and they sense afferent arteriolar stretch and distal sodium delivery. They would be correct if the question concerned this patient's blood pressure or her lisinopril.\", \"3\": \"Principal cells of the collecting duct respond to aldosterone and antidiuretic hormone to handle sodium, potassium and water. They are hormone TARGETS, not a source of erythropoietin.\", \"4\": \"Proximal tubular epithelium performs bulk reabsorption and 1-alpha-hydroxylation of vitamin D, so it would be correct for the calcitriol deficiency and renal bone disease that accompany chronic kidney disease. It does not make erythropoietin — the erythropoietin-producing cells lie in the interstitium BESIDE these tubules.\", \"5\": \"The zona glomerulosa produces aldosterone. It would be correct for a question about this patient's volume status or potassium, not her anemia.\"}, \"eli5\": \"Kidneys do two jobs: filter blood, and send the message telling the marrow to build red cells. Her damaged kidneys stopped sending the message, so the marrow stopped building.\", \"los\": [{\"n\": 83, \"t\": \"Using your knowledge of adult stem cell hierarchy, identify common functions and pathophysiology of hematopoietic stem cells (HSCs), multipotent regulators and myeloid + lymphoid lineage.\", \"a\": \"s1-hematopoiesis\", \"s\": \"§1\"}, {\"n\": 19, \"t\": \"Differentiate clinical causes of anemias by clinical presentation, etiologies, laboratory studies, and diagnostics.\", \"a\": \"s3-anemia-eval\", \"s\": \"§3\"}]}, {\"stem\": \"A 29-year-old man who lives at sea level travels to a research station at an altitude of 4,200 m (13,800 ft). On arrival, his arterial oxygen saturation is 88%. Over the next 10 days, his serum erythropoietin concentration rises from 12 mU/mL to 96 mU/mL (N=4–26 mU/mL), and his hematocrit increases from 44% to 51%.\\n\\nWhich of the following best explains the increase in this patient's serum erythropoietin concentration?\", \"choices\": [\"A. Decreased degradation of hypoxia-inducible factor 1-alpha\", \"B. Decreased renal blood flow with activation of the renin-angiotensin system\", \"C. Increased hepatic synthesis of thrombopoietin\", \"D. Increased prolyl hydroxylation of hypoxia-inducible factor 1-alpha\", \"E. Increased transcription of the von Hippel-Lindau tumor suppressor gene\"], \"correct\": 0, \"explanation\": \"The oxygen sensor is a controlled-degradation switch, and the exam tests its DIRECTION.\\n\\nIn NORMOXIA: prolyl hydroxylase enzymes use molecular oxygen as a substrate to hydroxylate proline residues on HIF-1-alpha → hydroxylated HIF-1-alpha is recognized by the von Hippel-Lindau protein → it is ubiquitinated and destroyed by the proteasome. Erythropoietin transcription stays low.\\n\\nIn HYPOXIA: there is not enough oxygen for the prolyl hydroxylases to work → HIF-1-alpha is NOT hydroxylated → VHL cannot bind it → DEGRADATION FALLS and HIF-1-alpha accumulates → it dimerizes with HIF-1-beta, binds the hypoxia response element of the EPO gene, and erythropoietin transcription rises.\\n\\nSo the correct phrasing is DECREASED DEGRADATION. Note this is the same axis that the HIF prolyl hydroxylase inhibitors (vadadustat) drug class exploits pharmacologically — they block the hydroxylase to simulate altitude.\", \"wrongExplanations\": {\"1\": \"Renal hypoperfusion activates renin and would be correct for a question about this man's blood pressure or aldosterone. Erythropoietin responds to the oxygen CONTENT of blood, not to perfusion pressure; anemia raises erythropoietin with entirely normal renal blood flow.\", \"2\": \"Thrombopoietin is made constitutively by the liver and drives megakaryocyte production. It would be correct if his platelet count, not his hematocrit, had risen.\", \"3\": \"This is the correct molecule and the correct enzyme, but the wrong DIRECTION — and it is the intended trap. Prolyl hydroxylation REQUIRES oxygen, so hypoxia DECREASES it. Increased hydroxylation is what happens at sea level, and it would lower erythropoietin.\", \"4\": \"The von Hippel-Lindau protein is the ubiquitin ligase adaptor that destroys HIF, so increasing it would LOWER erythropoietin. Loss-of-function VHL mutations cause unopposed HIF signalling and are why VHL disease produces polycythemia and renal cell carcinoma — the opposite change from the one described.\"}, \"eli5\": \"A protein that switches on red-cell production is normally destroyed as fast as it is made, and oxygen is what allows the destroying enzyme to work. Up a mountain there is less oxygen, so the protein survives and piles up.\", \"los\": [{\"n\": 83, \"t\": \"Using your knowledge of adult stem cell hierarchy, identify common functions and pathophysiology of hematopoietic stem cells (HSCs), multipotent regulators and myeloid + lymphoid lineage.\", \"a\": \"s1-hematopoiesis\", \"s\": \"§1\"}, {\"n\": 70, \"t\": \"Identify the erythropoiesis-stimulating agents (ESAs) and hypoxia-inducible factor prolyl hydroxylase inhibitor (HIF-PHI) and describe their mechanisms of action, route of administration, clinical use, pregnancy use, contraindications, warnings/precautions, adverse effects, and when the medications should be initiated.\", \"a\": \"s16-anemia-drugs\", \"s\": \"§17\"}]}, {\"stem\": \"A 54-year-old woman with alcohol-associated cirrhosis is admitted to the hospital for evaluation of easy bruising. She has no fever. Physical examination shows scleral icterus, spider angiomas, shifting dullness, and scattered petechiae over the lower extremities. The spleen is palpated 4 cm below the left costal margin.\\n\\nLaboratory studies show:\\n  Hemoglobin  11.2 g/dL (N=12.0–16.0 g/dL)\\n  Hematocrit  34% (N=36%–46%)\\n  Leukocyte count  3,800/mm3 (N=4,500–11,000/mm3)\\n  Platelet count  44,000/mm3 (N=150,000–400,000/mm3)\\n  Prothrombin time  18 seconds (N=11–15 seconds)\\n  Serum albumin  2.4 g/dL (N=3.5–5.5 g/dL)\\nDecreased hepatic production of which of the following most directly accounts for this patient's thrombocytopenia?\", \"choices\": [\"A. Erythropoietin\", \"B. Granulocyte colony-stimulating factor\", \"C. Interleukin-3\", \"D. Stem cell factor\", \"E. Thrombopoietin\"], \"correct\": 4, \"explanation\": \"This patient has two reasons to be thrombocytopenic, and the lead-in tells you which one it wants: decreased HEPATIC PRODUCTION.\\n\\nTHROMBOPOIETIN is synthesized constitutively by the LIVER (with a minor renal contribution), binds the c-MPL receptor on megakaryocytes and their precursors, and drives megakaryocyte proliferation, endomitotic nuclear replication and platelet shedding. In cirrhosis, hepatic synthetic function fails — which the prolonged prothrombin time and the albumin of 2.4 g/dL independently confirm — and thrombopoietin falls with it.\\n\\nThe splenomegaly is the deliberate decoy: congestive splenomegaly from portal hypertension genuinely sequesters platelets and contributes here, but it is a peripheral, NON-hepatic mechanism, and the lead-in asks specifically about decreased hepatic production.\", \"wrongExplanations\": {\"0\": \"Erythropoietin is overwhelmingly renal in adults, and it drives the erythroid line. A deficiency would produce a hypoproliferative anemia, not thrombocytopenia — and her hemoglobin of 11.2 g/dL is the least abnormal value in the panel.\", \"1\": \"Granulocyte colony-stimulating factor is produced by macrophages, endothelium and fibroblasts, not by hepatocytes, and it drives neutrophil production. It would be correct if the question asked about her mildly low leukocyte count.\", \"2\": \"Interleukin-3 is a multilineage growth factor secreted by activated T LYMPHOCYTES, not hepatocytes. The stem specifies hepatic production, which excludes it regardless of its effect on megakaryocytes.\", \"3\": \"Stem cell factor is produced by marrow stromal cells and acts at the top of the hierarchy on c-KIT. It is neither hepatic nor megakaryocyte-specific, so a deficiency would depress all lineages rather than platelets selectively.\"}, \"eli5\": \"The liver makes the hormone that tells the body to build platelets. A scarred liver makes less of it, so platelets run low.\", \"los\": [{\"n\": 83, \"t\": \"Using your knowledge of adult stem cell hierarchy, identify common functions and pathophysiology of hematopoietic stem cells (HSCs), multipotent regulators and myeloid + lymphoid lineage.\", \"a\": \"s1-hematopoiesis\", \"s\": \"§1\"}]}, {\"stem\": \"A 61-year-old woman receives her second cycle of chemotherapy for breast cancer. After the first cycle, her absolute neutrophil count fell to 240/mm3 and she was hospitalized for 5 days with fever. She is otherwise well and takes no other medications. Her oncologist plans to give a recombinant growth factor after this cycle to shorten the duration of neutropenia.\\n\\nThe agent most appropriate for this indication acts on which of the following cell populations?\", \"choices\": [\"A. Committed granulocytic progenitors and mature neutrophils\", \"B. Erythroid colony-forming units in the marrow\", \"C. Megakaryocyte precursors expressing c-MPL\", \"D. Multipotent hematopoietic stem cells in the endosteal niche\", \"E. Peripheral blood T lymphocytes\"], \"correct\": 0, \"explanation\": \"The agent is FILGRASTIM (granulocyte colony-stimulating factor, G-CSF). The lead-in asks what it acts ON, which is the lineage-specificity point.\\n\\nG-CSF acts on COMMITTED GRANULOCYTIC PROGENITORS — it shortens their transit time through the marrow, expands the proliferating pool, and mobilizes the marginated and storage pools into the blood. It also enhances the function of MATURE neutrophils. Its action is confined to the granulocytic arm, which is exactly why it is the right drug when the problem is isolated neutropenia rather than pancytopenia.\\n\\nContrast with GM-CSF (sargramostim), which acts one branch point higher and stimulates granulocyte AND monocyte/macrophage lines; and with the erythroid agents (epoetin) and megakaryocyte agents (romiplostim, eltrombopag), which serve the other two lineages.\", \"wrongExplanations\": {\"1\": \"Erythroid colony-forming units are the target of the erythropoiesis-stimulating agents, epoetin alfa and darbepoetin. That would be correct if the problem were her hemoglobin; her documented complication was febrile neutropenia.\", \"2\": \"c-MPL is the thrombopoietin receptor, targeted by romiplostim and eltrombopag. These are the right agents for chemotherapy-induced THROMBOCYTOPENIA, which is a different cytopenia from the one described.\", \"3\": \"Acting on the multipotent stem cell in the niche describes stem cell factor, and describes the mechanism by which plerixafor mobilizes CD34-positive cells for apheresis collection. Mobilizing stem cells into the blood does not shorten a neutrophil nadir.\", \"4\": \"T lymphocytes are the target of interleukin-2 (aldesleukin) and of modern immunotherapies. Stimulating T cells does nothing for a granulocyte count and is not the purpose of growth factor support after chemotherapy.\"}, \"eli5\": \"Chemotherapy wipes out the infection-fighting white cells. This drug tells the marrow to hurry up and release more of that one specific cell type.\", \"explanationImage\": \"fig_cytokines\", \"explanationImageCaption\": \"Hematopoiesis and its principal cytokines — each growth factor acts at a defined level of the hierarchy, which is what makes the drugs lineage-specific.\", \"los\": [{\"n\": 83, \"t\": \"Using your knowledge of adult stem cell hierarchy, identify common functions and pathophysiology of hematopoietic stem cells (HSCs), multipotent regulators and myeloid + lymphoid lineage.\", \"a\": \"s1-hematopoiesis\", \"s\": \"§1\"}]}, {\"stem\": \"A 24-year-old woman comes to the office because of a 5-day history of fatigue and dark urine. She has no history of serious illness. Her temperature is 37.3°C (99.1°F), pulse is 104/min, respirations are 18/min, and blood pressure is 112/70 mm Hg. Physical examination shows scleral icterus and pallor; the spleen is palpated 3 cm below the left costal margin.\\n\\nLaboratory studies show:\\n  Hemoglobin  7.5 g/dL (N=12.0–16.0 g/dL)\\n  Hematocrit  22.5% (N=36%–46%)\\n  Mean corpuscular volume  94 µm3 (N=80–100 µm3)\\n  Reticulocyte count  8% (N=0.5%–1.5%)\\n  Lactate dehydrogenase  540 U/L (N=45–200 U/L)\\n  Haptoglobin  <10 mg/dL (N=30–200 mg/dL)\\n  Total bilirubin  3.2 mg/dL (N=0.1–1.0 mg/dL)\\n  Direct bilirubin  0.3 mg/dL (N=0.0–0.3 mg/dL)\\nWhich of the following values most closely approximates this patient's corrected reticulocyte count?\", \"choices\": [\"A. 0.8%\", \"B. 1.6%\", \"C. 4.0%\", \"D. 8.0%\", \"E. 16.0%\"], \"correct\": 2, \"explanation\": \"The raw reticulocyte percentage is a FRACTION, and in anemia the denominator has shrunk — so the raw number always overstates marrow output. The correction restores a common denominator.\\n\\nCorrected reticulocyte count = reticulocyte % × (patient hematocrit ÷ 45)\\n= 8% × (22.5 ÷ 45)\\n= 8% × 0.5\\n= 4.0%\\n\\nInterpretation, which is the reason the calculation exists: a corrected count ABOVE 2–3% means the marrow is responding appropriately, so the anemia is due to destruction or loss rather than a production defect. That fits everything else in the panel — the hemolysis trio moves as a unit here (LDH UP, haptoglobin UNDETECTABLE, indirect bilirubin UP with a normal direct fraction), alongside splenomegaly and jaundice.\\n\\nNote also that the hematocrit of 22.5% is consistent with a hemoglobin of 7.5 g/dL by the ×3 rule — always check that before trusting a panel.\", \"wrongExplanations\": {\"0\": \"0.8% would be the result of dividing rather than multiplying by the hematocrit ratio, and it lands in the range that would indicate marrow FAILURE. That conclusion would contradict the undetectable haptoglobin and raised LDH.\", \"1\": \"1.6% is what you get if you use a denominator of 45 without first taking the ratio, or if you correct twice. It is also the value that would wrongly reclassify this hemolytic anemia as hypoproliferative.\", \"3\": \"8.0% is the RAW, uncorrected reticulocyte percentage, and it is the surface-read answer. It would be the correct corrected value only if the hematocrit were normal at 45%.\", \"4\": \"16.0% results from multiplying by 45 ÷ hematocrit — the ratio inverted. Applying that correction to an anemic patient would inflate the apparent marrow response rather than temper it.\"}, \"eli5\": \"When you are very anemic, a percentage looks bigger than it really is because the total number of cells is small. You scale it down to compare fairly — here it halves, from 8% to 4%.\", \"explanationImage\": \"fig_retics\", \"explanationImageCaption\": \"Peripheral blood, supravital stain. Reticulocytes retain a deep-blue granular meshwork of ribosomal RNA, are slightly larger and rounder than mature erythrocytes, and lack their central pallor.\", \"los\": [{\"n\": 29, \"t\": \"Given a clinical vignette with a presentation of anemia, differentiate clinical presentations based upon laboratory + bone marrow findings and correlate with the underlying pathophysiologic mechanisms.\", \"a\": \"s2-marrow\", \"s\": \"§2\"}, {\"n\": 19, \"t\": \"Differentiate clinical causes of anemias by clinical presentation, etiologies, laboratory studies, and diagnostics.\", \"a\": \"s3-anemia-eval\", \"s\": \"§3\"}]}, {\"stem\": \"A 47-year-old man with multiple myeloma is scheduled for autologous hematopoietic stem cell transplantation. Before the transplant, CD34-positive cells must be collected from his peripheral blood by apheresis. After 4 days of granulocyte colony-stimulating factor, his peripheral CD34-positive cell count remains below the threshold required for collection. A second agent is added that blocks a chemokine receptor on hematopoietic stem cells, and the CD34-positive cell count rises sharply over the next 12 hours.\\n\\nThe added agent most likely interrupts binding between which of the following pairs?\", \"choices\": [\"A. c-KIT and stem cell factor\", \"B. CXCR4 and CXCL12\", \"C. Integrin alpha-4-beta-1 and fibronectin\", \"D. Notch1 and Jagged1\", \"E. P-selectin and P-selectin glycoprotein ligand 1\"], \"correct\": 1, \"explanation\": \"The niche is not a warehouse where cells are stored; it is an active anchoring system, and stem cell collection works by breaking the anchor.\\n\\nMarrow stromal cells and CXCL12-abundant reticular cells secrete CXCL12 (also called stromal cell-derived factor 1). Hematopoietic stem cells express its receptor, CXCR4. The CXCL12–CXCR4 bond is the dominant tether holding stem cells in the endosteal and perivascular niche.\\n\\nPLERIXAFOR is a reversible CXCR4 antagonist. Blocking the receptor releases the tether, and stem cells leave the marrow for the blood within hours — which is exactly the rapid 12-hour rise described. It is used precisely in this situation: the patient who mobilizes poorly on G-CSF alone.\\n\\nThis is also the clinical answer to 'why does the niche matter?' — three therapies live in it: mobilization for transplant, engraftment after transplant, and the niche-dependence of leukemic stem cells.\", \"wrongExplanations\": {\"0\": \"c-KIT and stem cell factor is a genuine stem cell survival and proliferation signal, but stem cell factor is not a CHEMOKINE and the pair is not the positional anchor. Blocking it would impair stem cell survival rather than release cells into the blood.\", \"2\": \"Integrin alpha-4-beta-1 (VLA-4) binding to fibronectin and VCAM-1 is a real secondary adhesion mechanism in the niche, and natalizumab-like VLA-4 blockade does cause some mobilization. It is an adhesion-molecule pair, not the chemokine-receptor pair the stem specifies.\", \"3\": \"Notch1–Jagged1 signalling regulates stem cell fate decisions and self-renewal in the niche. It determines what the cell BECOMES, not where it is physically held.\", \"4\": \"P-selectin and its ligand mediate the rolling step of leukocyte adhesion to activated endothelium during inflammation. It is the wrong compartment entirely, and blocking it impairs neutrophil entry into tissues.\"}, \"eli5\": \"Stem cells are held inside the marrow by a molecular Velcro. This drug unsticks the Velcro so the cells float into the bloodstream, where they can be collected.\", \"los\": [{\"n\": 29, \"t\": \"Given a clinical vignette with a presentation of anemia, differentiate clinical presentations based upon laboratory + bone marrow findings and correlate with the underlying pathophysiologic mechanisms.\", \"a\": \"s2-marrow\", \"s\": \"§2\"}]}, {\"stem\": \"A 67-year-old man is evaluated for a 4-month history of fatigue. His hemoglobin concentration is 9.1 g/dL, leukocyte count is 3,200/mm3, and platelet count is 96,000/mm3. A bone marrow procedure is performed at the posterior iliac crest, and two specimens are obtained: an aspirated liquid sample that is smeared and stained, and a cylindrical piece of intact bone and marrow that is decalcified, sectioned, and stained with hematoxylin and eosin.\\n\\nWhich of the following questions can be answered ONLY by the second specimen?\", \"choices\": [\"A. Whether Auer rods are present within blast cytoplasm\", \"B. Whether individual erythroid precursors show nuclear-cytoplasmic asynchrony\", \"C. Whether stainable iron is present within marrow macrophages\", \"D. Whether the marrow is hypocellular relative to the patient's age\", \"E. Whether the myeloid-to-erythroid ratio can be determined by differential count\"], \"correct\": 3, \"explanation\": \"The two specimens answer different questions, and the difference is ARCHITECTURE versus CYTOLOGY.\\n\\nThe ASPIRATE is a liquid sample that is smeared, so individual cells are spread in one layer and their fine cytoplasmic and nuclear detail is superb. It answers cytologic questions: blast percentage, Auer rods, dysplasia, the myeloid-to-erythroid ratio, iron stores by Prussian blue, and it supplies material for flow cytometry, cytogenetics and molecular studies.\\n\\nThe CORE BIOPSY preserves the marrow IN SITU — bone trabeculae, fat spaces and hematopoietic cells in their true spatial relationship. Only an intact core lets you state what fraction of the marrow space is hematopoietic tissue rather than fat, which is the definition of CELLULARITY. An aspirate is diluted by peripheral blood and by the act of suction, so it cannot be used to judge cellularity.\\n\\nThe core is also the only specimen that can show marrow FIBROSIS, granulomas, or focal metastatic infiltration, and it is the specimen that still yields an answer when the aspirate gives a dry tap.\", \"wrongExplanations\": {\"0\": \"Auer rods are best seen on the ASPIRATE smear, where a blast lies flat in a single layer and its cytoplasmic detail is preserved. Decalcification and sectioning of a core degrade exactly this kind of fine detail.\", \"1\": \"Nuclear-cytoplasmic asynchrony in erythroid precursors — the hallmark of megaloblastic change — is a single-cell morphologic judgement, which is what the aspirate smear is for.\", \"2\": \"The Prussian blue stain for storage iron is performed on the ASPIRATE smear, and is one of the few genuine indications for marrow sampling in anemia. A core biopsy is decalcified, and decalcification can leach iron and make the stain unreliable.\", \"4\": \"The myeloid-to-erythroid ratio is obtained by counting several hundred individual nucleated cells on the aspirate smear. Counting cells one by one requires them spread in a monolayer, which a sectioned core does not provide.\"}, \"eli5\": \"One sample is liquid marrow smeared on a slide, which is great for looking at single cells close up. The other is a solid core that keeps the marrow's structure, which is the only way to see how much of the space is actually making blood.\", \"image\": \"fig_aplastic\", \"imageCaption\": \"Core biopsy specimen of bone marrow (hematoxylin and eosin, medium power). Bony trabeculae are seen at the left and right; the intervening marrow space is largely occupied by clear, round fat spaces with only scattered residual hematopoietic cells.\", \"los\": [{\"n\": 29, \"t\": \"Given a clinical vignette with a presentation of anemia, differentiate clinical presentations based upon laboratory + bone marrow findings and correlate with the underlying pathophysiologic mechanisms.\", \"a\": \"s2-marrow\", \"s\": \"§2\"}]}, {\"stem\": \"A 70-year-old woman is evaluated for pancytopenia. A bone marrow core biopsy specimen is obtained and reported as showing 45% cellularity, with trilineage hematopoiesis and no fibrosis, granulomas, dysplasia, or increase in blasts. Her physician states that the cellularity is not the explanation for her cytopenias.\\n\\nWhich of the following best supports that conclusion?\", \"choices\": [\"A. Cellularity above 30% excludes a hypoproliferative process at any age\", \"B. Cellularity is expected to be approximately 100 minus the patient's age in years\", \"C. Cellularity is not interpretable on a core biopsy specimen and requires an aspirate\", \"D. Marrow cellularity is constant at approximately 50% throughout adult life\", \"E. Marrow cellularity rises with age as fat is replaced by hematopoietic tissue\"], \"correct\": 1, \"explanation\": \"Marrow cellularity is AGE-DEPENDENT, and the number alone means nothing until it is compared with what that patient's age predicts.\\n\\nThe working rule is CELLULARITY ≈ 100 − AGE (in years). A newborn's marrow is near 100% cellular; a 30-year-old runs about 70%; a 70-year-old runs about 30%. The rest of the marrow space is fat, and the proportion of fat rises steadily through adult life.\\n\\nFor this 70-year-old, the predicted cellularity is roughly 30%. Her measured 45% is therefore NORMAL to mildly increased — certainly not hypocellular. A marrow that is making plenty of cells while the blood counts are low points the workup away from production failure and toward peripheral destruction, sequestration, or ineffective hematopoiesis.\\n\\nThe trap is reading 45% as 'low' because it is under half. Against a predicted 30% it is not low at all.\", \"wrongExplanations\": {\"0\": \"This invents a fixed threshold and, in doing so, abolishes the age adjustment that is the entire point. Thirty percent cellularity is normal at 70 years and severely hypocellular at 20 years; no single cut-off can be right for both.\", \"2\": \"This reverses the two specimens. Cellularity requires the intact architecture of a CORE biopsy precisely because an aspirate is diluted by blood and cannot show the tissue-to-fat proportion.\", \"3\": \"A constant 50% is a convenient approximation for a middle-aged adult, which is probably why it feels familiar, but applying it here would misclassify this patient's marrow as hypocellular and send the workup in the wrong direction.\", \"4\": \"This is the correct variable moving in the wrong direction, and it is the intended trap. Hematopoietic tissue is progressively replaced BY fat with age, so cellularity FALLS; the option describes the reverse.\"}, \"eli5\": \"Bone marrow gets fattier as you age, so 'normal' fullness depends on how old you are. Roughly, 100 minus your age gives the expected percentage.\", \"los\": [{\"n\": 29, \"t\": \"Given a clinical vignette with a presentation of anemia, differentiate clinical presentations based upon laboratory + bone marrow findings and correlate with the underlying pathophysiologic mechanisms.\", \"a\": \"s2-marrow\", \"s\": \"§2\"}, {\"n\": 65, \"t\": \"Identify causes of pancytopenia and bone marrow failure in children.\", \"a\": \"s46-pediatric\", \"s\": \"§51\"}]}, {\"stem\": \"A 72-year-old man is evaluated for a 6-month history of fatigue. He does not drink alcoholic beverages and takes no medications.\\n\\nLaboratory studies show:\\n  Hemoglobin  9.4 g/dL (N=13.5–17.5 g/dL)\\n  Hematocrit  28% (N=41%–53%)\\n  Mean corpuscular volume  104 µm3 (N=80–100 µm3)\\n  Reticulocyte count  0.6% (N=0.5%–1.5%)\\n  Leukocyte count  3,400/mm3 (N=4,500–11,000/mm3)\\n  Platelet count  118,000/mm3 (N=150,000–400,000/mm3)\\n  Serum iron  190 µg/dL (N=65–175 µg/dL)\\n  Serum ferritin  620 ng/mL (N=20–250 ng/mL)\\n  Total iron-binding capacity  240 µg/dL (N=250–400 µg/dL)\\n  Serum vitamin B12  480 pg/mL (N=200–900 pg/mL)\\n  Serum folate  12 ng/mL (N=2.5–20 ng/mL)\\nA bone marrow aspirate is obtained and a special stain is performed, shown below.\\n\\nThe stain used to demonstrate this finding identifies which of the following?\", \"choices\": [\"A. Glycogen within cytoplasmic vacuoles\", \"B. Iron within erythroid precursor mitochondria\", \"C. Lipid within macrophage cytoplasm\", \"D. Myeloperoxidase within primary granules\", \"E. Ribosomal RNA within reticulocytes\"], \"correct\": 1, \"explanation\": \"The stain is PRUSSIAN BLUE (Perls stain), and it is the one special stain routinely applied to a marrow aspirate.\\n\\nPrussian blue reacts with ferric iron to produce a blue precipitate. It answers two questions at once: how much STORAGE iron sits in marrow macrophages, and whether iron is abnormally deposited inside ERYTHROID PRECURSORS. When the deposits form a ring of blue granules encircling the nucleus — iron trapped inside perinuclear MITOCHONDRIA because it cannot be incorporated into heme — the cell is a RINGED SIDEROBLAST.\\n\\nThe laboratory panel sets this up: a macrocytic anemia with other cytopenias in an older man, with iron studies that are HIGH ACROSS THE BOARD (high iron, high ferritin, LOW total iron-binding capacity) and normal B12 and folate. That is a picture of iron that is present but cannot be used — sideroblastic erythropoiesis, here in the setting of a myelodysplastic neoplasm.\\n\\nNote the contrast that iron studies make possible: iron deficiency gives low iron with HIGH binding capacity; this patient's low binding capacity with high ferritin excludes it outright.\", \"wrongExplanations\": {\"0\": \"Glycogen is demonstrated by the periodic acid-Schiff stain, which produces block positivity in lymphoblasts. It would be relevant to classifying an acute leukemia, not to iron handling.\", \"2\": \"Lipid-laden macrophages are demonstrated by oil red O or Sudan black B on frozen material. Sudan black B is used in leukemia workups to confirm myeloid differentiation, and would be correct if the question concerned lineage assignment of blasts.\", \"3\": \"Myeloperoxidase staining identifies granulocytic lineage and is the stain that corroborates Auer rods in acute myeloid leukemia. It says nothing about iron, and the stem gives no increase in blasts.\", \"4\": \"Ribosomal RNA in reticulocytes is demonstrated by a SUPRAVITAL stain such as new methylene blue — the stain used to count reticulocytes. That is performed on peripheral blood, not on a marrow aspirate, and this patient's reticulocyte count is already reported as normal.\"}, \"eli5\": \"This stain turns iron bright blue. Here it shows iron stuck in a ring inside the young red cells, which means the body has plenty of iron but cannot load it into hemoglobin.\", \"image\": \"fig_sideroblast\", \"imageCaption\": \"Bone marrow aspirate, Prussian blue stain. Several immature erythroid cells contain coarse blue granules arranged around the nucleus.\", \"los\": [{\"n\": 29, \"t\": \"Given a clinical vignette with a presentation of anemia, differentiate clinical presentations based upon laboratory + bone marrow findings and correlate with the underlying pathophysiologic mechanisms.\", \"a\": \"s2-marrow\", \"s\": \"§2\"}, {\"n\": 53, \"t\": \"Given a clinical vignette, interpret laboratory and diagnostic studies as well as molecular genetics to distinguish various etiologies of anemia.\", \"a\": \"s3-anemia-eval\", \"s\": \"§3\"}]}, {\"stem\": \"A 42-year-old woman comes to the office because of a 4-month history of fatigue. She has heavy menstrual periods lasting 7 days. She has no history of serious illness and takes no medications. Physical examination shows pale conjunctivae and no organomegaly.\\n\\nLaboratory studies show:\\n  Hemoglobin  9.8 g/dL (N=12.0–16.0 g/dL)\\n  Hematocrit  29% (N=36%–46%)\\n  Mean corpuscular volume  72 µm3 (N=80–100 µm3)\\n  Red cell distribution width  18.4% (N=11.5%–14.5%)\\n  Reticulocyte count  0.7% (N=0.5%–1.5%)\\n  Leukocyte count  6,900/mm3 (N=4,500–11,000/mm3)\\n  Platelet count  431,000/mm3 (N=150,000–400,000/mm3)\\n  Serum iron  22 µg/dL (N=65–175 µg/dL)\\n  Total iron-binding capacity  468 µg/dL (N=250–400 µg/dL)\\n  Serum ferritin  6 ng/mL (N=20–250 ng/mL)\\nWhich of the following is the most appropriate next step in management?\", \"choices\": [\"A. Bone marrow aspiration and biopsy\", \"B. Hemoglobin electrophoresis\", \"C. Oral iron supplementation\", \"D. Serum erythropoietin measurement\", \"E. Transfusion of packed red blood cells\"], \"correct\": 2, \"explanation\": \"The iron panel here is a complete, internally consistent row for IRON DEFICIENCY: low serum iron, HIGH total iron-binding capacity, low ferritin, microcytosis, a high red cell distribution width, and the reactive thrombocytosis that commonly accompanies it. There is a sufficient explanation for the losses in the history.\\n\\nWhen the diagnosis is already established non-invasively, the next step is TREATMENT, not more testing. Oral iron is first-line, and the response itself confirms the diagnosis — the reticulocyte count rises within about a week and the hemoglobin by about 1 g/dL every 2–3 weeks.\\n\\nThe marrow-biopsy distractor is the specific point of this item. A marrow examination is the historical gold standard for iron stores, but it is invasive, painful, and almost never necessary: ferritin and the transferrin saturation answer the question. Reserve marrow sampling for unexplained cytopenias, suspected marrow infiltration or malignancy, and cases where non-invasive testing has genuinely failed. None applies here — her white cell count is normal and her platelets are high, so there is no cytopenia to explain beyond the anemia itself.\", \"wrongExplanations\": {\"0\": \"A marrow examination would be appropriate if she had unexplained cytopenias in more than one lineage, blasts or dysplasia on the smear, or an iron panel that did not fit. It is the wrong answer here precisely because the diagnosis has already been made from blood tests and a history of heavy menstrual losses.\", \"1\": \"Hemoglobin electrophoresis would be the next step if the microcytosis came with NORMAL iron studies, a normal or high red cell count and a normal red cell distribution width — the thalassemia trait profile. Her ferritin of 6 ng/mL excludes that pattern.\", \"3\": \"Serum erythropoietin measurement is used when a hypoproliferative anemia is unexplained, particularly in renal disease, or to evaluate polycythemia. It adds nothing once a definite cause of the anemia is in hand.\", \"4\": \"Transfusion is reserved for hemodynamic instability, active bleeding, or symptomatic anemia at a much lower threshold. She is stable at 9.8 g/dL with a chronic, correctable cause, and transfusing her would expose her to risk while treating a number rather than a patient.\"}, \"eli5\": \"All her blood tests already say 'low iron', and her heavy periods explain why. Give her iron rather than putting a needle in her hip bone.\", \"los\": [{\"n\": 29, \"t\": \"Given a clinical vignette with a presentation of anemia, differentiate clinical presentations based upon laboratory + bone marrow findings and correlate with the underlying pathophysiologic mechanisms.\", \"a\": \"s2-marrow\", \"s\": \"§2\"}, {\"n\": 49, \"t\": \"Given a clinical vignette, identify the important next steps in the differential diagnosis of iron deficiency anemia.\", \"a\": \"s4-iron\", \"s\": \"§4\"}]}, {\"stem\": \"A 58-year-old man with poorly controlled type 2 diabetes mellitus is admitted to the hospital for evaluation of fatigue. A complete blood count performed on an automated analyzer reports a hemoglobin concentration of 17.9 g/dL and a hematocrit of 34%. A blood smear shows normochromic, normocytic erythrocytes with no agglutination, no spherocytes, and no fragmented cells. The plasma layer of a centrifuged specimen is creamy white rather than straw-coloured, and the serum triglyceride concentration is 3,400 mg/dL (N=<150 mg/dL).\\n\\nWhich of the following best explains the relationship between the reported hemoglobin concentration and the reported hematocrit?\", \"choices\": [\"A. The hematocrit is falsely decreased because agglutinated erythrocytes are counted as single particles\", \"B. The hemoglobin is falsely decreased because lipid binds hemoglobin and removes it from solution\", \"C. The hemoglobin is falsely elevated because sample turbidity increases light absorbance\", \"D. The values are internally consistent and indicate true polycythemia\", \"E. The values reflect true acute blood loss with delayed plasma refill\"], \"correct\": 2, \"explanation\": \"The first move with any complete blood count is to check the HEMOGLOBIN-TO-HEMATOCRIT RELATIONSHIP: the hematocrit is normally about THREE TIMES the hemoglobin. Here the hematocrit of 34% predicts a hemoglobin near 11.3 g/dL, but the analyzer reports 17.9 g/dL. That gap is far too wide to be biological, so one of the two numbers is wrong.\\n\\nThe two are measured by completely different physical principles, which is what makes the cross-check useful. HEMOGLOBIN is a direct CHEMICAL measurement: erythrocytes are lysed, hemoglobin is converted to a coloured derivative, and light ABSORBANCE is read in a spectrophotometer. HEMATOCRIT on a modern analyzer is CALCULATED from the directly counted erythrocyte number and the measured mean corpuscular volume — a particle-counting method that light scattering does not disturb.\\n\\nGross LIPEMIA makes the sample TURBID. Turbidity absorbs and scatters light in the photometer, and the analyzer cannot distinguish that lost light from light absorbed by the hemoglobin derivative, so it reports a FALSELY HIGH hemoglobin. Hyperbilirubinemia and marked leukocytosis interfere by the same optical route. The laboratory corrects it by replacing the lipemic plasma with an equal volume of saline and repeating the measurement — after which this patient's true hemoglobin will sit near the 11 g/dL his hematocrit predicts, and he is in fact ANEMIC, not polycythemic.\\n\\nThe smear findings are deliberate exclusions: no agglutination excludes a cold agglutinin, and normal morphology excludes spherocytes and fragments as a cause of index abnormalities.\", \"wrongExplanations\": {\"0\": \"Cold agglutinins do corrupt this panel, but in the opposite direction and by a different route: clumped erythrocytes pass the aperture as single large particles, so the COUNT falls and the mean corpuscular volume rises. The stem explicitly states there is no agglutination, and warming the sample would resolve that artefact.\", \"1\": \"Lipid does not bind or sequester hemoglobin, and this option also has the direction wrong — a falsely LOW hemoglobin would make the reported value smaller than the hematocrit predicts, which is the reverse of what is reported.\", \"3\": \"Accepting these values is exactly the error the item is built to catch. True polycythemia raises hemoglobin and hematocrit TOGETHER — a hemoglobin of 17.9 g/dL should come with a hematocrit near 53%, not 34%.\", \"4\": \"Acute blood loss lowers hemoglobin and hematocrit together and in proportion, because whole blood is lost. Before plasma refill both values are near-normal; afterwards both fall. Neither phase produces two values that disagree with each other.\"}, \"eli5\": \"Hematocrit is usually about three times the hemoglobin, and these two numbers do not match. His blood is full of fat, which clouds the sample and fools the machine's light-based hemoglobin reading into reading too high.\", \"los\": [{\"n\": 29, \"t\": \"Given a clinical vignette with a presentation of anemia, differentiate clinical presentations based upon laboratory + bone marrow findings and correlate with the underlying pathophysiologic mechanisms.\", \"a\": \"s2-marrow\", \"s\": \"§2\"}, {\"n\": 27, \"t\": \"Given a clinical vignette and laboratory and/or diagnostic values, identify the key components of the CBC, methodology and troubleshooting of interferences.\", \"a\": \"s20-cbc-method\", \"s\": \"§23\"}]}, {\"stem\": \"A 26-year-old woman comes to the office because of a 2-week history of fatigue and dark urine. Physical examination shows jaundice and splenomegaly.\\n\\nLaboratory studies show:\\n  Hemoglobin  8.7 g/dL (N=12.0–16.0 g/dL)\\n  Hematocrit  23% (N=36%–46%)\\n  Mean corpuscular volume  84 µm3 (N=80–100 µm3)\\n  Mean corpuscular hemoglobin concentration  37.8% Hb/cell (N=31%–36% Hb/cell)\\n  Red cell distribution width  17.1% (N=11.5%–14.5%)\\n  Reticulocyte count  9% (N=0.5%–1.5%)\\n  Lactate dehydrogenase  410 U/L (N=45–200 U/L)\\n  Haptoglobin  14 mg/dL (N=30–200 mg/dL)\\n  Total bilirubin  3.6 mg/dL (N=0.1–1.0 mg/dL)\\n  Direct bilirubin  0.4 mg/dL (N=0.0–0.3 mg/dL)\\nThe elevated mean corpuscular hemoglobin concentration in this patient is best explained by which of the following?\", \"choices\": [\"A. A population of erythrocytes with reduced surface area relative to volume\", \"B. Cold agglutinin-induced erythrocyte clumping within the analyzer\", \"C. Incorporation of excess hemoglobin during erythroid maturation\", \"D. Lipemia causing spurious elevation of the measured hemoglobin\", \"E. Reticulocytosis raising the average cellular hemoglobin content\"], \"correct\": 0, \"explanation\": \"Mean corpuscular hemoglobin CONCENTRATION is hemoglobin divided by hematocrit — it asks how densely packed the hemoglobin is inside the average cell. A value above about 36–37% is one of the few genuinely useful red flags on a complete blood count, because very few things can raise it.\\n\\nThe cell cannot manufacture extra hemoglobin beyond its normal ceiling. So a high concentration almost always means the DENOMINATOR has shrunk: the cell has lost membrane and therefore surface area, while keeping its hemoglobin. The cell rounds up into a SPHERE — a spherocyte — whose volume is smaller for the same contents. Reduced surface area relative to volume is exactly that description.\\n\\nEverything else in the panel supports hereditary spherocytosis or an immune hemolytic anemia: brisk reticulocytosis at 9%, a hemolysis panel moving as a unit (LDH up, haptoglobin low, indirect bilirubin up), jaundice and splenomegaly, and a high red cell distribution width from the mixed population.\\n\\nThe practical rule worth carrying: MCHC above 36–37% means spherocytes, or an artefact — and the artefacts are cold agglutinins and lipemia, both of which the item must exclude before the biological answer stands.\", \"wrongExplanations\": {\"1\": \"Cold agglutinins are a real cause of a spuriously high mean corpuscular hemoglobin concentration: clumped cells are counted as fewer, larger particles, so the calculated hematocrit falls and the ratio rises. It would be correct if the smear showed agglutination or the values corrected on warming the sample — neither is described.\", \"2\": \"There is a fixed ceiling on how much hemoglobin a normal erythroid precursor can load; the cell cannot become supersaturated. Hemoglobin synthesis defects move this value DOWN (hypochromia), never up.\", \"3\": \"Lipemia raises the measured hemoglobin optically and would raise the ratio — a genuine artefact, and worth excluding. It does not fit here, because there is no mention of lipemic serum and because a full hemolysis panel and splenomegaly demand a biological explanation.\", \"4\": \"Reticulocytes are LARGER than mature erythrocytes and contain proportionally LESS hemoglobin per unit volume, so marked reticulocytosis tends to raise the mean corpuscular volume and lower this ratio. The direction is wrong.\"}, \"eli5\": \"This number says how tightly hemoglobin is packed inside a red cell. It goes up when the cell loses part of its outer skin and shrinks into a ball, with the same hemoglobin squeezed into less space.\", \"los\": [{\"n\": 29, \"t\": \"Given a clinical vignette with a presentation of anemia, differentiate clinical presentations based upon laboratory + bone marrow findings and correlate with the underlying pathophysiologic mechanisms.\", \"a\": \"s2-marrow\", \"s\": \"§2\"}, {\"n\": 27, \"t\": \"Given a clinical vignette and laboratory and/or diagnostic values, identify the key components of the CBC, methodology and troubleshooting of interferences.\", \"a\": \"s20-cbc-method\", \"s\": \"§23\"}]}, {\"stem\": \"A 24-year-old man is brought to the emergency department 30 minutes after sustaining a stab wound to the left thigh. Bystanders report a large volume of blood at the scene. He is alert but anxious. His temperature is 36.6°C (97.9°F), pulse is 126/min, respirations are 24/min, and blood pressure is 94/58 mm Hg. Physical examination shows cool, pale extremities, delayed capillary refill, and a 3-cm laceration over the medial thigh with ongoing bleeding.\\n\\nLaboratory studies obtained on arrival show:\\n  Hemoglobin  14.1 g/dL (N=13.5–17.5 g/dL)\\n  Hematocrit  42% (N=41%–53%)\\n  Mean corpuscular volume  89 µm3 (N=80–100 µm3)\\n  Platelet count  232,000/mm3 (N=150,000–400,000/mm3)\\nWhich of the following best explains this patient's hemoglobin concentration?\", \"choices\": [\"A. Hemoconcentration from third-spacing of plasma into injured tissue\", \"B. Loss of whole blood without a change in the ratio of erythrocytes to plasma\", \"C. Rapid release of stored erythrocytes from the splenic reservoir\", \"D. Reticulocytosis from an immediate marrow response to hemorrhage\", \"E. Splenic contraction driven by catecholamine release\"], \"correct\": 1, \"explanation\": \"Hemoglobin is a CONCENTRATION — grams per decilitre — not a total amount. Acute hemorrhage removes ERYTHROCYTES AND PLASMA TOGETHER, in the proportion they exist in the vessel, so the ratio between them is unchanged and the concentration initially reads NORMAL.\\n\\nThe hemoglobin only falls once the intravascular volume is restored and the remaining red cells are diluted — by endogenous fluid shifting from the interstitium over several hours, or far faster if crystalloid is given. A normal hemoglobin 30 minutes into a significant bleed is therefore expected and tells you nothing reassuring.\\n\\nThis is why the immediate threat in acute bleeding is VOLUME, not the number on the complete blood count. His tachycardia at 126/min, narrowed pulse pressure, cool extremities and delayed capillary refill are the findings that describe the severity; the hemoglobin lags behind them.\\n\\nContrast with chronic blood loss, which gives the opposite picture: plasma volume stays normal throughout, so the hemoglobin falls steadily and the cells become microcytic as iron stores are depleted.\", \"wrongExplanations\": {\"0\": \"Third-spacing of plasma would CONCENTRATE the remaining erythrocytes and drive the hemoglobin ABOVE baseline, which is seen in burns and severe dehydration. His hemoglobin is normal, not elevated, and his cool extremities and hypotension describe volume LOSS rather than plasma redistribution.\", \"2\": \"The human spleen is not a physiologically significant erythrocyte reservoir, unlike in dogs and horses. Even complete emptying of the human splenic red cell pool would raise the hemoglobin only marginally and could not maintain it through a major hemorrhage.\", \"3\": \"A marrow response takes DAYS, not minutes: the reticulocyte count begins to rise at about 2–3 days and peaks near a week. Nothing the marrow does can influence a value drawn 30 minutes after injury.\", \"4\": \"Catecholamine-driven splenic contraction does occur in humans and contributes a small autotransfusion, so this is the most tempting distractor. Its magnitude is far too small to account for a fully normal hemoglobin, and it would be a partial contributor rather than the explanation.\"}, \"eli5\": \"Bleeding loses red cells and the liquid they float in at the same time, so the mixture stays the same strength at first. The blood count only drops later, once the body refills the liquid part.\", \"los\": [{\"n\": 29, \"t\": \"Given a clinical vignette with a presentation of anemia, differentiate clinical presentations based upon laboratory + bone marrow findings and correlate with the underlying pathophysiologic mechanisms.\", \"a\": \"s2-marrow\", \"s\": \"§2\"}]}, {\"stem\": \"A 66-year-old man is evaluated for a 5-month history of fatigue, early satiety, and a 6-kg weight loss. The spleen is palpated 10 cm below the left costal margin. A peripheral blood smear shows teardrop-shaped erythrocytes, nucleated erythrocytes, and occasional immature granulocytes. Bone marrow aspiration is attempted twice at separate sites, and on both occasions no marrow can be drawn into the syringe.\\n\\nThe inability to aspirate marrow in this patient is best explained by which of the following marrow findings?\", \"choices\": [\"A. Complete replacement of hematopoietic tissue by mature adipocytes\", \"B. Deposition of reticulin and collagen fibrosis throughout the marrow space\", \"C. Diffuse infiltration by sheets of monomorphic lymphoid cells\", \"D. Necrosis of hematopoietic cells with preserved bony trabeculae\", \"E. Non-caseating granulomas surrounding marrow arterioles\"], \"correct\": 1, \"explanation\": \"A 'DRY TAP' — the inability to aspirate marrow despite correct technique at more than one site — means the marrow is not liquid enough to be sucked into a syringe. The commonest reason is that it has been replaced by FIBROUS TISSUE.\\n\\nEverything else in this vignette points the same way. TEARDROP erythrocytes (dacrocytes) are deformed as they squeeze out of a fibrotic marrow. The combination of nucleated red cells and immature granulocytes in the blood is a LEUKOERYTHROBLASTIC picture, which means the marrow-blood barrier has been disrupted. Massive splenomegaly reflects extramedullary hematopoiesis: when the marrow can no longer function, the fetal sites — spleen and liver — are recruited back into service. Together these describe PRIMARY MYELOFIBROSIS.\\n\\nThe practical consequence is the exam point: when the aspirate is dry, the CORE BIOPSY is the specimen that still yields a diagnosis, because it removes an intact cylinder of bone and marrow regardless of whether the tissue can be aspirated. A reticulin stain on that core grades the fibrosis.\", \"wrongExplanations\": {\"0\": \"Complete fatty replacement describes severe aplastic anemia, and it is a genuine cause of a hypocellular aspirate. It does not fit the rest of the picture: aplastic anemia gives a SMALL or normal spleen and no teardrop cells or leukoerythroblastic smear, because there is no fibrosis to deform cells and nothing driving extramedullary hematopoiesis.\", \"2\": \"Dense lymphoid infiltration — as in chronic lymphocytic leukemia or a lymphoma involving the marrow — can produce a 'packed marrow' that aspirates poorly, so this is the best of the alternatives. It would not produce teardrop cells, and it would be expected to show lymphocytosis on the smear rather than the leukoerythroblastic pattern described.\", \"3\": \"Marrow necrosis does occur, typically in sickle cell disease or with widespread malignancy, and yields necrotic material rather than a true dry tap. It would not explain splenomegaly of this magnitude or the teardrop cells.\", \"4\": \"Granulomas, as in sarcoidosis or disseminated infection, are focal lesions found on the core biopsy and generally do not prevent aspiration of the surrounding marrow. They also do not cause teardrop poikilocytosis.\"}, \"eli5\": \"The marrow has turned to scar tissue, so nothing liquid can be sucked out with a needle. Red cells get squeezed out of shape into teardrops, and the spleen takes over making blood, so it grows huge.\", \"los\": [{\"n\": 29, \"t\": \"Given a clinical vignette with a presentation of anemia, differentiate clinical presentations based upon laboratory + bone marrow findings and correlate with the underlying pathophysiologic mechanisms.\", \"a\": \"s2-marrow\", \"s\": \"§2\"}, {\"n\": 38, \"t\": \"Given a clinical vignette, differentiate the myeloproliferative neoplasms/disorders based upon their clinical presentation, underlying pathophysiology including chromosomal mutations, labs and diagnostics and possible complications/prognosis.\", \"a\": \"s35-mpn\", \"s\": \"§39\"}]}, {\"stem\": \"A medical student centrifuges an anticoagulated tube of her own venous blood at 3,000 rpm for 10 minutes. Three layers are visible afterwards: an upper straw-coloured layer occupying 55% of the column, a lower dark red layer occupying 44% of the column, and a thin greyish-white layer approximately 1% of the column thickness that lies at the interface between them.\\n\\nThe thin interface layer is composed principally of which of the following?\", \"choices\": [\"A. Erythrocytes and reticulocytes\", \"B. Fibrinogen and clotting factors\", \"C. Leukocytes and platelets\", \"D. Lipoproteins and chylomicrons\", \"E. Plasma proteins and immunoglobulins\"], \"correct\": 2, \"explanation\": \"Spinning a tube of anticoagulated blood separates it by DENSITY, and the three layers map directly onto the three cellular compartments of the blood.\\n\\nBOTTOM (about 45%, the hematocrit) — ERYTHROCYTES, the densest element.\\nINTERFACE (about 1%) — the BUFFY COAT: LEUKOCYTES and PLATELETS, which are intermediate in density. Its greyish-white colour is what names it.\\nTOP (about 55%) — PLASMA: water, proteins, electrolytes and clotting factors. It should be straw-yellow.\\n\\nThis single tube is also a diagnostic map: the bottom layer is where the anemias and polycythemias live, the buffy coat is where the leukemias and leukopenias live, and the plasma is where the paraproteins and coagulation disorders live. A buffy coat that is visibly thick suggests marked leukocytosis, and plasma that is milky rather than straw-coloured indicates lipemia.\", \"wrongExplanations\": {\"0\": \"Erythrocytes and reticulocytes are the densest cellular elements and form the packed BOTTOM layer — the 44% dark red column described in the stem, which is the hematocrit.\", \"1\": \"Fibrinogen and the clotting factors are dissolved PROTEINS and remain in the plasma at the top. They would only form a separate layer if the blood had been allowed to clot, in which case the supernatant would be serum and would lack them altogether.\", \"3\": \"Lipoproteins and chylomicrons are the least dense components and float at the TOP of the plasma layer. In marked hypertriglyceridemia they make the plasma turbid and creamy rather than forming a discrete grey interface band.\", \"4\": \"Plasma proteins and immunoglobulins are dissolved in the upper straw-coloured layer and give it its colour and viscosity. They are not particulate and therefore cannot sediment into a discrete band.\"}, \"eli5\": \"Spinning blood separates it into heavy red cells at the bottom, watery plasma on top, and a thin pale stripe in between that holds the white cells and platelets.\", \"los\": [{\"n\": 2, \"t\": \"Categorize the adult stem cell hierarchy and identify the primary sites of adult hematopoiesis.\", \"a\": \"s1-hematopoiesis\", \"s\": \"§1\"}]}, {\"stem\": \"A 61-year-old man comes to the office because of a 4-month history of fatigue and shortness of breath when climbing stairs. He has no abdominal pain, change in bowel habits, or visible blood in his stool. He takes no medications, including over-the-counter analgesics. He eats a varied diet that includes red meat. Physical examination shows conjunctival pallor; the abdomen is soft and nontender. A single test of the stool for occult blood is negative.\\n\\nLaboratory studies show:\\n  Hemoglobin  10.4 g/dL (N=13.5–17.5 g/dL)\\n  Hematocrit  31% (N=41%–53%)\\n  Mean corpuscular volume  72 µm3 (N=80–100 µm3)\\n  Red cell distribution width  17.9% (N=11.5%–14.5%)\\n  Reticulocyte count  0.7% (N=0.5%–1.5%)\\n  Platelet count  468,000/mm3 (N=150,000–400,000/mm3)\\n  Serum iron  28 µg/dL (N=65–175 µg/dL)\\n  Total iron-binding capacity  452 µg/dL (N=250–400 µg/dL)\\n  Serum ferritin  7 ng/mL (N=20–250 ng/mL)\\n  Transferrin saturation  6% (N=20%–50%)\\nWhich of the following is the most appropriate next step in diagnosis?\", \"choices\": [\"A. Bidirectional endoscopy (colonoscopy and esophagogastroduodenoscopy)\", \"B. Bone marrow aspiration with Prussian blue stain\", \"C. Hemoglobin electrophoresis\", \"D. Serum erythropoietin concentration\", \"E. Serum lead concentration\"], \"correct\": 0, \"explanation\": \"Every value in the panel is one coherent row for IRON DEFICIENCY: microcytosis, a high red cell distribution width, low serum iron, HIGH total iron-binding capacity, a ferritin of 7 ng/mL, a transferrin saturation of 6%, and the reactive thrombocytosis that often accompanies it. The diagnosis is made. The question is where the iron went.\\n\\nThe review file calls this the single highest-yield sentence in the anemia lectures: iron deficiency in an ADULT MALE or a POSTMENOPAUSAL WOMAN is gastrointestinal blood loss until proven otherwise. He has no dietary explanation and no menstrual losses, so the leak must be found. Colorectal adenocarcinoma can present with iron deficiency and nothing else → the patient bleeds slowly into the stool without noticing → the loss is chronic and insidious. Iron deficiency is a symptom, not a final diagnosis.\\n\\nThe decoy is the NEGATIVE stool occult blood test. Bleeding from a colonic or gastric lesion is intermittent, so a single negative test does not exclude a gastrointestinal source. It does not change the need for endoscopic evaluation of both the upper and lower tract.\", \"wrongExplanations\": {\"1\": \"A marrow iron stain is the historical gold standard for iron stores, and would be the answer if the iron studies were contradictory — for example a normal ferritin in an inflamed patient. Here the ferritin of 7 ng/mL already proves the stores are empty, so an invasive procedure adds nothing and still does not find the bleeding source.\", \"2\": \"Hemoglobin electrophoresis would be the next step for microcytosis with NORMAL iron studies, a normal or high red cell count, and a normal red cell distribution width — the thalassemia trait profile. A ferritin of 7 ng/mL excludes that picture.\", \"3\": \"Erythropoietin measurement helps with unexplained hypoproliferative anemia, particularly in chronic kidney disease, or in the workup of polycythemia. It would not be informative once a definite iron deficiency has been demonstrated.\", \"4\": \"Lead poisoning also gives a microcytic anemia, but with basophilic stippling, abdominal pain or neurologic symptoms, an exposure history, and iron studies that are not deficient. This man has none of those, and his ferritin is profoundly low.\"}, \"eli5\": \"His blood is low on iron, and in a grown man iron does not just disappear — it leaks out as blood, usually from the gut. One clean stool test does not rule that out, so you look inside with a camera.\", \"explanationImage\": \"fig_ida_progression\", \"explanationImageCaption\": \"Laboratory changes with progressive iron deficiency: ferritin falls first, then serum iron and transferrin saturation, and only last do the MCV and hemoglobin fall.\", \"los\": [{\"n\": 49, \"t\": \"Given a clinical vignette, identify the important next steps in the differential diagnosis of iron deficiency anemia.\", \"a\": \"s4-iron\", \"s\": \"§4\"}, {\"n\": 20, \"t\": \"Differentiate clinical causes of nutritional anemias (iron, B12 + folate deficiency) by clinical presentation, etiologies, laboratory studies, and diagnostics.\", \"a\": \"s4-iron\", \"s\": \"§4\"}]}, {\"stem\": \"An 18-month-old boy is brought to the office by his mother because of pallor and irritability for 2 months. He drinks approximately 1.2 L (40 oz) of whole cow's milk daily and eats very little solid food. He was born at term and has no history of serious illness. He takes no medications. Physical examination shows pallor of the palmar creases and conjunctivae; there is no hepatosplenomegaly or jaundice.\\n\\nLaboratory studies show:\\n  Hemoglobin  8.1 g/dL (N=11.0–13.5 g/dL for age)\\n  Hematocrit  25% (N=33%–39% for age)\\n  Mean corpuscular volume  63 µm3 (N=70–86 µm3 for age)\\n  Red cell distribution width  18.6% (N=11.5%–14.5%)\\n  Reticulocyte count  0.8% (N=0.5%–1.5%)\\n  Platelet count  512,000/mm3 (N=150,000–400,000/mm3)\\nA peripheral blood smear is shown.\\n\\nWhich of the following best explains the small size of this patient's erythrocytes?\", \"choices\": [\"A. Accelerated splenic removal of membrane from circulating erythrocytes\", \"B. Additional divisions of erythroid precursors before the hemoglobin target is reached\", \"C. Impaired globin chain synthesis with precipitation of unpaired chains\", \"D. Loss of intracellular water through an abnormal cation leak\", \"E. Premature release of immature erythrocytes from the marrow\"], \"correct\": 1, \"explanation\": \"The history names the cause: a toddler drinking large volumes of cow's milk, which contains very little bioavailable iron, and eating little else. The smear and indices confirm it — small, pale cells with a wide central pallor and a high red cell distribution width.\\n\\nThe lead-in asks for the MECHANISM of the small size, which the review file states in one line. An erythroid precursor divides while it accumulates hemoglobin and STOPS dividing once it reaches a target hemoglobin concentration. Without iron → it cannot reach that concentration on schedule → it undergoes an extra division or two before maturing → each division halves the cell. One mechanism, two findings: MICROCYTIC and HYPOCHROMIC.\\n\\nContrast the megaloblastic anemias, where the cytoplasm matures normally but the nucleus cannot divide, so the cell ends up too BIG. Same organ, opposite direction — which is why the mean corpuscular volume splits the differential so cleanly.\", \"wrongExplanations\": {\"0\": \"Splenic removal of membrane produces SPHEROCYTES: the cell loses surface area, rounds up, loses its central pallor, and its hemoglobin concentration RISES. This smear shows the opposite — cells with an enlarged central pallor — and there is no splenomegaly or jaundice.\", \"2\": \"Impaired globin synthesis is the mechanism of thalassemia, which also gives small cells. It would be correct with target cells, a normal or high red cell count, a NORMAL red cell distribution width, and a family history — not in a toddler with an obvious dietary cause and a markedly wide distribution width.\", \"3\": \"Cation leak with red cell dehydration shrinks cells in conditions such as hereditary xerocytosis. It produces dense, hyperchromic cells with a raised hemoglobin concentration and signs of hemolysis, not pale cells with a low reticulocyte count.\", \"4\": \"Immature erythrocytes released early are reticulocytes, which are LARGER than mature cells, not smaller. A premature-release picture would come with a raised reticulocyte count; his is 0.8%.\"}, \"eli5\": \"A young red cell keeps dividing until it has filled up with enough hemoglobin. Without iron it never fills up in time, so it divides a couple of extra times — and every split makes it smaller.\", \"image\": \"fig_ida_smear\", \"imageCaption\": \"Peripheral blood smear. Most erythrocytes are smaller than the nucleus of the lymphocyte near the center of the field and show an enlarged zone of central pallor; scattered cells are irregular in shape.\", \"los\": [{\"n\": 20, \"t\": \"Differentiate clinical causes of nutritional anemias (iron, B12 + folate deficiency) by clinical presentation, etiologies, laboratory studies, and diagnostics.\", \"a\": \"s4-iron\", \"s\": \"§4\"}]}, {\"stem\": \"A 38-year-old woman comes to the office because of a 6-month history of fatigue. Three years ago she underwent Roux-en-Y gastric bypass for obesity. She has taken ferrous sulfate 325 mg by mouth daily for the past 6 months and reports taking every dose. Her menstrual periods are regular and light. Her only other medication is a daily multivitamin. Physical examination shows conjunctival pallor and well-healed laparoscopic scars.\\n\\nLaboratory studies show:\\n  Hemoglobin  9.6 g/dL (N=12.0–16.0 g/dL)\\n  Hematocrit  29% (N=36%–46%)\\n  Mean corpuscular volume  74 µm3 (N=80–100 µm3)\\n  Red cell distribution width  17.2% (N=11.5%–14.5%)\\n  Serum ferritin  6 ng/mL (N=10–120 ng/mL)\\n  Total iron-binding capacity  438 µg/dL (N=250–400 µg/dL)\\n  C-reactive protein  0.3 mg/dL (N=<1.0 mg/dL)\\n  Serum vitamin B12  610 pg/mL (N=200–900 pg/mL)\\nWhich of the following best explains the failure of oral iron therapy in this patient?\", \"choices\": [\"A. Bypass of the duodenum and proximal jejunum\", \"B. Decreased hepatic synthesis of transferrin\", \"C. Increased hepatic production of hepcidin\", \"D. Loss of intrinsic factor from gastric parietal cells\", \"E. Retention of absorbed iron within ileal enterocytes\"], \"correct\": 0, \"explanation\": \"Dietary iron is absorbed in the DUODENUM, and only as Fe²⁺, at roughly 1–2 mg per day. The review file lists what breaks that station: celiac disease, chronic diarrhea, gastrectomy and bariatric surgery, and acid suppression — anything that removes or bypasses the duodenum, or removes gastric acid.\\n\\nRoux-en-Y gastric bypass does both. Food passes from a small gastric pouch straight into the jejunum → the duodenum and proximal jejunum never see the iron → absorption fails no matter how faithfully the tablets are taken. The small pouch also produces little acid, so less Fe³⁺ is reduced to the absorbable Fe²⁺ form.\\n\\nThe panel rules out the alternatives. The pattern is pure iron deficiency — low ferritin, high total iron-binding capacity, high red cell distribution width. A normal C-reactive protein removes an inflammatory hepcidin block. Her menstrual losses are light, so there is no competing blood-loss explanation. Management is intravenous iron, which bypasses the gut entirely, with lifelong monitoring for both iron and B12 deficiency.\", \"wrongExplanations\": {\"1\": \"Transferrin synthesis actually INCREASES in iron deficiency, which is exactly why her total iron-binding capacity is high at 438 µg/dL. Decreased transferrin synthesis — a low binding capacity — is the pattern of inflammation or liver disease.\", \"2\": \"Increased hepcidin blocks iron export through ferroportin and is the mechanism of anemia of chronic disease. It would be correct with a high ferritin, a LOW binding capacity, and an elevated C-reactive protein. Her ferritin is 6 ng/mL and her C-reactive protein is normal.\", \"3\": \"Loss of intrinsic factor is the right consequence of gastric surgery but the WRONG VITAMIN — it causes B12 deficiency and a macrocytic anemia. Her B12 of 610 pg/mL is normal and her cells are microcytic.\", \"4\": \"Iron is absorbed proximally, not in the ileum; the ileum is where the B12–intrinsic factor complex is taken up. Trapping of absorbed iron within enterocytes is a hepcidin effect, which her normal inflammatory markers argue against.\"}, \"eli5\": \"Iron gets soaked up in the first part of the small intestine, right after the stomach. Her surgery rerouted food around that part, so the pills pass by the only place that could absorb them.\", \"los\": [{\"n\": 20, \"t\": \"Differentiate clinical causes of nutritional anemias (iron, B12 + folate deficiency) by clinical presentation, etiologies, laboratory studies, and diagnostics.\", \"a\": \"s4-iron\", \"s\": \"§4\"}]}, {\"stem\": \"A 72-year-old man is admitted to the hospital because of a flare of rheumatoid arthritis with swelling of both wrists and knees. For the past year he has taken naproxen 500 mg twice daily. He reports two episodes of black stools in the past month.\\n\\nLaboratory studies show:\\n  Hemoglobin  8.9 g/dL (N=13.5–17.5 g/dL)\\n  Hematocrit  27% (N=41%–53%)\\n  Mean corpuscular volume  76 µm3 (N=80–100 µm3)\\n  Reticulocyte count  0.6% (N=0.5%–1.5%)\\n  Serum iron  22 µg/dL (N=65–175 µg/dL)\\n  Total iron-binding capacity  310 µg/dL (N=250–400 µg/dL)\\n  Serum ferritin  95 ng/mL (N=20–250 ng/mL)\\n  Transferrin saturation  7% (N=20%–50%)\\n  C-reactive protein  6.8 mg/dL (N=<1.0 mg/dL)\\nWhich of the following findings would most reliably establish that this patient has depleted iron stores?\", \"choices\": [\"A. Absence of stainable iron on bone marrow aspirate\", \"B. Decrease in the reticulocyte count on repeat testing\", \"C. Low serum iron concentration\", \"D. Normal serum ferritin concentration\", \"E. Normal total iron-binding capacity\"], \"correct\": 0, \"explanation\": \"Two processes are running at once, and the panel is deliberately ambiguous because of it. The black stools and daily naproxen make GASTROINTESTINAL BLOOD LOSS likely. The rheumatoid flare and a C-reactive protein of 6.8 mg/dL make INFLAMMATION certain.\\n\\nFERRITIN IS AN ACUTE PHASE REACTANT. It rises in inflammation, infection, liver disease and malignancy regardless of iron stores → a genuinely iron-deficient patient who is also inflamed can show a normal ferritin. His ferritin of 95 ng/mL therefore cannot be trusted to say his stores are adequate. The total iron-binding capacity is caught between the two processes as well: deficiency pushes it up, inflammation pulls it down, and it lands in the middle.\\n\\nThe review file's rule for exactly this mixed picture: when the pattern is mixed, the transferrin saturation and a MARROW IRON STAIN settle it. Absent stainable iron in marrow macrophages on Prussian blue is the most direct evidence that stores are empty. In pure anemia of chronic disease, macrophage iron is INCREASED, so the stain separates the two cleanly.\", \"wrongExplanations\": {\"1\": \"The reticulocyte count is low in iron deficiency AND in anemia of chronic disease, because both are production defects. A falling count shows the marrow is under-producing but says nothing about why.\", \"2\": \"Serum iron is low in both conditions, so the review file states plainly that it discriminates nothing. It is the classic distractor in this comparison.\", \"3\": \"A normal ferritin is what this patient already has, and it is exactly the finding that CANNOT be trusted during active inflammation. Treating it as reassurance would miss a bleeding gastrointestinal lesion.\", \"4\": \"A normal total iron-binding capacity is the indeterminate result the two processes produce when they pull in opposite directions. Only a clearly HIGH value would argue for deficiency; normal leaves the question open.\"}, \"eli5\": \"When the body is inflamed, the blood test that usually measures stored iron goes up even if the tank is empty. Looking directly at the bone marrow for iron is the way to know for sure.\", \"los\": [{\"n\": 20, \"t\": \"Differentiate clinical causes of nutritional anemias (iron, B12 + folate deficiency) by clinical presentation, etiologies, laboratory studies, and diagnostics.\", \"a\": \"s4-iron\", \"s\": \"§4\"}, {\"n\": 53, \"t\": \"Given a clinical vignette, interpret laboratory and diagnostic studies as well as molecular genetics to distinguish various etiologies of anemia.\", \"a\": \"s6-aocd\", \"s\": \"§6\"}]}, {\"stem\": \"A 44-year-old woman is evaluated for fatigue 5 months after she was diagnosed with nodular sclerosis Hodgkin lymphoma. She has not yet started treatment. She has night sweats and has lost 5 kg (11 lb). Her menstrual periods are regular and light, and she has no history of gastrointestinal bleeding.\\n\\nLaboratory studies show:\\n  Hemoglobin  10.0 g/dL (N=12.0–16.0 g/dL)\\n  Hematocrit  30% (N=36%–46%)\\n  Mean corpuscular volume  83 µm3 (N=80–100 µm3)\\n  Reticulocyte count  0.5% (N=0.5%–1.5%)\\n  Erythrocyte sedimentation rate  64 mm/h (N=0–20 mm/h)\\nFurther studies of serum iron, serum ferritin, total iron-binding capacity, and marrow macrophage iron are planned, in that order.\\n\\nWhich of the following sets of findings is most likely?\", \"choices\": [\"A. Decreased, decreased, increased, absent\", \"B. Decreased, increased, decreased, increased\", \"C. Decreased, normal, normal, decreased\", \"D. Increased, increased, decreased, increased\", \"E. Normal, decreased, normal, decreased\"], \"correct\": 1, \"explanation\": \"A normocytic, hypoproliferative anemia developing months into a malignancy, with a high sedimentation rate and no source of blood loss, is ANEMIA OF CHRONIC DISEASE (anemia of inflammation). The review file lists its causes as chronic infections, chronic immune disorders, and neoplasms — Hodgkin disease by name — and notes it can appear as early as 1–2 months after disease onset.\\n\\nRead the row through the mechanism. Interleukin-6 → hepatic HEPCIDIN rises → ferroportin is destroyed → iron is locked inside macrophages and enterocytes.\\n• Serum iron DECREASED — none is circulating.\\n• Ferritin INCREASED — iron is stored, and ferritin is also an acute phase reactant.\\n• Total iron-binding capacity DECREASED — transferrin is a negative acute phase reactant, so there are fewer cups on the shelf.\\n• Marrow macrophage iron INCREASED — the iron is trapped exactly where hepcidin locked it.\\n\\nThe pair that separates this from iron deficiency is ferritin and total iron-binding capacity, which move in OPPOSITE directions in the two conditions.\", \"wrongExplanations\": {\"0\": \"This is the iron deficiency row: empty tank (low ferritin), extra empty cups (high binding capacity), and no marrow iron. It would be correct if she had heavy menses or gastrointestinal bleeding and a microcytic anemia.\", \"2\": \"Low-normal ferritin, an indeterminate binding capacity and REDUCED marrow iron is the COMBINED picture — iron deficiency and inflammation together. It would fit if she also had a source of chronic blood loss, which the stem excludes.\", \"3\": \"High serum iron, high ferritin, low binding capacity and increased marrow iron describe iron overload — hereditary hemochromatosis, transfusional overload or a sideroblastic anemia. The HIGH serum iron is the discriminator; in anemia of chronic disease serum iron is low.\", \"4\": \"Falling ferritin with a still-normal serum iron and binding capacity is the EARLIEST stage of iron depletion, before anemia develops. It cannot explain an established anemia, and it would not arise from an inflammatory process.\"}, \"eli5\": \"Inflammation makes the body hide its iron inside storage cells. The storage number looks high, but almost none of the iron is out in the blood where the marrow can use it.\", \"los\": [{\"n\": 19, \"t\": \"Differentiate clinical causes of anemias by clinical presentation, etiologies, laboratory studies, and diagnostics.\", \"a\": \"s6-aocd\", \"s\": \"§6\"}, {\"n\": 53, \"t\": \"Given a clinical vignette, interpret laboratory and diagnostic studies as well as molecular genetics to distinguish various etiologies of anemia.\", \"a\": \"s6-aocd\", \"s\": \"§6\"}]}, {\"stem\": \"A 71-year-old woman with a 20-year history of rheumatoid arthritis comes to the office for follow-up of anemia. For the past 3 months she has taken ferrous sulfate 325 mg by mouth daily, with no change in her hemoglobin concentration. Her joint disease remains active, with synovitis of both wrists.\\n\\nLaboratory studies show:\\n  Hemoglobin  9.6 g/dL (N=12.0–16.0 g/dL)\\n  Hematocrit  29% (N=36%–46%)\\n  Mean corpuscular volume  86 µm3 (N=80–100 µm3)\\n  Reticulocyte count  0.6% (N=0.5%–1.5%)\\n  Serum iron  31 µg/dL (N=50–170 µg/dL)\\n  Serum ferritin  340 ng/mL (N=10–120 ng/mL)\\n  Total iron-binding capacity  212 µg/dL (N=250–400 µg/dL)\\n  C-reactive protein  4.1 mg/dL (N=<1.0 mg/dL)\\nIncreased activity of which of the following best explains the lack of response to oral iron?\", \"choices\": [\"A. Divalent metal transporter 1\", \"B. Duodenal cytochrome b\", \"C. Ferroportin\", \"D. Hepcidin\", \"E. Transferrin receptor 1\"], \"correct\": 3, \"explanation\": \"High ferritin, low serum iron, low total iron-binding capacity, a normal MCV and active inflammation = ANEMIA OF CHRONIC DISEASE. The question is why the tablets did nothing.\\n\\nInflammation → interleukin-6 → the liver makes more HEPCIDIN → hepcidin binds FERROPORTIN, the only exit iron has from an enterocyte or a macrophage, and causes it to be internalized and destroyed → the doors are locked.\\n\\nThe review file's memory hook: hepcidin is the doorman who locks the exits. The iron is in the building; it cannot reach the marrow. That single image explains the whole picture — ferritin high because iron is stored, serum iron low because none is circulating — and the treatment failure: oral iron is absorbed into enterocytes and then cannot leave them, because the exit is gone. The management is to control the rheumatoid arthritis.\", \"wrongExplanations\": {\"0\": \"Divalent metal transporter 1 carries Fe²⁺ from the gut lumen INTO the enterocyte. Increasing its activity would improve iron uptake, not block it — and in this patient the problem is iron LEAVING the cell, not entering it.\", \"1\": \"Duodenal cytochrome b is the ferrireductase that reduces dietary Fe³⁺ to absorbable Fe²⁺. Increased activity would enhance absorption; its loss, as with acid suppression, is what would impair it.\", \"2\": \"Ferroportin is the right molecule but the wrong direction — the intended trap. Increased ferroportin would EXPORT more iron into plasma and improve her response. In anemia of chronic disease ferroportin activity is DECREASED, because hepcidin destroys it.\", \"4\": \"Transferrin receptor 1 brings transferrin-bound iron into erythroid precursors. Its expression rises when cells are iron-hungry, and increased activity would support erythropoiesis rather than prevent iron from reaching the marrow.\"}, \"eli5\": \"Inflammation tells the liver to make a hormone that locks the doors iron uses to leave the gut and the storage cells. Swallowing more iron just piles it up behind a locked door.\", \"explanationImage\": \"fig_hepcidin\", \"explanationImageCaption\": \"Hepcidin, made in the liver, inhibits ferroportin-1 on enterocytes and macrophages — the only exits for iron into the blood.\", \"los\": [{\"n\": 19, \"t\": \"Differentiate clinical causes of anemias by clinical presentation, etiologies, laboratory studies, and diagnostics.\", \"a\": \"s6-aocd\", \"s\": \"§6\"}]}, {\"stem\": \"A 66-year-old woman comes to the office because of a 4-month history of fatigue. She lives alone and eats a limited diet of toast, tea, and canned soup. She does not drink alcoholic beverages and takes no medications. Neurologic examination shows no abnormalities; vibration sense and proprioception are intact.\\n\\nLaboratory studies show:\\n  Hemoglobin  9.3 g/dL (N=12.0–16.0 g/dL)\\n  Hematocrit  28% (N=36%–46%)\\n  Mean corpuscular volume  114 µm3 (N=80–100 µm3)\\n  Leukocyte count  3,900/mm3 (N=4,500–11,000/mm3)\\n  Platelet count  142,000/mm3 (N=150,000–400,000/mm3)\\n  Reticulocyte count  0.6% (N=0.5%–1.5%)\\n  Serum vitamin B12  238 pg/mL (N=200–900 pg/mL)\\n  Serum folate  3.1 ng/mL (N=2.5–20 ng/mL)\\nA peripheral blood smear is shown.\\n\\nWhich of the following additional findings would most strongly indicate vitamin B12 deficiency as the cause of this patient's anemia?\", \"choices\": [\"A. Decreased serum haptoglobin concentration\", \"B. Increased red cell distribution width\", \"C. Increased serum homocysteine concentration\", \"D. Increased serum lactate dehydrogenase activity\", \"E. Increased serum methylmalonic acid concentration\"], \"correct\": 4, \"explanation\": \"Macro-ovalocytes and a hypersegmented neutrophil with pancytopenia mean defective DNA synthesis — B12 or folate. Both vitamin levels are at the bottom of their reference ranges, so the serum levels alone cannot decide which one is missing. A normal neurologic examination does not decide it either, because neurologic signs can lag behind the anemia.\\n\\nThe discriminator is the one metabolite only B12 controls. B12 has two jobs: it regenerates methionine from HOMOCYSTEINE (shared with folate), and it is the cofactor for methylmalonyl-CoA mutase, which converts METHYLMALONYL-CoA to succinyl-CoA (B12 only).\\n• Homocysteine rises in BOTH deficiencies → it only tells you that one of the two is missing.\\n• Methylmalonic acid rises in B12 deficiency ONLY → it names the vitamin.\\n\\nReview file memory hook: MMA rises with B12 — the M's go together. If you can order one test to separate them, order the methylmalonic acid.\", \"wrongExplanations\": {\"0\": \"A low haptoglobin reflects hemolysis, and megaloblastic anemias do lower it through intramedullary destruction of precursors. But this happens equally in B12 and folate deficiency, so it cannot discriminate between them.\", \"1\": \"A wide red cell distribution width shows anisocytosis. It is increased in both megaloblastic anemias, and in iron deficiency too, so it carries no information about which vitamin is missing.\", \"2\": \"Homocysteine is the tempting near-miss. It is elevated in B12 deficiency, but it is EQUALLY elevated in folate deficiency, because both vitamins are needed to convert homocysteine back to methionine. A raised value would be expected here whichever vitamin is deficient.\", \"3\": \"Lactate dehydrogenase rises from ineffective erythropoiesis in any megaloblastic anemia, and can be strikingly high. It confirms intramedullary cell death but is shared by both deficiencies.\"}, \"eli5\": \"Two vitamins are needed for one step in making DNA, so a shortage of either gives the same big red cells. Only B12 is also needed to clear a substance called methylmalonic acid, so if that is high, B12 is the one missing.\", \"image\": \"fig_hyperseg_uw\", \"imageCaption\": \"Peripheral blood smear. Many erythrocytes are large and oval. The neutrophil in the center of the field has a nucleus with six lobes.\", \"los\": [{\"n\": 20, \"t\": \"Differentiate clinical causes of nutritional anemias (iron, B12 + folate deficiency) by clinical presentation, etiologies, laboratory studies, and diagnostics.\", \"a\": \"s5-b12-folate\", \"s\": \"§5\"}, {\"n\": 53, \"t\": \"Given a clinical vignette, interpret laboratory and diagnostic studies as well as molecular genetics to distinguish various etiologies of anemia.\", \"a\": \"s5-b12-folate\", \"s\": \"§5\"}]}, {\"stem\": \"A 64-year-old man comes to the office because of a 6-week history of numbness in both feet and unsteadiness when walking, especially in the dark. Four months ago he was found to have a macrocytic anemia and was started on folic acid 1 mg daily by another physician; no further testing was performed. He feels less fatigued since starting treatment. Neurologic examination shows decreased vibration sense and proprioception in the toes and ankles, and a positive Romberg sign. Muscle strength and bulk are normal, with no fasciculations. Deep tendon reflexes are brisk at the knees, and plantar responses are extensor bilaterally. Pain and temperature sensation are intact.\\n\\nLaboratory studies show:\\n  Hemoglobin  13.9 g/dL (N=13.5–17.5 g/dL)\\n  Hematocrit  42% (N=41%–53%)\\n  Mean corpuscular volume  98 µm3 (N=80–100 µm3)\\n  Serum vitamin B12  104 pg/mL (N=200–900 pg/mL)\\n  Serum folate  18.2 ng/mL (N=2.5–20 ng/mL)\\nDegeneration of which of the following spinal cord structures is most likely responsible for this patient's findings?\", \"choices\": [\"A. Anterior horn cells\", \"B. Anterior white commissure\", \"C. Dorsal columns and lateral corticospinal tracts\", \"D. Dorsal columns only\", \"E. Lateral spinothalamic tracts\"], \"correct\": 2, \"explanation\": \"This is the complication the review file warns about by name: NEVER GIVE FOLATE ALONE TO A MACROCYTIC ANEMIA.\\n\\nB12 has two jobs; folate has one. Both feed DNA synthesis, so folate supplementation corrects the anemia of B12 deficiency — his hemoglobin has normalized and his MCV has nearly normalized. But ONLY B12 maintains the myelin surrounding neurons. Folate has no effect on that second job → the blood count recovers, everyone relaxes → the neurologic degeneration continues unopposed toward irreversibility.\\n\\nThe lesion is SUBACUTE COMBINED DEGENERATION: myelin degeneration of the DORSAL COLUMNS and the LATERAL CORTICOSPINAL TRACTS.\\n• Dorsal columns → loss of vibration and proprioception, sensory ataxia, positive Romberg sign.\\n• Lateral corticospinal tracts → upper motor neuron signs: brisk reflexes and extensor plantar responses.\\n\\nThe rule the review file gives: always check a B12 level before treating a megaloblastic anemia with folate. Treatment now is parenteral B12, and the neurologic deficits may not fully recover.\", \"wrongExplanations\": {\"0\": \"Anterior horn cell loss produces pure lower motor neuron findings — weakness, atrophy and fasciculations — with normal sensation, as in poliomyelitis. His strength and bulk are normal and his deficit is sensory.\", \"1\": \"The anterior white commissure is where crossing pain and temperature fibers are damaged in syringomyelia, giving a cape-like loss of pain and temperature. His pain and temperature sensation are explicitly intact.\", \"3\": \"Isolated dorsal column degeneration explains the lost vibration and proprioception and the Romberg sign, as in tabes dorsalis. It cannot explain the brisk knee reflexes and extensor plantar responses, which require corticospinal tract involvement.\", \"4\": \"The lateral spinothalamic tracts carry pain and temperature. Their involvement would produce contralateral loss of those modalities, which he does not have.\"}, \"eli5\": \"Folic acid fixed his blood count but cannot protect nerves — only B12 does that. So the anemia got better while the insulation around his spinal cord nerves kept wearing away.\", \"los\": [{\"n\": 20, \"t\": \"Differentiate clinical causes of nutritional anemias (iron, B12 + folate deficiency) by clinical presentation, etiologies, laboratory studies, and diagnostics.\", \"a\": \"s5-b12-folate\", \"s\": \"§5\"}]}, {\"stem\": \"A 58-year-old woman with Hashimoto thyroiditis and vitiligo comes to the office because of a 5-month history of fatigue and a sore tongue. Her only medication is levothyroxine. Examination shows a smooth, beefy-red tongue and patchy depigmentation of the hands.\\n\\nLaboratory studies show:\\n  Hemoglobin  8.8 g/dL (N=12.0–16.0 g/dL)\\n  Hematocrit  26% (N=36%–46%)\\n  Mean corpuscular volume  118 µm3 (N=80–100 µm3)\\n  Reticulocyte count  0.5% (N=0.5%–1.5%)\\n  Serum vitamin B12  92 pg/mL (N=200–900 pg/mL)\\n  Lactate dehydrogenase  780 U/L (N=45–200 U/L)\\nSerum anti-intrinsic factor antibodies are present. Upper endoscopy shows thin mucosa with loss of rugal folds in the gastric body and fundus; the antrum appears normal. She is treated with intramuscular vitamin B12, and her hemoglobin concentration returns to normal over 8 weeks.\\n\\nDespite normalization of her hemoglobin, this patient requires ongoing surveillance because she is at increased risk for which of the following?\", \"choices\": [\"A. Chronic lymphocytic leukemia\", \"B. Colorectal adenocarcinoma\", \"C. Gastric adenocarcinoma\", \"D. Hepatocellular carcinoma\", \"E. Pancreatic adenocarcinoma\"], \"correct\": 2, \"explanation\": \"PERNICIOUS ANEMIA is an autoimmune disease, not a diet problem. Autoimmune destruction of the gastric mucosa → loss of parietal cells in the BODY and FUNDUS → no intrinsic factor → no B12 absorption in the terminal ileum, however much B12 she eats. The associated autoimmune diseases (Hashimoto thyroiditis, vitiligo), the anti-intrinsic factor antibody, and atrophy sparing the antrum all point the same way.\\n\\nThe review file frames the lesson as THREE ORGANS, NOT ONE:\\n1. Megaloblastic anemia — from the B12 deficiency.\\n2. Gastric atrophy with intestinal metaplasia — from the immune-mediated destruction → an increased risk of GASTRIC CARCINOMA.\\n3. Central nervous system lesions — myelin degeneration of the dorsal and lateral columns.\\n\\nIntramuscular B12 fixes problem 1 and halts problem 3. It does nothing for problem 2 — the atrophic, metaplastic stomach remains, and with it the cancer risk. That is why these patients need ongoing surveillance after the blood count normalizes. Treating pernicious anemia means treating three problems.\", \"wrongExplanations\": {\"0\": \"Chronic lymphocytic leukemia is associated with autoimmune HEMOLYTIC anemia and immune thrombocytopenia, not with autoimmune gastritis. It would be suspected with a lymphocytosis and smudge cells, which are not described.\", \"1\": \"Colorectal adenocarcinoma is the surface-read answer: anemia in an adult prompts a search for a gastrointestinal cancer. That rule applies to IRON deficiency from blood loss. Her anemia is macrocytic from B12 malabsorption, and the organ at risk is the atrophic stomach, not the colon.\", \"3\": \"Hepatocellular carcinoma arises in cirrhosis from hepatitis B or C, alcohol or hemochromatosis. Nothing in her history or endoscopy points to chronic liver disease.\", \"4\": \"Pancreatic adenocarcinoma is not linked to autoimmune gastritis. Pancreatic insufficiency can impair B12 absorption by failing to free B12 from haptocorrin, but that is a cause of deficiency, not a consequence of pernicious anemia.\"}, \"eli5\": \"Her immune system attacked the part of her stomach that helps absorb B12. The shots fix the vitamin, but the damaged stomach lining stays damaged and has a higher chance of turning into cancer, so doctors keep checking it.\", \"los\": [{\"n\": 20, \"t\": \"Differentiate clinical causes of nutritional anemias (iron, B12 + folate deficiency) by clinical presentation, etiologies, laboratory studies, and diagnostics.\", \"a\": \"s5-b12-folate\", \"s\": \"§5\"}]}, {\"stem\": \"A 61-year-old man comes to the office because of a 3-month history of fatigue, mild confusion, and tingling in his fingers. His temperature is 36.8°C (98.2°F), pulse is 102/min, and blood pressure is 118/72 mm Hg. Examination shows pallor and mild scleral icterus. There is no splenomegaly.\\n\\nLaboratory studies show:\\n  Hemoglobin  7.4 g/dL (N=13.5–17.5 g/dL)\\n  Hematocrit  22% (N=41%–53%)\\n  Mean corpuscular volume  121 µm3 (N=80–100 µm3)\\n  Leukocyte count  3,600/mm3 (N=4,500–11,000/mm3)\\n  Platelet count  118,000/mm3 (N=150,000–400,000/mm3)\\n  Reticulocyte count  0.4% (N=0.5%–1.5%)\\n  Lactate dehydrogenase  1,450 U/L (N=45–200 U/L)\\n  Haptoglobin  22 mg/dL (N=30–200 mg/dL)\\n  Total bilirubin  2.1 mg/dL (N=0.1–1.0 mg/dL)\\n  Direct bilirubin  0.3 mg/dL (N=0.0–0.3 mg/dL)\\n  Serum vitamin B12  110 pg/mL (N=200–900 pg/mL)\\nA bone marrow aspirate is obtained; the marrow is hypercellular. A representative field is shown.\\n\\nWhich of the following best explains the combination of a hypercellular marrow and a low reticulocyte count?\", \"choices\": [\"A. Destruction of erythroid precursors within the marrow before release\", \"B. Failure of renal erythropoietin production\", \"C. Immune-mediated destruction of circulating erythrocytes in the spleen\", \"D. Replacement of hematopoietic tissue by marrow fibrosis\", \"E. Suppression of hematopoietic stem cells by cytotoxic T lymphocytes\"], \"correct\": 0, \"explanation\": \"The marrow is BUSY and the blood is EMPTY. That contradiction has one name: INEFFECTIVE ERYTHROPOIESIS.\\n\\nThe review file's single idea behind every megaloblastic finding is NUCLEAR–CYTOPLASMIC ASYNCHRONY. Hemoglobin synthesis in the cytoplasm proceeds normally, because it needs iron, not DNA. Nuclear maturation and cell division stall, because they need thymidine → which needs folate → which needs B12 to be regenerated. The cytoplasm outruns the nucleus. The aspirate shows the result: large precursors with fine, open chromatin.\\n\\nMany of those precursors cannot complete division and DIE INSIDE THE MARROW before release → hypercellular marrow (many cells produced) + low reticulocyte count (few released) + raised LDH and indirect bilirubin, with a lowered haptoglobin, from intramedullary cell death.\\n\\nThis is the trap: the hemolysis panel moves as a unit here, and a hurried reader calls it peripheral hemolysis. The LOW reticulocyte count is the buried clue that kills that reading. Peripheral destruction with an intact marrow drives the reticulocyte count UP; destruction inside the marrow does not.\", \"wrongExplanations\": {\"1\": \"Erythropoietin failure, as in chronic kidney disease, produces a HYPOCELLULAR or normocellular marrow with a normocytic anemia. Lack of the hormone means too few precursors are made — the opposite of this packed marrow.\", \"2\": \"Immune destruction in the spleen is extravascular hemolysis. With an intact marrow it drives a brisk RETICULOCYTOSIS and splenomegaly. His reticulocyte count is 0.4% and he has no splenomegaly, so the cells are dying before they ever reach the circulation.\", \"3\": \"Marrow fibrosis gives a dry tap, teardrop cells, a leukoerythroblastic smear and massive splenomegaly. The marrow was aspirated successfully and is hypercellular, not replaced.\", \"4\": \"T-cell suppression of stem cells is the mechanism of aplastic anemia, which gives a HYPOCELLULAR, fatty marrow with a normal-to-slightly-raised MCV and no hemolysis markers — the reverse of every marrow finding here.\"}, \"eli5\": \"His marrow is making plenty of young red cells, but they cannot finish dividing because they lack B12, so most of them die before they leave. The dying cells release chemicals into the blood that look like red cells breaking apart.\", \"image\": \"fig_megaloblastic_marrow\", \"imageCaption\": \"Bone marrow aspirate (high power). The field is highly cellular. Many precursor cells are enlarged, with nuclei showing finely dispersed, open chromatin, and several granulocytic cells are larger than expected.\", \"los\": [{\"n\": 20, \"t\": \"Differentiate clinical causes of nutritional anemias (iron, B12 + folate deficiency) by clinical presentation, etiologies, laboratory studies, and diagnostics.\", \"a\": \"s5-b12-folate\", \"s\": \"§5\"}, {\"n\": 29, \"t\": \"Given a clinical vignette with a presentation of anemia, differentiate clinical presentations based upon laboratory + bone marrow findings and correlate with the underlying pathophysiologic mechanisms.\", \"a\": \"s5-b12-folate\", \"s\": \"§5\"}]}, {\"stem\": \"A 67-year-old man with a 14-year history of type 2 diabetes mellitus comes to the office for routine follow-up. He reports increasing fatigue over the past year and numbness of both feet. His medications are amlodipine, aspirin, atorvastatin, lisinopril, and metformin 1,000 mg twice daily. He eats a diet that includes meat and dairy. He does not drink alcoholic beverages and has had no gastrointestinal surgery.\\n\\nLaboratory studies show:\\n  Hemoglobin  11.1 g/dL (N=13.5–17.5 g/dL)\\n  Hematocrit  33% (N=41%–53%)\\n  Mean corpuscular volume  106 µm3 (N=80–100 µm3)\\n  Hemoglobin A1c  7.1% (N=≤6%)\\n  Serum vitamin B12  162 pg/mL (N=200–900 pg/mL)\\n  Serum folate  11.4 ng/mL (N=2.5–20 ng/mL)\\n  Methylmalonic acid  0.92 µmol/L (N=0.08–0.40 µmol/L)\\nA peripheral blood smear shows oval macrocytes and hypersegmented neutrophils.\\n\\nWhich of the following medications is the most likely cause of this patient's anemia?\", \"choices\": [\"A. Amlodipine\", \"B. Aspirin\", \"C. Atorvastatin\", \"D. Lisinopril\", \"E. Metformin\"], \"correct\": 4, \"explanation\": \"Macrocytosis, hypersegmented neutrophils, a low B12 and a raised METHYLMALONIC ACID — with a normal folate — confirm VITAMIN B12 DEFICIENCY. He is not vegan, does not drink, and has no gastric or ileal surgery, so the review file's table of causes points to the drug-induced row.\\n\\nMETFORMIN interferes with CALCIUM-DEPENDENT uptake of the B12–intrinsic factor complex at the terminal ileum. Long-term, high-dose use — 14 years and 2 g daily here — produces a gradual deficiency.\\n\\nThe dramatic decoy is the numbness of his feet. In a man with long-standing diabetes it is easy to call that diabetic peripheral neuropathy and stop thinking. B12 deficiency ALSO causes a neuropathy and dorsal column loss, and the two can coexist. Patients on long-term metformin should have their B12 checked, particularly when neuropathy or anemia appears. The other drug on the review file's list is the proton pump inhibitor — without acid, B12 is never released from food protein.\", \"wrongExplanations\": {\"0\": \"Amlodipine causes peripheral edema and gingival hyperplasia. It has no effect on B12 absorption or DNA synthesis.\", \"1\": \"Aspirin causes gastrointestinal blood loss, which leads to IRON deficiency — a microcytic anemia with a low ferritin. His MCV is 106 µm3 with a raised methylmalonic acid, which is the opposite picture.\", \"2\": \"Atorvastatin is associated with myopathy and elevated liver enzymes. It does not impair B12 absorption and would not produce hypersegmented neutrophils.\", \"3\": \"Lisinopril can cause hyperkalemia, cough and angioedema, and angiotensin-converting enzyme inhibitors can modestly lower hemoglobin by reducing erythropoietin. That anemia is normocytic, without hypersegmented neutrophils or a raised methylmalonic acid.\"}, \"eli5\": \"His diabetes pill slowly blocks the gut from soaking up vitamin B12. After years of it, he ran low on B12 — which made his red cells big and can also numb his feet.\", \"los\": [{\"n\": 20, \"t\": \"Differentiate clinical causes of nutritional anemias (iron, B12 + folate deficiency) by clinical presentation, etiologies, laboratory studies, and diagnostics.\", \"a\": \"s5-b12-folate\", \"s\": \"§5\"}]}, {\"stem\": \"A 27-year-old woman comes to the office for a health maintenance examination. She plans to stop her oral contraceptive next month in order to conceive. She has never been pregnant. She has no history of serious illness, and there is no family history of congenital anomalies. She eats a balanced diet that includes leafy green vegetables. Vital signs are within normal limits, and physical examination shows no abnormalities.\\n\\nWhich of the following is the most appropriate recommendation regarding folic acid?\", \"choices\": [\"A. Begin folic acid 0.4 mg daily now, before attempting conception\", \"B. Begin folic acid 4 mg daily after the first positive pregnancy test\", \"C. Begin folic acid after an ultrasound confirms a viable intrauterine pregnancy\", \"D. Folic acid supplementation is unnecessary with a diet rich in green vegetables\", \"E. Measure serum folate and supplement only if the concentration is low\"], \"correct\": 0, \"explanation\": \"FOLATE IS THE KEY NUTRIENT FOR NEURAL TUBE CLOSURE. Supplementation prevents the neural tube defects spina bifida and anencephaly.\\n\\nThe timing is the whole point, and the review file states it directly. The neural tube closes at about 4 WEEKS after conception → often before a pregnancy is even recognized → by the time a pregnancy test turns positive, the window may already be closing. The recommendation is therefore to supplement BEFORE CONCEPTION, in all women of childbearing potential, not after a positive test.\\n\\nThe standard dose for a woman with no prior affected pregnancy is 0.4 mg daily. Pregnancy is also a state of increased folate requirement in its own right, which is why every prenatal vitamin contains more folic acid than a general multivitamin.\", \"wrongExplanations\": {\"1\": \"Four milligrams daily is the higher dose reserved for women who have had a PREVIOUS pregnancy affected by a neural tube defect. Starting after a positive test is also too late, because closure is complete around 4 weeks — often before a test would be positive.\", \"2\": \"Waiting for an ultrasound delays supplementation until well after the neural tube has already closed. It would miss the entire protective window.\", \"3\": \"Green vegetables are the richest dietary source of folate, which is why this distractor is tempting. Diet alone does not reliably supply the amount needed around conception, and the recommendation applies regardless of diet.\", \"4\": \"A serum folate level reflects recent intake and does not predict neural tube defect risk. Testing before supplementing adds delay and cost to an intervention that is cheap, safe and recommended for everyone planning pregnancy.\"}, \"eli5\": \"The baby's spinal cord forms in the first few weeks, before most people even know they are pregnant. Taking folic acid ahead of time makes sure it is already there when that happens.\", \"los\": [{\"n\": 18, \"t\": \"Describe why folic acid supplementation is needed during pregnancy.\", \"a\": \"s5-b12-folate\", \"s\": \"§5\"}]}, {\"stem\": \"A 34-year-old man with Crohn disease comes to the office because of a 3-month history of fatigue and tingling in his feet. Four years ago he underwent resection of 90 cm of terminal ileum for a stricture. He eats meat and dairy. He takes no medications and does not drink alcoholic beverages.\\n\\nLaboratory studies show:\\n  Hemoglobin  10.2 g/dL (N=13.5–17.5 g/dL)\\n  Hematocrit  31% (N=41%–53%)\\n  Mean corpuscular volume  109 µm3 (N=80–100 µm3)\\n  Serum vitamin B12  128 pg/mL (N=200–900 pg/mL)\\n  Serum folate  14.0 ng/mL (N=2.5–20 ng/mL)\\n  Methylmalonic acid  0.88 µmol/L (N=0.08–0.40 µmol/L)\\nSerum anti-intrinsic factor and anti-parietal cell antibodies are absent.\\n\\nAbsorption of vitamin B12 is impaired in this patient because of loss of which of the following?\", \"choices\": [\"A. Cubilin receptors on terminal ileal enterocytes\", \"B. Haptocorrin secreted in saliva\", \"C. Intrinsic factor secreted by gastric parietal cells\", \"D. Pancreatic proteases acting in the duodenum\", \"E. Transcobalamin II in the plasma\"], \"correct\": 0, \"explanation\": \"The review file describes B12 metabolism as a long road with many exits, and every station is a place a deficiency can start:\\n1. Stomach — acid and pepsin liberate B12 from food protein; salivary haptocorrin carries it onward.\\n2. Stomach — parietal cells secrete intrinsic factor.\\n3. Duodenum — pancreatic proteases split haptocorrin, freeing B12 to bind intrinsic factor.\\n4. TERMINAL ILEUM — the B12–intrinsic factor complex is absorbed via the CUBILIN receptor. This is the ONLY place it happens.\\n5. Blood — transcobalamin II delivers B12 to cells.\\n\\nResecting 90 cm of terminal ileum removes station 4. His stomach, pancreas and saliva are intact, and the absent antibodies exclude pernicious anemia — so intrinsic factor is being made and binding normally, but there is nowhere left to absorb the complex. The macrocytosis, low B12 and raised methylmalonic acid confirm the deficiency.\\n\\nThe historical Schilling test localized exactly this lesion: radiolabeled B12 is not absorbed in stage I, and adding intrinsic factor in stage II STILL does not correct it → the defect is at the terminal ileum, not the stomach.\", \"wrongExplanations\": {\"1\": \"Haptocorrin carries B12 through the stomach, but its loss is not a recognized cause of deficiency, and his salivary glands are unaffected by ileal surgery.\", \"2\": \"Loss of intrinsic factor is pernicious anemia or gastric surgery. It would be correct with anti-intrinsic factor or anti-parietal cell antibodies, or a gastrectomy. His antibodies are absent and his stomach is intact.\", \"3\": \"Pancreatic insufficiency does impair B12 absorption by failing to free B12 from haptocorrin, and would be correct in chronic pancreatitis or cystic fibrosis. His pancreas is untouched by the resection.\", \"4\": \"Transcobalamin II carries B12 in the plasma AFTER it has been absorbed. A congenital deficiency presents in infancy, and loss of it would not follow bowel resection.\"}, \"eli5\": \"Vitamin B12 can only get into the body at one specific spot at the end of the small intestine. That spot was removed in his surgery, so the vitamin passes straight through.\", \"explanationImage\": \"fig_b12_absorption\", \"explanationImageCaption\": \"Vitamin B12 absorption: release from food protein in the stomach, transfer from haptocorrin to intrinsic factor in the duodenum, uptake via cubilin in the ileum, and transport on transcobalamin II.\", \"los\": [{\"n\": 20, \"t\": \"Differentiate clinical causes of nutritional anemias (iron, B12 + folate deficiency) by clinical presentation, etiologies, laboratory studies, and diagnostics.\", \"a\": \"s5-b12-folate\", \"s\": \"§5\"}]}, {\"stem\": \"A 52-year-old man is evaluated for fatigue. He drinks six to eight cans of beer daily and eats one meal a day, consisting mostly of fast food. He takes no medications. Physical examination shows no jaundice, ascites, or spider angiomas; the liver edge is not palpable.\\n\\nLaboratory studies show:\\n  Hemoglobin  10.6 g/dL (N=13.5–17.5 g/dL)\\n  Hematocrit  32% (N=41%–53%)\\n  Mean corpuscular volume  112 µm3 (N=80–100 µm3)\\n  Leukocyte count  4,100/mm3 (N=4,500–11,000/mm3)\\n  Platelet count  131,000/mm3 (N=150,000–400,000/mm3)\\n  Aspartate aminotransferase  64 U/L (N=12–38 U/L)\\n  Alanine aminotransferase  38 U/L (N=10–40 U/L)\\nA peripheral blood smear is shown.\\n\\nThe neutrophil morphology shown is most specifically caused by which of the following?\", \"choices\": [\"A. Accelerated release of immature neutrophils from the marrow storage pool\", \"B. Excess membrane lipid deposition from altered hepatic cholesterol metabolism\", \"C. Impaired thymidine synthesis delaying nuclear maturation\", \"D. Inherited failure of normal nuclear lobation\", \"E. Toxic granulation from cytokine-stimulated granulopoiesis\"], \"correct\": 2, \"explanation\": \"Macrocytosis has a long differential — alcohol, liver disease, hypothyroidism, drugs, reticulocytosis — and this man could fit several. The smear narrows it.\\n\\nA normal neutrophil has three to five lobes. SIX OR MORE is a HYPERSEGMENTED neutrophil, and the review file calls it the giveaway: it says the problem is specifically DNA SYNTHESIS, which narrows you immediately to B12 or folate. In this man, heavy alcohol use and a poor diet make FOLATE deficiency the likely cause.\\n\\nThe mechanism is nuclear–cytoplasmic asynchrony. DNA synthesis needs thymidine → thymidine synthesis needs folate (and B12 to regenerate it) → without it, nuclear maturation stalls in every dividing cell → granulocyte precursors enlarge and their nuclei become abnormally segmented as they mature. The same defect produces the macro-ovalocytes and giant bands.\\n\\nThe decoy is the alcohol and the raised aspartate aminotransferase, which surface-read toward the macrocytosis of liver disease. That macrocytosis comes from lipid added to the red cell membrane, produces round macrocytes and target cells, and never segments a neutrophil's nucleus.\", \"wrongExplanations\": {\"0\": \"Accelerated release from the storage pool is a LEFT SHIFT — band forms and metamyelocytes with FEWER nuclear segments, as in bacterial infection. It moves the lobe count in the opposite direction.\", \"1\": \"Membrane lipid deposition is the mechanism of the round macrocytes and target cells of liver disease and alcohol use. It is the surface-read answer here, but it affects the red cell membrane and cannot change a neutrophil's nucleus.\", \"3\": \"Inherited failure of lobation is the Pelger–Huët anomaly, in which neutrophils are HYPOsegmented — typically bilobed, 'pince-nez' nuclei. It is the mirror image of what is shown.\", \"4\": \"Toxic granulation reflects cytokine-driven granulopoiesis in severe infection and inflammation, with coarse dark cytoplasmic granules and often Döhle bodies. It changes the cytoplasm, not the number of nuclear lobes.\"}, \"eli5\": \"This white cell's nucleus is split into too many pieces. That happens when a cell cannot build DNA properly, which is what low folate or B12 does — and heavy drinkers with poor diets often run out of folate.\", \"image\": \"fig_hyperseg\", \"imageCaption\": \"Peripheral blood smear (very high power). A large neutrophil with a nucleus divided into six lobes is surrounded by erythrocytes, several of which are oval.\", \"los\": [{\"n\": 20, \"t\": \"Differentiate clinical causes of nutritional anemias (iron, B12 + folate deficiency) by clinical presentation, etiologies, laboratory studies, and diagnostics.\", \"a\": \"s5-b12-folate\", \"s\": \"§5\"}]}, {\"stem\": \"A 61-year-old man with type 2 diabetes mellitus comes to the office because of fatigue. For 5 months he has had chronic osteomyelitis of the right calcaneus with a draining sinus tract, treated intermittently with oral antibiotics. He has no gastrointestinal symptoms. His temperature is 37.6°C (99.7°F), pulse is 88/min, and blood pressure is 132/80 mm Hg. Examination shows a 1-cm draining sinus over the right heel with surrounding erythema. Test of the stool for occult blood is negative.\\n\\nLaboratory studies show:\\n  Hemoglobin  10.3 g/dL (N=13.5–17.5 g/dL)\\n  Hematocrit  31% (N=41%–53%)\\n  Mean corpuscular volume  87 µm3 (N=80–100 µm3)\\n  Reticulocyte count  0.7% (N=0.5%–1.5%)\\n  Serum iron  34 µg/dL (N=65–175 µg/dL)\\n  Serum ferritin  410 ng/mL (N=20–250 ng/mL)\\n  Total iron-binding capacity  218 µg/dL (N=250–400 µg/dL)\\n  Erythrocyte sedimentation rate  88 mm/h (N=0–15 mm/h)\\nWhich of the following is the most appropriate management of this patient's anemia?\", \"choices\": [\"A. Erythropoiesis-stimulating agent therapy\", \"B. Intravenous iron sucrose\", \"C. Oral ferrous sulfate\", \"D. Surgical debridement with culture-directed antibiotic therapy\", \"E. Transfusion of packed red blood cells\"], \"correct\": 3, \"explanation\": \"A normocytic, hypoproliferative anemia with LOW serum iron, HIGH ferritin, LOW total iron-binding capacity and a sedimentation rate of 88 mm/h, in a patient with a 5-month chronic infection, is ANEMIA OF CHRONIC DISEASE. The review file lists chronic infections — osteomyelitis first among them — as a classic cause. It is the most common cause of anemia among hospitalized patients in the United States, and a diagnosis of exclusion.\\n\\nThe management rule is stated plainly because the instinct to 'treat the number' is so strong: TREAT THE UNDERLYING DISEASE. The anemia is driven by the inflammatory cytokine response, not by a shortage of iron → interleukin-6 raises hepcidin → iron is locked away → erythropoietin release and erythroid proliferation are blunted. Remove the stimulus and all four mechanisms switch off.\\n\\nFor chronic osteomyelitis with a draining sinus, that means surgical debridement of infected bone and antibiotics directed by bone culture. As the infection resolves, the hemoglobin recovers on its own.\", \"wrongExplanations\": {\"0\": \"Erythropoiesis-stimulating agents may be considered for symptomatic anemia of chronic disease, but the review file notes they are NOT FDA-approved for this indication and carry real safety concerns. They would be a second-line consideration after the infection is treated, not the primary management.\", \"1\": \"Intravenous iron bypasses the gut and is the right choice for a patient with true iron deficiency who cannot absorb oral iron. This man's ferritin of 410 ng/mL shows his stores are replete; the problem is iron release, not supply.\", \"2\": \"Oral iron generally does not help in anemia of chronic disease, because the enterocyte cannot export absorbed iron past a hepcidin-destroyed ferroportin. It would be correct only with a coexisting true iron deficiency, which his high ferritin and low binding capacity exclude.\", \"4\": \"Transfusion is reserved for severe or symptomatic anemia with hemodynamic compromise, active bleeding, or a much lower hemoglobin. He is stable at 10.3 g/dL with a correctable cause, so transfusion would add risk without addressing the problem.\"}, \"eli5\": \"His bone infection is keeping his body in fight mode, and fight mode switches off red cell making. Clear the infection and the blood count comes back by itself.\", \"los\": [{\"n\": 19, \"t\": \"Differentiate clinical causes of anemias by clinical presentation, etiologies, laboratory studies, and diagnostics.\", \"a\": \"s6-aocd\", \"s\": \"§6\"}]}, {\"stem\": \"A 25-year-old woman comes to the office because of a 3-month history of fatigue and shortness of breath when walking uphill. She reports an intense craving to chew ice. Her menstrual periods last 8 days with passage of clots. She has followed a vegetarian diet for 4 years. She has no gastrointestinal symptoms. Physical examination shows conjunctival pallor; the abdomen is nontender.\\n\\nLaboratory studies show:\\n  Hemoglobin  7.9 g/dL (N=12.0–16.0 g/dL)\\n  Hematocrit  24% (N=36%–46%)\\n  Mean corpuscular volume  71 µm3 (N=80–100 µm3)\\n  Red cell distribution width  18.2% (N=11.5%–14.5%)\\n  Platelet count  452,000/mm3 (N=150,000–400,000/mm3)\\n  Serum ferritin  4 ng/mL (N=10–120 ng/mL)\\n  Total iron-binding capacity  470 µg/dL (N=250–400 µg/dL)\\n  Transferrin saturation  5% (N=20%–50%)\\nOral ferrous sulfate is prescribed, and she is referred for gynecologic evaluation of her menstrual bleeding.\\n\\nWhich of the following is the most appropriate plan for the duration of oral iron therapy?\", \"choices\": [\"A. Continue for approximately 3 months after the hemoglobin concentration normalizes\", \"B. Discontinue once the hemoglobin concentration normalizes\", \"C. Discontinue once the ice craving resolves\", \"D. Discontinue once the reticulocyte count peaks\", \"E. Replace with dietary modification once the hemoglobin concentration reaches 10 g/dL\"], \"correct\": 0, \"explanation\": \"This is iron deficiency anemia from two mechanisms at once, exactly as the review file's case describes: chronic loss through MENORRHAGIA plus reduced intake of bioavailable iron on a VEGETARIAN diet. The craving to chew ice is PICA — specifically pagophagia — which is distinctive and highly suggestive of iron deficiency. The ferritin of 4 ng/mL settles the diagnosis.\\n\\nThe lead-in is about DURATION, and the principle is that there are two pools to refill, in order:\\n1. Functional iron — hemoglobin in circulating erythrocytes. This recovers first, over roughly 6–8 weeks.\\n2. Storage iron — ferritin and hemosiderin in liver and macrophages. This was the FIRST pool to empty and is the LAST to refill.\\n\\nStopping when the hemoglobin normalizes leaves the stores empty → the next heavy period tips her straight back into anemia. So iron is continued for about 3 months after the hemoglobin normalizes to replete stores. The review file adds the other half of management: diet alone will not correct an established deficiency, and the cause of the loss must be addressed.\\n\\nNote the discrimination the review file makes: in a premenopausal woman with an obvious gynecologic source, a gastrointestinal workup is NOT automatic. The adult-male and postmenopausal rule does not apply here.\", \"wrongExplanations\": {\"1\": \"Stopping at a normal hemoglobin is the most common error in practice. The hemoglobin recovers before the storage pool does, so the stores are still empty at that point and the anemia recurs with ongoing menstrual losses.\", \"2\": \"Pica often resolves within days to weeks of starting iron — well before the hemoglobin has recovered, let alone the stores. It is a useful early sign of response, not an endpoint for therapy.\", \"3\": \"The reticulocyte count peaks at about 7–10 days, which confirms that the diagnosis is right and the patient is absorbing the iron. Stopping then would leave both the hemoglobin and the stores uncorrected.\", \"4\": \"The review file states directly that diet alone will not correct an established deficiency. A vegetarian diet also supplies mostly nonheme iron, which is less well absorbed than heme iron.\"}, \"eli5\": \"Her body uses iron first to rebuild the blood, and only after that to refill its storage tank. If she stops when her blood count looks normal, the tank is still empty and the anemia comes back.\", \"explanationImage\": \"fig_ida_smear_uw\", \"explanationImageCaption\": \"Iron deficiency anemia: microcytic, hypochromic erythrocytes with enlarged central pallor.\", \"los\": [{\"n\": 20, \"t\": \"Differentiate clinical causes of nutritional anemias (iron, B12 + folate deficiency) by clinical presentation, etiologies, laboratory studies, and diagnostics.\", \"a\": \"s4-iron\", \"s\": \"§4\"}, {\"n\": 49, \"t\": \"Given a clinical vignette, identify the important next steps in the differential diagnosis of iron deficiency anemia.\", \"a\": \"s4-iron\", \"s\": \"§4\"}]}, {\"stem\": \"A 29-year-old woman calls the office 2 weeks after starting ferrous sulfate 325 mg daily for iron deficiency anemia caused by heavy menstrual bleeding. She reports that her stools have turned very dark and that she has mild constipation. She has no abdominal pain, nausea, vomiting, lightheadedness, or hematemesis. She takes no other medications or over-the-counter products. She is seen the same day. Her pulse is 74/min and blood pressure is 116/72 mm Hg, without orthostatic change. The abdomen is soft and nontender. Rectal examination shows formed, dark green-black stool that is not tarry. Two weeks ago her hemoglobin concentration was 8.6 g/dL and her reticulocyte count was 0.8%.\\n\\nLaboratory studies today show:\\n  Hemoglobin  9.4 g/dL (N=12.0–16.0 g/dL)\\n  Hematocrit  28% (N=36%–46%)\\n  Reticulocyte count  4.8% (N=0.5%–1.5%)\\nWhich of the following is the most likely explanation for the change in her stool color?\", \"choices\": [\"A. Bismuth subsalicylate ingestion\", \"B. Bleeding duodenal ulcer\", \"C. Esophageal variceal hemorrhage\", \"D. Iron-induced stool discoloration\", \"E. Right-sided colon carcinoma\"], \"correct\": 3, \"explanation\": \"Unabsorbed oral iron is excreted in the stool and turns it DARK GREEN-BLACK. The review file lists black stools among the expected adverse effects of oral iron — alongside nausea, constipation and a metallic taste — and names them as the main reason patients stop taking it. Warning her up front is part of prescribing it.\\n\\nThe buried clues separate this from melena:\\n• The stool is FORMED and NOT TARRY. Melena from upper gastrointestinal bleeding is sticky, tarry and foul-smelling, because hemoglobin is digested.\\n• She is HEMODYNAMICALLY STABLE with no orthostatic change.\\n• Most decisively, she is RESPONDING. Her reticulocyte count has risen from 0.8% to 4.8% and her hemoglobin from 8.6 to 9.4 g/dL. The review file says to expect a reticulocyte rise within about a week if treatment is working, and a patient who was actively bleeding enough to blacken her stool would not be gaining hemoglobin.\\n\\nManagement is reassurance and continuing the iron. Constipation is managed symptomatically, or by taking the dose with food at the cost of some absorption.\", \"wrongExplanations\": {\"0\": \"Bismuth subsalicylate also turns stool black and is a classic cause of 'pseudomelena'. It would be correct if she were taking an over-the-counter antidiarrheal, but the stem states she takes no other medications or over-the-counter products.\", \"1\": \"A bleeding duodenal ulcer causes true melena — tarry, sticky stool — usually with epigastric pain, NSAID use, or hemodynamic change. A falling, not rising, hemoglobin would be expected.\", \"2\": \"Variceal hemorrhage is an upper gastrointestinal emergency in cirrhosis, with hematemesis, melena and hemodynamic instability. Nothing in her history suggests liver disease, and she is stable with a rising hemoglobin.\", \"4\": \"Right-sided colon carcinoma causes chronic occult blood loss and iron deficiency, but in older adults and generally without visible black stool. Her anemia already has a gynecologic explanation, and her rapid response to iron argues against ongoing loss.\"}, \"eli5\": \"Iron pills that do not get absorbed come out in the stool and turn it very dark. Her blood count is already going up, which shows the iron is working and she is not bleeding.\", \"los\": [{\"n\": 20, \"t\": \"Differentiate clinical causes of nutritional anemias (iron, B12 + folate deficiency) by clinical presentation, etiologies, laboratory studies, and diagnostics.\", \"a\": \"s4-iron\", \"s\": \"§4\"}]}, {\"stem\": \"A 34-year-old man comes to a blood donation center for his scheduled donation. He has donated a unit of whole blood every 8 weeks for the past 3 years. He feels well and has no symptoms. He eats a varied diet that includes red meat. Physical examination shows no abnormalities.\\n\\nLaboratory studies show:\\n  Hemoglobin  14.6 g/dL (N=13.5–17.5 g/dL)\\n  Hematocrit  44% (N=41%–53%)\\n  Mean corpuscular volume  88 µm3 (N=80–100 µm3)\\n  Red cell distribution width  13.1% (N=11.5%–14.5%)\\n  Serum iron  82 µg/dL (N=65–175 µg/dL)\\n  Total iron-binding capacity  372 µg/dL (N=250–400 µg/dL)\\n  Transferrin saturation  22% (N=20%–50%)\\n  Serum ferritin  9 ng/mL (N=20–250 ng/mL)\\nWhich of the following best describes this patient's iron status?\", \"choices\": [\"A. Anemia of chronic disease\", \"B. Depleted iron stores without iron-deficient erythropoiesis\", \"C. Established iron deficiency anemia\", \"D. Iron-deficient erythropoiesis without anemia\", \"E. Normal iron status\"], \"correct\": 1, \"explanation\": \"Every value here is normal EXCEPT the ferritin. That pattern describes the first stage of iron deficiency.\\n\\nThe review file's map of where iron sits explains why ferritin moves first. About 80% of body iron is FUNCTIONAL — mostly hemoglobin in circulating erythrocytes. About 20% is STORAGE — ferritin and hemosiderin in liver and macrophages, roughly 1,000 mg in a man. When iron is lost faster than it is absorbed, the body spends STORES first to protect hemoglobin. So deficiency progresses in a fixed order:\\n1. DEPLETED STORES — ferritin falls; serum iron, transferrin saturation, MCV and hemoglobin all still normal. ← this donor\\n2. Iron-deficient erythropoiesis — serum iron and transferrin saturation fall too; hemoglobin still normal.\\n3. Iron deficiency anemia — MCV and hemoglobin finally fall.\\n\\nThe review file's memory hook: ferritin is the fuel gauge, the earliest thing to fall, before the hemoglobin ever moves; transferrin saturation is the fuel line. His gauge reads empty while fuel still reaches the engine. Each unit of whole blood removes roughly 200–250 mg of iron, so donation every 8 weeks outpaces absorption of 1–2 mg per day. He should defer donation or take iron supplements.\", \"wrongExplanations\": {\"0\": \"Anemia of chronic disease requires anemia and inflammation, and it RAISES ferritin. This man has a normal hemoglobin, no illness, and a low ferritin — the opposite pattern.\", \"2\": \"Established iron deficiency anemia requires a low hemoglobin and microcytosis. His hemoglobin of 14.6 g/dL and MCV of 88 µm3 are normal — that stage is still ahead of him if donation continues.\", \"3\": \"Iron-deficient erythropoiesis is the next stage, marked by a falling serum iron and a transferrin saturation below normal. His transferrin saturation is 22%, still within range, so the fuel line is not yet affected.\", \"4\": \"A normal hemoglobin is the surface-read that makes this look normal. His ferritin of 9 ng/mL is below the reference range, and ferritin is the earliest and most sensitive marker of iron stores.\"}, \"eli5\": \"The body keeps a reserve tank of iron and uses it up before letting the blood count drop. His blood count is fine, but his reserve tank is almost empty from giving blood so often.\", \"explanationImage\": \"fig_ida_progression\", \"explanationImageCaption\": \"Laboratory changes with progressive iron deficiency: decreased storage first (ferritin alone), then iron-limited erythropoiesis, then anemia.\", \"los\": [{\"n\": 20, \"t\": \"Differentiate clinical causes of nutritional anemias (iron, B12 + folate deficiency) by clinical presentation, etiologies, laboratory studies, and diagnostics.\", \"a\": \"s4-iron\", \"s\": \"§4\"}]}, {\"stem\": \"A 26-year-old woman comes to the office for follow-up of iron deficiency anemia. She has taken ferrous sulfate 325 mg by mouth daily as directed for 4 months, with no improvement. Her menstrual periods are regular and light. For 2 years she has had intermittent bloating and loose stools. She has an itchy rash on her elbows and knees. She eats a diet that includes meat and has not traveled outside the United States. Physical examination shows clustered, excoriated papules and vesicles on the extensor surfaces of both elbows and knees. A test of the stool for occult blood is negative.\\n\\nLaboratory studies show:\\n  Hemoglobin  9.8 g/dL (N=12.0–16.0 g/dL)\\n  Hematocrit  30% (N=36%–46%)\\n  Mean corpuscular volume  73 µm3 (N=80–100 µm3)\\n  Serum ferritin  5 ng/mL (N=10–120 ng/mL)\\n  Total iron-binding capacity  448 µg/dL (N=250–400 µg/dL)\\n  Serum folate  2.2 ng/mL (N=2.5–20 ng/mL)\\nWhich of the following is the most appropriate next step in diagnosis?\", \"choices\": [\"A. Colonoscopy\", \"B. Hemoglobin electrophoresis\", \"C. Serum anti-tissue transglutaminase IgA and total IgA concentrations\", \"D. Serum lead concentration\", \"E. Stool examination for ova and parasites\"], \"correct\": 2, \"explanation\": \"Iron deficiency that FAILS TO RESPOND to adequate oral iron in a patient who takes it faithfully means the iron is not getting in. The review file lists the causes of impaired absorption: celiac disease, chronic diarrhea, gastrectomy and bariatric surgery, and acid suppression — anything that removes or damages the DUODENUM.\\n\\nThis patient has the full picture of CELIAC DISEASE:\\n• Chronic bloating and loose stools.\\n• An itchy vesicular rash on the extensor surfaces — dermatitis herpetiformis.\\n• Iron deficiency refractory to oral iron — the duodenum, where iron is absorbed as Fe²⁺, is the most affected segment.\\n• A LOW FOLATE as well — folate is also absorbed proximally, so a combined iron-and-folate deficiency points at the proximal small bowel.\\n\\nThe review file's rule is that iron deficiency is a symptom, not a final diagnosis — always ask where the iron went. Here the iron was never absorbed. The first test is serologic: anti-tissue transglutaminase IgA, with a total IgA level, because selective IgA deficiency is more common in celiac disease and would give a false-negative result. A positive test is confirmed by duodenal biopsy showing villous atrophy.\", \"wrongExplanations\": {\"0\": \"Colonoscopy is the right next step for iron deficiency in an adult man or a postmenopausal woman, where gastrointestinal blood loss must be excluded. She is 26, her stool is negative for occult blood, and her history points to malabsorption rather than bleeding.\", \"1\": \"Hemoglobin electrophoresis is for microcytosis with NORMAL iron studies — the thalassemia trait picture. Her ferritin of 5 ng/mL proves true iron deficiency.\", \"3\": \"Lead poisoning causes microcytic anemia with basophilic stippling and an exposure history, and does not lower ferritin or cause a vesicular rash. It would be correct in a child with pica for paint chips or a worker with occupational exposure.\", \"4\": \"Hookworm infection is a major cause of iron deficiency worldwide through intestinal blood loss. She has not traveled, her stool is negative for occult blood, and hookworm would not explain the rash or the low folate.\"}, \"eli5\": \"Her iron pills are not working because the first part of her small intestine, where iron is soaked up, is damaged. The rash and stomach trouble point to gluten causing that damage, and a blood test checks for it first.\", \"explanationImage\": \"fig_celiac_duodenum\", \"explanationImageCaption\": \"Normal duodenum with tall villi (left) compared with celiac disease showing villous atrophy (right).\", \"los\": [{\"n\": 49, \"t\": \"Given a clinical vignette, identify the important next steps in the differential diagnosis of iron deficiency anemia.\", \"a\": \"s4-iron\", \"s\": \"§4\"}, {\"n\": 20, \"t\": \"Differentiate clinical causes of nutritional anemias (iron, B12 + folate deficiency) by clinical presentation, etiologies, laboratory studies, and diagnostics.\", \"a\": \"s4-iron\", \"s\": \"§4\"}]}, {\"stem\": \"A 72-year-old woman comes to the office because of a 6-month history of fatigue and tingling in both feet. For the past 11 years she has taken omeprazole 40 mg daily for gastroesophageal reflux disease. She eats a diet that includes meat and dairy, does not drink alcoholic beverages, and has had no abdominal surgery. Serum anti-intrinsic factor and anti-parietal cell antibodies are absent.\\n\\nLaboratory studies show:\\n  Hemoglobin  10.8 g/dL (N=12.0–16.0 g/dL)\\n  Hematocrit  32% (N=36%–46%)\\n  Mean corpuscular volume  108 µm3 (N=80–100 µm3)\\n  Serum vitamin B12  168 pg/mL (N=200–900 pg/mL)\\n  Serum folate  9.8 ng/mL (N=2.5–20 ng/mL)\\n  Methylmalonic acid  0.74 µmol/L (N=0.08–0.40 µmol/L)\\nImpaired vitamin B12 absorption in this patient most likely results from failure at which of the following steps?\", \"choices\": [\"A. Binding of vitamin B12 to intrinsic factor in the duodenum\", \"B. Release of vitamin B12 from dietary protein in the stomach\", \"C. Secretion of intrinsic factor by gastric parietal cells\", \"D. Transfer of vitamin B12 to transcobalamin II in the plasma\", \"E. Uptake of the vitamin B12–intrinsic factor complex by ileal cubilin receptors\"], \"correct\": 1, \"explanation\": \"The review file walks vitamin B12 along a long road with many exits. The first station is in the STOMACH: dietary B12 arrives bound to food protein, and GASTRIC ACID and PEPSIN are what liberate it so it can be picked up by haptocorrin and later intrinsic factor.\\n\\nA proton pump inhibitor removes acid → pepsinogen is not activated → B12 is NEVER RELEASED from food protein → it passes through unabsorbed. The review file lists proton pump inhibitors by name among drug-induced causes, with exactly this mechanism. After 11 years of daily omeprazole she has a macrocytic anemia, a low B12 and a raised methylmalonic acid, with antibodies ruling out pernicious anemia.\\n\\nThis is the trap: parietal cells make BOTH acid and intrinsic factor — the review file tells you to remember that pairing. A proton pump inhibitor blocks the acid pump but leaves intrinsic factor secretion intact. The failure is upstream of intrinsic factor, at the release step.\\n\\nA practical corollary: crystalline B12 in supplements is not protein-bound, so it does not need acid to be released and is absorbed normally in these patients.\", \"wrongExplanations\": {\"0\": \"Binding to intrinsic factor in the duodenum requires pancreatic proteases to cleave haptocorrin first. It fails in pancreatic insufficiency — chronic pancreatitis or cystic fibrosis — which nothing in her history suggests.\", \"2\": \"Loss of intrinsic factor secretion is pernicious anemia or gastrectomy. The shared parietal cell makes this the near-miss, but proton pump inhibitors block the acid pump, not intrinsic factor, and her antibodies are absent.\", \"3\": \"Transcobalamin II carries B12 in the plasma AFTER absorption. Congenital deficiency presents in infancy; acid suppression has no effect on it.\", \"4\": \"Ileal uptake through cubilin fails with terminal ileal resection or Crohn disease, and metformin interferes with this calcium-dependent step. She has no ileal disease and takes no metformin.\"}, \"eli5\": \"Vitamin B12 in food is stuck to protein, and stomach acid is what pries it loose. Her acid-blocking pill stops that from happening, so the vitamin stays stuck and passes straight through.\", \"explanationImage\": \"fig_b12_absorption\", \"explanationImageCaption\": \"Vitamin B12 absorption: HCl and pepsin release cobalamin from food protein in the stomach; later steps require intrinsic factor, pancreatic trypsin, ileal cubilin and transcobalamin II.\", \"los\": [{\"n\": 20, \"t\": \"Differentiate clinical causes of nutritional anemias (iron, B12 + folate deficiency) by clinical presentation, etiologies, laboratory studies, and diagnostics.\", \"a\": \"s5-b12-folate\", \"s\": \"§5\"}]}, {\"stem\": \"A 45-year-old man comes to the office because of a 5-month history of fatigue and numbness in his hands. He lives near Lake Superior and frequently eats pike and perch that he catches, cures, and eats raw. He has occasionally noticed flat, ribbon-like segments in his stool. He eats a diet that includes meat and dairy, does not drink alcoholic beverages, and has had no abdominal surgery. Serum anti-intrinsic factor antibodies are absent.\\n\\nLaboratory studies show:\\n  Hemoglobin  10.9 g/dL (N=13.5–17.5 g/dL)\\n  Hematocrit  33% (N=41%–53%)\\n  Mean corpuscular volume  110 µm3 (N=80–100 µm3)\\n  Serum vitamin B12  140 pg/mL (N=200–900 pg/mL)\\n  Serum folate  12.0 ng/mL (N=2.5–20 ng/mL)\\n  Methylmalonic acid  0.81 µmol/L (N=0.08–0.40 µmol/L)\\nWhich of the following infectious agents is the most likely cause of this patient's vitamin B12 deficiency?\", \"choices\": [\"A. Ascaris lumbricoides\", \"B. Diphyllobothrium latum\", \"C. Giardia lamblia\", \"D. Necator americanus\", \"E. Taenia solium\"], \"correct\": 1, \"explanation\": \"Vitamin B12 deficiency with an intact stomach, no ileal disease, an adequate diet and absent antibodies needs another explanation. The review file lists COMPETITIVE UPTAKE as a cause — something in the gut consumes the B12 before the patient can absorb it.\\n\\nThe fish tapeworm, DIPHYLLOBOTHRIUM LATUM, is acquired by eating RAW or undercooked FRESHWATER FISH containing larvae → the adult worm lives in the small intestine, can grow to several meters, and sheds flat ribbon-like proglottids in the stool → it absorbs vitamin B12 avidly, competing with the host → megaloblastic anemia and, eventually, neurologic signs.\\n\\nThe two buried clues are the raw cured freshwater fish from the Great Lakes region and the ribbon-like segments. The review file's other competitive-uptake cause is intestinal bacterial overgrowth, which would be suggested by blind loops, strictures or dysmotility. Treatment is praziquantel with B12 replacement.\", \"wrongExplanations\": {\"0\": \"Ascaris is a roundworm acquired from fecally contaminated soil. Heavy infection causes intestinal or biliary obstruction and malnutrition in children, and the passed worms are round and earthworm-like, not flat segments.\", \"2\": \"Giardia is acquired from contaminated water and causes foul-smelling fatty diarrhea and malabsorption of fats and fat-soluble vitamins. It is a protozoan, so no worm segments would be seen, and B12 deficiency is not its characteristic consequence.\", \"3\": \"Necator americanus, a hookworm, penetrates the skin from soil and feeds on blood in the small intestine. It causes IRON deficiency — a microcytic anemia — which is the opposite of this patient's macrocytosis.\", \"4\": \"Taenia solium, the pork tapeworm, is also a flat worm that sheds segments, which makes it the near-miss. It is acquired from undercooked pork, its danger is cysticercosis of the brain and muscle, and it does not cause B12 deficiency.\"}, \"eli5\": \"Eating raw lake fish gave him a very long tapeworm living in his gut. The worm eats up the vitamin B12 from his food before his body can absorb it.\", \"los\": [{\"n\": 20, \"t\": \"Differentiate clinical causes of nutritional anemias (iron, B12 + folate deficiency) by clinical presentation, etiologies, laboratory studies, and diagnostics.\", \"a\": \"s5-b12-folate\", \"s\": \"§5\"}]}, {\"stem\": \"A 59-year-old man is evaluated for a macrocytic anemia with a serum vitamin B12 concentration of 96 pg/mL (N=200–900 pg/mL). A Schilling test is performed. An intramuscular injection of unlabeled vitamin B12 is first given to saturate body binding sites, so that any absorbed oral B12 is excreted in the urine. He then takes an oral dose of radiolabeled vitamin B12, and urine is collected for 24 hours; only 1% of the radiolabeled dose is recovered (N=>8%). One week later, the test is repeated with the oral radiolabeled vitamin B12 given together with exogenous intrinsic factor, and 15% of the dose is recovered in the urine.\\n\\nWhich of the following is the most likely cause of this patient's vitamin B12 deficiency?\", \"choices\": [\"A. Autoimmune destruction of gastric parietal cells\", \"B. Bacterial overgrowth in the small intestine\", \"C. Chronic pancreatitis with exocrine insufficiency\", \"D. Inadequate dietary intake of animal products\", \"E. Resection of the terminal ileum\"], \"correct\": 0, \"explanation\": \"The Schilling test is no longer performed, but the review file keeps it because it localizes a B12 absorption defect better than any single modern test — it teaches the anatomy.\\n\\nThe logic:\\n• The unlabeled injection saturates binding sites → any radiolabeled B12 that is ABSORBED spills into the urine.\\n• STAGE I (oral B12 alone): 1% recovered → the oral dose was NOT absorbed. That already excludes a purely dietary cause, where absorption is normal.\\n• STAGE II (oral B12 plus intrinsic factor): excretion NORMALIZES to 15% → supplying intrinsic factor fixed the problem → the missing ingredient was INTRINSIC FACTOR → PERNICIOUS ANEMIA.\\n\\nIf stage II had still been abnormal, the defect would lie beyond intrinsic factor — at the terminal ileum (ileitis, resection) or in the lumen (bacterial overgrowth, fish tapeworm). Pernicious anemia is autoimmune destruction of the gastric mucosa with loss of the parietal cells that make intrinsic factor.\", \"wrongExplanations\": {\"1\": \"Bacterial overgrowth consumes B12 in the lumen, so adding intrinsic factor does NOT correct stage II. Excretion would normalize only after a course of antibiotics — the historical 'stage III'.\", \"2\": \"Pancreatic insufficiency prevents cleavage of haptocorrin, so B12 cannot transfer to intrinsic factor. Stage II would not correct with intrinsic factor alone; it corrects when pancreatic enzymes are given.\", \"3\": \"Dietary deficiency, as in a strict vegan, leaves every absorptive step intact. Stage I would therefore be NORMAL — the oral radiolabeled dose would be absorbed and excreted.\", \"4\": \"Terminal ileal resection removes the cubilin receptors that take up the B12–intrinsic factor complex. Adding intrinsic factor cannot help when there is nowhere to absorb the complex, so stage II would remain abnormal.\"}, \"eli5\": \"When they gave the missing helper protein from the stomach along with the vitamin, he absorbed it fine. That means the only thing wrong was his stomach not making that helper.\", \"los\": [{\"n\": 20, \"t\": \"Differentiate clinical causes of nutritional anemias (iron, B12 + folate deficiency) by clinical presentation, etiologies, laboratory studies, and diagnostics.\", \"a\": \"s5-b12-folate\", \"s\": \"§5\"}]}, {\"stem\": \"A 63-year-old woman is evaluated for a macrocytic anemia. She has a history of type 1 diabetes mellitus and primary adrenal insufficiency. She eats a diet that includes meat and dairy and has had no gastrointestinal surgery. Neurologic examination shows decreased vibration sense in the toes.\\n\\nLaboratory studies show:\\n  Hemoglobin  9.1 g/dL (N=12.0–16.0 g/dL)\\n  Hematocrit  27% (N=36%–46%)\\n  Mean corpuscular volume  116 µm3 (N=80–100 µm3)\\n  Serum vitamin B12  110 pg/mL (N=200–900 pg/mL)\\n  Methylmalonic acid  0.96 µmol/L (N=0.08–0.40 µmol/L)\\nPernicious anemia is suspected.\\n\\nWhich of the following laboratory findings is most specific for this diagnosis?\", \"choices\": [\"A. Anti-intrinsic factor antibodies\", \"B. Anti-parietal cell antibodies\", \"C. Anti-thyroid peroxidase antibodies\", \"D. Elevated serum gastrin concentration\", \"E. Elevated serum homocysteine concentration\"], \"correct\": 0, \"explanation\": \"The review file gives the two pernicious anemia antibodies as a pair with opposite strengths:\\n• ANTI-PARIETAL CELL antibody — present in 85–90% → MORE SENSITIVE, but also found in other autoimmune gastritis and in a proportion of healthy older adults.\\n• ANTI-INTRINSIC FACTOR antibody — present in about 75% → MORE SPECIFIC. When it is present, pernicious anemia is very likely.\\n\\nSo the lead-in 'most specific' points to anti-intrinsic factor antibodies, while a question asking for the most sensitive screen would point to anti-parietal cell antibodies.\\n\\nThe stem supports the diagnosis in other ways too. Pernicious anemia is an autoimmune disease, not a diet problem, and it clusters with other autoimmune endocrine disease — here type 1 diabetes and primary adrenal insufficiency. The B12 deficiency is confirmed by a raised methylmalonic acid, and early dorsal column involvement shows as reduced vibration sense.\", \"wrongExplanations\": {\"1\": \"Anti-parietal cell antibodies are the MORE SENSITIVE of the two, found in 85–90% of patients. Their weakness is specificity — they also occur in other atrophic gastritis and in some healthy older adults — which makes them the near-miss for a 'most specific' lead-in.\", \"2\": \"Anti-thyroid peroxidase antibodies mark Hashimoto thyroiditis, which often coexists with pernicious anemia as part of the same autoimmune cluster. They say nothing specific about the stomach.\", \"3\": \"Gastrin rises because loss of acid removes the negative feedback on antral G cells, so hypergastrinemia is expected in pernicious anemia. It is also raised by proton pump inhibitors, gastrinoma and other causes of achlorhydria, so it is not specific.\", \"4\": \"Homocysteine rises in both B12 and folate deficiency, and in renal failure and hypothyroidism. It cannot identify the cause of the B12 deficiency, let alone pernicious anemia specifically.\"}, \"eli5\": \"One antibody test catches almost everyone with this condition but also some people without it. The other misses a few people but, when it is positive, it is almost always this condition.\", \"los\": [{\"n\": 20, \"t\": \"Differentiate clinical causes of nutritional anemias (iron, B12 + folate deficiency) by clinical presentation, etiologies, laboratory studies, and diagnostics.\", \"a\": \"s5-b12-folate\", \"s\": \"§5\"}]}, {\"stem\": \"A 64-year-old woman with rheumatoid arthritis comes to the office because of painful mouth sores and fatigue for 1 week. She has taken methotrexate 20 mg orally once weekly for 3 years, without folic acid supplementation. Ten days ago she began trimethoprim-sulfamethoxazole for a urinary tract infection. Examination shows multiple shallow ulcers on the buccal mucosa and tongue.\\n\\nLaboratory studies show:\\n  Hemoglobin  8.8 g/dL (N=12.0–16.0 g/dL)\\n  Hematocrit  26% (N=36%–46%)\\n  Mean corpuscular volume  109 µm3 (N=80–100 µm3)\\n  Leukocyte count  2,300/mm3 (N=4,500–11,000/mm3)\\n  Platelet count  74,000/mm3 (N=150,000–400,000/mm3)\\n  Serum vitamin B12  540 pg/mL (N=200–900 pg/mL)\\n  Serum creatinine  1.0 mg/dL (N=0.6–1.2 mg/dL)\\nA peripheral blood smear shows oval macrocytes and hypersegmented neutrophils.\\n\\nWhich of the following is the most appropriate pharmacotherapy to reverse these adverse effects?\", \"choices\": [\"A. Cyanocobalamin\", \"B. Filgrastim\", \"C. Folic acid\", \"D. Leucovorin\", \"E. Pyridoxine\"], \"correct\": 3, \"explanation\": \"The review file lists IMPAIRED UTILIZATION of folate among the causes of folate deficiency, naming the folate antagonist METHOTREXATE, and explains why chemotherapy targets this pathway at all. Chemotherapy is broadly a poison aimed at fast-dividing cells → fast-dividing cells are busy with DNA synthesis → shut down the folate pathway → the side effects are predictable, because the fastest-dividing normal tissues suffer first: the MARROW empties (pancytopenia) and the GUT MUCOSA ulcerates (her stomatitis).\\n\\nMechanism: methotrexate inhibits DIHYDROFOLATE REDUCTASE → dihydrofolate cannot be reduced to tetrahydrofolate → no one-carbon donors for thymidylate → DNA synthesis stalls → megaloblastic pancytopenia. Trimethoprim is a weaker dihydrofolate reductase inhibitor, and it also reduces renal clearance of methotrexate, which is why the combination precipitated toxicity.\\n\\nThe reversal agent is LEUCOVORIN (folinic acid, N5-formyl-tetrahydrofolate). It is ALREADY REDUCED, so it enters the pathway BELOW the blocked enzyme and restores tetrahydrofolate even while dihydrofolate reductase is inhibited. The trimethoprim-sulfamethoxazole should be stopped and methotrexate held.\", \"wrongExplanations\": {\"0\": \"Cyanocobalamin treats vitamin B12 deficiency. Her B12 is normal at 540 pg/mL, and the megaloblastic change here comes from blocked folate metabolism rather than a missing cofactor.\", \"1\": \"Filgrastim shortens neutropenia by stimulating granulocyte production, and may be added in severe neutropenia. It does not correct the underlying DNA synthesis block, the anemia, the thrombocytopenia or the mucositis.\", \"2\": \"Folic acid is the near-miss. Ordinary folic acid must be reduced by DIHYDROFOLATE REDUCTASE to become active — the very enzyme methotrexate is blocking — so it cannot rescue acute toxicity. Low-dose folic acid is, however, given routinely with weekly methotrexate to PREVENT these effects.\", \"4\": \"Pyridoxine (vitamin B6) is the cofactor for heme synthesis and treats sideroblastic anemia, particularly isoniazid-induced. It has no role in folate metabolism.\"}, \"eli5\": \"Her arthritis drug blocks the enzyme that turns folate into its usable form, so fast-growing cells in the marrow and mouth stop dividing properly. Leucovorin is folate that is already in usable form, so it slips past the blocked enzyme.\", \"explanationImage\": \"fig_mtx_pathway\", \"explanationImageCaption\": \"Methotrexate inhibits dihydrofolate reductase (DHF → THF); folinic acid (leucovorin) enters as a reduced folate below the block.\", \"los\": [{\"n\": 20, \"t\": \"Differentiate clinical causes of nutritional anemias (iron, B12 + folate deficiency) by clinical presentation, etiologies, laboratory studies, and diagnostics.\", \"a\": \"s5-b12-folate\", \"s\": \"§5\"}, {\"n\": 17, \"t\": \"Describe the toxicities of antineoplastic agents (traditional drugs).\", \"a\": \"s39-chemo-tox\", \"s\": \"§44\"}]}, {\"stem\": \"A 16-year-old boy with hereditary spherocytosis is brought to the office because of progressively worsening fatigue over 6 weeks. His baseline hemoglobin concentration is 11 g/dL, with a reticulocyte count of 8%. He has had no fever, rash, sore throat, or recent illness. He eats very few fruits or vegetables. His pulse is 108/min. Examination shows pallor, mild scleral icterus, and a spleen palpable 3 cm below the left costal margin, unchanged from previous examinations.\\n\\nLaboratory studies show:\\n  Hemoglobin  7.2 g/dL (N=13.5–17.5 g/dL)\\n  Hematocrit  22% (N=41%–53%)\\n  Mean corpuscular volume  104 µm3 (N=80–100 µm3)\\n  Reticulocyte count  1.1% (N=0.5%–1.5%)\\n  Serum vitamin B12  520 pg/mL (N=200–900 pg/mL)\\n  Serum folate  1.6 ng/mL (N=2.5–20 ng/mL)\\nA test for parvovirus B19 IgM is negative. A peripheral blood smear is shown; hypersegmented neutrophils are also present elsewhere on the slide.\\n\\nWhich of the following is the most likely cause of the worsening of this patient's anemia?\", \"choices\": [\"A. Aplastic crisis from parvovirus B19 infection\", \"B. Folate deficiency from increased requirement\", \"C. Hyperhemolytic crisis with splenic sequestration\", \"D. Iron deficiency from chronic hemolysis\", \"E. Vitamin B12 deficiency from ileal malabsorption\"], \"correct\": 1, \"explanation\": \"A patient with chronic hemolysis suddenly stops making enough red cells — his reticulocyte count has collapsed from a baseline of 8% to 1.1%. Two causes produce that, and they are separated by tempo and morphology.\\n\\nThe review file lists CHRONIC HEMOLYSIS as a cause of INCREASED FOLATE REQUIREMENT. His marrow has been running at several times normal output for years to compensate for spherocyte destruction → every new cell needs folate for DNA synthesis → a poor intake of fruits and vegetables cannot keep up → folate runs out → megaloblastic erythropoiesis.\\n\\nThe discriminators:\\n• MCV has RISEN to 104 µm3 — spherocytosis alone would keep it normal or low.\\n• HYPERSEGMENTED NEUTROPHILS — a DNA synthesis defect.\\n• Serum folate 1.6 ng/mL with a normal B12.\\n• A GRADUAL 6-week decline.\\n\\nThis is why patients with chronic hemolytic anemias are given daily folic acid supplementation.\", \"wrongExplanations\": {\"0\": \"Aplastic crisis is the near-miss: parvovirus B19 infects erythroid precursors and also drops the reticulocyte count abruptly in chronic hemolysis. It comes on over days, usually after a viral illness, and gives a NORMOCYTIC picture without hypersegmented neutrophils. His IgM is negative and his course is gradual and macrocytic.\", \"2\": \"A hyperhemolytic or sequestration crisis would drive the reticulocyte count UP, with rapid enlargement of the spleen and worsening jaundice. His reticulocyte count has fallen and his spleen is unchanged.\", \"3\": \"Extravascular hemolysis in the spleen RECYCLES iron through macrophages, so iron deficiency does not develop. Iron deficiency would also produce microcytosis, not an MCV of 104 µm3.\", \"4\": \"Vitamin B12 deficiency would produce the same smear, but his serum B12 is normal at 520 pg/mL and he has no ileal disease. The body's B12 stores last years, whereas folate stores last only months — which is why folate is the vitamin a high-turnover marrow exhausts.\"}, \"eli5\": \"His marrow has to work overtime to replace the fragile red cells he keeps losing, and building all those cells uses up folate. He did not eat enough folate to keep up, so the marrow ran out of supplies.\", \"image\": \"fig_spherocytes\", \"imageCaption\": \"Peripheral blood smear. Many erythrocytes are small, round and densely staining, without central pallor; cell size varies.\", \"explanationImage\": \"fig_parvo_pronormoblast\", \"explanationImageCaption\": \"The contrast case: a giant pronormoblast with deep-blue cytoplasm, the marrow hallmark of parvovirus B19 aplastic crisis.\", \"los\": [{\"n\": 20, \"t\": \"Differentiate clinical causes of nutritional anemias (iron, B12 + folate deficiency) by clinical presentation, etiologies, laboratory studies, and diagnostics.\", \"a\": \"s5-b12-folate\", \"s\": \"§5\"}]}, {\"stem\": \"A 41-year-old woman comes to the office because of a 4-month history of fatigue and numbness in both feet. Six years ago she underwent Roux-en-Y gastric bypass. She stopped taking her prescribed vitamin supplements 3 years ago. Her menstrual periods are regular and light. Neurologic examination shows decreased vibration sense in the toes.\\n\\nLaboratory studies show:\\n  Hemoglobin  9.0 g/dL (N=12.0–16.0 g/dL)\\n  Hematocrit  27% (N=36%–46%)\\n  Mean corpuscular volume  88 µm3 (N=80–100 µm3)\\n  Red cell distribution width  23.4% (N=11.5%–14.5%)\\n  Serum ferritin  5 ng/mL (N=10–120 ng/mL)\\n  Serum vitamin B12  118 pg/mL (N=200–900 pg/mL)\\n  Serum folate  7.0 ng/mL (N=2.5–20 ng/mL)\\n  Methylmalonic acid  0.90 µmol/L (N=0.08–0.40 µmol/L)\\nA peripheral blood smear shows a mixture of small, pale erythrocytes and large, oval erythrocytes, with occasional hypersegmented neutrophils.\\n\\nWhich of the following best explains this patient's mean corpuscular volume?\", \"choices\": [\"A. Anemia of chronic disease producing normocytic erythrocytes\", \"B. Coexisting iron and vitamin B12 deficiencies producing two erythrocyte populations\", \"C. Early deficiency before erythrocyte size has changed\", \"D. Reticulocytosis offsetting microcytosis\", \"E. Spurious elevation from erythrocyte agglutination\"], \"correct\": 1, \"explanation\": \"A normal MCV with a red cell distribution width of 23.4% is a warning, not a reassurance. The MCV is an AVERAGE, and an average of two abnormal populations can be normal.\\n\\nThe review file names bariatric surgery as a modern, common cause of exactly this. Gastric bypass removes or bypasses the acid- and intrinsic-factor-producing stomach AND the duodenum → a predictable long-term deficiency of IRON (lost duodenal absorption, less acid) and VITAMIN B12 (no intrinsic factor, no acid to release B12 from food) TOGETHER → it is 'a common source of the mixed micro-plus-macrocytic picture that averages out to a normal MCV.'\\n\\nEverything confirms two separate deficiencies: a ferritin of 5 ng/mL (iron), a low B12 with a raised methylmalonic acid (B12), neuropathy, and a smear showing both populations — small pale cells AND oval macrocytes with hypersegmented neutrophils. The wide red cell distribution width is the index that betrays the mixture. Both deficiencies need replacement, with lifelong monitoring after bariatric surgery.\", \"wrongExplanations\": {\"0\": \"Anemia of chronic disease is normocytic, but it has a NORMAL red cell distribution width, a normal or high ferritin, and an inflammatory cause. Her ferritin is 5 ng/mL and her smear shows two distinct abnormal populations rather than uniform cells.\", \"2\": \"Early deficiency before cells change size would give a normal MCV with a NORMAL red cell distribution width and a normal smear. A width of 23.4% with visibly small and large cells means the size change has already happened.\", \"3\": \"Reticulocytes are larger than mature cells, so a brisk reticulocytosis can pull a low MCV up toward normal. It needs an active marrow responding to loss or hemolysis, which a combined nutritional production defect does not provide.\", \"4\": \"Agglutination from cold antibodies spuriously RAISES the MCV as clumps are counted as single large cells. It would be seen as clumping on the smear, which is not described, and would not explain the iron and B12 results.\"}, \"eli5\": \"She is short on two nutrients at once: one makes red cells small and the other makes them big. Averaged together the size looks normal, but the smear shows both kinds.\", \"explanationImage\": \"fig_intestinal_absorption\", \"explanationImageCaption\": \"Absorptive capacity along the intestine: vitamin B12 is taken up in the ileum. Iron, not shown, is absorbed in the duodenum — the segment gastric bypass skips.\", \"los\": [{\"n\": 20, \"t\": \"Differentiate clinical causes of nutritional anemias (iron, B12 + folate deficiency) by clinical presentation, etiologies, laboratory studies, and diagnostics.\", \"a\": \"s5-b12-folate\", \"s\": \"§5\"}]}, {\"stem\": \"A 68-year-old man with pernicious anemia confirmed by anti-intrinsic factor antibodies has received monthly intramuscular cyanocobalamin injections for 2 years. He has a severe needle phobia and asks whether he can take tablets instead. His physician prescribes oral cyanocobalamin 1,000 µg daily. Three months later, his hemoglobin concentration, serum vitamin B12 concentration, and methylmalonic acid concentration are all within the reference ranges.\\n\\nThe effectiveness of this oral regimen depends on which of the following?\", \"choices\": [\"A. Increased gastric acid release of vitamin B12 from the tablet matrix\", \"B. Passive diffusion of a small fraction of a large dose independent of intrinsic factor\", \"C. Recovery of intrinsic factor secretion after vitamin B12 repletion\", \"D. Transcobalamin II–mediated uptake across the gastric mucosa\", \"E. Up-regulation of ileal cubilin receptors in vitamin B12 deficiency\"], \"correct\": 1, \"explanation\": \"In pernicious anemia there is no intrinsic factor, so the normal pathway — the intrinsic factor–B12 complex taken up by cubilin in the terminal ileum — is permanently closed.\\n\\nThe review file states the treatment rule directly: B12 must be given by a route that does NOT require intrinsic factor. Two routes qualify:\\n• INTRAMUSCULAR injection — bypasses the gut completely.\\n• HIGH-DOSE ORAL therapy — relies on PASSIVE DIFFUSION across the intestinal mucosa.\\n\\nPassive diffusion absorbs only about 1% of an oral dose regardless of intrinsic factor. That is why the dose is enormous: 1% of 1,000 µg is roughly 10 µg a day, comfortably above the daily requirement of a few micrograms. The normal-range B12 and methylmalonic acid confirm it is working.\\n\\nThe review file also reminds you that treating pernicious anemia means treating three problems: the anemia and the neurology are covered by adequate B12 by either route, but the atrophic gastritis and its gastric carcinoma risk still need surveillance.\", \"wrongExplanations\": {\"0\": \"Pernicious anemia causes ACHLORHYDRIA — the same destroyed parietal cells make acid. And the crystalline B12 in tablets is not protein-bound, so it needs no acid release in any case.\", \"2\": \"Pernicious anemia is autoimmune destruction of parietal cells, which is permanent. Repleting B12 does not regenerate them or restore intrinsic factor, which is why treatment is lifelong.\", \"3\": \"Transcobalamin II carries B12 in the plasma after absorption and delivers it to tissues. It plays no role in moving B12 across the gut, and the stomach is not an absorptive site.\", \"4\": \"Cubilin receptors take up only the intrinsic factor–B12 COMPLEX. With no intrinsic factor, more receptors would have nothing to bind.\"}, \"eli5\": \"Normally the body needs a helper protein to absorb B12, and his stomach cannot make it. But if you swallow a very large dose, a tiny bit leaks through the gut wall on its own — and a tiny bit of a big dose is enough.\", \"los\": [{\"n\": 20, \"t\": \"Differentiate clinical causes of nutritional anemias (iron, B12 + folate deficiency) by clinical presentation, etiologies, laboratory studies, and diagnostics.\", \"a\": \"s5-b12-folate\", \"s\": \"§5\"}]}, {\"stem\": \"A 57-year-old man is evaluated for fatigue. For 3 months he has been treated for a lung abscess and still has a productive cough and intermittent fevers. He has no history of kidney disease and has never received erythropoiesis-stimulating agents. He is breathing room air. His temperature is 37.9°C (100.2°F), pulse is 92/min, and blood pressure is 128/78 mm Hg. Pulse oximetry on room air shows an oxygen saturation of 95%.\\n\\nLaboratory studies show:\\n  Hemoglobin  9.4 g/dL (N=13.5–17.5 g/dL)\\n  Hematocrit  28% (N=41%–53%)\\n  Mean corpuscular volume  85 µm3 (N=80–100 µm3)\\n  Reticulocyte count  0.6% (N=0.5%–1.5%)\\n  Serum iron  30 µg/dL (N=65–175 µg/dL)\\n  Serum ferritin  380 ng/mL (N=20–250 ng/mL)\\n  Total iron-binding capacity  205 µg/dL (N=250–400 µg/dL)\\n  Serum creatinine  0.9 mg/dL (N=0.6–1.2 mg/dL)\\n  Serum erythropoietin  22 mU/mL (N=4–26 mU/mL)\\nWhich of the following best explains this patient's serum erythropoietin concentration?\", \"choices\": [\"A. Destruction of renal peritubular interstitial cells\", \"B. Hepcidin-mediated sequestration of iron in macrophages\", \"C. Inflammatory cytokine suppression of renal erythropoietin release\", \"D. Neutralizing antibodies against endogenous erythropoietin\", \"E. Suppression of hypoxia-inducible factor by supplemental oxygen\"], \"correct\": 2, \"explanation\": \"An erythropoietin of 22 mU/mL looks 'normal' — and that is the abnormality. A healthy kidney facing a hemoglobin of 9.4 g/dL should raise erythropoietin many-fold above the reference range. A normal value in the face of anemia is INAPPROPRIATELY LOW.\\n\\nThe review file frames anemia of chronic disease as FOUR MECHANISMS, ONE STIMULUS — the inflammatory cytokine response. Hepcidin is the famous one, but it is only the first:\\nA. Hepcidin goes up → iron is locked away.\\nB. ERYTHROPOIETIN RELEASE IS INHIBITED → 'the order is never given loudly enough.'\\nC. Erythroid proliferation is inhibited directly by cytokines.\\nD. Hemophagocytosis is augmented.\\n\\nThe lead-in asks specifically about the erythropoietin number, and mechanism B is the one that explains it. The stem removes the alternatives: a normal creatinine excludes kidney disease, he has never had an erythropoiesis-stimulating agent, and he is breathing room air.\", \"wrongExplanations\": {\"0\": \"Loss of the peritubular interstitial cells that make erythropoietin is the anemia of CHRONIC KIDNEY DISEASE. It would be correct with an elevated creatinine; his creatinine is 0.9 mg/dL.\", \"1\": \"Hepcidin-mediated iron sequestration is genuinely happening in this patient — it explains his low serum iron, high ferritin and low binding capacity. It is the right disease but the wrong mechanism for this lead-in, because hepcidin controls iron, not erythropoietin.\", \"3\": \"Anti-erythropoietin antibodies cause pure red cell aplasia, almost exclusively after treatment with recombinant erythropoiesis-stimulating agents. He has never received one, and he would have profound reticulocytopenia with an absent erythroid series.\", \"4\": \"Supplemental oxygen raises tissue oxygen, allowing prolyl hydroxylation and degradation of hypoxia-inducible factor, which lowers erythropoietin. He is breathing room air, so this cannot apply.\"}, \"eli5\": \"Anemia normally makes the kidneys shout for more red cells. His ongoing infection floods his body with chemicals that turn that shout into a whisper, so the hormone level sits at 'normal' when it should be sky-high.\", \"los\": [{\"n\": 19, \"t\": \"Differentiate clinical causes of anemias by clinical presentation, etiologies, laboratory studies, and diagnostics.\", \"a\": \"s6-aocd\", \"s\": \"§6\"}]}, {\"stem\": \"A 66-year-old woman is in week 6 of intravenous antibiotic therapy for infective endocarditis of the mitral valve. She reports fatigue. She has no history of liver disease and does not drink alcoholic beverages. A urinalysis shows no protein.\\n\\nLaboratory studies show:\\n  Hemoglobin  9.9 g/dL (N=12.0–16.0 g/dL)\\n  Hematocrit  30% (N=36%–46%)\\n  Mean corpuscular volume  84 µm3 (N=80–100 µm3)\\n  Serum iron  28 µg/dL (N=50–170 µg/dL)\\n  Serum ferritin  290 ng/mL (N=10–120 ng/mL)\\n  Total iron-binding capacity  196 µg/dL (N=250–400 µg/dL)\\n  Serum albumin  3.6 g/dL (N=3.5–5.5 g/dL)\\n  Aspartate aminotransferase  24 U/L (N=12–38 U/L)\\nWhich of the following best explains this patient's decreased total iron-binding capacity?\", \"choices\": [\"A. Increased occupancy of transferrin binding sites by iron\", \"B. Increased renal loss of transferrin\", \"C. Increased uptake of transferrin by erythroid precursors\", \"D. Reduced hepatic synthesis of transferrin as a negative acute phase reactant\", \"E. Sequestration of transferrin within macrophages by hepcidin\"], \"correct\": 3, \"explanation\": \"Total iron-binding capacity is an indirect measure of TRANSFERRIN — how many iron-binding sites exist in the plasma. The review file's picture is transferrin carrying little cups, full or empty.\\n\\nIn iron deficiency the cups float around empty and the liver makes MORE transferrin → HIGH binding capacity. In anemia of chronic disease the opposite happens: inflammation drives the liver to make LESS transferrin, because transferrin is a NEGATIVE ACUTE PHASE REACTANT — its production falls as acute phase proteins rise → fewer cups on the shelf → LOW binding capacity.\\n\\nThat single difference, the review file says, separates the two most commonly confused anemias in the hospital: ferritin and total iron-binding capacity move in OPPOSITE directions — iron deficiency LOW/HIGH, anemia of chronic disease HIGH/LOW.\\n\\nThe stem rules out the other causes of low transferrin: no proteinuria, no liver disease, and a preserved albumin.\", \"wrongExplanations\": {\"0\": \"Iron occupying the sites would raise the transferrin SATURATION, not lower the total capacity — capacity counts all sites, full or empty. And her serum iron is low, so there is less iron to occupy them.\", \"1\": \"Urinary transferrin loss lowers the binding capacity in NEPHROTIC SYNDROME, along with heavy proteinuria and a low albumin. Her urinalysis shows no protein and her albumin is 3.6 g/dL.\", \"2\": \"Erythroid precursors take up transferrin-bound iron through transferrin receptors, but the transferrin itself is recycled back to the plasma. Uptake does not deplete the circulating transferrin pool, and her marrow is under-producing, not over-consuming.\", \"4\": \"Hepcidin acts on FERROPORTIN, the iron exporter, trapping IRON inside macrophages. It does not sequester transferrin — this is the right hormone applied to the wrong molecule.\"}, \"eli5\": \"The blood protein that carries iron is made in the liver. During a long infection the liver deliberately makes less of it, so there are fewer iron carriers in the blood.\", \"los\": [{\"n\": 19, \"t\": \"Differentiate clinical causes of anemias by clinical presentation, etiologies, laboratory studies, and diagnostics.\", \"a\": \"s6-aocd\", \"s\": \"§6\"}, {\"n\": 53, \"t\": \"Given a clinical vignette, interpret laboratory and diagnostic studies as well as molecular genetics to distinguish various etiologies of anemia.\", \"a\": \"s6-aocd\", \"s\": \"§6\"}]}, {\"stem\": \"A 10-month-old girl is brought to the office because of lethargy, poor feeding, and loss of the ability to sit without support over the past 2 months; she first sat unsupported at 6 months of age. She was born at term after an uncomplicated pregnancy and has been exclusively breastfed. Her mother has followed a strict vegan diet for 6 years and takes no supplements. Examination shows pallor, generalized hypotonia, and decreased spontaneous movements.\\n\\nLaboratory studies show:\\n  Hemoglobin  8.4 g/dL (N=10.5–13.5 g/dL for age)\\n  Hematocrit  25% (N=33%–39% for age)\\n  Mean corpuscular volume  101 µm3 (N=70–86 µm3 for age)\\n  Platelet count  128,000/mm3 (N=150,000–400,000/mm3)\\n  Serum vitamin B12  84 pg/mL (N=200–900 pg/mL)\\n  Serum folate  14.0 ng/mL (N=2.5–20 ng/mL)\\n  Methylmalonic acid  3.2 µmol/L (N=0.08–0.40 µmol/L)\\nWhich of the following is the most likely underlying cause of this patient's condition?\", \"choices\": [\"A. Congenital transcobalamin II deficiency\", \"B. Folate deficiency from goat's milk feeding\", \"C. Hereditary intrinsic factor deficiency\", \"D. Iron deficiency from excess cow's milk intake\", \"E. Maternal dietary vitamin B12 deficiency\"], \"correct\": 4, \"explanation\": \"The review file names two relevant facts: the major source of B12 is ANIMAL PRODUCTS — plants contain very little, which is why STRICT VEGANS are at genuine risk — and B12 has TWO JOBS, DNA synthesis and maintaining myelin.\\n\\nPut them together across two people. A mother on a strict vegan diet for 6 years without supplements has low B12 stores → her breast milk contains little B12 → her exclusively breastfed infant, born with low stores, depletes them over the first months → megaloblastic anemia (macrocytosis, low platelets) PLUS the neurologic job failing in a developing brain → lethargy, hypotonia and loss of a milestone already achieved. The very high methylmalonic acid confirms B12 deficiency, and the normal folate excludes folate.\\n\\nDevelopmental REGRESSION in an exclusively breastfed infant of a vegan mother is the vignette to recognize. Treatment is B12 for both mother and infant; neurologic recovery may be incomplete if it is delayed.\", \"wrongExplanations\": {\"0\": \"Congenital transcobalamin II deficiency presents in the FIRST FEW MONTHS of life, and the serum B12 is often NORMAL because B12 is carried on other binders while delivery to cells fails. This infant developed normally until after 6 months and has a very low serum B12.\", \"1\": \"Goat's milk is genuinely deficient in folate and causes megaloblastic anemia in infants fed on it — a classic distractor. She is exclusively breastfed, her folate is normal, and folate deficiency would not raise methylmalonic acid or cause neurologic regression.\", \"2\": \"Hereditary intrinsic factor deficiency does cause infantile B12 deficiency with neurologic signs, typically after maternal stores run out. It becomes the leading answer only when the mother's own B12 status is adequate — here the mother's strict unsupplemented vegan diet provides a far more likely explanation.\", \"3\": \"Excess cow's milk causes IRON deficiency in toddlers, with MICROcytosis. She is exclusively breastfed, her MCV is high, and iron deficiency does not raise methylmalonic acid.\"}, \"eli5\": \"Vitamin B12 comes almost only from animal foods. Her mom eats none and takes no vitamins, so there was very little B12 in the breast milk, and the baby's growing brain and blood both ran short.\", \"explanationImage\": \"fig_b12_def_uw\", \"explanationImageCaption\": \"Vitamin B12 deficiency: methylmalonyl-CoA mutase failure raises methylmalonic acid and impairs myelin; methionine synthase failure traps folate and impairs DNA synthesis.\", \"los\": [{\"n\": 20, \"t\": \"Differentiate clinical causes of nutritional anemias (iron, B12 + folate deficiency) by clinical presentation, etiologies, laboratory studies, and diagnostics.\", \"a\": \"s5-b12-folate\", \"s\": \"§5\"}]}, {\"stem\": \"A 64-year-old man comes to the office because of a 3-week history of fatigue and dark brown urine that is most noticeable on waking. He underwent mechanical aortic valve replacement 5 months ago. His medications are warfarin and metoprolol. He has had no muscle pain or weakness and has not done unaccustomed exercise. His temperature is 37.0°C (98.6°F), pulse is 88/min, respirations are 16/min, and blood pressure is 128/76 mm Hg. Physical examination shows scleral icterus and a crisp mechanical click at the second right intercostal space; the spleen is not palpable. A tube of blood is spun, and the plasma layer is pink.\\n\\nLaboratory studies show:\\n  Hemoglobin  9.4 g/dL (N=13.5–17.5 g/dL)\\n  Hematocrit  28% (N=41%–53%)\\n  Mean corpuscular volume  91 µm3 (N=80–100 µm3)\\n  Reticulocyte count  6.4% (N=0.5%–1.5%)\\n  Platelet count  224,000/mm3 (N=150,000–400,000/mm3)\\n  Lactate dehydrogenase  840 U/L (N=45–200 U/L)\\n  Haptoglobin  <10 mg/dL (N=30–200 mg/dL)\\n  Total bilirubin  2.6 mg/dL (N=0.1–1.0 mg/dL)\\n  Direct bilirubin  0.2 mg/dL (N=0.0–0.3 mg/dL)\\n  Creatine kinase  62 U/L (N=25–90 U/L)\\n  Creatinine  1.0 mg/dL (N=0.6–1.2 mg/dL)\\nUrinalysis of a freshly voided specimen shows a dipstick strongly positive for blood; microscopic examination of the sediment shows no erythrocytes. A peripheral blood smear is shown.\\n\\nWhich of the following best explains this patient's urinalysis findings?\", \"choices\": [\"A. Excretion of conjugated bilirubin into the urine\", \"B. Excretion of increased urobilinogen into the urine\", \"C. Filtration of free hemoglobin released into the plasma\", \"D. Filtration of myoglobin released from injured skeletal muscle\", \"E. Lysis of intact erythrocytes within the collected specimen\"], \"correct\": 2, \"explanation\": \"This is intravascular hemolysis, and the whole vignette is the triad from §8: pink plasma, dark urine, and an undetectable haptoglobin. A mechanical valve shears erythrocytes under arterial pressure → cells rupture inside the vessel → free hemoglobin is spilled directly into plasma. The smear shows the fragments that shearing produces.\\n\\nThe urine dipstick does not detect erythrocytes. It detects the peroxidase activity of HEME, whatever is carrying it. So free plasma hemoglobin, once it exceeds the binding capacity of haptoglobin, is filtered at the glomerulus and turns the dipstick positive → hemoglobinuria → a positive dipstick with an empty sediment.\\n\\nThat mismatch (dipstick positive, microscopy negative) is the finding to recognize: with true hematuria you would see erythrocytes under the microscope. And this is the dangerous form of hemolysis — filtered free heme is toxic to the renal tubule, which is why his creatinine must be followed.\", \"wrongExplanations\": {\"0\": \"Conjugated (direct) bilirubin is water-soluble and does appear in urine when it accumulates — in biliary obstruction or hepatocellular disease. It would be the answer if the direct fraction were raised; his is 0.2 mg/dL, and conjugated bilirubinuria does not turn a blood dipstick positive.\", \"1\": \"Urobilinogen is genuinely increased in any hemolysis and darkens urine, so it is a real finding here. But urobilinogen has its own dipstick pad and contains no heme — it cannot produce a strongly positive test for blood. It explains the color, not the result asked about.\", \"3\": \"Myoglobin also contains heme and produces exactly this dipstick-positive, erythrocyte-negative pattern — rhabdomyolysis is the counterfactual. It would be the answer with muscle pain, unaccustomed exertion, and a raised creatine kinase. His creatine kinase is 62 U/L and his plasma is pink, which myoglobin does not cause.\", \"4\": \"Erythrocytes lysing in a stale specimen can produce free hemoglobin in the tube, and it is why a fresh sample is requested — this one was freshly voided. In vitro lysis also would not make the patient jaundiced, drive the lactate dehydrogenase to 840 U/L, or consume the haptoglobin.\"}, \"eli5\": \"His new heart valve is shredding red cells as blood rushes past it, so hemoglobin spills loose in the blood and gets dumped into the urine. The urine test strip reacts to hemoglobin, not to whole cells — so it turns positive even though there are no red cells to find.\", \"image\": \"fig_schistocytes\", \"imageCaption\": \"Peripheral blood smear. Among the intact erythrocytes there are several smaller angular cells with one straight or concave edge and a sharply pointed contour.\", \"explanationImage\": \"fig_howell_jolly\", \"explanationImageCaption\": \"For comparison: a peripheral blood smear in which erythrocytes contain small dense round nuclear remnants (arrows) — the Howell-Jolly bodies of a missing or non-functioning spleen, a different clue entirely.\", \"los\": [{\"n\": 25, \"t\": \"Distinguish between various causes of hemolytic anemia and characterize by site of hemolysis (intravascular versus extravascular), pathophysiology, laboratory testing and diagnostics.\", \"a\": \"s7-hemolysis\", \"s\": \"§8\"}]}, {\"stem\": \"A 44-year-old woman is admitted to the hospital because of a 4-day history of fatigue, exertional dyspnea, and yellowing of her eyes. She has no history of serious illness, takes no medications, and does not smoke cigarettes or drink alcoholic beverages. Her temperature is 37.2°C (99.0°F), pulse is 104/min, respirations are 18/min, and blood pressure is 112/70 mm Hg. Physical examination shows scleral icterus and pallor of the conjunctivae. The abdomen is soft; the liver edge is not enlarged and the spleen is difficult to assess because of body habitus.\\n\\nLaboratory studies show:\\n  Hemoglobin  8.6 g/dL (N=12.0–16.0 g/dL)\\n  Hematocrit  26% (N=36%–46%)\\n  Mean corpuscular volume  94 µm3 (N=80–100 µm3)\\n  Reticulocyte count  7.8% (N=0.5%–1.5%)\\n  Platelet count  268,000/mm3 (N=150,000–400,000/mm3)\\n  Lactate dehydrogenase  610 U/L (N=45–200 U/L)\\n  Total bilirubin  3.4 mg/dL (N=0.1–1.0 mg/dL)\\n  Direct bilirubin  0.3 mg/dL (N=0.0–0.3 mg/dL)\\n  Haptoglobin  12 mg/dL (N=30–200 mg/dL)\\nHemolysis is established, but the site of erythrocyte destruction is not yet clear. Which of the following additional findings would best establish that destruction is occurring within the blood vessels rather than within the spleen?\", \"choices\": [\"A. Increased reticulocyte count\", \"B. Increased serum lactate dehydrogenase activity\", \"C. Increased serum unconjugated bilirubin concentration\", \"D. Spherocytes on the peripheral blood smear\", \"E. Urine positive for hemosiderin on Prussian blue staining\"], \"correct\": 4, \"explanation\": \"Four of the five findings are shared by both kinds of hemolysis and therefore localize nothing. The §8 table splits them cleanly:\\n\\n• SHARED — reticulocytosis (the marrow compensates either way), raised lactate dehydrogenase (released from any destroyed cell), raised unconjugated bilirubin (heme is catabolized either way).\\n• INTRAVASCULAR ONLY — hemoglobinemia (pink plasma), hemoglobinuria, an absent rather than merely low haptoglobin, and urine hemosiderin.\\n• EXTRAVASCULAR ONLY — spherocytes and splenomegaly.\\n\\nUrine hemosiderin is the one option that can only happen if hemoglobin was free in plasma: filtered hemoglobin is reabsorbed by proximal tubular cells → the iron is stored as hemosiderin → those cells slough into the urine days later → Prussian blue stains them. It is also the marker that survives after an acute episode has passed, when the plasma has cleared.\", \"wrongExplanations\": {\"0\": \"A raised reticulocyte count establishes that the marrow is intact and responding — the split from the impaired-production anemias of §4–§6 — but it rises in both intravascular and extravascular hemolysis. It would localize nothing even if it were 20%.\", \"1\": \"Lactate dehydrogenase is released from erythrocytes destroyed anywhere, and is already raised at 610 U/L. It would be a localizing finding only if it were undetectable in extravascular hemolysis, which it is not.\", \"2\": \"Unconjugated hyperbilirubinemia only says that heme is being catabolized faster than the liver conjugates it; splenic macrophages produce it just as efficiently as vessel rupture does. Her value of 3.4 mg/dL with a normal direct fraction already shows this and still does not answer the question.\", \"3\": \"Spherocytes point the opposite way. They are produced when a splenic macrophage removes part of the membrane and the cell rounds up — the signature of EXTRAVASCULAR destruction. Finding them would argue against the very thing the lead-in asks you to establish.\"}, \"eli5\": \"Lots of blood tests tell you red cells are dying, but not where. Only the leftovers of hemoglobin floating free — like iron showing up in the urine days later — prove they burst inside the blood vessels.\", \"explanationImage\": \"fig_aiha\", \"explanationImageCaption\": \"Two antibody-mediated hemolytic anemias that illustrate the split: IgM plus complement destroys cells inside the vessel, while IgG-coated cells are removed piecemeal by splenic macrophages.\", \"los\": [{\"n\": 25, \"t\": \"Distinguish between various causes of hemolytic anemia and characterize by site of hemolysis (intravascular versus extravascular), pathophysiology, laboratory testing and diagnostics.\", \"a\": \"s7-hemolysis\", \"s\": \"§8\"}]}, {\"stem\": \"A 24-year-old man comes to the emergency department because of a 5-day history of fatigue, dyspnea on exertion, and yellow eyes. He has no history of serious illness and takes no medications. His temperature is 37.1°C (98.8°F), pulse is 108/min, respirations are 18/min, and blood pressure is 118/72 mm Hg. Physical examination shows scleral icterus and marked conjunctival pallor.\\n\\nLaboratory studies show:\\n  Hemoglobin  7.0 g/dL (N=13.5–17.5 g/dL)\\n  Hematocrit  21% (N=41%–53%)\\n  Mean corpuscular volume  96 µm3 (N=80–100 µm3)\\n  Reticulocyte count  6.0% (N=0.5%–1.5%)\\n  Platelet count  302,000/mm3 (N=150,000–400,000/mm3)\\nWhich of the following is the best estimate of this patient's corrected reticulocyte count?\", \"choices\": [\"A. 0.9%\", \"B. 2.8%\", \"C. 3.2%\", \"D. 6.0%\", \"E. 12.9%\"], \"correct\": 1, \"explanation\": \"Corrected reticulocyte count = reported reticulocyte % × (patient hematocrit ÷ 45).\\n\\n6.0% × (21 ÷ 45) = 6.0 × 0.467 → 2.8%\\n\\nThe correction exists because the reticulocyte count is a PERCENTAGE of circulating erythrocytes. When the denominator collapses — this man has lost half his red cell mass — the percentage rises even if the marrow has not produced a single extra cell. Scaling to a hematocrit of 45% asks the real question: how many reticulocytes is he making compared with a person with a normal red cell mass?\\n\\nInterpretation is the point of the arithmetic. A corrected value above 2–3% means an intact marrow responding to peripheral destruction or blood loss → hemolysis, the whole of §8–§10. Below 2% means a production defect → iron, B12, folate, inflammation, or marrow failure. At 2.8% with jaundice, this man is destroying cells, not failing to make them.\", \"wrongExplanations\": {\"0\": \"0.9% is what you get by substituting the hemoglobin for the hematocrit — 6.0 × (7 ÷ 45). It would be correct only if the formula were indexed to hemoglobin, and it inverts the clinical meaning, turning a compensating marrow into a failing one.\", \"2\": \"3.2% comes from dividing by 40 rather than 45 — 6.0 × (21 ÷ 40). The reference hematocrit in the correction is 45%, and although the conclusion happens to survive this error, the value does not.\", \"3\": \"6.0% is the uncorrected laboratory value, which is the answer only if the hematocrit were already normal. Taking it at face value at a hematocrit of 21% overstates the marrow response by more than twofold — the exact error the correction exists to prevent.\", \"4\": \"12.9% comes from inverting the ratio — 6.0 × (45 ÷ 21). The correction must always scale the count DOWN in an anemic patient, never up; any answer larger than the reported value has the fraction upside down.\"}, \"eli5\": \"The reticulocyte count is a percentage, and when the total number of red cells drops, that percentage looks bigger than the marrow really deserves. You scale it to a normal hematocrit to get the honest number. Here 6% is really about 2.8%.\", \"explanationImage\": \"fig_retics\", \"explanationImageCaption\": \"Reticulocytes in peripheral blood — the young erythrocytes whose percentage must be corrected for the degree of anemia before it can be interpreted.\", \"los\": [{\"n\": 25, \"t\": \"Distinguish between various causes of hemolytic anemia and characterize by site of hemolysis (intravascular versus extravascular), pathophysiology, laboratory testing and diagnostics.\", \"a\": \"s7-hemolysis\", \"s\": \"§8\"}, {\"n\": 19, \"t\": \"Differentiate clinical causes of anemias by clinical presentation, etiologies, laboratory studies, and diagnostics.\", \"a\": \"s3-anemia-eval\", \"s\": \"§3\"}]}, {\"stem\": \"A 13-year-old girl is brought to the office by her father because of 6 months of increasing weakness and intermittent yellowing of her eyes. She has had brief episodes of jaundice since early childhood, usually during colds. Her father was told he was jaundiced as a teenager and had his spleen removed at age 20. She takes no medications. Her temperature is 37.0°C (98.6°F), pulse is 92/min, respirations are 16/min, and blood pressure is 106/68 mm Hg. Physical examination shows scleral icterus; the spleen is palpated 6 cm below the left costal margin. Ultrasonography of the abdomen shows multiple small gallstones.\\n\\nLaboratory studies show:\\n  Hemoglobin  9.3 g/dL (N=12.0–16.0 g/dL)\\n  Hematocrit  25% (N=36%–46%)\\n  Mean corpuscular volume  87 µm3 (N=80–100 µm3)\\n  Mean corpuscular hemoglobin concentration  37.2% Hb/cell (N=31%–36% Hb/cell)\\n  Reticulocyte count  9.8% (N=0.5%–1.5%)\\n  Total bilirubin  3.8 mg/dL (N=0.1–1.0 mg/dL)\\n  Direct bilirubin  0.3 mg/dL (N=0.0–0.3 mg/dL)\\n  Lactate dehydrogenase  265 U/L (N=45–200 U/L)\\n  Haptoglobin  22 mg/dL (N=30–200 mg/dL)\\nThe direct antiglobulin (Coombs) test is negative. Osmotic fragility is increased. A peripheral blood smear is shown.\\n\\nWhich of the following is the most likely diagnosis?\", \"choices\": [\"A. Autoimmune hemolytic anemia, warm antibody type\", \"B. Beta-thalassemia trait\", \"C. Glucose-6-phosphate dehydrogenase deficiency\", \"D. Hereditary spherocytosis\", \"E. Pyruvate kinase deficiency\"], \"correct\": 3, \"explanation\": \"Every element of the §9 picture is present: lifelong episodic jaundice, an affected parent (autosomal dominant), splenomegaly, pigmented gallstones in a teenager, spherocytes on the smear, increased osmotic fragility, and a HIGH mean corpuscular hemoglobin concentration.\\n\\nThe mechanism runs in one line. A defective membrane cytoskeletal protein — ankyrin, band 3, β-spectrin, α-spectrin or protein 4.2 — cannot hold the biconcave shape → the cell rounds into a sphere → a sphere has the least surface area for its volume and cannot fold through the splenic cords → splenic macrophages remove it. Extravascular hemolysis, by definition.\\n\\nTwo numbers deserve attention. The mean corpuscular hemoglobin concentration is raised because membrane was lost while hemoglobin was not — the same hemoglobin in a smaller container. And the haptoglobin is only modestly reduced, not absent, exactly as §8 predicts for extravascular destruction.\\n\\nThe NEGATIVE Coombs test is the value that decides the item.\", \"wrongExplanations\": {\"0\": \"Warm autoimmune hemolytic anemia produces spherocytes, jaundice and splenomegaly as well — it is the near-miss, and the reason a Coombs test is mandatory whenever spherocytes are seen. It would be the answer if the direct antiglobulin test were POSITIVE. It also would not explain jaundice dating from early childhood or an affected father.\", \"1\": \"Beta-thalassemia trait gives a low mean corpuscular volume with a near-normal hemoglobin and target cells, not spherocytes. It would be correct with an MCV in the 60s and a high erythrocyte count; her MCV is 87 µm3 and her hemoglobin is 9.3 g/dL.\", \"2\": \"G6PD deficiency is X-linked, so it is expressed fully in males, and its hemolysis is episodic and triggered — an oxidant drug, an infection, or fava beans — with bite cells and blister cells rather than spherocytes. It would be the answer with an acute crisis after an oxidant exposure, not 6 months of steady hemolysis with an affected father.\", \"4\": \"Pyruvate kinase deficiency is an autosomal recessive enzyme defect that also produces chronic extravascular hemolysis from infancy, so it is a genuine competitor. It would be the answer with a NORMAL osmotic fragility, no spherocytes, and a normal mean corpuscular hemoglobin concentration; the increased fragility and the dominant family history point to the membrane instead.\"}, \"eli5\": \"Her red cells are missing part of the scaffolding that holds their doughnut shape, so they become little balls. Balls cannot squeeze through the spleen, so the spleen eats them — which is why she is pale, yellow, and has a big spleen and gallstones.\", \"image\": \"fig_spherocytes\", \"imageCaption\": \"Peripheral blood smear. Many erythrocytes are uniformly round and densely stained and lack the pale central zone seen in normal cells; the cells vary considerably in size.\", \"explanationImage\": \"fig_spherocytes_uw\", \"explanationImageCaption\": \"A higher-power field: small, dense, round erythrocytes without central pallor, alongside larger bluish polychromatophilic cells — the young erythrocytes of a marrow working at maximum.\", \"los\": [{\"n\": 28, \"t\": \"Given a clinical vignette of a patient with hemolytic anemia, characterize clinical presentations, labs and diagnostics (including peripheral smear + hemoglobin electrophoresis findings), therapies and long-term complications.\", \"a\": \"s8-membrane-enzyme\", \"s\": \"§9\"}]}, {\"stem\": \"In a hematology laboratory, erythrocytes from a patient are washed and then incubated in a graded series of sodium chloride solutions of decreasing tonicity, and the proportion of cells that lyse at each concentration is measured against cells from a healthy control. The patient's cells begin to lyse at a HIGHER sodium chloride concentration than control cells, and lysis is complete at a concentration at which most control cells remain intact. On a stained smear, the patient's cells are round and densely stained and lack a pale central zone.\\n\\nWhich of the following properties of the patient's erythrocytes best explains the laboratory result?\", \"choices\": [\"A. Decreased intracellular potassium concentration\", \"B. Decreased ratio of membrane surface area to cell volume\", \"C. Increased hemoglobin affinity for oxygen\", \"D. Increased intracellular viscosity from polymerized hemoglobin\", \"E. Increased membrane permeability to sodium\"], \"correct\": 1, \"explanation\": \"The osmotic fragility test is old-fashioned, but the logic IS the disease. In a hypotonic solution water enters the cell and the cell swells. What decides whether it bursts is how much spare membrane it has for the volume it contains.\\n\\n• A normal biconcave disc carries excess surface area for its volume → it can swell a long way, rounding up into a sphere, before the membrane is stretched to failure.\\n• A spherocyte is already a sphere → its surface-area-to-volume ratio is already minimal → a small amount of water entry ruptures it.\\n\\nSo lysis begins at a higher (less hypotonic) sodium chloride concentration → increased osmotic fragility. This is a test of SHAPE, not of the pump, the hemoglobin, or the permeability of the membrane. Note that it is not specific to hereditary spherocytosis: any process producing spherocytes, including warm autoimmune hemolysis, increases fragility, which is why a direct antiglobulin test is sent alongside it.\", \"wrongExplanations\": {\"0\": \"A fall in intracellular potassium accompanies cell dehydration and would make the cell SHRINK, which if anything protects it from osmotic lysis by giving it more room to swell. It would be the answer only if the question asked about the dehydrated cells of hereditary xerocytosis, whose fragility is characteristically decreased.\", \"2\": \"Oxygen affinity is a property of the hemoglobin molecule and its allosteric effectors, and it has no bearing on whether a membrane ruptures in hypotonic saline. It would matter in a question about hemoglobin Barts or the oxygen dissociation curve, not in one about lysis.\", \"3\": \"Polymerized hemoglobin stiffens the cell and distorts it into a crescent — the mechanism of sickle cell disease. Rigid cells are trapped and fragmented in the microcirculation; they do not show a shifted osmotic lysis curve, and the described cells are round rather than crescent-shaped.\", \"4\": \"A sodium leak lets the cell gain solute and swell, and cation-leak disorders are real. But the cells here are spherical with no central pallor before any incubation, which is a surface-area problem present at baseline; a pure permeability defect would not produce that resting morphology.\"}, \"eli5\": \"A normal red cell is a floppy doughnut with spare skin, so it can puff up a lot before it pops. A cell that is already a tight little ball has no spare skin, so it pops almost immediately in watery salt solution.\", \"explanationImage\": \"fig_spherocytes\", \"explanationImageCaption\": \"Spherocytes on a peripheral blood smear: uniformly round, densely stained cells lacking the pale central zone of a normal biconcave disc.\", \"los\": [{\"n\": 28, \"t\": \"Given a clinical vignette of a patient with hemolytic anemia, characterize clinical presentations, labs and diagnostics (including peripheral smear + hemoglobin electrophoresis findings), therapies and long-term complications.\", \"a\": \"s8-membrane-enzyme\", \"s\": \"§9\"}]}, {\"stem\": \"A 9-year-old girl with known hereditary spherocytosis is brought to the emergency department by her parents because of 3 days of increasing pallor, lethargy, and headache. She had a low-grade fever and a faint lacy rash over her trunk 5 days ago; several children at her school have had a similar illness. Her baseline hemoglobin concentration is 10.5 g/dL. She takes daily folic acid. Her temperature is 37.4°C (99.3°F), pulse is 132/min, respirations are 26/min, and blood pressure is 96/58 mm Hg. Physical examination shows marked pallor and a soft systolic murmur; the spleen is palpated 4 cm below the left costal margin, unchanged from previous examinations. There is no scleral icterus today.\\n\\nLaboratory studies show:\\n  Hemoglobin  4.3 g/dL (N=11.5–15.5 g/dL)\\n  Hematocrit  13% (N=35%–45%)\\n  Mean corpuscular volume  86 µm3 (N=77–95 µm3)\\n  Reticulocyte count  0.2% (N=0.5%–1.5%)\\n  Leukocyte count  6,200/mm3 (N=4500–11,000/mm3)\\n  Platelet count  216,000/mm3 (N=150,000–400,000/mm3)\\n  Total bilirubin  1.1 mg/dL (N=0.1–1.0 mg/dL)\\nWhich of the following infectious agents is the most likely cause of these findings?\", \"choices\": [\"A. Epstein-Barr virus\", \"B. Human parvovirus B19\", \"C. Mycoplasma pneumoniae\", \"D. Salmonella enterica\", \"E. Streptococcus pneumoniae\"], \"correct\": 1, \"explanation\": \"The reticulocyte count of 0.2% is the whole item. In a child whose hemoglobin has fallen from 10.5 to 4.3 g/dL, the marrow should be pouring out reticulocytes. It has stopped instead → this is a production failure superimposed on chronic hemolysis → an APLASTIC crisis.\\n\\nParvovirus B19 infects erythroid precursors through the P antigen and shuts erythropoiesis down for about a week. A healthy child tolerates that pause, because normal erythrocytes live 120 days. A child with hereditary spherocytosis does not: her cells survive only days, and her hemoglobin is held up entirely by a marrow running at maximum. Remove the compensation and the hemoglobin falls off a cliff.\\n\\nTwo quiet details confirm it rather than the rash. Her bilirubin is LOWER than her usual value and she is not icteric — less hemolysis is occurring, not more, because fewer cells are being made to destroy. And her leukocyte and platelet counts are normal, because the virus targets the erythroid line specifically.\\n\\nParvovirus B19 does the identical thing in sickle cell disease.\", \"wrongExplanations\": {\"0\": \"Epstein-Barr virus causes infectious mononucleosis with pharyngitis, cervical lymphadenopathy and atypical lymphocytosis, and it can trigger a cold-agglutinin hemolysis — in which case the reticulocyte count would be HIGH. It would be the answer with sore throat, adenopathy, and a leukocytosis with atypical lymphocytes.\", \"2\": \"Mycoplasma pneumoniae infection is the classic trigger of cold agglutinin disease, which would produce a hemolytic crisis with agglutinated cells on the smear and a RISING reticulocyte count and bilirubin. It would be correct with cough, patchy infiltrates and a raised reticulocyte count — the opposite of the value here.\", \"3\": \"Salmonella species cause osteomyelitis and bacteremia in patients with functional asplenia, particularly in sickle cell disease. That is a febrile, focal illness; it does not selectively shut off erythroid precursors, and this child has no fever, no bone pain, and a normal leukocyte count.\", \"4\": \"Streptococcus pneumoniae is the organism that kills asplenic and hyposplenic patients, and fever in such a child is an emergency. But it produces fulminant sepsis with a high fever, hypotension and a very abnormal leukocyte count, not an isolated reticulocytopenia in a well-perfused, afebrile child.\"}, \"eli5\": \"Her red cells die fast, so her bone marrow has to work flat out just to keep up. A virus turned the marrow's red cell factory off for a week, and without that constant resupply her blood count crashed.\", \"explanationImage\": \"fig_parvo_pronormoblast\", \"explanationImageCaption\": \"Bone marrow in parvovirus B19 infection: erythroid precursors are nearly absent apart from a few very large pronormoblasts with glassy nuclear inclusions.\", \"los\": [{\"n\": 28, \"t\": \"Given a clinical vignette of a patient with hemolytic anemia, characterize clinical presentations, labs and diagnostics (including peripheral smear + hemoglobin electrophoresis findings), therapies and long-term complications.\", \"a\": \"s8-membrane-enzyme\", \"s\": \"§9\"}]}, {\"stem\": \"A 58-year-old woman comes to the office because of a 2-week history of fatigue, exertional dyspnea, and darkening of her eyes' whites. She has no history of serious illness, has never been transfused, and takes no medications. Her temperature is 37.1°C (98.8°F), pulse is 102/min, respirations are 18/min, and blood pressure is 124/78 mm Hg. Physical examination shows scleral icterus and conjunctival pallor; the spleen is palpated 2 cm below the left costal margin. Her fingers and ears are normal in color and are not painful in the cold.\\n\\nLaboratory studies show:\\n  Hemoglobin  8.0 g/dL (N=12.0–16.0 g/dL)\\n  Hematocrit  24% (N=36%–46%)\\n  Mean corpuscular volume  99 µm3 (N=80–100 µm3)\\n  Reticulocyte count  8.4% (N=0.5%–1.5%)\\n  Platelet count  254,000/mm3 (N=150,000–400,000/mm3)\\n  Lactate dehydrogenase  430 U/L (N=45–200 U/L)\\n  Total bilirubin  2.9 mg/dL (N=0.1–1.0 mg/dL)\\n  Direct bilirubin  0.3 mg/dL (N=0.0–0.3 mg/dL)\\n  Haptoglobin  18 mg/dL (N=30–200 mg/dL)\\nA peripheral blood smear shows numerous round, densely stained erythrocytes without central pallor. The direct antiglobulin test is strongly positive for IgG and negative for complement C3. Serum studies show no cold agglutinins. Urinalysis shows no blood.\\n\\nWhich of the following best explains the destruction of this patient's erythrocytes?\", \"choices\": [\"A. Complement-mediated lysis in the circulation triggered by IgM at temperatures below core body temperature\", \"B. Inherited deficiency of a membrane cytoskeletal protein\", \"C. Mechanical fragmentation of erythrocytes within small vessels\", \"D. Oxidative denaturation of hemoglobin with formation of intracellular inclusions\", \"E. Splenic macrophage removal of membrane from IgG-coated erythrocytes\"], \"correct\": 4, \"explanation\": \"Spherocytes plus a POSITIVE direct antiglobulin test for IgG is warm autoimmune hemolytic anemia. IgG autoantibody binds erythrocytes at core body temperature → splenic macrophages engage the Fc portion and remove a piece of membrane rather than the whole cell → the cell loses surface area and rounds up into a spherocyte → on a later pass it is removed entirely. Extravascular destruction, with a spleen that enlarges from the work.\\n\\nEvery laboratory value fits that location. The haptoglobin is reduced but far from absent, there is no hemoglobin in the urine, and the raised mean corpuscular volume simply reflects the reticulocytosis.\\n\\nThe teaching point of §9 is that the smear alone cannot get you here. Spherocytes have exactly two common homes — hereditary spherocytosis and warm autoimmune hemolysis — and only the direct antiglobulin test separates them. It is negative in the inherited disease and positive here. Note also that the antibody class localizes the destruction: IgG means warm, splenic and extravascular; IgM with C3 means cold, complement-mediated and intravascular.\", \"wrongExplanations\": {\"0\": \"That is cold agglutinin disease: IgM binds in cooled peripheral blood, fixes complement, and lyses cells inside the vessel. It would be the answer with acrocyanosis or pain in the cold, agglutinated cells on the smear, a positive test for cold agglutinins, and a direct antiglobulin test positive for C3 rather than IgG.\", \"1\": \"An inherited cytoskeletal defect — hereditary spherocytosis — produces an identical smear and a similar clinical picture, which is exactly why this item exists. It would be the answer if the direct antiglobulin test were NEGATIVE, and it typically declares itself in childhood with a family history rather than over 2 weeks at age 58.\", \"2\": \"Mechanical fragmentation gives schistocytes — angular fragments with straight edges — together with the intravascular signature of an absent haptoglobin and hemoglobinuria. It would be the answer with a prosthetic valve or a microangiopathy and a low platelet count; her platelets are normal and there is no blood in her urine.\", \"3\": \"Oxidative denaturation produces Heinz bodies, and the splenic bite taken out of them leaves bite cells and blister cells — the G6PD picture. It would be the answer after an oxidant drug or fava beans, and it would not produce a positive direct antiglobulin test.\"}, \"eli5\": \"Her immune system has coated her own red cells with antibody, and the spleen nibbles pieces off them until they turn into little balls and get eaten. The blood test that finds the antibody stuck on the cells is what proves it is her immune system and not an inherited cell problem.\", \"explanationImage\": \"fig_aiha\", \"explanationImageCaption\": \"Warm (IgG) versus cold (IgM) autoimmune hemolysis: IgG-coated cells are stripped of membrane by splenic macrophages, while IgM plus complement lyses cells within the vessel.\", \"los\": [{\"n\": 28, \"t\": \"Given a clinical vignette of a patient with hemolytic anemia, characterize clinical presentations, labs and diagnostics (including peripheral smear + hemoglobin electrophoresis findings), therapies and long-term complications.\", \"a\": \"s8-membrane-enzyme\", \"s\": \"§9\"}]}, {\"stem\": \"A 7-year-old boy is brought to the emergency department by his mother because of 1 day of dark brown urine, fatigue, and yellow eyes. Two days ago he was started on trimethoprim-sulfamethoxazole for a urinary tract infection. He has been otherwise healthy and takes no other medications. An older brother had an episode of jaundice after an antibiotic several years ago. His temperature is 37.3°C (99.1°F), pulse is 118/min, respirations are 24/min, and blood pressure is 102/64 mm Hg. Physical examination shows scleral icterus and pallor; the spleen is not palpable and there is no abdominal tenderness.\\n\\nLaboratory studies show:\\n  Hemoglobin  7.4 g/dL (N=11.5–15.5 g/dL)\\n  Hematocrit  22% (N=35%–45%)\\n  Mean corpuscular volume  88 µm3 (N=77–95 µm3)\\n  Reticulocyte count  3.4% (N=0.5%–1.5%)\\n  Platelet count  288,000/mm3 (N=150,000–400,000/mm3)\\n  Lactate dehydrogenase  690 U/L (N=45–200 U/L)\\n  Haptoglobin  <10 mg/dL (N=30–200 mg/dL)\\n  Total bilirubin  3.1 mg/dL (N=0.1–1.0 mg/dL)\\n  Direct bilirubin  0.2 mg/dL (N=0.0–0.3 mg/dL)\\nThe direct antiglobulin test is negative. A peripheral blood smear is shown.\\n\\nWhich of the following is the most likely diagnosis?\", \"choices\": [\"A. Autoimmune hemolytic anemia\", \"B. Glucose-6-phosphate dehydrogenase deficiency\", \"C. Hereditary spherocytosis\", \"D. Microangiopathic hemolytic anemia\", \"E. Sickle cell disease\"], \"correct\": 1, \"explanation\": \"An acute hemolytic episode beginning within 2 days of a sulfonamide, in a previously well boy, with a smear showing cells that appear to have had a semicircular chunk removed: this is G6PD deficiency.\\n\\nThe chain is short. The drug generates oxidants → without G6PD the cell cannot regenerate reduced glutathione → hydrogen peroxide accumulates → hemoglobin is oxidized, denatures, and precipitates onto the inner membrane as a HEINZ BODY → a splenic macrophage removes the inclusion together with the overlying membrane → a BITE CELL. Less damaged cells round up as spherocytes, which is one more reason spherocytes alone never make a diagnosis.\\n\\nThe X-linked inheritance shows in the affected brother and the male patient. The undetectable haptoglobin marks a substantial intravascular component, which is why his urine is dark. Heinz bodies themselves require a supravital stain such as crystal violet — they are invisible on this routine smear, so do not wait for them.\\n\\nManagement is to stop the offending drug and support him; the episode is self-limited.\", \"wrongExplanations\": {\"0\": \"Autoimmune hemolysis produces spherocytes and a POSITIVE direct antiglobulin test — his is negative, which is the value that excludes it. It would also not be triggered within 48 hours by a first exposure to a sulfonamide in this way.\", \"2\": \"Hereditary spherocytosis is autosomal dominant and chronic: lifelong episodic jaundice, splenomegaly, gallstones, a high mean corpuscular hemoglobin concentration and increased osmotic fragility. It would be the answer with a palpable spleen and a history dating from early childhood rather than a first episode 2 days after a drug.\", \"3\": \"Microangiopathic hemolysis shears cells into schistocytes and is accompanied by a LOW platelet count and usually renal or neurologic findings. It would be correct with fragments on the smear and thrombocytopenia; his platelet count is 288,000/mm3 and the cells have bites taken out of them rather than being fragmented.\", \"4\": \"Sickle cell disease produces crescent-shaped cells, target cells and Howell-Jolly bodies, with pain crises and dactylitis from infancy and a chronically raised reticulocyte count. It is detected on newborn screening and would not first appear at age 7 after an antibiotic.\"}, \"eli5\": \"His red cells have no way to mop up the damage an oxidizing drug causes, so the hemoglobin inside clumps up. The spleen takes a bite out of each cell to remove the clump, leaving cells that look like someone bit a piece off a cookie.\", \"image\": \"fig_bite_cells\", \"imageCaption\": \"Peripheral blood smear. Several erythrocytes have a smooth semicircular defect at the edge, as though a portion had been removed, and appear smaller and more densely stained than the surrounding cells.\", \"explanationImage\": \"fig_bite_uw\", \"explanationImageCaption\": \"A second field showing the same finding: erythrocytes with a discrete semicircular portion of the periphery missing.\", \"los\": [{\"n\": 28, \"t\": \"Given a clinical vignette of a patient with hemolytic anemia, characterize clinical presentations, labs and diagnostics (including peripheral smear + hemoglobin electrophoresis findings), therapies and long-term complications.\", \"a\": \"s8-membrane-enzyme\", \"s\": \"§9\"}]}, {\"stem\": \"A 6-year-old boy is brought to the office by his parents because of 2 days of pallor, dark urine, and yellow eyes that began the day after a family meal that included fava beans. He has had no fever, cough, or diarrhea. He takes no medications. His temperature is 37.0°C (98.6°F), pulse is 112/min, respirations are 22/min, and blood pressure is 98/60 mm Hg. Physical examination shows scleral icterus and pallor. His hemoglobin concentration is 6.9 g/dL, hematocrit is 21%, and lactate dehydrogenase activity is 720 U/L. A supravital stain of the peripheral blood shows small round inclusions attached to the inner surface of the erythrocyte membrane.\\n\\nImpairment of which of the following processes best explains the formation of these inclusions?\", \"choices\": [\"A. Conversion of hydrogen peroxide to water by glutathione peroxidase\", \"B. Generation of adenosine triphosphate by anaerobic glycolysis\", \"C. Generation of NADPH in the hexose monophosphate shunt\", \"D. Reduction of methemoglobin by cytochrome b5 reductase\", \"E. Synthesis of the globin chains of hemoglobin\"], \"correct\": 2, \"explanation\": \"The inclusions are Heinz bodies — precipitated, oxidized hemoglobin — and the step that fails upstream of them is NADPH production.\\n\\nThe chain, in order: glucose-6-phosphate dehydrogenase is the rate-limiting enzyme of the hexose monophosphate (pentose phosphate) shunt → it generates NADPH → NADPH powers glutathione reductase, which regenerates REDUCED glutathione from its oxidized form → reduced glutathione lets glutathione peroxidase convert hydrogen peroxide to water. Break the first link and everything downstream idles for want of reducing power → peroxide accumulates → hemoglobin is oxidized, denatures and precipitates as a Heinz body.\\n\\nWhy this is fatal specifically to a red cell: it has no nucleus and no mitochondria. It cannot make replacement enzyme, and it has no alternative route to NADPH. G6PD is the entire antioxidant plan, with no backup — which is why a single meal of fava beans can drop a hemoglobin by half.\", \"wrongExplanations\": {\"0\": \"Glutathione peroxidase performs the actual detoxifying step, and it is the correct pathway — but the enzyme itself is present and functional here. It idles because its substrate, reduced glutathione, cannot be regenerated without NADPH. This is the mechanism-confusion option: right pathway, wrong step.\", \"1\": \"Anaerobic glycolysis supplies the red cell's adenosine triphosphate, and its failure is pyruvate kinase deficiency — a chronic hemolytic anemia from infancy with rigid, energy-depleted cells. It would be the answer without an oxidant trigger and without Heinz bodies.\", \"3\": \"Cytochrome b5 reductase returns oxidized ferric iron in methemoglobin to the ferrous state; its deficiency causes congenital methemoglobinemia with cyanosis and chocolate-brown blood that does not correct with oxygen. That is oxidation of the IRON, not precipitation of the globin, and it would be the answer with cyanosis rather than hemolysis.\", \"4\": \"Deficient globin chain synthesis is thalassemia. Unpaired chains do precipitate and can also form inclusions, so the option is genuinely tempting — but that process is chronic and lifelong, produces microcytosis and target cells, and is not triggered by a single oxidant meal in a previously well child.\"}, \"eli5\": \"Red cells need a constant supply of a chemical called NADPH to neutralize the damaging oxygen chemicals that build up. One enzyme makes all of it, and if that enzyme is faulty, hemoglobin gets chemically burned and clumps into blobs inside the cell.\", \"explanationImage\": \"fig_g6pd_pathway\", \"explanationImageCaption\": \"The protective pathway: glucose-6-phosphate dehydrogenase generates NADPH, NADPH regenerates reduced glutathione, and glutathione peroxidase converts hydrogen peroxide to water.\", \"los\": [{\"n\": 28, \"t\": \"Given a clinical vignette of a patient with hemolytic anemia, characterize clinical presentations, labs and diagnostics (including peripheral smear + hemoglobin electrophoresis findings), therapies and long-term complications.\", \"a\": \"s8-membrane-enzyme\", \"s\": \"§9\"}]}, {\"stem\": \"A 10-year-old boy is admitted to the hospital because of 2 days of pallor, jaundice and dark urine that began shortly after he was given primaquine before travel. His hemoglobin concentration is 7.1 g/dL, reticulocyte count is 4.6%, haptoglobin is less than 10 mg/dL (N=30–200 mg/dL), and the direct antiglobulin test is negative. A peripheral blood smear shows erythrocytes with a semicircular portion of the periphery missing. The drug is stopped, and over the next week his hemoglobin concentration rises to 10.8 g/dL without transfusion. An erythrocyte glucose-6-phosphate dehydrogenase assay drawn on the second hospital day is reported as within the reference range.\\n\\nWhich of the following is the most appropriate next step in diagnosis?\", \"choices\": [\"A. Measure erythrocyte glucose-6-phosphate dehydrogenase activity again in 3 months\", \"B. Measure erythrocyte pyruvate kinase activity\", \"C. Obtain a bone marrow aspirate and biopsy\", \"D. Perform an osmotic fragility test\", \"E. Perform hemoglobin electrophoresis\"], \"correct\": 0, \"explanation\": \"A normal enzyme assay drawn during a crisis does not exclude G6PD deficiency, and the reason follows directly from the mechanism of the disease.\\n\\nThe variant enzyme is not absent — it is UNSTABLE, with a shortened half-life, so activity decays as a red cell ages. Deficiency is therefore worst in the OLDEST cells. During a hemolytic episode two things happen at once: those old, enzyme-depleted cells are precisely the ones being destroyed and removed from the sample, and the marrow floods the circulation with reticulocytes, which carry the HIGHEST enzyme activity of any red cell. Measure the average of what is left and it can look entirely normal.\\n\\nThe fix is timing. Repeat the assay 2 to 3 months after the episode, once the age distribution of the red cell population has returned to baseline. A genetic test is unaffected by timing and is an acceptable alternative at any point.\\n\\nEverything else in this vignette already says G6PD deficiency: an oxidant drug, bite cells, an intravascular signature, a negative Coombs test, and spontaneous recovery once the drug was stopped.\", \"wrongExplanations\": {\"1\": \"Pyruvate kinase deficiency is the other red cell enzyme defect worth knowing, but it causes chronic hemolysis from infancy without an oxidant trigger and without bite cells. It would be the answer in a child with lifelong anemia and a normal G6PD level measured at a valid time.\", \"2\": \"A marrow examination answers questions about production — aplasia, infiltration, dysplasia. This marrow is demonstrably working, since his hemoglobin rose by 3.7 g/dL in a week without transfusion. It is an invasive test that would not address the enzyme question.\", \"3\": \"Osmotic fragility tests for spherocytes, and would be the next step if the smear had shown round cells without central pallor in a child with splenomegaly and a family history of gallstones. His smear shows bite cells, his spleen is not enlarged, and his illness began with a drug.\", \"4\": \"Hemoglobin electrophoresis identifies structural variants and thalassemias — it would be the answer for a chronic microcytic anemia with target cells or for suspected sickling. It does not measure enzyme activity and would be normal in this boy.\"}, \"eli5\": \"The test looked normal only because it was done at the wrong moment: the damaged old cells had already been destroyed and the new ones are full of the enzyme. Wait a couple of months for his blood to settle back to normal, then test again.\", \"explanationImage\": \"fig_heinz\", \"explanationImageCaption\": \"Supravital staining of the same kind of episode: erythrocytes containing small round inclusions of precipitated hemoglobin, which are invisible on a routine stain.\", \"los\": [{\"n\": 28, \"t\": \"Given a clinical vignette of a patient with hemolytic anemia, characterize clinical presentations, labs and diagnostics (including peripheral smear + hemoglobin electrophoresis findings), therapies and long-term complications.\", \"a\": \"s8-membrane-enzyme\", \"s\": \"§9\"}]}, {\"stem\": \"A 22-year-old man is admitted to the hospital because of 3 days of fatigue, jaundice and dark urine that began 2 days after he started dapsone for a dermatologic condition. His hemoglobin concentration on admission is 8.2 g/dL and his reticulocyte count is 5.2%. The dermatologic condition requires continued treatment, and dapsone is continued at the same dose. Over the following 10 days his jaundice resolves, his urine clears, and his hemoglobin concentration rises to 12.9 g/dL despite ongoing therapy. Erythrocyte glucose-6-phosphate dehydrogenase activity measured 3 months later is 22% of normal.\\n\\nWhich of the following best explains the resolution of hemolysis despite continued exposure to the drug?\", \"choices\": [\"A. Antibody against the drug was cleared from the circulation\", \"B. Hepatic metabolism of the drug was induced, lowering its oxidant load\", \"C. Splenic macrophages became saturated and stopped removing damaged cells\", \"D. The enzyme-deficient older erythrocytes were destroyed and replaced by young, enzyme-replete cells\", \"E. Tolerance developed through downregulation of erythrocyte oxidant receptors\"], \"correct\": 3, \"explanation\": \"This is the behavior of a moderate (WHO class III) variant such as G6PD A−, and it follows from one fact: the mutant enzyme is unstable, not absent. Its half-life is roughly 13 days against a normal 62, so activity decays steeply as a cell ages.\\n\\nThat gives an age-graded vulnerability. When the oxidant arrives, the OLD cells — the ones whose enzyme has already decayed — hemolyze; the young cells are still protected. The oldest fraction of the population is destroyed within days, the marrow replaces it with reticulocytes carrying near-normal enzyme activity, and the remaining population is resistant to the same insult. Hemolysis stops even though the drug continues. This is why class III episodes are described as self-limited.\\n\\nThe contrast worth carrying is G6PD Mediterranean (WHO class II), where activity is under 10% and the enzyme half-life is measured in hours. There is no protected young population, the entire red cell mass is vulnerable, and hemolysis can be severe and sustained — that patient does not self-correct and the drug must be stopped.\\n\\nThe same age dependence is what makes an enzyme assay falsely normal during a crisis.\", \"wrongExplanations\": {\"0\": \"Drug-dependent antibody is a real mechanism of immune hemolysis, and it would be the answer with a POSITIVE direct antiglobulin test. Here the defect is enzymatic and heritable, confirmed by an enzyme activity of 22% measured after recovery, and immune hemolysis would not remit while the drug continued.\", \"1\": \"Enzyme induction can lower the concentration of some drugs, but dapsone's oxidant metabolites are generated by that same hepatic metabolism, so induction would if anything worsen the hemolysis. It would also not explain why the reticulocyte-rich population is protected.\", \"2\": \"Splenic macrophages do not saturate and switch off — and this episode has a substantial intravascular component in any case. If splenic clearance were the limiting step, the damaged cells would accumulate in the circulation rather than the patient recovering a normal hemoglobin.\", \"4\": \"There is no such thing as an erythrocyte oxidant receptor to downregulate, and a red cell has no nucleus with which to alter gene expression. The protection acquired here is demographic — a younger cell population — not adaptive.\"}, \"eli5\": \"The faulty enzyme wears out as a red cell gets older, so only his oldest cells were vulnerable. Once those were destroyed and replaced with brand-new cells, the rest could handle the drug just fine.\", \"explanationImage\": \"fig_bite_uw\", \"explanationImageCaption\": \"The morphologic fingerprint of the episode: erythrocytes with a semicircular portion removed after a splenic macrophage extracted a Heinz body.\", \"los\": [{\"n\": 28, \"t\": \"Given a clinical vignette of a patient with hemolytic anemia, characterize clinical presentations, labs and diagnostics (including peripheral smear + hemoglobin electrophoresis findings), therapies and long-term complications.\", \"a\": \"s8-membrane-enzyme\", \"s\": \"§9\"}]}, {\"stem\": \"A 3-year-old boy is brought to the office for evaluation of chronic anemia first noted at 9 months of age. He has required no transfusions. His parents report that he tires more easily than his sibling. His temperature is 37.0°C (98.6°F), pulse is 104/min, and blood pressure is 94/56 mm Hg. Physical examination shows mild scleral icterus and a spleen palpated 3 cm below the left costal margin.\\n\\nLaboratory studies show:\\n  Hemoglobin  8.6 g/dL (N=11.5–15.5 g/dL)\\n  Hematocrit  26% (N=35%–45%)\\n  Mean corpuscular volume  61 µm3 (N=77–95 µm3)\\n  Reticulocyte count  4.8% (N=0.5%–1.5%)\\n  Serum ferritin  96 ng/mL (N=10–120 ng/mL)\\n  Total iron-binding capacity  302 µg/dL (N=250–400 µg/dL)\\n  Total bilirubin  2.2 mg/dL (N=0.1–1.0 mg/dL)\\nA peripheral blood smear shows hypochromic erythrocytes with marked variation in size and shape and many cells with a central dark area surrounded by a pale ring. Supravital staining shows erythrocytes with multiple small inclusions composed of a beta globin tetramer. Hemoglobin electrophoresis shows no hemoglobin S and a normal hemoglobin A2 concentration.\\n\\nDeletion of how many alpha globin genes best accounts for these findings?\", \"choices\": [\"A. One of four\", \"B. Two of four\", \"C. Three of four\", \"D. Four of four\"], \"correct\": 2, \"explanation\": \"The inclusions made of a BETA globin tetramer are hemoglobin H (β₄), and hemoglobin H disease means three of the four alpha genes are deleted, leaving one working gene.\\n\\nThe framework is arithmetic. Adult hemoglobin is α₂β₂; you carry FOUR alpha genes (two on each chromosome 16) and only two beta genes (one on each chromosome 11). With alpha globin severely reduced, the beta chains produced have no partner, so they self-associate into β₄ — unstable, oxidized, precipitating, and removed by the spleen. Hence the moderate anemia, the splenomegaly and the reticulocytosis without transfusion dependence.\\n\\nThe two negatives in the stem do real work. Normal iron studies exclude iron deficiency as the cause of the microcytosis, and a NORMAL hemoglobin A2 excludes beta-thalassemia trait, in which A2 is raised. Alpha thalassemia is the microcytic anemia in which electrophoresis is essentially unremarkable in an older child — the diagnosis comes from the hemoglobin H inclusions and gene testing.\", \"wrongExplanations\": {\"0\": \"A single gene deletion is the silent carrier state: three working alpha genes, no anemia, normal indices, and no clinical findings whatsoever. More than one person in any lecture hall has it and will never know. It cannot produce a hemoglobin of 8.6 g/dL with splenomegaly.\", \"1\": \"Two deletions give alpha-thalassemia trait: microcytosis with minimal or no anemia and normal iron studies — the state most often mistaken for iron deficiency. There is not enough excess beta chain to form hemoglobin H inclusions, and the spleen is not enlarged.\", \"3\": \"Deletion of all four genes makes no alpha-containing hemoglobin possible at all. Excess gamma chains form hemoglobin Barts (γ₄), which binds oxygen and will not release it, causing severe intrauterine anoxia — hydrops fetalis. Without intrauterine intervention such a fetus does not survive to become a 3-year-old in the office.\"}, \"eli5\": \"Hemoglobin needs two kinds of chain, and this boy has lost three of his four genes for one of them. The leftover chains clump together inside his red cells, and his spleen destroys the cells that carry the clumps.\", \"explanationImage\": \"fig_globin_chains\", \"explanationImageCaption\": \"Globin chain composition of the normal and abnormal hemoglobins, including the β₄ and γ₄ tetramers that form when alpha chains are deficient.\", \"los\": [{\"n\": 28, \"t\": \"Given a clinical vignette of a patient with hemolytic anemia, characterize clinical presentations, labs and diagnostics (including peripheral smear + hemoglobin electrophoresis findings), therapies and long-term complications.\", \"a\": \"s9-globin\", \"s\": \"§10\"}]}, {\"stem\": \"A 26-year-old woman, gravida 2, para 1, is evaluated at 28 weeks' gestation because ultrasonography shows fetal ascites, pleural effusions, generalized skin edema, and cardiomegaly. Both she and the father of the fetus have mild microcytosis with normal iron studies. Fetal blood sampling shows severe anemia; hemoglobin analysis shows that nearly all of the fetal hemoglobin is a tetramer of gamma globin chains, with no hemoglobin F and no hemoglobin A detected.\\n\\nWhich of the following best explains the severe tissue hypoxia in this fetus?\", \"choices\": [\"A. The tetramer binds oxygen with such high affinity that it does not release it to tissue\", \"B. The tetramer cannot bind oxygen because it lacks a heme group\", \"C. The tetramer is oxidized to the ferric state and cannot bind oxygen\", \"D. The tetramer polymerizes when deoxygenated and occludes the microcirculation\", \"E. The tetramer precipitates in erythroid precursors, preventing their release from the marrow\"], \"correct\": 0, \"explanation\": \"A tetramer of four gamma chains is hemoglobin Barts, and it forms when NO functional alpha genes remain — all four deleted. Because every physiologic hemoglobin (A, F and A2) requires alpha chains, none of them can be assembled, and the gamma chains that would normally pair with alpha associate with each other instead.\\n\\nThe problem is not binding oxygen; it is releasing it. Hemoglobin Barts has an extremely high oxygen affinity, so it takes up oxygen in the placenta and holds onto it. The fetus is full of hemoglobin and still profoundly anoxic → high-output cardiac failure, generalized edema, effusions and ascites → hydrops fetalis. Untreated it is lethal in utero or shortly after birth; survival requires intrauterine transfusion and, later, transplantation.\\n\\nThe parallel with hemoglobin H disease is the point §10 is making. There, ONE alpha gene remains, the excess partner is beta, and β₄ is unstable rather than avid — it precipitates and is removed by the spleen, giving a survivable hemolytic anemia. Which chain is left over, and how that tetramer behaves, is what separates a manageable disease from a lethal one.\", \"wrongExplanations\": {\"1\": \"Hemoglobin Barts assembles normally around its heme groups — the defect is in the globin genes, not in heme synthesis. A failure of heme production is the porphyrias and sideroblastic anemias, which would be the answer with ringed sideroblasts and abnormal porphyrin intermediates.\", \"2\": \"Oxidation of heme iron to the ferric state is methemoglobinemia, which would be the answer in a cyanotic neonate with chocolate-brown blood unresponsive to oxygen, often after an oxidizing agent. It is not a consequence of losing alpha globin genes.\", \"3\": \"Polymerization on deoxygenation is the mechanism of hemoglobin S, and it would be the answer with sickled erythrocytes and vaso-occlusion. Sickle cell disease is a beta chain structural mutation; it does not present as hydrops with a gamma tetramer.\", \"4\": \"Precipitation inside precursors with intramedullary death — ineffective erythropoiesis — is the mechanism of beta-thalassemia major and part of hemoglobin H disease. It would be the answer with an unpartnered ALPHA chain excess, and it produces a severe anemia after birth rather than a fetus whose hemoglobin cannot unload oxygen.\"}, \"eli5\": \"This baby cannot make one of the two building blocks of hemoglobin at all, so the leftover blocks stick together into a version that grabs oxygen and refuses to let go. The blood is full of oxygen that never reaches the tissues.\", \"explanationImage\": \"fig_globin_chains\", \"explanationImageCaption\": \"Which tetramer forms depends on which partner chain is missing: β₄ (hemoglobin H) when one alpha gene remains, γ₄ (hemoglobin Barts) when none does.\", \"los\": [{\"n\": 28, \"t\": \"Given a clinical vignette of a patient with hemolytic anemia, characterize clinical presentations, labs and diagnostics (including peripheral smear + hemoglobin electrophoresis findings), therapies and long-term complications.\", \"a\": \"s9-globin\", \"s\": \"§10\"}]}, {\"stem\": \"A 7-month-old boy is brought to the office by his parents because of increasing pallor and poor weight gain over the past 6 weeks. He was born at term after an uncomplicated pregnancy, and his newborn examination and growth in the first months of life were normal. His temperature is 37.1°C (98.8°F), pulse is 148/min, and respirations are 38/min. Physical examination shows marked pallor, mild scleral icterus, and a spleen palpated 4 cm below the left costal margin.\\n\\nLaboratory studies show:\\n  Hemoglobin  6.4 g/dL (N=10.5–13.5 g/dL)\\n  Hematocrit  19% (N=33%–39%)\\n  Mean corpuscular volume  62 µm3 (N=70–86 µm3)\\n  Reticulocyte count  5.2% (N=0.5%–1.5%)\\n  Serum ferritin  180 ng/mL (N=10–120 ng/mL)\\nA peripheral blood smear shows hypochromic erythrocytes, marked variation in size and shape, target cells, and nucleated erythrocytes. Hemoglobin electrophoresis shows markedly reduced hemoglobin A with elevated hemoglobin F and elevated hemoglobin A2.\\n\\nWhich of the following best explains why this infant was healthy at birth and for the first months of life?\", \"choices\": [\"A. Fetal hemoglobin contains gamma chains in place of the deficient beta chains\", \"B. Maternal hemoglobin crossed the placenta and persisted in the infant's circulation\", \"C. Neonatal erythrocytes have a longer lifespan than those of older infants\", \"D. Physiologic splenic function does not mature until approximately 6 months of age\", \"E. Transfused hemoglobin A from delivery persisted through the first months of life\"], \"correct\": 0, \"explanation\": \"Fetal hemoglobin is α₂γ₂ — it contains NO beta chains at all. An infant with beta-thalassemia major is therefore genuinely well in utero and in early infancy, because the hemoglobin he is running on does not require the gene that is defective.\\n\\nThe illness appears with the globin switch. Gamma chain production falls off over the first 3 to 6 months and beta is meant to take over → in this infant beta output is absent or nearly so → hemoglobin A cannot be assembled → the anemia declares itself at precisely the age described. His electrophoresis is a picture of a switch that never completed: little hemoglobin A, persistently high hemoglobin F, and raised hemoglobin A2 (α₂δ₂) as delta chains take up some of the unpartnered alpha.\\n\\nThe damage is done by the chain he has too MUCH of. Unpartnered alpha chains precipitate in erythroid precursors and kill them in the marrow (ineffective erythropoiesis) and mark surviving cells for splenic removal. Hence a hypercellular marrow with a profoundly anemic child, hepatosplenomegaly, and — later — frontal bossing and maxillary prominence from marrow cavity expansion.\", \"wrongExplanations\": {\"1\": \"Maternal hemoglobin does not cross the placenta; only the gases and nutrients do, and the fetus makes its own erythrocytes from the first weeks of gestation. If maternal hemoglobin were the explanation, every fetal hemoglobinopathy would present identically at birth.\", \"2\": \"Neonatal erythrocytes actually have a SHORTER lifespan than adult cells — roughly 60 to 90 days — which contributes to physiologic anemia of infancy. A longer lifespan would be the answer only if it were true, and it would not explain an electrophoresis showing persistent hemoglobin F.\", \"3\": \"Splenic function is relevant to infection risk in asplenia, not to when a globin defect becomes apparent. It would matter in a question about encapsulated organisms in sickle cell disease; it does not determine which hemoglobin an infant is using.\", \"4\": \"He was not transfused — the pregnancy and delivery were uncomplicated. Even if he had been, donor erythrocytes survive only weeks, and this explanation would not account for the raised hemoglobin F and A2 on his electrophoresis.\"}, \"eli5\": \"Babies use a special baby hemoglobin that does not need the broken part at all, so he was fine at first. Around 6 months the body switches over to the adult version — and that is the one he cannot make.\", \"explanationImage\": \"fig_beta_thal_uw\", \"explanationImageCaption\": \"Peripheral blood in beta-thalassemia: small, pale erythrocytes with marked variation in size and shape and numerous target cells.\", \"los\": [{\"n\": 28, \"t\": \"Given a clinical vignette of a patient with hemolytic anemia, characterize clinical presentations, labs and diagnostics (including peripheral smear + hemoglobin electrophoresis findings), therapies and long-term complications.\", \"a\": \"s9-globin\", \"s\": \"§10\"}]}, {\"stem\": \"A 24-year-old woman comes to the office for a routine examination. She feels well, exercises regularly, and has regular light menstrual periods. Six months ago a complete blood count obtained at a blood drive showed a small mean corpuscular volume, and she has taken ferrous sulfate 325 mg by mouth daily since then without any change in her indices. She takes no other medications and eats a varied diet including red meat. Vital signs are within normal limits. Physical examination shows no abnormalities; there is no scleral icterus and the spleen is not palpable.\\n\\nLaboratory studies show:\\n  Hemoglobin  11.4 g/dL (N=12.0–16.0 g/dL)\\n  Hematocrit  34% (N=36%–46%)\\n  Mean corpuscular volume  66 µm3 (N=80–100 µm3)\\n  Red cell distribution width  13.1% (N=11.5%–14.5%)\\n  Reticulocyte count  1.4% (N=0.5%–1.5%)\\n  Platelet count  246,000/mm3 (N=150,000–400,000/mm3)\\nA peripheral blood smear is shown. Testing of the stool for occult blood is negative on three specimens.\\n\\nAdditional studies are obtained:\\n\\n    Serum iron | Total iron-binding capacity | Ferritin | Erythrocyte count\\n\\nWhich of the following sets of results is most likely in this patient?\", \"choices\": [\"A. Decreased, decreased, increased, decreased\", \"B. Decreased, increased, decreased, decreased\", \"C. Increased, decreased, increased, decreased\", \"D. Normal, normal, normal, decreased\", \"E. Normal, normal, normal, increased\"], \"correct\": 4, \"explanation\": \"Thalassemia trait is the microcytosis with NORMAL iron studies, and the erythrocyte count is the detail that separates it from everything else on the list.\\n\\nRead the clues in order. Her mean corpuscular volume of 66 µm3 is disproportionately low for a hemoglobin of 11.4 g/dL — iron deficiency severe enough to shrink cells that far would leave her far more anemic. Her red cell distribution width is normal, whereas iron deficiency produces a wide one as small cells mix with older normal cells. She has no source of blood loss, three negative stool tests, and 6 months of iron with no response. And she makes MORE erythrocytes than expected: in thalassemia the marrow produces a large number of small, poorly filled cells, so the count is normal or high while the hemoglobin is only mildly low.\\n\\nThe practical consequence is in §10's warning box. Iron given to a thalassemic patient treats nothing and eventually produces the iron overload that the rest of their care is spent chelating out. The next step here is hemoglobin electrophoresis, expected to show raised hemoglobin A2 in beta-thalassemia trait, with gene testing if alpha thalassemia is suspected.\", \"wrongExplanations\": {\"0\": \"Low iron, LOW total iron-binding capacity and a normal or high ferritin is the anemia of chronic disease row — iron sequestered by hepcidin rather than absent. It would be the answer in a patient with an inflammatory, infectious or malignant illness; she is well, exercises, and has no such disease.\", \"1\": \"Low iron, HIGH total iron-binding capacity and low ferritin is iron deficiency, the row most students pick here. It would be the answer with a wide red cell distribution width, a source of blood loss, and — critically — a response to 6 months of oral iron. She has none of those.\", \"2\": \"High iron with a high ferritin and a low iron-binding capacity is the sideroblastic or iron-overload row, in which iron reaches the cell but cannot be incorporated into heme. It would be the answer with ringed sideroblasts on a Prussian blue stain of the marrow, or with a history of lead exposure or alcohol use.\", \"3\": \"This row has the iron studies right and the last column wrong, which is what makes it the near-miss. Thalassemia trait characteristically raises the erythrocyte count rather than lowering it — the marrow turns out many small underfilled cells — and a low count with normal iron studies would point instead toward a hypoproliferative process.\"}, \"eli5\": \"Her red cells are small but she is barely anemic, and she has plenty of them — that is the fingerprint of a hemoglobin-building fault, not a shortage of iron. Six months of iron tablets did nothing because iron was never the problem.\", \"image\": \"fig_target_cells\", \"imageCaption\": \"Peripheral blood smear. The erythrocytes are small and pale, and many show a dark central area surrounded by a pale ring within a darker outer rim.\", \"explanationImage\": \"fig_ida_progression\", \"explanationImageCaption\": \"For contrast, the sequence of laboratory change in true iron deficiency: ferritin falls first, then serum iron and transferrin saturation, and only last the mean corpuscular volume and hemoglobin.\", \"los\": [{\"n\": 28, \"t\": \"Given a clinical vignette of a patient with hemolytic anemia, characterize clinical presentations, labs and diagnostics (including peripheral smear + hemoglobin electrophoresis findings), therapies and long-term complications.\", \"a\": \"s9-globin\", \"s\": \"§10\"}, {\"n\": 20, \"t\": \"Differentiate clinical causes of nutritional anemias (iron, B12 + folate deficiency) by clinical presentation, etiologies, laboratory studies, and diagnostics.\", \"a\": \"s4-iron\", \"s\": \"§4\"}]}, {\"stem\": \"A 9-year-old girl with beta-thalassemia major is evaluated during a routine visit. She has received packed red blood cell transfusions every 3 to 4 weeks since 14 months of age. She takes folic acid daily. Her height and weight are below the 5th percentile for age, and she has not begun puberty. Her temperature is 37.0°C (98.6°F), pulse is 92/min, and blood pressure is 104/64 mm Hg. Physical examination shows a greyish-brown discoloration of the skin, a liver edge palpated 4 cm below the right costal margin, and no scleral icterus.\\n\\nLaboratory studies show:\\n  Hemoglobin  9.8 g/dL (N=11.5–15.5 g/dL)\\n  Serum ferritin  2,840 ng/mL (N=10–120 ng/mL)\\n  Transferrin saturation  88% (N=20%–50%)\\n  Alanine aminotransferase  96 U/L (N=10–40 U/L)\\n  Fasting serum glucose  118 mg/dL (N=70–100 mg/dL)\\nEchocardiography shows normal ventricular function. Which of the following is the most appropriate next step in management?\", \"choices\": [\"A. Begin oral deferasirox therapy\", \"B. Begin oral ferrous sulfate therapy\", \"C. Begin subcutaneous erythropoietin therapy\", \"D. Discontinue transfusions and observe\", \"E. Perform serial therapeutic phlebotomy\"], \"correct\": 0, \"explanation\": \"Every unit of transfused blood carries about 200–250 mg of iron, and the human body has NO physiologic mechanism for excreting iron. A child transfused every 3 to 4 weeks since infancy accumulates it relentlessly, and the deposits land in the organs named in this vignette: liver (hepatomegaly, raised transaminases), pancreas (impaired glucose tolerance), pituitary and gonads (growth failure and delayed puberty), skin (bronze discoloration), and — the one that kills — the heart.\\n\\nThe treatment is chelation: deferasirox (oral, once daily) or deferoxamine (parenteral). Thresholds in common use are a ferritin persistently above about 1,000 ng/mL or roughly 10 to 20 transfusions, both of which she has passed by a wide margin. Her normal echocardiogram is reassuring but not a reason to wait — cardiac iron deposition is silent until it is not.\\n\\nThe irony §10 draws out is worth keeping: this is the one anemia in which you must remove iron rather than give it. She stays anemic and she stays iron-overloaded at the same time, because the anemia is a globin problem and the overload is a transfusion problem.\", \"wrongExplanations\": {\"1\": \"Oral iron would be the answer for iron deficiency — a low ferritin with a high iron-binding capacity. Giving iron to a patient with a ferritin of 2,840 ng/mL and a transferrin saturation of 88% accelerates precisely the organ damage already underway. This is the trap that the microcytosis of thalassemia sets.\", \"2\": \"Erythropoiesis-stimulating agents work when the marrow lacks the signal to produce cells, as in chronic kidney disease. Her marrow is already maximally driven and profoundly ineffective; she cannot make beta chains no matter how hard it is stimulated, so the drug would add toxicity without benefit.\", \"3\": \"Stopping transfusions would be the answer if the transfusions were unnecessary. In transfusion-dependent thalassemia major they prevent severe anemia, marrow cavity expansion with skeletal deformity, and growth failure. Withdrawing them trades a treatable complication for an untreatable one.\", \"4\": \"Phlebotomy is the correct treatment for HEREDITARY hemochromatosis, where the patient makes normal blood and can spare it. It would be the answer in an adult with a high transferrin saturation and a normal hemoglobin. Removing blood from a transfusion-dependent anemic child is self-defeating.\"}, \"eli5\": \"Each blood transfusion brings iron with it, and the body has no way to get rid of extra iron. After years of transfusions the iron piles up in her liver, pancreas and heart, so she needs a medicine that grabs iron and carries it out.\", \"explanationImage\": \"fig_hepcidin\", \"explanationImageCaption\": \"Normal iron regulation: absorption is controlled by hepcidin, but there is no regulated route of iron EXCRETION, which is why transfused iron accumulates without limit.\", \"los\": [{\"n\": 28, \"t\": \"Given a clinical vignette of a patient with hemolytic anemia, characterize clinical presentations, labs and diagnostics (including peripheral smear + hemoglobin electrophoresis findings), therapies and long-term complications.\", \"a\": \"s9-globin\", \"s\": \"§10\"}, {\"n\": 9, \"t\": \"Describe the adverse effects of iron therapy and the reversal agents for acute iron toxicity and chronic iron overload.\", \"a\": \"s16-anemia-drugs\", \"s\": \"§17\"}]}, {\"stem\": \"A 19-year-old man comes to the office for a pre-participation sports examination. He feels well and has never had jaundice, bone pain, or episodes of severe pain. His younger brother was recently found to have an abnormal hemoglobin on testing, and the patient wishes to know his own status. His temperature is 36.9°C (98.4°F), pulse is 62/min, and blood pressure is 118/72 mm Hg. Physical examination shows no abnormalities; there is no scleral icterus and the spleen is not palpable.\\n\\nLaboratory studies show:\\n  Hemoglobin  14.8 g/dL (N=13.5–17.5 g/dL)\\n  Hematocrit  44% (N=41%–53%)\\n  Mean corpuscular volume  88 µm3 (N=80–100 µm3)\\n  Reticulocyte count  1.1% (N=0.5%–1.5%)\\n  Total bilirubin  0.8 mg/dL (N=0.1–1.0 mg/dL)\\nA peripheral blood smear shows no abnormalities. Hemoglobin electrophoresis shows hemoglobin A 58%, hemoglobin S 40%, hemoglobin A2 2%, and hemoglobin F less than 1%.\\n\\nWhich of the following is the most likely diagnosis?\", \"choices\": [\"A. Beta-thalassemia trait\", \"B. Hemoglobin SC disease\", \"C. Normal hemoglobin pattern\", \"D. Sickle cell disease\", \"E. Sickle cell trait\"], \"correct\": 4, \"explanation\": \"Both hemoglobin A and hemoglobin S are present, in roughly 60:40 proportion. That is heterozygosity read directly off the gel — sickle cell TRAIT.\\n\\nThe rule that decides the item is the absence, not the presence. In sickle cell disease the patient is homozygous, so 90–100% of the hemoglobin is S and there is NO hemoglobin A band at all. Any detectable hemoglobin A (in an untransfused patient) excludes the homozygous state. The clinical picture agrees: a normal hemoglobin concentration, a normal reticulocyte count, a normal bilirubin, a normal smear and no history of pain.\\n\\nWhy hemoglobin S stays below half in trait: the beta chains compete for alpha partners, and normal beta globin is incorporated somewhat more efficiently than S, so the S fraction settles at about 40–45%. That dilution is also the protection — hemoglobin S polymerizes readily with itself and poorly with hemoglobin A, so at this proportion polymerization essentially does not occur under ordinary conditions.\\n\\nTrait is generally asymptomatic and is not a disease, though it warrants genetic counseling: two carrier parents face a 25% risk of an affected child with each pregnancy.\", \"wrongExplanations\": {\"0\": \"Beta-thalassemia trait would show a RAISED hemoglobin A2 (typically 3.5–7%) with a low mean corpuscular volume and a mild anemia, and no hemoglobin S at all. His A2 is 2% and his indices are entirely normal.\", \"1\": \"Hemoglobin SC disease shows hemoglobin S and hemoglobin C with NO hemoglobin A, and causes a mild-to-moderate hemolytic anemia with target cells, retinopathy and avascular necrosis. No hemoglobin C band is present here, and his hemoglobin A of 58% excludes any compound homozygous state.\", \"2\": \"A normal pattern is essentially all hemoglobin A with hemoglobin A2 under about 3.5% and no hemoglobin S. A band comprising 40% of his hemoglobin is not a normal finding, and reporting it as normal would miss the counseling that this result requires.\", \"3\": \"Sickle cell disease would show hemoglobin S at 90–100% with hemoglobin A ABSENT, accompanied by anemia, reticulocytosis, sickled cells and Howell-Jolly bodies on the smear, and a history of pain crises from early childhood. The presence of 58% hemoglobin A rules it out.\"}, \"eli5\": \"He has one normal copy of the gene and one sickle copy, so his blood carries both kinds of hemoglobin. Having the normal kind alongside is what keeps the sickle kind from clumping, which is why he is completely healthy.\", \"explanationImage\": \"fig_electrophoresis\", \"explanationImageCaption\": \"Electrophoresis patterns: the trait states show two bands, while the homozygous disease states show a single abnormal band with no hemoglobin A.\", \"los\": [{\"n\": 28, \"t\": \"Given a clinical vignette of a patient with hemolytic anemia, characterize clinical presentations, labs and diagnostics (including peripheral smear + hemoglobin electrophoresis findings), therapies and long-term complications.\", \"a\": \"s9-globin\", \"s\": \"§10\"}]}, {\"stem\": \"A 14-month-old boy with sickle cell disease, diagnosed on newborn screening, is brought to the emergency department by his mother because of a fever that began 6 hours ago. He has been fussy and is feeding less than usual. He takes penicillin twice daily and folic acid, and his immunizations, including pneumococcal conjugate vaccine, are up to date. His temperature is 39.4°C (102.9°F), pulse is 168/min, respirations are 38/min, and blood pressure is 88/50 mm Hg. Physical examination shows an irritable but consolable infant with moist mucous membranes and a capillary refill time of 2 seconds. The tympanic membranes are normal, the lungs are clear to auscultation, and there is no rash or focal tenderness. The spleen is palpated 2 cm below the left costal margin, unchanged from his last visit.\\n\\nLaboratory studies show:\\n  Hemoglobin  7.6 g/dL (N=10.5–13.5 g/dL)\\n  Hematocrit  23% (N=33%–39%)\\n  Reticulocyte count  9.2% (N=0.5%–1.5%)\\n  Leukocyte count  17,400/mm3 (N=4500–11,000/mm3)\\n  Platelet count  384,000/mm3 (N=150,000–400,000/mm3)\\nHis baseline hemoglobin concentration is 7.5 g/dL. Which of the following is the most appropriate next step in management?\", \"choices\": [\"A. Administer intravenous ceftriaxone after blood cultures are obtained\", \"B. Administer oral amoxicillin and arrange reassessment in 24 hours\", \"C. Begin hydroxyurea therapy\", \"D. Perform red blood cell exchange transfusion\", \"E. Withhold antibiotics until blood culture results are available\"], \"correct\": 0, \"explanation\": \"Fever in a young child with sickle cell disease is a medical emergency, and the reason is anatomic. Repeated splenic infarction produces functional asplenia — autosplenectomy — within the first few years of life, even while the spleen is still palpable. Without splenic clearance of opsonized organisms the child cannot control encapsulated bacteria, above all Streptococcus pneumoniae, and can progress from fever to fulminant sepsis and death within hours.\\n\\nSo the sequence is: obtain blood cultures, then give an empiric parenteral third-generation cephalosporin IMMEDIATELY — do not wait for a source, a culture result, or a white count to declare itself. Neither prophylactic penicillin nor conjugate vaccination removes the risk; both reduce it, and both have been given here.\\n\\nThe anemia is a deliberate distraction. His hemoglobin of 7.6 g/dL is his baseline, and his reticulocyte count of 9.2% shows a marrow compensating normally — there is no aplastic crisis (reticulocytes would be low), no sequestration (the spleen is unchanged and he is not in shock), and no acute chest syndrome (the lungs are clear). The problem to treat first is the fever.\", \"wrongExplanations\": {\"1\": \"Oral antibiotics with next-day review is reasonable practice for a febrile immunocompetent toddler, and it is the answer the surface reading of a well-appearing, consolable child invites. In functional asplenia the margin for error is a few hours, which oral therapy and a 24-hour interval do not provide.\", \"2\": \"Hydroxyurea is disease-modifying therapy for recurrent vaso-occlusive episodes, severe anemia or acute chest syndrome; it raises fetal hemoglobin over weeks to months. It would be the answer at a planning visit for a child with frequent painful episodes. It treats nothing acutely and causes myelosuppression in a child who may be septic.\", \"3\": \"Exchange transfusion is used for acute chest syndrome, stroke and severe vaso-occlusive events with a high hemoglobin S fraction. It would be the answer with hypoxemia and a new pulmonary infiltrate, or with focal neurologic findings. His lungs are clear and his hemoglobin is at his own baseline.\", \"4\": \"Waiting for cultures is the error this scenario is built to punish: pneumococcal sepsis in an asplenic child outruns the laboratory. Cultures are drawn first, but antibiotics follow within minutes, not days.\"}, \"eli5\": \"His spleen has been destroyed by years of sickling, and the spleen is the organ that clears certain bacteria from the blood. That makes any fever a potential emergency, so he gets a strong antibiotic into a vein right away.\", \"explanationImage\": \"fig_howell_jolly\", \"explanationImageCaption\": \"The morphologic sign of a spleen that is absent or no longer working: erythrocytes containing small dense nuclear remnants (arrows), the Howell-Jolly bodies that a functioning spleen would have removed.\", \"los\": [{\"n\": 7, \"t\": \"Describe management approaches for sickle cell disease as it pertains to prevention and complications.\", \"a\": \"s9-globin\", \"s\": \"§10\"}, {\"n\": 51, \"t\": \"Given a clinical vignette, identify the pathophysiology of post splenectomy complications including the serious complication of post-splenectomy infection and/or sepsis.\", \"a\": \"s10-spleen\", \"s\": \"§11\"}]}, {\"stem\": \"A 3-year-old girl with sickle cell disease is brought to the emergency department by her parents because of 12 hours of increasing pallor, lethargy, and abdominal fullness. She has had no fever, cough, or pain in her arms or legs. Her baseline hemoglobin concentration is 8.0 g/dL. Her temperature is 37.0°C (98.6°F), pulse is 164/min, respirations are 36/min, and blood pressure is 78/40 mm Hg. Physical examination shows marked pallor, cool extremities, and a distended abdomen; the spleen is firm and palpated 8 cm below the left costal margin, compared with 2 cm 3 months ago. The lungs are clear to auscultation.\\n\\nLaboratory studies show:\\n  Hemoglobin  4.2 g/dL (N=10.5–13.5 g/dL)\\n  Hematocrit  13% (N=33%–39%)\\n  Reticulocyte count  16.4% (N=0.5%–1.5%)\\n  Leukocyte count  14,200/mm3 (N=4500–11,000/mm3)\\n  Platelet count  96,000/mm3 (N=150,000–400,000/mm3)\\nA peripheral blood smear is shown. Which of the following is the most likely diagnosis?\", \"choices\": [\"A. Acute chest syndrome\", \"B. Acute splenic sequestration crisis\", \"C. Aplastic crisis\", \"D. Delayed hemolytic transfusion reaction\", \"E. Vaso-occlusive (painful) crisis\"], \"correct\": 1, \"explanation\": \"Three findings decide it together: a spleen that has grown from 2 cm to 8 cm in 3 months and is acutely distended, a hemoglobin that has halved, and a reticulocyte count of 16.4% — HIGH.\\n\\nIn splenic sequestration, rigid sickled cells are abruptly trapped in the splenic cords and a large fraction of the circulating blood volume is swallowed by the spleen. The cells are not destroyed so much as removed from circulation → the child becomes profoundly anemic and HYPOVOLEMIC at the same time → tachycardia, hypotension, cool extremities. Platelets are sequestered along with the erythrocytes, which is why her platelet count has fallen. It is one of the commonest causes of death in young children with sickle cell disease and requires immediate volume resuscitation and cautious transfusion.\\n\\n§10's memory hook is three crises and three reticulocyte counts: aplastic → LOW (production has stopped, think parvovirus B19); sequestration → HIGH with a suddenly enormous spleen (the cells are alive, just not in the circulation); vaso-occlusive → hemoglobin near baseline, because the problem is ischemia and pain rather than red cell mass. Ask for the reticulocyte count and the spleen size and the three separate immediately.\\n\\nThe spleen is still present and functioning here because she is only 3 — autosplenectomy has not yet completed.\", \"wrongExplanations\": {\"0\": \"Acute chest syndrome presents with fever, chest pain, hypoxemia and a NEW pulmonary infiltrate, and it is the leading cause of death in adults with sickle cell disease. It would be the answer with respiratory findings; her lungs are clear and she has no fever or chest pain.\", \"2\": \"An aplastic crisis produces the same abrupt fall in hemoglobin, which is what makes it the near-miss — but the reticulocyte count would be LOW (often under 1%) because parvovirus B19 has shut erythropoiesis down, and the spleen would not enlarge. Hers is 16.4%, and her spleen has quadrupled.\", \"3\": \"A delayed hemolytic transfusion reaction occurs 2 to 10 days after a transfusion as an anamnestic response to a minor red cell antigen, with a gradual hemoglobin fall and a positive direct antiglobulin test. It would be the answer with a transfusion in the preceding 2 weeks; she has not been transfused, and it does not cause acute splenic enlargement.\", \"4\": \"A vaso-occlusive crisis causes severe pain in the limbs, back, abdomen or chest, and characteristically leaves the hemoglobin near the patient's baseline. It would be the answer with pain as the dominant complaint and a hemoglobin of about 8 g/dL — not a halving of the hemoglobin with hypotension and no pain.\"}, \"eli5\": \"Her spleen suddenly trapped a huge amount of her blood inside itself, so her spleen got enormous while her blood count crashed. Her bone marrow is still working hard — the young cells are there — the blood is just stuck in the wrong place.\", \"image\": \"fig_sickle_smear\", \"imageCaption\": \"Peripheral blood smear. Numerous erythrocytes are elongated and crescent-shaped with pointed ends; others are round with a dark central area surrounded by a pale ring.\", \"explanationImage\": \"fig_sickle_target\", \"explanationImageCaption\": \"A second field from a patient with the same disorder: crescent-shaped erythrocytes alongside target cells.\", \"los\": [{\"n\": 7, \"t\": \"Describe management approaches for sickle cell disease as it pertains to prevention and complications.\", \"a\": \"s9-globin\", \"s\": \"§10\"}]}, {\"stem\": \"A 17-year-old young man with sickle cell disease is evaluated in the clinic. Over the preceding year he was admitted five times for severe painful episodes and once for acute chest syndrome. Six months ago hydroxyurea was started at 15 mg/kg once daily and the dose was gradually increased. Since then he has had one painful episode requiring admission. His hemoglobin concentration has risen from 7.4 to 9.1 g/dL, his mean corpuscular volume has risen from 88 to 104 µm3, and quantitative hemoglobin studies show that his hemoglobin F has risen from 4% to 19%.\\n\\nWhich of the following best explains the reduction in this patient's painful episodes?\", \"choices\": [\"A. Correction of the beta globin point mutation in hematopoietic stem cells\", \"B. Decreased polymerization of hemoglobin S owing to a higher proportion of fetal hemoglobin\", \"C. Increased erythropoietin secretion with a resulting increase in erythrocyte production\", \"D. Inhibition of splenic macrophage uptake of sickled erythrocytes\", \"E. Irreversible inhibition of platelet cyclooxygenase\"], \"correct\": 1, \"explanation\": \"Hemoglobin S polymerizes readily with itself and POORLY with hemoglobin F. Raising the fetal hemoglobin fraction therefore dilutes the polymer: the deoxygenated hemoglobin S molecules are progressively separated by molecules they cannot stick to → fewer fibers form → fewer cells become rigid and crescent-shaped → less vaso-occlusion, less pain, less organ damage. His hemoglobin F rose from 4% to 19%, and his admissions fell from five to one.\\n\\nThis is the single therapeutic lever that almost every sickle cell treatment pulls, from different directions. Hydroxyurea raises hemoglobin F; transfusion adds hemoglobin A; intravenous fluids lower the intracellular hemoglobin concentration; oxygen keeps the molecule in the conformation that does not polymerize; and gene therapy either switches fetal hemoglobin back on (by disabling BCL11A) or inserts a working beta globin gene. Dilute the polymer, or keep it oxygenated.\\n\\nThe rise in mean corpuscular volume is a useful marker of adherence and effect. The trade-off must be stated: hydroxyurea carries two boxed warnings — myelosuppression and secondary malignancy — because it is a cytotoxic agent, so the blood count is monitored throughout treatment.\", \"wrongExplanations\": {\"0\": \"Correcting the mutation itself is gene therapy or stem cell transplantation, not hydroxyurea, which alters gene EXPRESSION rather than sequence. It would be the answer for Lyfgenia, which inserts a functional beta globin gene, or Casgevy, which edits BCL11A to restore fetal hemoglobin.\", \"2\": \"Hydroxyurea suppresses the marrow; it does not stimulate it, and his rising hemoglobin reflects less hemolysis rather than more production. Increased erythropoietin action would be the mechanism of an erythropoiesis-stimulating agent, which does nothing about polymerization and could raise viscosity in this patient.\", \"3\": \"Blocking splenic uptake would address extravascular destruction, which is the mechanism of splenectomy or of immunosuppression in autoimmune hemolysis. It would not reduce vaso-occlusive PAIN, and most adolescents with sickle cell disease have already autoinfarcted their spleens.\", \"4\": \"Irreversible cyclooxygenase inhibition is aspirin. Antiplatelet therapy has not been shown to prevent vaso-occlusive episodes, and it would not raise the hemoglobin F fraction or the mean corpuscular volume, both of which changed here.\"}, \"eli5\": \"The sickling happens when the abnormal hemoglobin molecules stick to each other in long chains. This drug makes the body switch some baby hemoglobin back on, and the abnormal molecules cannot stick to that — so the chains do not form and the pain attacks drop off.\", \"explanationImage\": \"fig_sickle_target\", \"explanationImageCaption\": \"Sickle cell disease on a peripheral blood smear: crescent-shaped erythrocytes with pointed ends, together with target cells.\", \"los\": [{\"n\": 7, \"t\": \"Describe management approaches for sickle cell disease as it pertains to prevention and complications.\", \"a\": \"s9-globin\", \"s\": \"§10\"}]}, {\"stem\": \"A 19-year-old woman comes to the emergency department because of a 6-hour history of severe pain in the right upper quadrant that began after a meal and radiates to her right shoulder. She has had three similar but milder episodes over the past year. She has hereditary spherocytosis, diagnosed at 6 years of age, and takes daily folic acid. She has never been pregnant and does not use oral contraceptives. Her temperature is 37.4°C (99.3°F), pulse is 96/min, and blood pressure is 122/74 mm Hg. She is 165 cm (5 ft 5 in) tall and weighs 58 kg (128 lb); BMI is 21 kg/m2. Physical examination shows scleral icterus and tenderness in the right upper quadrant; the spleen is palpated 5 cm below the left costal margin.\\n\\nLaboratory studies show:\\n  Hemoglobin  10.2 g/dL (N=12.0–16.0 g/dL)\\n  Hematocrit  30% (N=36%–46%)\\n  Reticulocyte count  7.4% (N=0.5%–1.5%)\\n  Total bilirubin  3.6 mg/dL (N=0.1–1.0 mg/dL)\\n  Direct bilirubin  0.4 mg/dL (N=0.0–0.3 mg/dL)\\n  Alkaline phosphatase  72 U/L (N=25–100 U/L)\\n  Alanine aminotransferase  26 U/L (N=10–40 U/L)\\nUltrasonography of the abdomen shows multiple small echogenic stones in the gallbladder without wall thickening or ductal dilation. Which of the following best explains the formation of this patient's gallstones?\", \"choices\": [\"A. Bacterial deconjugation of bilirubin by β-glucuronidase within the biliary tract\", \"B. Impaired gallbladder emptying with prolonged biliary stasis\", \"C. Loss of bile salts through a diseased terminal ileum, contracting the bile salt pool\", \"D. Precipitation of calcium bilirubinate from chronically increased unconjugated bilirubin in bile\", \"E. Supersaturation of bile with cholesterol relative to solubilizing bile salts\"], \"correct\": 3, \"explanation\": \"Chronic hemolysis produces pigment (black) gallstones, and the arithmetic is simple. Every destroyed erythrocyte delivers its heme for catabolism → unconjugated bilirubin is produced far faster than normal → the liver conjugates and excretes it → the bilirubin load delivered into bile is chronically enormous → calcium bilirubinate precipitates out.\\n\\nThis is one of the three consequences §9 attaches to ANY long-standing hemolysis: anemia, jaundice, splenomegaly and pigmented gallstones. It is why gallstones in a teenager or young adult with a normal body habitus should not be read as ordinary gallbladder disease — at her age, with this build and no pregnancies or estrogen exposure, cholesterol stones are unlikely and the stones are a clue to the underlying hematologic disorder rather than an independent problem.\\n\\nHer laboratory pattern confirms the mechanism rather than obstruction: the bilirubin rise is almost entirely UNCONJUGATED (direct fraction 0.4 mg/dL), with a normal alkaline phosphatase and no ductal dilation. Splenectomy for her spherocytosis would reduce ongoing stone formation, and cholecystectomy is commonly performed at the same operation.\", \"wrongExplanations\": {\"0\": \"Bacterial β-glucuronidase deconjugates bilirubin already in bile and produces BROWN pigment stones. It would be the answer with biliary infection or infestation — ascending cholangitis, a biliary stricture, or a liver fluke — with ductal dilation and cholangitic features, none of which she has.\", \"1\": \"Biliary stasis promotes stone formation in prolonged fasting, total parenteral nutrition, rapid weight loss, and after vagotomy. It would be the answer in a hospitalized patient who has not eaten for weeks; it does not explain stones in a young outpatient whose bilirubin production is quadrupled.\", \"2\": \"Terminal ileal disease or resection interrupts the enterohepatic circulation of bile salts, and does cause stones — but by contracting the bile salt pool so that cholesterol precipitates, in a patient with Crohn disease or an ileal resection. She has no gastrointestinal disease.\", \"4\": \"Cholesterol supersaturation is the mechanism of the common cholesterol stone, favored by female sex, obesity, multiparity, estrogen use and increasing age — the classic risk profile. She has a BMI of 21 kg/m2, has never been pregnant, takes no estrogen, and is 19 years old, and her hemolysis provides a far better explanation.\"}, \"eli5\": \"Her body destroys red cells constantly, and the yellow pigment from that destruction pours into her bile. Eventually the pigment settles out and hardens into stones — which is why she has gallstones decades earlier than most people.\", \"explanationImage\": \"fig_pigment_stones\", \"explanationImageCaption\": \"Pathogenesis of pigment stones: chronic hemolysis raises the unconjugated bilirubin delivered into bile, which precipitates as calcium bilirubinate.\", \"los\": [{\"n\": 25, \"t\": \"Distinguish between various causes of hemolytic anemia and characterize by site of hemolysis (intravascular versus extravascular), pathophysiology, laboratory testing and diagnostics.\", \"a\": \"s7-hemolysis\", \"s\": \"§8\"}]}, {\"stem\": \"A 23-year-old man is admitted to the hospital because of 2 days of jaundice, dark brown urine, and fatigue that began after he took a sulfonamide antibiotic. Over the next 24 hours in the hospital his urine output falls to 15 mL/h despite intravenous fluids. He has no history of kidney disease. His temperature is 37.2°C (99.0°F), pulse is 118/min, respirations are 22/min, and blood pressure is 104/62 mm Hg. Physical examination shows deep scleral icterus and pallor; the jugular venous pulse is visible at 4 cm above the sternal angle, and the lungs are clear.\\n\\nLaboratory studies show:\\n  Hemoglobin  5.8 g/dL (N=13.5–17.5 g/dL)\\n  Hematocrit  17% (N=41%–53%)\\n  Reticulocyte count  2.2% (N=0.5%–1.5%)\\n  Platelet count  232,000/mm3 (N=150,000–400,000/mm3)\\n  Lactate dehydrogenase  1,240 U/L (N=45–200 U/L)\\n  Haptoglobin  <10 mg/dL (N=30–200 mg/dL)\\n  Total bilirubin  5.2 mg/dL (N=0.1–1.0 mg/dL)\\n  Direct bilirubin  0.4 mg/dL (N=0.0–0.3 mg/dL)\\n  Creatinine  2.9 mg/dL (N=0.6–1.2 mg/dL)\\n  Potassium  5.3 mEq/L (N=3.5–5.0 mEq/L)\\nHis creatinine concentration was 0.9 mg/dL on admission. Urinalysis shows a dipstick strongly positive for blood with no erythrocytes on microscopy, and pigmented granular casts. Which of the following best explains the deterioration in this patient's renal function?\", \"choices\": [\"A. Deposition of immune complexes along the glomerular basement membrane\", \"B. Direct tubular injury by filtered free heme, with obstruction of tubules by pigment casts\", \"C. Embolic occlusion of renal arterioles by aggregated erythrocytes\", \"D. Precipitation of uric acid crystals within the renal tubules\", \"E. Prerenal hypoperfusion from intravascular volume depletion\"], \"correct\": 1, \"explanation\": \"This is why §8 calls intravascular hemolysis the more dangerous form. Hemoglobin is safe inside a cell and toxic outside one. Once free hemoglobin exceeds the binding capacity of haptoglobin — which here is entirely consumed, at less than 10 mg/dL — it is filtered at the glomerulus → free heme is directly toxic to the proximal tubular epithelium, generates reactive oxygen species, scavenges nitric oxide and causes intrarenal vasoconstriction → pigment casts obstruct the tubular lumen → acute tubular necrosis.\\n\\nThe urinalysis is the confirmation: a dipstick positive for blood with no erythrocytes (the dipstick detects heme, not cells) together with pigmented granular casts. His creatinine has risen from 0.9 to 2.9 mg/dL in a day, with the hyperkalemia that accompanies acute tubular injury.\\n\\nThe same mechanism kills patients after ABO-incompatible transfusion. Management is aggressive intravenous fluid to maintain a high urine flow and dilute the pigment load, removal of the trigger, and support of the anemia — the injury is potentially reversible if the tubules are kept flushed.\", \"wrongExplanations\": {\"0\": \"Immune complex deposition produces a glomerulonephritis — hypertension, edema, proteinuria and DYSMORPHIC erythrocytes with red cell casts in the sediment. It would be the answer with erythrocytes visible on microscopy; his sediment has none, which is the whole point of the finding.\", \"2\": \"Erythrocytes do not aggregate into arteriolar emboli in this setting. Embolic renal injury occurs with cholesterol emboli after arterial instrumentation or with septic emboli in endocarditis, and would come with livedo reticularis, eosinophilia, or a murmur and fever.\", \"3\": \"Uric acid crystal nephropathy is the renal lesion of tumor lysis syndrome, after treatment of a bulky rapidly dividing malignancy, and comes with hyperphosphatemia, hyperuricemia and HYPOcalcemia. He is hemolyzing after a drug, not being treated for a tumor.\", \"4\": \"Volume depletion is worth excluding in any acute kidney injury, and it would be the answer with dry mucous membranes, flat neck veins and a response to fluids. He has a visible jugular venous pulse at 4 cm, has received intravenous fluid, and is still oliguric — so hypoperfusion is not the explanation.\"}, \"eli5\": \"When red cells burst inside blood vessels, hemoglobin spills loose and gets filtered into the kidney. Raw hemoglobin poisons the kidney's tubes and clogs them, so the kidney stops making urine.\", \"explanationImage\": \"fig_bilirubin\", \"explanationImageCaption\": \"Hemoglobin catabolism: heme released from destroyed erythrocytes is normally handled entirely within macrophages, and only reaches plasma and the glomerular filtrate when cells rupture inside the vessel.\", \"los\": [{\"n\": 25, \"t\": \"Distinguish between various causes of hemolytic anemia and characterize by site of hemolysis (intravascular versus extravascular), pathophysiology, laboratory testing and diagnostics.\", \"a\": \"s7-hemolysis\", \"s\": \"§8\"}]}, {\"stem\": \"A 31-year-old woman is evaluated because of 3 weeks of fatigue and progressive yellowing of her eyes. She takes no medications, does not drink alcoholic beverages, and has no history of liver disease. Her temperature is 37.0°C (98.6°F), pulse is 98/min, and blood pressure is 118/72 mm Hg. Physical examination shows deep scleral icterus; the abdomen is soft with no hepatomegaly, and the spleen is palpated 3 cm below the left costal margin. Her stools are normal in color.\\n\\nLaboratory studies show:\\n  Hemoglobin  8.8 g/dL (N=12.0–16.0 g/dL)\\n  Hematocrit  26% (N=36%–46%)\\n  Reticulocyte count  9.1% (N=0.5%–1.5%)\\n  Total bilirubin  4.2 mg/dL (N=0.1–1.0 mg/dL)\\n  Direct bilirubin  0.3 mg/dL (N=0.0–0.3 mg/dL)\\n  Alkaline phosphatase  68 U/L (N=25–100 U/L)\\n  Alanine aminotransferase  22 U/L (N=10–40 U/L)\\n  Lactate dehydrogenase  520 U/L (N=45–200 U/L)\\nUrinalysis shows increased urobilinogen and NO bilirubin. Which of the following best explains the absence of bilirubin in this patient's urine?\", \"choices\": [\"A. Bilirubin is cleared entirely by biliary excretion, so none reaches the circulation\", \"B. Bilirubin is degraded within the renal collecting system before it can be detected\", \"C. Conjugated bilirubin is reabsorbed by the renal tubules after being filtered\", \"D. The excess bilirubin is unconjugated and bound to albumin, and is therefore not filtered at the glomerulus\", \"E. The renal threshold for bilirubin excretion is raised during hemolysis\"], \"correct\": 3, \"explanation\": \"Unconjugated bilirubin is water-insoluble and travels tightly bound to albumin. Albumin is not filtered by a healthy glomerulus, so neither is the bilirubin riding on it → hemolytic jaundice is ACHOLURIC: deeply jaundiced patient, no bilirubin in the urine.\\n\\nOnly CONJUGATED bilirubin — water-soluble and not albumin-bound — appears in urine, which is why bilirubinuria points to hepatocellular disease or biliary obstruction instead. Her direct fraction is 0.3 mg/dL against a total of 4.2 mg/dL, with a normal alkaline phosphatase and transaminases, so no conjugated bilirubin is accumulating to be excreted.\\n\\nThe raised urobilinogen is the positive half of the same picture and is worth reading alongside it. The liver conjugates and excretes the extra bilirubin normally → gut bacteria convert it to urobilinogen → some is reabsorbed and spills into the urine. In biliary OBSTRUCTION the pattern inverts: bilirubin appears in the urine, urobilinogen disappears from it, and the stools become pale. Hers are normal in color.\", \"wrongExplanations\": {\"0\": \"Bilirubin certainly does reach the circulation — hers is 4.2 mg/dL, which is what is making her yellow. This option would describe a patient with a normal serum bilirubin, in whom the question of urinary bilirubin would not arise.\", \"1\": \"There is no renal or bacterial degradation pathway for bilirubin in the collecting system. Bacterial conversion of bilirubin does occur, but in the COLON, where it produces the urobilinogen that this patient has in excess.\", \"2\": \"Filtered conjugated bilirubin is not meaningfully reabsorbed; that is exactly why it appears in the urine in hepatocellular and obstructive jaundice. If this option were true, bilirubinuria would never occur in any disease.\", \"4\": \"There is no adjustable renal threshold for bilirubin in the way there is for glucose. The determinant is whether the molecule is filterable at all, which depends on conjugation and albumin binding — not on how much hemolysis is taking place.\"}, \"eli5\": \"The yellow pigment from broken red cells hitches a ride on a large blood protein, and the kidney's filter will not let that protein through. So she is very yellow but her urine stays a normal color.\", \"explanationImage\": \"fig_bilirubin\", \"explanationImageCaption\": \"Bilirubin metabolism: unconjugated bilirubin travels albumin-bound to the liver, and only the conjugated, water-soluble form can appear in urine.\", \"los\": [{\"n\": 25, \"t\": \"Distinguish between various causes of hemolytic anemia and characterize by site of hemolysis (intravascular versus extravascular), pathophysiology, laboratory testing and diagnostics.\", \"a\": \"s7-hemolysis\", \"s\": \"§8\"}]}, {\"stem\": \"A 16-year-old boy with hereditary spherocytosis is evaluated in the clinic. Over the past 2 years he has required four transfusions, misses school regularly because of fatigue, and has had two episodes of biliary colic. His hemoglobin concentration ranges between 7.5 and 8.5 g/dL, and his reticulocyte count is persistently above 10%. Ultrasonography shows gallstones. His spleen is palpated 8 cm below the left costal margin. After discussion, total splenectomy with cholecystectomy is planned for 6 weeks from now. He takes daily folic acid; his childhood immunizations are complete.\\n\\nWhich of the following is the most appropriate next step in management?\", \"choices\": [\"A. Administer pneumococcal, meningococcal, and Haemophilus influenzae type b vaccines\", \"B. Begin lifelong iron chelation therapy\", \"C. Begin oral ferrous sulfate therapy\", \"D. Obtain hemoglobin electrophoresis\", \"E. Transfuse to a hemoglobin concentration of 12 g/dL\"], \"correct\": 0, \"explanation\": \"Splenectomy cures the anemia of hereditary spherocytosis in functional terms — remove the site of destruction and red cell survival normalizes, although the spherocytes themselves remain — but it trades a hematologic problem for a lifelong infectious one.\\n\\nWithout a spleen the patient cannot clear opsonized ENCAPSULATED organisms: Streptococcus pneumoniae above all, then Neisseria meningitidis and Haemophilus influenzae type b. Overwhelming post-splenectomy infection has a mortality measured in hours, and the risk never goes away. So vaccination against all three is given BEFORE the operation — at least 2 weeks in advance, while the spleen is still present to mount a proper antibody response. He has 6 weeks, which is ample.\\n\\nThe rest of the package, which the explanation should carry even though it is not the lead-in: antibiotic prophylaxis after surgery (particularly in children), a standing plan for immediate evaluation of any fever, and — the smear sign that the spleen is gone — Howell-Jolly bodies appearing afterwards.\\n\\nHis routine childhood immunizations do not cover this. Conjugate pneumococcal vaccine given in infancy is not equivalent to the asplenia schedule, which adds the polysaccharide vaccine and meningococcal coverage.\", \"wrongExplanations\": {\"1\": \"Iron chelation is for transfusional iron overload, which develops after roughly 10 to 20 units. Four transfusions over 2 years is nowhere near that threshold, and his hemolysis is extravascular — the iron from it is recycled, not lost.\", \"2\": \"Oral iron treats iron deficiency. He is not iron deficient: his marrow is turning over cells at maximum speed and recycling iron efficiently, and giving iron here adds nothing. FOLIC acid is the supplement that a high-turnover marrow genuinely needs, and he already takes it.\", \"3\": \"Hemoglobin electrophoresis would be the answer if the diagnosis were in doubt and a hemoglobinopathy were suspected — a microcytic anemia with target cells, say. His diagnosis is established, his cells are spherocytes, and electrophoresis would be normal.\", \"4\": \"Transfusing to a normal hemoglobin is neither necessary nor safe practice; he tolerates 7.5 to 8.5 g/dL, and transfusion carries alloimmunization and iron loading. It would be the answer only for symptomatic severe anemia or an aplastic crisis, and it does nothing about the infection risk the surgery creates.\"}, \"eli5\": \"Taking out the spleen will fix his anemia, but the spleen is also the organ that protects against a few specific bacteria. So he gets those vaccines while he still has a spleen to respond to them properly.\", \"explanationImage\": \"fig_howell_jolly\", \"explanationImageCaption\": \"After splenectomy the smear shows Howell-Jolly bodies (arrows) — dense nuclear remnants that a working spleen would have removed.\", \"los\": [{\"n\": 28, \"t\": \"Given a clinical vignette of a patient with hemolytic anemia, characterize clinical presentations, labs and diagnostics (including peripheral smear + hemoglobin electrophoresis findings), therapies and long-term complications.\", \"a\": \"s8-membrane-enzyme\", \"s\": \"§9\"}, {\"n\": 51, \"t\": \"Given a clinical vignette, identify the pathophysiology of post splenectomy complications including the serious complication of post-splenectomy infection and/or sepsis.\", \"a\": \"s10-spleen\", \"s\": \"§11\"}]}, {\"stem\": \"A 6-year-old girl is evaluated because of lifelong anemia and intermittent jaundice first noted in the newborn period, when she required phototherapy and an exchange transfusion. Her parents are first cousins. She has had no episodes triggered by drugs or foods. Her temperature is 37.0°C (98.6°F), pulse is 96/min, and blood pressure is 98/60 mm Hg. Physical examination shows mild scleral icterus and a spleen palpated 4 cm below the left costal margin. She is active and plays sports without limitation despite her hemoglobin concentration.\\n\\nLaboratory studies show:\\n  Hemoglobin  8.4 g/dL (N=11.5–15.5 g/dL)\\n  Hematocrit  25% (N=35%–45%)\\n  Mean corpuscular volume  92 µm3 (N=77–95 µm3)\\n  Reticulocyte count  12.6% (N=0.5%–1.5%)\\n  Total bilirubin  3.2 mg/dL (N=0.1–1.0 mg/dL)\\n  Direct bilirubin  0.3 mg/dL (N=0.0–0.3 mg/dL)\\n  Lactate dehydrogenase  310 U/L (N=45–200 U/L)\\nA peripheral blood smear shows polychromasia and scattered contracted cells with short spiny projections; no spherocytes and no bite cells are seen. Osmotic fragility is normal, the direct antiglobulin test is negative, hemoglobin electrophoresis shows no abnormal band, and erythrocyte glucose-6-phosphate dehydrogenase activity is normal. Which of the following best explains the hemolysis in this patient?\", \"choices\": [\"A. Decreased production of adenosine triphosphate by anaerobic glycolysis\", \"B. Decreased regeneration of reduced glutathione by the hexose monophosphate shunt\", \"C. Defective anchoring of spectrin to the inner erythrocyte membrane\", \"D. Polymerization of deoxygenated hemoglobin into rigid fibers\", \"E. Reduced synthesis of structurally normal beta globin chains\"], \"correct\": 0, \"explanation\": \"Every alternative has been excluded by a named test, which is what the vignette is built to do: normal osmotic fragility and no spherocytes rule out the membrane, a negative antiglobulin test rules out antibody, a normal electrophoresis rules out the globins, and a normal enzyme assay rules out G6PD. What is left is the other enzyme — pyruvate kinase.\\n\\nPyruvate kinase catalyzes the last step of glycolysis. A red cell has no mitochondria, so anaerobic glycolysis is its ONLY source of adenosine triphosphate → without it the cation pumps fail → the cell dehydrates, stiffens and becomes the contracted, spiculated form on her smear → the spleen removes it. Chronic extravascular hemolysis, autosomal recessive (hence the consanguinity), often severe enough to cause neonatal jaundice needing exchange transfusion, and unrelated to drugs or foods.\\n\\nOne elegant detail explains her exercise tolerance. The block is upstream of pyruvate, so 2,3-bisphosphoglycerate accumulates → hemoglobin's oxygen affinity falls → oxygen is unloaded more readily to tissue. These patients tolerate a given hemoglobin concentration better than other anemic patients do.\\n\\nManagement is folic acid, transfusion when needed, and splenectomy in severe cases.\", \"wrongExplanations\": {\"1\": \"Failure to regenerate reduced glutathione is G6PD deficiency — but her enzyme activity is normal, her hemolysis is continuous rather than episodic, there is no oxidant trigger, and there are no bite cells. Those are four separate points against it.\", \"2\": \"A defective membrane skeleton is hereditary spherocytosis, which would be the answer with spherocytes, INCREASED osmotic fragility, a high mean corpuscular hemoglobin concentration, and dominant inheritance. Her smear shows no spherocytes and her fragility is normal.\", \"3\": \"Polymerization of deoxygenated hemoglobin is sickle cell disease, and it would be the answer with crescent-shaped cells, pain crises, and hemoglobin S on electrophoresis. Her electrophoresis shows no abnormal band.\", \"4\": \"Reduced synthesis of normal beta chains is beta thalassemia — a quantity problem that produces MICROCYTOSIS with target cells and a raised hemoglobin A2. Her mean corpuscular volume is 92 µm3 and her electrophoresis is normal.\"}, \"eli5\": \"Red cells have no power plant, so they make all their energy one way — and her cells are missing a key enzyme in that pathway. Starved of energy, the cells shrivel and stiffen, and the spleen clears them out.\", \"explanationImage\": \"fig_g6pd_pathway\", \"explanationImageCaption\": \"For contrast, the pathway that is intact in this patient: G6PD generates NADPH for glutathione regeneration, a separate route from the glycolytic pathway that supplies the cell's adenosine triphosphate.\", \"los\": [{\"n\": 28, \"t\": \"Given a clinical vignette of a patient with hemolytic anemia, characterize clinical presentations, labs and diagnostics (including peripheral smear + hemoglobin electrophoresis findings), therapies and long-term complications.\", \"a\": \"s8-membrane-enzyme\", \"s\": \"§9\"}]}, {\"stem\": \"An 8-year-old boy is admitted to the hospital with a 3-day history of fever, cough, and right-sided chest pain. A chest radiograph shows a right lower lobe consolidation, and treatment with intravenous ampicillin is begun. He has taken no other medication, has no known allergies, and eats a regular diet with no unusual foods in the past month. On the second hospital day he becomes jaundiced and passes dark urine. His temperature is 38.6°C (101.5°F), pulse is 124/min, respirations are 30/min, and blood pressure is 100/60 mm Hg. Pulse oximetry on room air shows an oxygen saturation of 95%.\\n\\nLaboratory studies on the second hospital day show:\\n  Hemoglobin  8.0 g/dL (N=11.5–15.5 g/dL)\\n  Hematocrit  24% (N=35%–45%)\\n  Reticulocyte count  3.1% (N=0.5%–1.5%)\\n  Lactate dehydrogenase  640 U/L (N=45–200 U/L)\\n  Haptoglobin  <10 mg/dL (N=30–200 mg/dL)\\n  Total bilirubin  3.4 mg/dL (N=0.1–1.0 mg/dL)\\n  Direct bilirubin  0.3 mg/dL (N=0.0–0.3 mg/dL)\\nHis hemoglobin concentration was 12.6 g/dL on admission. The direct antiglobulin test is negative, and a peripheral blood smear shows erythrocytes with a semicircular portion of the periphery missing. Which of the following is the most likely precipitant of this episode?\", \"choices\": [\"A. Acetaminophen administered for fever\", \"B. Dehydration from reduced oral intake\", \"C. Inhaled albuterol administered for wheezing\", \"D. The systemic infection itself\", \"E. Transient hypoxemia from the pneumonia\"], \"correct\": 3, \"explanation\": \"Drugs and fava beans are the triggers everyone memorizes, but §9 is explicit that INFECTION is the commonest precipitant of hemolysis in G6PD deficiency in practice — and this boy has received no oxidant drug. Ampicillin is not on the list; acetaminophen at therapeutic doses is not either.\\n\\nThe mechanism is the activated neutrophil. Phagocytes mounting a respiratory burst against the pathogen generate hydrogen peroxide and other reactive oxygen species → these diffuse into nearby erythrocytes → a G6PD-deficient cell cannot regenerate reduced glutathione to neutralize them → hemoglobin is oxidized and precipitates as Heinz bodies → splenic macrophages bite out the inclusions, leaving the cells on his smear.\\n\\nThe clinical importance is that the hemolysis is easily mistaken for the infection worsening: a child with pneumonia who becomes more tachycardic and paler on day 2 is assumed to be septic. The findings that reveal it are the jaundice, the dark urine, the hemoglobin falling from 12.6 to 8.0 g/dL, the undetectable haptoglobin, and the bite cells.\", \"wrongExplanations\": {\"0\": \"Acetaminophen is safe at therapeutic doses in G6PD deficiency and is not on the list of oxidant precipitants; massive overdose is a different question, and one about the liver. It would be the answer if the drug given had been a sulfonamide, primaquine, dapsone, or nitrofurantoin.\", \"1\": \"Dehydration concentrates intracellular hemoglobin and worsens sickling in SICKLE CELL disease — that is where it belongs as an answer. It does not generate the oxidant stress that a G6PD-deficient cell cannot handle.\", \"2\": \"Albuterol is not an oxidant and has no role in hemolysis; it is included because it is a plausible-sounding inpatient medication. He was not given it, and no bronchodilator causes Heinz body formation.\", \"4\": \"His oxygen saturation is 95%, so there is no meaningful hypoxemia to invoke. Hypoxia is not a trigger for G6PD hemolysis in any case — the injury is oxidative, and paradoxically requires oxygen-derived species rather than their absence.\"}, \"eli5\": \"Fighting an infection makes the body release bleach-like chemicals to kill germs, and those chemicals damage his red cells too. His cells lack the enzyme that normally cleans them up, so the infection itself set off the hemolysis.\", \"explanationImage\": \"fig_bite_uw\", \"explanationImageCaption\": \"The resulting morphology: erythrocytes with a discrete semicircular portion of the periphery removed by a splenic macrophage.\", \"los\": [{\"n\": 28, \"t\": \"Given a clinical vignette of a patient with hemolytic anemia, characterize clinical presentations, labs and diagnostics (including peripheral smear + hemoglobin electrophoresis findings), therapies and long-term complications.\", \"a\": \"s8-membrane-enzyme\", \"s\": \"§9\"}]}, {\"stem\": \"A 29-year-old man and his 27-year-old partner come to the office for preconception counseling. He has hereditary spherocytosis caused by a documented mutation in ANK1, as did his mother; he underwent splenectomy at age 14. His partner is healthy, with a normal complete blood count and no family history of anemia, jaundice, gallstones, or splenectomy. Their first child, now 2 years old, has hereditary spherocytosis and has required one transfusion.\\n\\nIf this couple has another child, which of the following is the probability that the child will inherit hereditary spherocytosis?\", \"choices\": [\"A. 1 in 2\", \"B. 1 in 3\", \"C. 1 in 4\", \"D. 2 in 3\", \"E. 3 in 4\"], \"correct\": 0, \"explanation\": \"Hereditary spherocytosis is AUTOSOMAL DOMINANT in about three-quarters of cases, including the ANK1 mutations. One affected parent who is heterozygous passes the mutant allele to half of his offspring, and a single copy is sufficient to cause disease → 1 in 2 with each pregnancy.\\n\\nThe trap is the child they already have. Each conception is an independent event: a coin that has come up heads once is no less likely to come up heads again. Having an affected 2-year-old neither raises nor lowers the risk for the next pregnancy, and reasoning that they have 'used up' their affected child is the named error the distractors are built from.\\n\\nHis dominant inheritance is visible in the pedigree — his mother was affected as well, and §9 notes this pattern showing up as a parent jaundiced in adolescence or splenectomized young. His own splenectomy cured his anemia but changed nothing about what he transmits: the mutation is in every cell, and removing the spleen removes the site of destruction, not the defect.\", \"wrongExplanations\": {\"1\": \"1 in 3 is the risk of being a carrier among the unaffected siblings in an autosomal RECESSIVE pedigree, once an affected child has been excluded. It has no application to a dominant condition, in which carriers are affected.\", \"2\": \"1 in 4 is the recurrence risk when BOTH parents are carriers of an autosomal recessive condition — the figure for sickle cell disease, beta thalassemia major, or pyruvate kinase deficiency. Applying it here treats a dominant disease as recessive.\", \"3\": \"2 in 3 comes from conditioning on being unaffected in a recessive pedigree, and would only be reached by a chain of reasoning that does not apply to a dominantly inherited disorder in which the father is affected.\", \"4\": \"3 in 4 is the probability of being unaffected in a recessive cross, or of showing a dominant phenotype when both parents are heterozygous for a dominant allele. Neither describes this couple, in whom only one parent carries the mutation.\"}, \"eli5\": \"The gene is dominant, so a child only needs one copy — and dad passes on one of his two copies each time, a coin flip. Already having one affected child does not change the odds for the next one.\", \"explanationImage\": \"fig_spherocytes\", \"explanationImageCaption\": \"The cellular consequence of the inherited defect: round, densely stained erythrocytes lacking the pale central zone.\", \"los\": [{\"n\": 28, \"t\": \"Given a clinical vignette of a patient with hemolytic anemia, characterize clinical presentations, labs and diagnostics (including peripheral smear + hemoglobin electrophoresis findings), therapies and long-term complications.\", \"a\": \"s8-membrane-enzyme\", \"s\": \"§9\"}]}, {\"stem\": \"A 5-year-old boy who receives regular transfusions for beta-thalassemia major is evaluated because of protrusion of the upper jaw and prominence of the forehead noted by his parents over the past year. He was diagnosed at 8 months of age and has been transfused irregularly because the family lives far from the center. His temperature is 37.0°C (98.6°F), pulse is 110/min, and blood pressure is 96/58 mm Hg. Physical examination shows frontal bossing, prominent maxillae with malocclusion of the teeth, and a spleen palpated 6 cm below the left costal margin.\\n\\nLaboratory studies show:\\n  Hemoglobin  7.2 g/dL (N=11.5–15.5 g/dL)\\n  Hematocrit  22% (N=35%–45%)\\n  Mean corpuscular volume  63 µm3 (N=77–95 µm3)\\n  Reticulocyte count  6.4% (N=0.5%–1.5%)\\n  Total bilirubin  2.6 mg/dL (N=0.1–1.0 mg/dL)\\nA radiograph of the skull is shown. Which of the following best explains these radiographic and facial findings?\", \"choices\": [\"A. Deposition of transfusional iron within the cranial bones\", \"B. Expansion of the marrow cavity driven by intense ineffective erythropoiesis\", \"C. Infiltration of the skull by leukemic blasts\", \"D. Osteopenia caused by long-term glucocorticoid therapy\", \"E. Subperiosteal hemorrhage caused by vitamin C deficiency\"], \"correct\": 1, \"explanation\": \"Unpartnered alpha globin chains precipitate inside erythroid precursors and kill them before release — ineffective erythropoiesis. The marrow is therefore working furiously and delivering almost nothing, and erythropoietin drive stays maximal → the hematopoietic marrow expands into every space it can reach.\\n\\nIn the skull it expands the diploic space between the inner and outer tables, and the trabeculae are pushed into perpendicular spicules, producing the radiographic appearance of fine vertical striations. In the facial bones the same expansion produces frontal bossing and maxillary prominence with dental malocclusion — the so-called chipmunk facies. Elsewhere it thins cortical bone and causes pathologic fractures, and extramedullary hematopoiesis enlarges the liver and spleen.\\n\\nThe clinically useful point is that these findings are largely PREVENTABLE. Adequate regular transfusion suppresses the erythropoietin drive and therefore the marrow expansion; this boy's changes reflect irregular transfusion because of the distance his family travels. The marrow is hypercellular while the child is profoundly anemic — the paradox that defines ineffective erythropoiesis.\", \"wrongExplanations\": {\"0\": \"Transfusional iron does accumulate in this disease and damages liver, pancreas, heart and endocrine organs — but it deposits in parenchymal organs, not as bone expansion, and it does not widen the diploic space. It would be the answer for hepatomegaly with raised transaminases, impaired glucose tolerance and delayed puberty.\", \"2\": \"Leukemic infiltration can cause bone pain and lytic change in a child, and would be the answer with blasts on the smear, a leukocyte count that is very abnormal, and thrombocytopenia. His counts are those of thalassemia, and the skull change here is a symmetric expansion rather than destructive infiltration.\", \"3\": \"Long-term glucocorticoids cause generalized osteopenia with vertebral compression, but they have no role in the treatment of thalassemia major and he is not taking any. The appearance described is expansion of a marrow space, not loss of bone mineral.\", \"4\": \"Scurvy causes subperiosteal hemorrhage, bleeding gums and poor wound healing, and would be the answer with a grossly deficient diet and perifollicular hemorrhage. It does not widen the diploë, and it does not produce microcytosis with a raised hemoglobin F.\"}, \"eli5\": \"His marrow is desperately trying to make red cells that die before they are finished, so it never switches off and it grows to fill every available space — including inside his skull and cheekbones. Regular transfusions would have turned that drive down.\", \"image\": \"fig_hair_on_end\", \"imageCaption\": \"Lateral radiograph of the skull in a child. The space between the inner and outer tables of the cranial vault is widened, and fine striations run perpendicular to the skull surface.\", \"explanationImage\": \"fig_beta_thal_uw\", \"explanationImageCaption\": \"The peripheral smear from the same disease: small, pale erythrocytes with marked variation in size and shape and numerous target cells.\", \"los\": [{\"n\": 28, \"t\": \"Given a clinical vignette of a patient with hemolytic anemia, characterize clinical presentations, labs and diagnostics (including peripheral smear + hemoglobin electrophoresis findings), therapies and long-term complications.\", \"a\": \"s9-globin\", \"s\": \"§10\"}]}, {\"stem\": \"A 27-year-old woman comes to the office for a routine examination. She feels well and has no symptoms. A complete blood count obtained 2 months ago showed microcytosis, and a 3-month course of oral iron produced no change in her indices. She has never been pregnant. Vital signs are within normal limits. Physical examination shows no abnormalities; there is no scleral icterus and the spleen is not palpable.\\n\\nLaboratory studies show:\\n  Hemoglobin  11.2 g/dL (N=12.0–16.0 g/dL)\\n  Hematocrit  34% (N=36%–46%)\\n  Mean corpuscular volume  67 µm3 (N=80–100 µm3)\\n  Red cell distribution width  13.2% (N=11.5%–14.5%)\\n  Erythrocyte count  5.4 million/mm3 (N=3.5–5.5 million/mm3)\\n  Serum ferritin  84 ng/mL (N=10–120 ng/mL)\\n  Total iron-binding capacity  318 µg/dL (N=250–400 µg/dL)\\nA peripheral blood smear shows small, pale erythrocytes and scattered target cells. Which of the following hemoglobin electrophoresis results is most likely in this patient?\", \"choices\": [\"A. Hemoglobin A2 1.8%, hemoglobin F less than 1%, no hemoglobin S\", \"B. Hemoglobin A2 2.0%, hemoglobin F 88%, no hemoglobin S\", \"C. Hemoglobin A2 2.4%, hemoglobin F 2%, hemoglobin S 39%\", \"D. Hemoglobin A2 3.0%, hemoglobin F 1%, hemoglobin S 89%\", \"E. Hemoglobin A2 5.4%, hemoglobin F 2.6%, no hemoglobin S\"], \"correct\": 4, \"explanation\": \"A RAISED hemoglobin A2 is the signature of beta-thalassemia trait, and everything in this vignette points there: microcytosis out of proportion to a nearly normal hemoglobin, a NORMAL red cell distribution width, a high-normal erythrocyte count, entirely normal iron studies, target cells, and no response to 3 months of iron.\\n\\nThe mechanism of the raised A2 follows from the arithmetic of globin chains. One beta gene is defective → beta chain output falls → alpha chains that would have paired with beta pair instead with delta (giving hemoglobin A2, α₂δ₂) and with gamma (giving hemoglobin F, α₂γ₂). So A2 rises above the normal ceiling of roughly 3.5%, typically to 3.5–7%, with a slight rise in hemoglobin F.\\n\\nThis is the counterpart to the alpha thalassemia item: in alpha-thalassemia trait, ALL of the hemoglobins need alpha chains, so every fraction falls proportionately and the electrophoresis looks unremarkable — the diagnosis there is made by gene testing after exclusion of everything else.\\n\\nThe practical instruction is the one §10 repeats: she should be given no more iron, and she needs counseling rather than treatment.\", \"wrongExplanations\": {\"0\": \"A normal hemoglobin A2 with no hemoglobin F and no hemoglobin S is the normal adult pattern, and it would be the expected result in ALPHA-thalassemia trait or in iron deficiency. Iron deficiency has been excluded by her ferritin, iron-binding capacity and lack of response to therapy.\", \"1\": \"Hemoglobin F of 88% with almost no hemoglobin A is the pattern of beta-thalassemia MAJOR or of hereditary persistence of fetal hemoglobin. Thalassemia major presents in infancy with transfusion dependence, not as an incidental finding in a well 27-year-old.\", \"2\": \"Hemoglobin S at 39% alongside hemoglobin A is sickle cell trait, which is asymptomatic — but it does not cause microcytosis, target cells, or a mean corpuscular volume of 67 µm3. It would be the answer if her indices were normal.\", \"3\": \"Hemoglobin S at 89% with no hemoglobin A is sickle cell DISEASE, which would come with a hemolytic anemia, reticulocytosis, sickled forms on the smear, and a history of painful crises from early childhood. She is asymptomatic with a hemoglobin of 11.2 g/dL.\"}, \"eli5\": \"Her cells are small but she is barely anemic, and iron did nothing — so the problem is building hemoglobin, not raw material. With one beta gene faulty, the spare chains pair up differently, and that alternative hemoglobin shows up raised on the gel.\", \"explanationImage\": \"fig_thal_minor_uw\", \"explanationImageCaption\": \"Beta-thalassemia minor on a peripheral smear: small, pale erythrocytes with target cells, in a patient who is only mildly anemic.\", \"los\": [{\"n\": 28, \"t\": \"Given a clinical vignette of a patient with hemolytic anemia, characterize clinical presentations, labs and diagnostics (including peripheral smear + hemoglobin electrophoresis findings), therapies and long-term complications.\", \"a\": \"s9-globin\", \"s\": \"§10\"}]}, {\"stem\": \"A 30-year-old woman and her 32-year-old partner come to the office for preconception counseling. Both are asymptomatic. Each has a mean corpuscular volume of approximately 70 µm3 with a hemoglobin concentration above 12 g/dL, normal iron studies, and a normal hemoglobin electrophoresis. Genetic testing shows that each of them carries a deletion of two alpha globin genes, and that in each of them the two deleted genes lie on the SAME copy of chromosome 16, with the other copy carrying two intact genes.\\n\\nFor each pregnancy, which of the following is the probability that the fetus will have hydrops fetalis?\", \"choices\": [\"A. 0\", \"B. 1 in 8\", \"C. 1 in 4\", \"D. 1 in 2\", \"E. 3 in 4\"], \"correct\": 2, \"explanation\": \"Each parent carries one chromosome 16 with NO functioning alpha gene and one with two. Each therefore transmits, with equal probability, either the doubly deleted chromosome or the intact one. A fetus receiving the deleted chromosome from both parents inherits zero functional alpha genes → 1/2 × 1/2 = 1 in 4.\\n\\nThe outcomes across a pregnancy are worth stating in full: 1 in 4 with no alpha genes (hydrops fetalis, from hemoglobin Barts), 2 in 4 with two genes on one chromosome (alpha-thalassemia trait, like the parents), and 1 in 4 with all four genes (unaffected).\\n\\nThe detail that decides the item is the word SAME. Two-gene deletions come in two arrangements, and they behave completely differently for a couple:\\n\\n• cis (--/αα), both deletions on one chromosome — can transmit a chromosome with zero alpha genes, so hydrops is possible. Commoner in Southeast Asian populations.\\n• trans (-α/-α), one deletion on each chromosome — every gamete carries at least one alpha gene, so the worst outcome for a child is hemoglobin H disease, and hydrops cannot occur.\\n\\nCounseling, prenatal diagnosis and planning for intrauterine transfusion follow from which arrangement they have, which is why the genotype rather than the blood count is what gets tested.\", \"wrongExplanations\": {\"0\": \"A risk of zero would be correct if their deletions were in the TRANS arrangement — one gene deleted on each chromosome — because then no gamete could carry a chromosome without an alpha gene. The stem specifies that both deletions lie on the same copy.\", \"1\": \"1 in 8 does not correspond to any step of this cross. It would require a third independent event of probability one half, which there is not; each parent contributes exactly one chromosome 16, so the denominator is 4.\", \"3\": \"1 in 2 is the proportion of pregnancies expected to produce a child with alpha-thalassemia trait like the parents — inheriting a deleted chromosome from one parent and an intact one from the other. It is the commonest outcome, but it is not hydrops.\", \"4\": \"3 in 4 is the probability that the fetus will be affected in SOME way, counting both the trait and the hydrops outcomes together, or equivalently the probability of not being entirely unaffected. The question asks specifically about hydrops fetalis.\"}, \"eli5\": \"Each parent has one chromosome with both alpha genes missing, and passes on one of their two chromosomes at random. If the baby happens to get the empty one from each parent, it has no alpha genes at all — and that is a one-in-four coin-flip combination.\", \"explanationImage\": \"fig_globin_chains\", \"explanationImageCaption\": \"With no alpha chains available, excess gamma chains form hemoglobin Barts (γ₄) — the tetramer that binds oxygen and will not release it.\", \"los\": [{\"n\": 28, \"t\": \"Given a clinical vignette of a patient with hemolytic anemia, characterize clinical presentations, labs and diagnostics (including peripheral smear + hemoglobin electrophoresis findings), therapies and long-term complications.\", \"a\": \"s9-globin\", \"s\": \"§10\"}]}, {\"stem\": \"A 16-year-old boy with sickle cell disease is admitted to the hospital with severe pain in his back and thighs and is treated with intravenous fluids and an opioid infusion. On the second hospital day he develops fever, pain on the right side of his chest that is worse with inspiration, and a dry cough. His temperature is 38.8°C (101.8°F), pulse is 122/min, respirations are 30/min, and blood pressure is 114/68 mm Hg. Pulse oximetry on room air shows an oxygen saturation of 88%. Physical examination shows splinting of the right chest and decreased breath sounds at the right base with scattered crackles.\\n\\nLaboratory studies show:\\n  Hemoglobin  6.9 g/dL (N=13.5–17.5 g/dL)\\n  Hematocrit  21% (N=41%–53%)\\n  Reticulocyte count  11.2% (N=0.5%–1.5%)\\n  Leukocyte count  19,800/mm3 (N=4500–11,000/mm3)\\n  Platelet count  340,000/mm3 (N=150,000–400,000/mm3)\\nHis baseline hemoglobin concentration is 8.4 g/dL. A chest radiograph shows a new right lower lobe infiltrate that was not present on admission. Which of the following is the most appropriate next step in management?\", \"choices\": [\"A. Administer empiric intravenous cefotaxime and oral azithromycin\", \"B. Administer intravenous furosemide\", \"C. Begin hydroxyurea therapy\", \"D. Increase the rate of the opioid infusion\", \"E. Obtain a ventilation-perfusion scan\"], \"correct\": 0, \"explanation\": \"A new pulmonary infiltrate with fever, chest pain and hypoxemia in a patient with sickle cell disease is acute chest syndrome — the leading cause of death in this population and the complication that most often follows a vaso-occlusive crisis by a day or two.\\n\\nAntibiotics come first and are given empirically to everyone, because the precipitant is frequently infectious and cannot be identified quickly. Cover encapsulated organisms with a third-generation cephalosporin AND atypicals with a macrolide, since Mycoplasma pneumoniae and Chlamydia pneumoniae are disproportionately common triggers here. Alongside that: supplemental oxygen to keep hemoglobin in the conformation that does not polymerize, careful hydration, incentive spirometry, adequate analgesia — and transfusion, simple or exchange, for progressive hypoxemia.\\n\\nThe self-perpetuating loop is the reason it escalates so fast: infection or infarction → hypoventilation from pain and splinting → regional hypoxemia → more sickling in the pulmonary microvasculature → more infarction. Breaking any part of it helps, which is why the treatment is a bundle.\\n\\nA third of episodes follow a painful crisis exactly as here, and opioids themselves contribute through hypoventilation — a reason for vigilance, not for withholding analgesia.\", \"wrongExplanations\": {\"1\": \"Furosemide treats volume overload, and would be the answer with distended neck veins, a third heart sound and pulmonary edema on the radiograph. Diuresis in acute chest syndrome is actively harmful: dehydration concentrates intracellular hemoglobin S and accelerates polymerization.\", \"2\": \"Hydroxyurea reduces the FREQUENCY of acute chest syndrome and painful crises over months by raising hemoglobin F, and he is an excellent candidate for it at discharge. It does nothing acutely, and starting a myelosuppressive agent during a possible infection is the wrong moment.\", \"3\": \"More opioid addresses pain but worsens the mechanism: sedation and hypoventilation reduce ventilation of the affected lung and drive further sickling. Analgesia must be adequate, but escalating it as the response to new hypoxemia and an infiltrate is the error this option captures.\", \"4\": \"A ventilation-perfusion scan looks for pulmonary embolism, which is a genuine consideration in a hypercoagulable, immobilized patient. It would be the next step with a clear chest radiograph and unexplained hypoxemia. He has a NEW infiltrate and fever, and imaging must not delay antibiotics.\"}, \"eli5\": \"Sickled cells clogged part of his lung, and infection often starts the whole thing off. He needs antibiotics and oxygen straight away, because this complication can spiral within hours.\", \"explanationImage\": \"fig_sickle_target\", \"explanationImageCaption\": \"Sickle cell disease on the peripheral smear: rigid crescent-shaped erythrocytes, the cells that lodge in the pulmonary microvasculature.\", \"los\": [{\"n\": 7, \"t\": \"Describe management approaches for sickle cell disease as it pertains to prevention and complications.\", \"a\": \"s9-globin\", \"s\": \"§10\"}]}, {\"stem\": \"A 21-year-old woman with sickle cell disease comes to the emergency department because of 8 hours of severe pain in both thighs and her lower back, similar to previous episodes. She ran a 10-km race the previous day in hot weather and drank little afterward. Her temperature is 37.2°C (99.0°F), pulse is 110/min, respirations are 20/min, and blood pressure is 108/66 mm Hg. Pulse oximetry on room air shows an oxygen saturation of 97%. Physical examination shows dry mucous membranes and tenderness of both thighs; the lungs are clear and there is no focal neurologic deficit.\\n\\nLaboratory studies show:\\n  Hemoglobin  7.9 g/dL (N=12.0–16.0 g/dL)\\n  Hematocrit  23% (N=36%–46%)\\n  Reticulocyte count  10.4% (N=0.5%–1.5%)\\n  Sodium  146 mEq/L (N=136–146 mEq/L)\\n  Creatinine  1.1 mg/dL (N=0.6–1.2 mg/dL)\\nHer baseline hemoglobin concentration is 8.0 g/dL. Intravenous normal saline and analgesia are begun. Which of the following best explains the benefit of intravenous hydration in this patient?\", \"choices\": [\"A. Decreased intracellular concentration of hemoglobin S, reducing the rate of polymerization\", \"B. Dilution of plasma free hemoglobin, protecting the renal tubules from injury\", \"C. Increased fetal hemoglobin production by erythroid precursors\", \"D. Increased oxygen-carrying capacity of the blood\", \"E. Increased splenic clearance of sickled erythrocytes\"], \"correct\": 0, \"explanation\": \"Three variables govern how much hemoglobin S polymerizes, and hydration acts on the second of them:\\n\\n1. The PROPORTION of hemoglobin S and what it can partner with. Hemoglobin S polymerizes readily with itself and poorly with hemoglobin F or A — the lever pulled by hydroxyurea and by transfusion.\\n2. The CONCENTRATION of hemoglobin inside the cell. Polymerization is steeply concentration-dependent, so a dehydrated, shrunken erythrocyte sickles far more readily. Restoring plasma volume and cell water lowers that concentration → polymerization falls off sharply.\\n3. pH. Acidosis lowers hemoglobin's oxygen affinity (the Bohr effect) → more hemoglobin is in the deoxygenated conformation → and only DEOXYGENATED hemoglobin S polymerizes.\\n\\nHer crisis has an obvious precipitant in a hot 10-km race with little fluid replacement, and the sodium of 146 mEq/L quietly confirms the dehydration. Oxygen works on the same physical chemistry from the other side, keeping hemoglobin in the conformation that does not polymerize; note that her saturation is 97%, so oxygen is not the missing element here.\\n\\nHer hemoglobin of 7.9 g/dL is at her baseline, which is the rule in a vaso-occlusive crisis: the problem is ischemia and pain, not a fall in red cell mass.\", \"wrongExplanations\": {\"1\": \"Protecting the tubules by diluting plasma free hemoglobin is the rationale for fluids in massive INTRAVASCULAR hemolysis — a G6PD crisis or an ABO-incompatible transfusion. Her crisis is vaso-occlusive, her hemoglobin is at baseline, and her creatinine is normal.\", \"2\": \"Raising fetal hemoglobin is the mechanism of hydroxyurea, and it takes weeks to months of therapy. No intravenous fluid changes which globin genes an erythroid precursor transcribes.\", \"3\": \"Oxygen-carrying capacity depends on hemoglobin concentration and saturation; intravenous crystalloid if anything dilutes the hemoglobin slightly. That effect is accepted because the benefit lies elsewhere — in the physical chemistry inside the cell.\", \"4\": \"Increasing splenic clearance would destroy MORE erythrocytes, not fewer, and would be harmful rather than helpful. Most adults with sickle cell disease have autoinfarcted their spleens in any case, so there is little splenic function left to increase.\"}, \"eli5\": \"Sickle hemoglobin only clumps when it is packed tightly together inside the cell. Giving fluid puts water back into the cells so the molecules are spread further apart and cannot lock together as easily.\", \"explanationImage\": \"fig_sickle_mutation\", \"explanationImageCaption\": \"The underlying defect: a single amino acid substitution places a sticky hydrophobic patch on the hemoglobin molecule, which allows deoxygenated molecules to polymerize.\", \"los\": [{\"n\": 7, \"t\": \"Describe management approaches for sickle cell disease as it pertains to prevention and complications.\", \"a\": \"s9-globin\", \"s\": \"§10\"}]}, {\"stem\": \"An 8-year-old girl with sickle cell disease is evaluated at a routine visit. She has had three painful episodes in the past year and takes hydroxyurea, penicillin, and folic acid. She has had no headache, weakness, or difficulty with speech, and her school performance is unchanged. Her temperature is 37.0°C (98.6°F), pulse is 92/min, and blood pressure is 104/62 mm Hg. Neurologic examination shows no abnormalities.\\n\\nLaboratory studies show:\\n  Hemoglobin  8.2 g/dL (N=11.5–15.5 g/dL)\\n  Hematocrit  25% (N=35%–45%)\\n  Reticulocyte count  8.6% (N=0.5%–1.5%)\\n  Hemoglobin F  14% (N=less than 2% after infancy)\\nTranscranial Doppler ultrasonography shows a time-averaged mean velocity of 212 cm/s in the right middle cerebral artery, confirmed on a repeat study 2 weeks later (abnormal is 200 cm/s or greater). Which of the following is the most appropriate next step in management?\", \"choices\": [\"A. Begin chronic red blood cell transfusion to maintain hemoglobin S below 30%\", \"B. Begin daily low-dose aspirin\", \"C. Begin therapeutic anticoagulation with warfarin\", \"D. Perform carotid endarterectomy\", \"E. Perform splenectomy\"], \"correct\": 0, \"explanation\": \"An abnormal transcranial Doppler velocity of 200 cm/s or more identifies a child at high risk of a first stroke — roughly 10% per year without treatment. The intervention with randomized trial evidence behind it is chronic transfusion to keep the hemoglobin S fraction below 30%, which reduces that risk by more than 90%.\\n\\nThe mechanism is dilution, the same lever as always. Transfused donor cells contain hemoglobin A, which hemoglobin S polymerizes with poorly → the sickling tendency of the circulating red cell mass falls → the turbulent high-velocity flow through a stenosing cerebral vessel is no longer accompanied by ongoing sickling and endothelial injury.\\n\\nThis is PRIMARY prevention: she is entirely asymptomatic and the screening study is what identifies her. Transcranial Doppler screening is performed annually from age 2 to 16 for that reason.\\n\\nWhat it commits her to also matters: transfusion every 3 to 4 weeks, iron overload requiring chelation, alloimmunization risk, and venous access problems. Hydroxyurea is not an adequate substitute at the point of an abnormal velocity, though it is appropriate to continue and is used in some children after a period of transfusion.\", \"wrongExplanations\": {\"1\": \"Aspirin prevents platelet-mediated arterial thrombosis in atherosclerotic disease. The cerebral vasculopathy of sickle cell disease is driven by sickling, endothelial injury and intimal proliferation, and antiplatelet therapy has not been shown to prevent these strokes.\", \"2\": \"Warfarin prevents thromboembolism from atrial fibrillation or venous thrombosis, and would be the answer for a cardioembolic source. It does nothing about polymerization, and adds bleeding risk to a child who does not have a thrombotic occlusion of the type it prevents.\", \"3\": \"Endarterectomy treats atherosclerotic stenosis at the carotid bifurcation in adults. Her abnormality is in the intracranial middle cerebral artery and is caused by a hemoglobinopathy, not by plaque; there is nothing for a surgeon to remove.\", \"4\": \"Splenectomy is reserved for recurrent splenic sequestration or massive splenomegaly. By 8 years of age most children with sickle cell disease have already autoinfarcted the spleen, and removing it has no effect on cerebral blood flow.\"}, \"eli5\": \"An ultrasound found blood racing through an artery in her brain, which warns that a stroke is coming. Regular transfusions swap in enough normal hemoglobin to dilute the sickle kind, and that has been shown to prevent those strokes.\", \"explanationImage\": \"fig_electrophoresis\", \"explanationImageCaption\": \"Electrophoresis quantifies the hemoglobin fractions — the measurement used to confirm that transfusion has driven hemoglobin S below the 30% target.\", \"los\": [{\"n\": 7, \"t\": \"Describe management approaches for sickle cell disease as it pertains to prevention and complications.\", \"a\": \"s9-globin\", \"s\": \"§10\"}]}, {\"stem\": \"A 20-year-old man with sickle cell disease comes to the office to establish care after moving to the area. He has had three painful episodes requiring admission in the past 2 years and takes hydroxyurea and folic acid. He has never undergone abdominal surgery. His temperature is 37.0°C (98.6°F), pulse is 84/min, and blood pressure is 118/70 mm Hg. Physical examination shows scleral icterus; the abdomen is soft and the spleen cannot be palpated. Ultrasonography of the abdomen shows a small, densely calcified spleen measuring 3 cm.\\n\\nLaboratory studies show:\\n  Hemoglobin  8.0 g/dL (N=13.5–17.5 g/dL)\\n  Hematocrit  24% (N=41%–53%)\\n  Reticulocyte count  9.4% (N=0.5%–1.5%)\\n  Leukocyte count  11,200/mm3 (N=4500–11,000/mm3)\\n  Platelet count  468,000/mm3 (N=150,000–400,000/mm3)\\nWhich of the following findings on the peripheral blood smear is most likely in this patient?\", \"choices\": [\"A. Basophilic stippling\", \"B. Bite cells\", \"C. Howell-Jolly bodies\", \"D. Hypersegmented neutrophils\", \"E. Rouleaux formation\"], \"correct\": 2, \"explanation\": \"Howell-Jolly bodies are small, dense, round remnants of nuclear DNA left in mature erythrocytes. A working spleen pits them out as cells pass through the splenic cords, so their presence means the spleen is absent or no longer functioning.\\n\\nHere the spleen is present but dead. Repeated sickling and infarction from early childhood produces AUTOSPLENECTOMY — a small, fibrotic, calcified organ, exactly as the ultrasound describes. His thrombocytosis and mild leukocytosis are part of the same picture, since the spleen normally sequesters a fraction of both.\\n\\nThe reason to recognize it is not the smear but what follows from it. Functional asplenia means he cannot clear encapsulated organisms — Streptococcus pneumoniae, Neisseria meningitidis, Haemophilus influenzae type b — so fever in this patient is an emergency requiring empiric parenteral antibiotics, and his pneumococcal and meningococcal vaccination must be current. The smear finding is the quiet clue; the vulnerability is the point.\\n\\nHis smear would also show sickled forms and target cells, but those are expected in anyone with the disease and say nothing about the spleen.\", \"wrongExplanations\": {\"0\": \"Basophilic stippling — fine blue cytoplasmic granules of residual ribosomal RNA — points to lead poisoning or a thalassemia, and would be the answer with an exposure history and abdominal pain or with microcytosis and a raised hemoglobin A2.\", \"1\": \"Bite cells appear when a splenic macrophage removes a Heinz body, which requires a functioning spleen and an oxidant insult in a G6PD-deficient cell. Both conditions are absent: he has no oxidant exposure, and the organ that takes the bite has infarcted.\", \"3\": \"Neutrophils with five or more lobes indicate B12 or folate deficiency. He takes folic acid precisely because chronic hemolysis consumes it, and deficiency would produce a raised mean corpuscular volume with a LOW reticulocyte count rather than the 9.4% here.\", \"4\": \"Rouleaux — erythrocytes stacked like coins — reflect a paraprotein coating the cells, as in multiple myeloma or Waldenström macroglobulinemia. It would be the answer with a monoclonal band, bone pain, renal impairment or hypercalcemia, none of which he has.\"}, \"eli5\": \"Years of sickling have scarred his spleen into a small lump of calcium, so it no longer cleans the blood. Leftover bits of DNA that the spleen would normally pluck out of red cells stay behind and show up on the slide.\", \"explanationImage\": \"fig_howell_jolly\", \"explanationImageCaption\": \"Howell-Jolly bodies (arrows): dense round nuclear remnants within circulating erythrocytes, the smear signature of a missing or non-functioning spleen.\", \"los\": [{\"n\": 7, \"t\": \"Describe management approaches for sickle cell disease as it pertains to prevention and complications.\", \"a\": \"s9-globin\", \"s\": \"§10\"}, {\"n\": 51, \"t\": \"Given a clinical vignette, identify the pathophysiology of post splenectomy complications including the serious complication of post-splenectomy infection and/or sepsis.\", \"a\": \"s10-spleen\", \"s\": \"§11\"}]}, {\"stem\": \"A 34-year-old woman with sickle cell disease comes to the office because of 6 months of increasing shortness of breath on exertion and a painful ulcer above her left medial malleolus that has not healed in 4 months. She has had few painful crises in recent years. She takes hydroxyurea and folic acid. Her temperature is 37.0°C (98.6°F), pulse is 92/min, respirations are 18/min, and blood pressure is 112/70 mm Hg. Pulse oximetry on room air shows an oxygen saturation of 95%. Physical examination shows scleral icterus, a loud pulmonic component of the second heart sound, and a 3-cm shallow ulcer with a clean base above the left medial malleolus. The lungs are clear.\\n\\nLaboratory studies show:\\n  Hemoglobin  8.4 g/dL (N=12.0–16.0 g/dL)\\n  Hematocrit  25% (N=36%–46%)\\n  Reticulocyte count  12.8% (N=0.5%–1.5%)\\n  Lactate dehydrogenase  620 U/L (N=45–200 U/L)\\n  Haptoglobin  <10 mg/dL (N=30–200 mg/dL)\\n  Total bilirubin  3.4 mg/dL (N=0.1–1.0 mg/dL)\\n  Direct bilirubin  0.3 mg/dL (N=0.0–0.3 mg/dL)\\nEchocardiography shows a tricuspid regurgitant jet velocity of 3.4 m/s (N=less than 2.5 m/s) with normal left ventricular function. CT angiography of the chest shows no pulmonary embolism and no parenchymal disease. Which of the following best explains this patient's pulmonary hypertension and leg ulceration?\", \"choices\": [\"A. Chronic deposition of iron within the pulmonary vasculature\", \"B. Depletion of nitric oxide by cell-free plasma hemoglobin\", \"C. Deposition of immune complexes within small vessels\", \"D. Increased blood viscosity from a chronically raised hematocrit\", \"E. Thromboembolic obstruction of the pulmonary arteries\"], \"correct\": 1, \"explanation\": \"Sickle cell disease has three downstream arms, and this patient is showing the third. Vaso-occlusion produces pain and infarction; vasculopathy produces endothelial dysfunction; and HEMOLYSIS produces a distinct set of complications through nitric oxide.\\n\\nThe chain: cells are torn apart under arterial pressure → hemoglobin is released free into plasma → cell-free hemoglobin avidly scavenges nitric oxide, and arginase released from the same lysed cells depletes the substrate for making more → nitric oxide, the principal endothelial vasodilator, is consumed → sustained vasoconstriction, endothelial dysfunction and smooth muscle proliferation. The clinical results are pulmonary hypertension, chronic leg ulceration, priapism and cerebrovascular disease.\\n\\nHer laboratory pattern is the hemolytic phenotype in its pure form: lactate dehydrogenase 620 U/L, an undetectable haptoglobin, unconjugated hyperbilirubinemia, and a reticulocyte count of 12.8%. The intensity of hemolysis, rather than the frequency of pain crises, is what tracks these particular complications — which is why she has few crises and severe vasculopathy.\\n\\nPulmonary hypertension in sickle cell disease carries a markedly increased mortality, and a raised tricuspid regurgitant jet velocity warrants right heart catheterization to confirm it.\", \"wrongExplanations\": {\"0\": \"Iron does accumulate in chronically transfused patients and damages the heart, liver and endocrine organs — but as parenchymal deposition producing cardiomyopathy, not as isolated pulmonary arterial hypertension, and it would not cause a leg ulcer.\", \"2\": \"Immune complex deposition causes vasculitis or glomerulonephritis, and would be the answer with palpable purpura, an active urinary sediment, arthritis, or a positive serology. Her ulcer has a clean base and there is no evidence of an immune-mediated process.\", \"3\": \"Hyperviscosity from a high hematocrit is the mechanism in polycythemia vera, and it is the reason transfusion in sickle cell disease is done cautiously. Her hematocrit is 25%, so viscosity is not raised — indeed one of the hazards of over-transfusing these patients is creating the problem this option describes.\", \"4\": \"Chronic thromboembolic disease is a genuine cause of pulmonary hypertension, and these patients are hypercoagulable — which is why CT angiography was obtained. It shows no embolism, and it would not explain a chronic medial malleolar ulcer.\"}, \"eli5\": \"When her red cells burst, hemoglobin spills into the blood and mops up the chemical her vessels use to relax. Her blood vessels stay clamped down, which strains the lungs and starves the skin over her ankle so an ulcer will not heal.\", \"explanationImage\": \"fig_sickle_smear\", \"explanationImageCaption\": \"The engine of the process: rigid crescent-shaped erythrocytes that are sheared apart under arterial pressure, releasing hemoglobin into plasma.\", \"los\": [{\"n\": 7, \"t\": \"Describe management approaches for sickle cell disease as it pertains to prevention and complications.\", \"a\": \"s9-globin\", \"s\": \"§10\"}, {\"n\": 25, \"t\": \"Distinguish between various causes of hemolytic anemia and characterize by site of hemolysis (intravascular versus extravascular), pathophysiology, laboratory testing and diagnostics.\", \"a\": \"s7-hemolysis\", \"s\": \"§8\"}]}, {\"stem\": \"PATIENT INFORMATION\\nAge: 68 years\\nGender: Female\\nSite of Care: Inpatient surgical ward, hospital day 2\\n\\nHISTORY\\nReason for Visit: Postoperative care after elective right total hip arthroplasty\\nHPI: Surgery was uncomplicated, with an estimated blood loss of 350 mL. She is ambulating with physical therapy, eating a regular diet, and reports only incisional pain. She denies chest pain, palpitations, light-headedness, and dyspnea at rest or with walking.\\nPMH: Hypertension. Osteoarthritis. No coronary artery disease, heart failure, or chronic kidney disease.\\nMedications: Lisinopril, acetaminophen, enoxaparin for thromboprophylaxis\\nAllergies: No known drug allergies\\nFamily History: Noncontributory\\nPsychosocial History: Does not smoke cigarettes or drink alcoholic beverages\\n\\nPHYSICAL EXAMINATION\\nVital Signs: Temperature 36.9°C (98.4°F), pulse 78/min, respirations 16/min, blood pressure 126/74 mm Hg, oxygen saturation 98% on room air\\nGeneral: Comfortable, alert, in no distress\\nCardiovascular: Regular rate and rhythm, no murmur, capillary refill less than 2 seconds\\nPulmonary: Clear to auscultation bilaterally\\nWound: Clean and dry, no hematoma, drain output minimal\\n\\nDIAGNOSTIC STUDIES\\nLaboratory studies show:\\n  Hemoglobin  7.6 g/dL (N=12.0–16.0 g/dL)\\n  Hematocrit  23% (N=36%–46%)\\n  Mean corpuscular volume  88 µm3 (N=80–100 µm3)\\n  Platelet count  268,000/mm3 (N=150,000–400,000/mm3)\\n  Creatinine  0.9 mg/dL (N=0.6–1.2 mg/dL)\\nHer preoperative hemoglobin concentration was 12.4 g/dL. Electrocardiography shows normal sinus rhythm with no ischemic changes.\\n\\nQuestion: Which of the following is the most appropriate next step in management?\", \"choices\": [\"A. Administer fresh frozen plasma\", \"B. Administer one unit of packed red blood cells\", \"C. Administer two units of packed red blood cells\", \"D. No transfusion; continue observation and reassess\", \"E. Transfuse to a target hemoglobin concentration of 10 g/dL\"], \"correct\": 3, \"explanation\": \"She is euvolemic, hemodynamically stable, asymptomatic, and not bleeding, with a hemoglobin of 7.6 g/dL. Under a restrictive strategy that is ABOVE the transfusion threshold, so the correct action is to give no blood.\\n\\nThe evidence is the TRICC trial (1999): 838 euvolemic critically ill patients randomized to a restrictive threshold (transfuse below 7 g/dL) or a liberal one (below 10 g/dL). There was no difference in 30-day mortality, and the LIBERAL arm — the one that received more blood — did worse. Every threshold in transfusion medicine has moved down since.\\n\\nTwo further points from §12 apply directly to the surgical resident's instinct here. Red cells are given to increase oxygen-carrying capacity; they are explicitly NOT given to speed wound healing or shorten time to ambulation, both of which were once believed and neither of which is supported. And when a transfusion is indicated, the order is ONE unit, then reassess — never a reflexive two.\\n\\nTransfusion is never free: every unit comes from a volunteer donor and carries a finite risk of reaction and infection. The question is never 'is the number low?' but 'will this unit help more than it might harm?'\", \"wrongExplanations\": {\"0\": \"Plasma is given for a documented multiple factor deficiency with active bleeding, or for a markedly prolonged coagulation test before a procedure. She has neither — her problem is dilutional anemia after a normal surgical blood loss, and plasma carries no oxygen at all.\", \"1\": \"One unit followed by reassessment is the correct FORM of a red cell order, and would be the answer if she were below the threshold or symptomatic — chest pain, dyspnea at rest, light-headedness, or hemodynamic instability. At 7.6 g/dL in a comfortable, ambulating patient, the indication itself is missing.\", \"2\": \"Two units at once compounds two errors: transfusing without an indication, and ordering a fixed number of units rather than reassessing after each. This is the reflex the whole restrictive-strategy literature was written against.\", \"4\": \"A target of 10 g/dL is precisely the liberal arm of TRICC, which showed no mortality benefit and worse outcomes than the restrictive arm. Chasing a number rather than treating a patient is the error the trial was designed to expose.\"}, \"eli5\": \"Her blood count is low after surgery, but she feels fine, is walking, and her heart and lungs are coping. Big studies showed that giving blood at this level makes people do worse, not better, so the right move is to wait and watch.\", \"explanationImage\": \"fig_tx_reactions\", \"explanationImageCaption\": \"Why transfusion is never free: each product carries its own reaction mechanism, summarized by donor factor, reaction, and host factor.\", \"los\": [{\"n\": 74, \"t\": \"Identify which blood product should be used to correct specific coagulopathies / bleeding disorders.\", \"a\": \"s11-products\", \"s\": \"§12\"}]}, {\"stem\": \"A 54-year-old woman with acute myeloid leukemia is receiving induction chemotherapy. On the tenth day of her admission she develops a headache and neck stiffness, and a diagnostic lumbar puncture is planned. She has no bleeding, no petechiae, and no bruising. Her temperature is 38.4°C (101.1°F), pulse is 96/min, respirations are 18/min, and blood pressure is 118/70 mm Hg.\\n\\nLaboratory studies show:\\n  Hemoglobin  8.9 g/dL (N=12.0–16.0 g/dL)\\n  Hematocrit  27% (N=36%–46%)\\n  Leukocyte count  900/mm3 (N=4500–11,000/mm3)\\n  Platelet count  14,000/mm3 (N=150,000–400,000/mm3)\\n  Prothrombin time  12.4 seconds (N=11–15 seconds)\\n  Partial thromboplastin time  31 seconds (N=25–40 seconds)\\nPlatelet transfusion is planned before the procedure. The platelet count should be raised above which of the following values?\", \"choices\": [\"A. 10,000/mm3\", \"B. 20,000/mm3\", \"C. 25,000/mm3\", \"D. 50,000/mm3\", \"E. 100,000/mm3\"], \"correct\": 1, \"explanation\": \"The thresholds in §12 rise with how much is about to be risked, and the lumbar puncture threshold is 20,000/mm3.\\n\\n• 10,000/mm3 — a stable, non-bleeding patient with HYPOPROLIFERATIVE thrombocytopenia (chemotherapy, stem cell transplant) and no procedure planned. This is where she was before the headache.\\n• 20,000/mm3 — before a lumbar puncture. A needle is entering the spinal canal, where a hematoma can compress the cord.\\n• 25,000/mm3 — preterm neonates, whose germinal matrix vessels are fragile.\\n\\nThe memory hook: ten for chemo, twenty for a tap, twenty-five for a preemie.\\n\\nThe rest of her picture supports transfusing rather than waiting. Her thrombocytopenia is hypoproliferative — the marrow is suppressed by chemotherapy — so transfused platelets will survive normally and the count will rise predictably. Her coagulation tests are normal, so plasma has no role. And the febrile neutropenia that prompted the lumbar puncture must be treated in parallel.\", \"wrongExplanations\": {\"0\": \"10,000/mm3 is the threshold for a stable, non-bleeding patient with hypoproliferative thrombocytopenia who is NOT undergoing a procedure. It would be the answer if the lumbar puncture were not planned — her count of 14,000/mm3 alone would not require transfusion.\", \"2\": \"25,000/mm3 is the threshold for preterm neonates. It would be the answer for a premature infant, whose fragile germinal matrix vessels make intraventricular hemorrhage the feared complication.\", \"3\": \"50,000/mm3 is the conventional threshold for major surgery or an invasive procedure with substantial bleeding risk, and for an actively bleeding patient. Applying it to a lumbar puncture transfuses more product than the evidence requires.\", \"4\": \"100,000/mm3 is reserved for neurosurgery and ophthalmic surgery, where bleeding into a closed space is catastrophic. Using it here would expose her to unnecessary transfusion in an already heavily transfused patient.\"}, \"eli5\": \"Her platelets are too low to safely put a needle into her spine, because a bruise there could squeeze the spinal cord. The cutoff for that particular procedure is twenty thousand.\", \"explanationImage\": \"fig_tx_timeline\", \"explanationImageCaption\": \"Transfusion carries its own risks on a predictable timeline, which is why each product is given against a defined threshold rather than reflexively.\", \"los\": [{\"n\": 74, \"t\": \"Identify which blood product should be used to correct specific coagulopathies / bleeding disorders.\", \"a\": \"s11-products\", \"s\": \"§12\"}]}, {\"stem\": \"A 28-year-old woman comes to the office because of 5 days of easy bruising and small red spots on her shins. She had an upper respiratory tract infection 2 weeks ago. She takes no medications and has no history of serious illness. Her temperature is 37.0°C (98.6°F), pulse is 78/min, and blood pressure is 114/72 mm Hg. Physical examination shows scattered petechiae over both shins and a few small bruises on her forearms. There is no lymphadenopathy, the spleen is not palpable, and there is no active bleeding.\\n\\nLaboratory studies show:\\n  Hemoglobin  13.1 g/dL (N=12.0–16.0 g/dL)\\n  Hematocrit  39% (N=36%–46%)\\n  Leukocyte count  7,200/mm3 (N=4500–11,000/mm3)\\n  Platelet count  8,000/mm3 (N=150,000–400,000/mm3)\\n  Prothrombin time  12.1 seconds (N=11–15 seconds)\\n  Partial thromboplastin time  29 seconds (N=25–40 seconds)\\n  Fibrinogen  340 mg/dL (N=200–400 mg/dL)\\nA peripheral blood smear shows markedly reduced platelets, some of them large, with normal erythrocyte and leukocyte morphology. Bone marrow examination shows increased megakaryocytes. Which of the following best explains why platelet transfusion would be unlikely to raise this patient's platelet count?\", \"choices\": [\"A. Antibody-mediated destruction of transfused platelets by splenic macrophages\", \"B. Consumption of transfused platelets within widespread microvascular thrombi\", \"C. Dilution of transfused platelets by the expanded plasma volume\", \"D. Failure of megakaryocyte maturation within the bone marrow\", \"E. Sequestration of transfused platelets within an enlarged spleen\"], \"correct\": 0, \"explanation\": \"This is immune thrombocytopenia: isolated thrombocytopenia with large platelets, normal coagulation tests, INCREASED marrow megakaryocytes, and no other cause. The marrow is producing platelets perfectly well; an autoantibody is destroying them peripherally, and splenic macrophages clear the antibody-coated platelets.\\n\\nThat mechanism is exactly why transfusion does not work. The autoantibody does not distinguish the patient's platelets from a donor's, so transfused platelets are destroyed at the same accelerated rate → the count barely moves → the product is wasted and the patient exposed for nothing.\\n\\nThe 10,000/mm3 transfusion threshold in §12 is written specifically for HYPOPROLIFERATIVE thrombocytopenia, where the marrow cannot make platelets and transfused ones survive normally. It does not transfer to destructive or consumptive states. The review file makes the same point with dengue, where the platelets are being consumed.\\n\\nTreatment is aimed at the immune process — corticosteroids, intravenous immune globulin, or a thrombopoietin receptor agonist — with platelet transfusion reserved for serious active bleeding, where it is given alongside that treatment as a temporizing measure. Treat the mechanism, not the number.\", \"wrongExplanations\": {\"1\": \"Consumption within microthrombi is the mechanism of disseminated intravascular coagulation and the thrombotic microangiopathies, and it would also make transfusion futile — so the reasoning is right but the disease is wrong. It would be the answer with schistocytes, a low fibrinogen, or organ ischemia; her fibrinogen is 340 mg/dL, her coagulation tests are normal and her smear shows no fragments.\", \"2\": \"Dilution explains thrombocytopenia after massive volume resuscitation or massive transfusion, and would be the answer in a patient who had received many units of red cells and crystalloid. She is euvolemic and has received nothing.\", \"3\": \"A maturation failure in the marrow is the hypoproliferative mechanism — aplastic anemia, myelodysplastic syndrome, marrow infiltration, or chemotherapy. That is the setting in which the 10,000 threshold applies and transfusion works well. Her marrow shows INCREASED megakaryocytes, which excludes it.\", \"4\": \"Splenic sequestration lowers the count in hypersplenism from portal hypertension or a large spleen of any cause, and transfused platelets would indeed be sequestered too. It would be the answer with a palpable spleen and often pancytopenia; her spleen is not palpable and her other counts are normal.\"}, \"eli5\": \"Her immune system is making antibodies that tag platelets for destruction. New platelets from a donor get tagged and destroyed just as fast, so you have to switch off the immune attack instead of topping up the platelets.\", \"explanationImage\": \"fig_tx_reactions\", \"explanationImageCaption\": \"Antibody-mediated destruction of platelets follows the same logic as the antibody-mediated transfusion reactions: what the antibody recognizes, it destroys — whether the cell came from the patient or a donor.\", \"los\": [{\"n\": 74, \"t\": \"Identify which blood product should be used to correct specific coagulopathies / bleeding disorders.\", \"a\": \"s11-products\", \"s\": \"§12\"}, {\"n\": 36, \"t\": \"Given a clinical vignette, differentiate both inherited and acquired disorders of platelets by their clinical presentation, labs and diagnostics, and pathophysiology.\", \"a\": \"s45-itp\", \"s\": \"§50\"}]}, {\"stem\": \"A 31-year-old woman, gravida 2, para 2, has heavy vaginal bleeding 40 minutes after a vaginal delivery complicated by placental abruption. She has received 2 L of crystalloid and 4 units of packed red blood cells. Bleeding continues from the uterus and oozes from her intravenous sites. Her temperature is 36.4°C (97.5°F), pulse is 128/min, respirations are 26/min, and blood pressure is 88/52 mm Hg.\\n\\nLaboratory studies show:\\n  Hemoglobin  7.8 g/dL (N=12.0–16.0 g/dL)\\n  Hematocrit  23% (N=36%–46%)\\n  Platelet count  96,000/mm3 (N=150,000–400,000/mm3)\\n  Prothrombin time  22 seconds (N=11–15 seconds)\\n  Partial thromboplastin time  58 seconds (N=25–40 seconds)\\n  Fibrinogen  82 mg/dL (N=200–400 mg/dL)\\n  D-dimer  4,900 ng/mL (N=≤250 ng/mL)\\nIn addition to continued red blood cell transfusion, which of the following products is most appropriate to correct the abnormality most in need of replacement?\", \"choices\": [\"A. Albumin 5%\", \"B. Cryoprecipitate\", \"C. Fresh frozen plasma\", \"D. Packed red blood cells\", \"E. Platelet concentrate\"], \"correct\": 1, \"explanation\": \"She has disseminated intravascular coagulation after placental abruption — clotting and fibrinolysis running at once, with a prolonged prothrombin time and partial thromboplastin time, a rising D-dimer, falling platelets, and a fibrinogen of 82 mg/dL. The value most in need of replacement is the fibrinogen, and the concentrated source of fibrinogen is cryoprecipitate.\\n\\nWhy not simply give more plasma? Plasma contains fibrinogen only at PHYSIOLOGIC concentration, so raising a fibrinogen of 82 mg/dL toward the 150–200 mg/dL needed for hemostasis would require a volume this hypotensive, already fluid-loaded patient cannot tolerate. Cryoprecipitate is the cold-insoluble fraction left when frozen plasma is thawed at refrigerator temperature — enriched in fibrinogen, and also carrying factor VIII, von Willebrand factor, factor XIII and fibronectin — and delivers the same fibrinogen in a fraction of the volume.\\n\\nFibrinogen matters because it is the end of the road: the intrinsic and extrinsic pathways converge on the common pathway, and the final step is fibrinogen becoming fibrin, the protein that actually cross-links the clot. Without it the rest of the cascade has nothing to build with.\\n\\nObstetric hemorrhage is named in §12 as the setting that drops into a low-fibrinogen state fastest. In practice all of this happens inside a massive transfusion protocol, with balanced products delivered together.\", \"wrongExplanations\": {\"0\": \"Albumin is a purified colloid volume expander made from pooled plasma. It contains NO coagulation factors at all, so it would restore blood pressure briefly while doing nothing for hemostasis — and would dilute what clotting factors she has left.\", \"2\": \"Plasma does address her multiple factor deficiency and is part of the resuscitation, which is what makes it the near-miss. It is not the answer to the specific question of what corrects the abnormality most in need of replacement: a fibrinogen of 82 mg/dL cannot be corrected by plasma in a tolerable volume.\", \"3\": \"More red cells are certainly being given — she is anemic and bleeding — and the stem says so explicitly. Red cells carry oxygen and contribute nothing to hemostasis, so they cannot correct the coagulopathy that is keeping her bleeding.\", \"4\": \"Platelets are reasonable in massive obstetric hemorrhage, and hers are falling. But at 96,000/mm3 she is well above any bleeding threshold, whereas her fibrinogen is less than half of the level needed to form a clot. The number that is critically low is the one to replace.\"}, \"eli5\": \"Her blood has burned through the protein that forms the actual mesh of a clot. Plain plasma is too watery to replace enough of it, so she needs the concentrated version.\", \"explanationImage\": \"fig_tx_reactions\", \"explanationImageCaption\": \"Each product replaces a specific deficit; cryoprecipitate is the concentrated fibrinogen source, which plasma cannot match without an intolerable volume load.\", \"los\": [{\"n\": 74, \"t\": \"Identify which blood product should be used to correct specific coagulopathies / bleeding disorders.\", \"a\": \"s11-products\", \"s\": \"§12\"}]}, {\"stem\": \"A 76-year-old man is brought to the emergency department 90 minutes after the sudden onset of severe headache followed by left-sided weakness. He takes warfarin for atrial fibrillation. His temperature is 36.8°C (98.2°F), pulse is 82/min and irregular, respirations are 16/min, and blood pressure is 176/94 mm Hg. Physical examination shows left hemiparesis and a left facial droop; he is drowsy but rousable.\\n\\nLaboratory studies show:\\n  Hemoglobin  13.9 g/dL (N=13.5–17.5 g/dL)\\n  Hematocrit  41% (N=41%–53%)\\n  Platelet count  232,000/mm3 (N=150,000–400,000/mm3)\\n  Prothrombin time  38 seconds (N=11–15 seconds)\\n  International normalized ratio  4.2 (N=0.8–1.2)\\n  Partial thromboplastin time  46 seconds (N=25–40 seconds)\\nCT scan of the head without contrast shows an acute right basal ganglia hemorrhage with mild mass effect. Which of the following is the most appropriate treatment to correct his coagulopathy?\", \"choices\": [\"A. Four-factor prothrombin complex concentrate and intravenous vitamin K\", \"B. Fresh frozen plasma alone\", \"C. Intravenous vitamin K alone\", \"D. Platelet transfusion\", \"E. Protamine sulfate\"], \"correct\": 0, \"explanation\": \"Warfarin depletes the vitamin K-dependent factors II, VII, IX and X. With an intracranial hemorrhage and an international normalized ratio of 4.2, reversal must be immediate and complete, and the combination is a factor concentrate PLUS vitamin K.\\n\\nWhy both, and why this concentrate:\\n• Four-factor prothrombin complex concentrate replaces exactly the missing factors, works within minutes, and comes in a volume of a few hundred millilitres. §12 states plainly that it is more efficacious and faster than plasma, with far less volume — which matters in a 76-year-old with a blood pressure of 176/94 mm Hg.\\n• Vitamin K is given at the same time because the concentrate is consumed within hours while warfarin's effect persists for days. Without it the international normalized ratio rebounds. Vitamin K alone takes 6 to 24 hours to work — far too slow for a bleeding brain.\\n\\nPlasma is the fallback only where prothrombin complex concentrate is unavailable: correcting an international normalized ratio of 4.2 with plasma takes a large volume delivered over hours, with a real risk of circulatory overload.\\n\\nThe general principle from §12 — do not use plasma when a specific concentrate exists — applies to single factor deficiencies in the same way.\", \"wrongExplanations\": {\"1\": \"Plasma alone is the historical answer and is still used where prothrombin complex concentrate is unavailable, which is what makes it the near-miss. It corrects more slowly, requires 10–20 mL/kg (roughly a litre in this man), risks circulatory overload, and without vitamin K the international normalized ratio rebounds as the transfused factors are consumed.\", \"2\": \"Vitamin K is an essential part of the treatment but takes 6 to 24 hours to restore factor synthesis, because the liver must make the factors. It would be sufficient alone only for an asymptomatic raised international normalized ratio without bleeding.\", \"3\": \"Platelets would be indicated if the coagulopathy were thrombocytopenic or if he were on an antiplatelet drug with a bleeding threshold — his count is 232,000/mm3. Platelets do nothing about depleted vitamin K-dependent factors.\", \"4\": \"Protamine sulfate reverses HEPARIN, by binding it directly. It has no effect on warfarin, which acts by inhibiting vitamin K epoxide reductase rather than by circulating as an inhibitable drug.\"}, \"eli5\": \"The blood thinner has knocked out four clotting proteins, and he is bleeding into his brain. He needs those proteins put straight back in, plus vitamin K so his liver starts making them again before the infusion wears off.\", \"explanationImage\": \"fig_tx_timeline\", \"explanationImageCaption\": \"Plasma-based reversal takes hours and a large volume; the timeline of transfusion-related harm is one reason a concentrated, low-volume product is preferred when it is available.\", \"los\": [{\"n\": 74, \"t\": \"Identify which blood product should be used to correct specific coagulopathies / bleeding disorders.\", \"a\": \"s11-products\", \"s\": \"§12\"}, {\"n\": 12, \"t\": \"Describe the methods of reversal of drug toxicities caused by anticoagulants and thrombolytics.\", \"a\": \"s14-anticoag\", \"s\": \"§15\"}]}, {\"stem\": \"A 22-year-old man with severe hemophilia A comes to the emergency department because of a swollen, painful right knee that began 4 hours ago after a fall. His baseline factor VIII activity is less than 1% of normal (N=50%–150%). He has had no inhibitor detected on previous testing. His temperature is 37.0°C (98.6°F), pulse is 92/min, and blood pressure is 122/74 mm Hg. Physical examination shows a warm, tense, distended right knee held in slight flexion, with severely limited range of motion. There is no mucosal bleeding and no petechiae.\\n\\nLaboratory studies show:\\n  Hemoglobin  13.6 g/dL (N=13.5–17.5 g/dL)\\n  Hematocrit  40% (N=41%–53%)\\n  Platelet count  254,000/mm3 (N=150,000–400,000/mm3)\\n  Prothrombin time  12.6 seconds (N=11–15 seconds)\\n  Partial thromboplastin time  74 seconds (N=25–40 seconds)\\nWhich of the following is the most appropriate treatment?\", \"choices\": [\"A. Cryoprecipitate\", \"B. Desmopressin\", \"C. Factor VIII concentrate\", \"D. Fresh frozen plasma\", \"E. Platelet transfusion\"], \"correct\": 2, \"explanation\": \"This is an acute hemarthrosis in severe hemophilia A, and the treatment is the specific factor that is missing. §12 states the rule directly: plasma is NOT for single factor deficiencies — if a patient is factor VIII deficient, you give factor VIII.\\n\\nThe reasoning is dose and volume. Recombinant factor VIII concentrate is purified, carries no risk of transfusion-transmitted infection, and delivers a calculable dose — enough to raise activity to roughly 50% for a joint bleed, or higher for intracranial or surgical bleeding. Achieving the same rise with plasma would require a volume measured in litres, because plasma carries factor VIII only at physiologic concentration.\\n\\nThe urgency is the joint itself. Blood in a joint space triggers synovial inflammation and cartilage destruction, and repeated hemarthroses produce the deforming arthropathy that used to define this disease. Factor is given FIRST, before imaging or aspiration, on clinical suspicion alone.\\n\\nHis laboratory pattern is the classic one: an isolated prolonged partial thromboplastin time with a normal prothrombin time and a normal platelet count, in a man with deep rather than mucosal bleeding.\", \"wrongExplanations\": {\"0\": \"Cryoprecipitate does contain factor VIII, and was used for hemophilia A historically — which is what makes it the near-miss. It would be the answer only where factor concentrate is unavailable. It is unpurified, carries multiple donor exposures, and gives an unpredictable dose compared with a recombinant concentrate.\", \"1\": \"Desmopressin releases stored von Willebrand factor and factor VIII from endothelium, and is genuinely useful in MILD hemophilia A and in type 1 von Willebrand disease. It works by mobilizing an existing store; with baseline activity under 1% there is nothing to mobilize.\", \"3\": \"Plasma contains factor VIII at physiologic concentration, so a hemostatic level cannot be reached in any tolerable volume. It is the answer for a MULTIPLE factor deficiency with bleeding — liver disease, disseminated intravascular coagulation, or warfarin when concentrate is unavailable.\", \"4\": \"Platelets address primary hemostasis, which is intact here: his count is normal, he has no petechiae, and he has no mucosal bleeding. Hemophilia is a defect of the fibrin mesh built over the platelet plug, not of the plug itself.\"}, \"eli5\": \"He is missing one specific clotting protein, so you give him that exact protein back. Giving whole plasma would mean pouring in litres of fluid to deliver the same amount.\", \"explanationImage\": \"fig_tx_reactions\", \"explanationImageCaption\": \"Blood-bank products versus purified concentrates: a specific factor concentrate avoids the multiple donor exposures that every pooled blood product carries.\", \"los\": [{\"n\": 74, \"t\": \"Identify which blood product should be used to correct specific coagulopathies / bleeding disorders.\", \"a\": \"s11-products\", \"s\": \"§12\"}]}, {\"stem\": \"A 34-year-old man is being resuscitated in the trauma bay after a motor vehicle collision with a splenic laceration. Over 50 minutes he has received 10 units of packed red blood cells, 8 units of plasma, and 2 pools of platelets through a rapid infuser under the massive transfusion protocol. He is awake and reports tingling around his mouth and in his fingertips. His temperature is 35.8°C (96.4°F), pulse is 122/min, respirations are 24/min, and blood pressure is 96/58 mm Hg. Physical examination shows carpal spasm when a blood pressure cuff is inflated, and continued oozing from his intravenous sites.\\n\\nLaboratory studies show:\\n  Ionized calcium  0.82 mmol/L (N=1.12–1.32 mmol/L)\\n  Potassium  5.1 mEq/L (N=3.5–5.0 mEq/L)\\n  Magnesium  1.8 mg/dL (N=1.5–2.0 mg/dL)\\n  Sodium  141 mEq/L (N=136–146 mEq/L)\\n  Arterial pH  7.31 (N=7.35–7.45)\\nElectrocardiography shows a prolonged QT interval. Which of the following best explains these findings?\", \"choices\": [\"A. Chelation of calcium by citrate contained in the transfused units\", \"B. Dilution of plasma proteins by crystalloid resuscitation\", \"C. Hypomagnesemia impairing parathyroid hormone release\", \"D. Release of potassium from stored erythrocytes\", \"E. Respiratory alkalosis increasing calcium binding to albumin\"], \"correct\": 0, \"explanation\": \"Every unit in the refrigerator contains citrate as its anticoagulant, and citrate works by chelating calcium — calcium being the trigger the coagulation cascade cannot proceed without. That is precisely why the unit does not clot in the bag.\\n\\nTransfuse fast enough and the recipient receives a citrate load faster than the liver can metabolize it → the citrate chelates the PATIENT's ionized calcium → hypocalcemia. The findings follow directly: perioral and digital paresthesias, carpal spasm on cuff inflation (Trousseau sign), QT prolongation, and — because calcium is a cofactor throughout the cascade — impaired hemostasis, which is part of why he continues to ooze.\\n\\nHepatic metabolism of citrate is the rate-limiting step, so the risk is greatest with rapid transfusion, hypothermia (his temperature is 35.8°C) and liver dysfunction, all of which are common in the exsanguinating trauma patient.\\n\\nManagement is to monitor ionized calcium during massive transfusion and replace it intravenously. His potassium of 5.1 mEq/L and pH of 7.31 are real accompaniments of massive transfusion, but neither produces tetany or a long QT — hyperkalemia shortens it.\", \"wrongExplanations\": {\"1\": \"Dilution of albumin would actually RAISE the ionized fraction of calcium for a given total calcium, since less is protein-bound. The value reported here is the ionized calcium itself, which is not affected by protein concentration.\", \"2\": \"Severe hypomagnesemia does impair parathyroid hormone secretion and action and causes a refractory hypocalcemia — it would be the answer with a magnesium well below normal, classically in alcohol use disorder or with prolonged diuretic use. His magnesium is 1.8 mg/dL, squarely normal.\", \"3\": \"Potassium does leak from erythrocytes during storage, and hyperkalemia is a genuine hazard of rapid massive transfusion — his potassium is 5.1 mEq/L. But hyperkalemia causes peaked T waves and a SHORTENED QT interval, and it does not cause tetany or carpal spasm.\", \"4\": \"Alkalosis increases calcium binding to albumin and can precipitate tetany — the mechanism behind carpopedal spasm during hyperventilation. His arterial pH is 7.31, an acidemia, which moves calcium in the opposite direction.\"}, \"eli5\": \"Donated blood has a chemical added that grabs calcium so the bag will not clot. Pour in ten bags quickly and it grabs the patient's calcium too, which makes his muscles cramp and his heart's electrical timing stretch out.\", \"explanationImage\": \"fig_tx_timeline\", \"explanationImageCaption\": \"Massive transfusion concentrates several hazards into a short window — citrate load, hypothermia and potassium shifts — alongside the immune reactions shown on this timeline.\", \"los\": [{\"n\": 31, \"t\": \"Given a clinical vignette, classify the different blood products and the clinical indications for each product, supported by evidence (if available).\", \"a\": \"s11-products\", \"s\": \"§12\"}]}, {\"stem\": \"A 22-year-old man donates blood for the first time. He has never been transfused, has no children, and has no history of serious illness. Testing of his red cells shows no A antigen and no B antigen. Testing of his plasma shows both anti-A and anti-B antibodies, which are predominantly IgM.\\n\\nWhich of the following best explains the presence of these antibodies in a person who has never been exposed to transfused blood?\", \"choices\": [\"A. Cross-reaction of autoantibodies with antigens expressed on his own erythrocytes\", \"B. Exposure to A-like and B-like carbohydrate antigens on gut bacteria during infancy\", \"C. Passive transfer of maternal antibody across the placenta before birth\", \"D. Prior exposure to foreign erythrocytes during fetal-maternal circulation\", \"E. Spontaneous somatic mutation within B lymphocyte germinal centers\"], \"correct\": 1, \"explanation\": \"ABO antibodies are NATURALLY OCCURRING, and this is the single fact that makes ABO incompatibility uniquely dangerous.\\n\\nA newborn has no ABO antibodies. Over the first six months to two years of life the gut is colonized by Escherichia coli and other organisms whose surface carbohydrates closely resemble the A and B antigens. The immune system responds to them, and tolerance ensures antibody is made only against the antigen the person does NOT express. By early childhood everybody carries the predictable mirror-image antibody, with no transfusion or pregnancy required.\\n\\nHe is group O — no A antigen, no B antigen — so he carries both anti-A and anti-B, and is an ocean of both.\\n\\nTwo consequences follow. First, the blood bank types every sample twice as a cross-check: the front type (antigens on the cells) must mirror the back type (antibodies in the plasma), and any disagreement stops the release of blood. Second, because these antibodies are IgM and IgM fixes complement extremely efficiently, an ABO-incompatible transfusion causes immediate INTRAVASCULAR hemolysis — no prior exposure needed, no sensitizing event, and a reaction that begins within minutes.\\n\\nContrast the alloantibodies to RhD, Kell, Duffy and Kidd: those are IgG, require prior exposure through transfusion or pregnancy, and cause slower extravascular hemolysis.\", \"wrongExplanations\": {\"0\": \"An autoantibody against his own erythrocytes would cause autoimmune hemolytic anemia and a positive direct antiglobulin test. These antibodies are directed at antigens he does not express, which is the opposite situation — the immune system working exactly as intended.\", \"2\": \"Maternal IgG does cross the placenta and protects the infant for the first months of life, but ABO antibodies are predominantly IgM, which does not cross. Maternal antibody also wanes by about 6 months, whereas his are lifelong and self-produced.\", \"3\": \"Fetal-maternal exchange of erythrocytes is the sensitizing route for RhD alloimmunization in the MOTHER, and is one of only two routes of exposure to foreign red cells. It produces unpredictable IgG alloantibodies in some people, not the universal IgM anti-A and anti-B found in everyone.\", \"4\": \"Somatic hypermutation refines antibody affinity after an antigen has been encountered; it does not create specificities out of nothing. Something must present an A-like or B-like epitope first, which is what the gut flora provides.\"}, \"eli5\": \"Bacteria that settle in a baby's gut happen to wear sugar coats that look like blood group markers. The immune system learns to attack whichever ones the body does not have, so everyone ends up with those antibodies without ever seeing donated blood.\", \"explanationImage\": \"fig_abo\", \"explanationImageCaption\": \"The ABO system: each phenotype carries antibodies against precisely the antigens it lacks — the mirror image the blood bank checks on every sample.\", \"los\": [{\"n\": 31, \"t\": \"Given a clinical vignette, classify the different blood products and the clinical indications for each product, supported by evidence (if available).\", \"a\": \"s12-immuno\", \"s\": \"§13\"}]}, {\"stem\": \"An unidentified man in his twenties is brought to the emergency department by paramedics after a high-speed motor vehicle collision. He is unresponsive, and there is no time to obtain a blood sample before transfusion is required. His pulse is 142/min, respirations are 30/min, and blood pressure is 68/40 mm Hg. Physical examination shows a rigid, distended abdomen and pallor. Focused abdominal ultrasonography shows free intraperitoneal fluid, and he is taken directly to the operating room. The blood bank has adequate stocks of every ABO and RhD type, but supplies of RhD-negative units are limited at this time of year.\\n\\nWhich of the following blood products is most appropriate to transfuse immediately?\", \"choices\": [\"A. Group A RhD-positive red blood cells\", \"B. Group AB RhD-negative red blood cells\", \"C. Group O RhD-negative red blood cells\", \"D. Group O RhD-positive red blood cells\", \"E. Type-specific red blood cells after a full crossmatch\"], \"correct\": 3, \"explanation\": \"Two separate decisions are being made here, and the second is the one being tested.\\n\\nThe ABO decision: group O red cells carry neither A nor B antigen, so no recipient's naturally occurring antibody has anything to attack. Group O is the universal red cell donor, and it is what goes out on emergency release before a type is known.\\n\\nThe RhD decision is rationing. Only about 15% of the population is RhD negative, and group O RhD negative is only about 6% — roughly 1 in 15 people — so it is a genuinely scarce resource. The consequence of giving RhD-POSITIVE blood to an RhD-negative person is that they may form anti-D. In a male that means potential difficulty with future transfusions; in a girl or woman of childbearing potential it means a future RhD-positive fetus can be destroyed by that IgG antibody crossing the placenta — hemolytic disease of the fetus and newborn.\\n\\nSo the rule in §13 is explicit: save the RhD-negative units for females of childbearing potential, and give RhD-positive to male trauma patients when supply is tight. He may die while you type him; the cost of the alternative is borne by someone who needs it more.\\n\\nOnce a sample reaches the blood bank he is switched to type-specific blood.\", \"wrongExplanations\": {\"0\": \"Group A red cells carry the A antigen. In a patient of unknown type — who has a 45% chance of being group O or B, and therefore of carrying anti-A — this risks an immediate acute hemolytic transfusion reaction. Emergency release is group O precisely to remove that possibility.\", \"1\": \"Group AB is the universal red cell RECIPIENT, not donor: its cells carry BOTH A and B antigens and would be attacked by almost any recipient's plasma. The AB inversion applies to plasma products, where AB is the universal donor because its plasma contains neither antibody.\", \"2\": \"Group O RhD-negative is the correct emergency product for a female of childbearing potential, and it would be the answer if this patient were a young woman. Spending a scarce unit on a male trauma patient when supplies are limited deprives someone for whom alloimmunization carries a much larger consequence.\", \"4\": \"Waiting for a full crossmatch is correct practice when there is time, but it takes 30 to 60 minutes — longer if an unexpected antibody turns up. He is hypotensive with free intraperitoneal blood and is going to the operating room now; the delay would kill him.\"}, \"eli5\": \"There is no time to find out his blood type, so he gets the type that nobody reacts against. The Rh-negative version is rare and is saved for girls and women, because for them a reaction could harm a future pregnancy.\", \"explanationImage\": \"fig_o_neg_compat\", \"explanationImageCaption\": \"Group O cells carry no A or B antigen, so no recipient antibody can attack them — the reason group O is the universal red cell donor and the emergency-release product.\", \"los\": [{\"n\": 31, \"t\": \"Given a clinical vignette, classify the different blood products and the clinical indications for each product, supported by evidence (if available).\", \"a\": \"s12-immuno\", \"s\": \"§13\"}]}, {\"stem\": \"A 24-year-old woman who is RhD negative receives 3 units of RhD-positive packed red blood cells during emergency surgery for a ruptured ectopic pregnancy, because RhD-negative units were unavailable. She recovers and is discharged. She has never been pregnant to term and has no children. Six weeks later, an antibody screen performed before an elective procedure is positive, and antibody identification shows anti-D. Her hemoglobin concentration is 12.6 g/dL (N=12.0–16.0 g/dL) and her direct antiglobulin test is negative.\\n\\nWhich of the following is the most likely future consequence of this finding?\", \"choices\": [\"A. Anaphylactic reaction to any plasma-containing product\", \"B. Hemolytic disease in a future RhD-positive fetus\", \"C. Post-transfusion purpura within 2 weeks of any future transfusion\", \"D. Transfusion-associated graft-versus-host disease\", \"E. Transfusion-related acute lung injury\"], \"correct\": 1, \"explanation\": \"She has been alloimmunized. Exposure to a foreign red cell antigen — here RhD, through transfusion, one of only two possible routes along with pregnancy — has produced an IgG antibody. Note that forming the antibody caused her no harm at all: her hemoglobin is normal and her direct antiglobulin test is negative, because she has no D-positive cells of her own for the antibody to coat.\\n\\nThe consequences are all in the future, and the important one is obstetric. Anti-D is IgG, and IgG crosses the placenta. If she later carries an RhD-positive fetus, maternal anti-D will cross, coat fetal erythrocytes, and cause their destruction in the fetal spleen — hemolytic disease of the fetus and newborn, with fetal anemia, hydrops and, after delivery, hyperbilirubinemia and kernicterus. That pregnancy needs specialist monitoring with serial middle cerebral artery Doppler studies and possible intrauterine transfusion.\\n\\nThe transfusion consequence is real but smaller: she must receive RhD-negative units for life, since the titre may fall below detection and then rise rapidly on re-exposure — the basis of a DELAYED hemolytic transfusion reaction.\\n\\nThis is exactly why RhD-negative units are rationed to females of childbearing potential, and why anti-D immune globulin is given prophylactically after events that risk fetal-maternal hemorrhage.\", \"wrongExplanations\": {\"0\": \"Anaphylaxis to plasma-containing products is the complication of IgA deficiency with anti-IgA antibodies, reacting to the IgA present in donor plasma. It has nothing to do with red cell antigens, and would be the answer in a patient with recurrent sinopulmonary infections and an undetectable serum IgA.\", \"2\": \"Post-transfusion purpura is a rare, abrupt thrombocytopenia 5 to 10 days after transfusion, caused by antibodies against a platelet antigen — most often HPA-1a — in a previously sensitized patient. It would be the answer if the alloantibody identified were directed at a PLATELET antigen rather than at D.\", \"3\": \"Transfusion-associated graft-versus-host disease is caused by donor LYMPHOCYTES engrafting in a recipient who cannot reject them, and is prevented by irradiating the product. It occurs in severely immunocompromised patients or with partially HLA-matched donors, and is unrelated to red cell alloantibodies.\", \"4\": \"Transfusion-related acute lung injury is caused by DONOR anti-HLA antibodies reacting with the recipient's leukocytes. The antibody direction here is the reverse — this patient has made an antibody, which affects her future transfusions and pregnancies rather than causing lung injury.\"}, \"eli5\": \"Her body has learned to recognize a red cell marker she does not carry, and it now makes an antibody against it. That antibody can cross the placenta, so a future baby who inherits that marker from its father could have its red cells destroyed before birth.\", \"explanationImage\": \"fig_rh_pregnancy\", \"explanationImageCaption\": \"RhD alloimmunization: once anti-D is formed, the IgG antibody crosses the placenta in a later pregnancy and destroys the erythrocytes of an RhD-positive fetus.\", \"los\": [{\"n\": 31, \"t\": \"Given a clinical vignette, classify the different blood products and the clinical indications for each product, supported by evidence (if available).\", \"a\": \"s12-immuno\", \"s\": \"§13\"}, {\"n\": 61, \"t\": \"Identify adverse events in transfusion medicine and classify by clinical presentation and pathophysiology.\", \"a\": \"s12-immuno\", \"s\": \"§13\"}]}, {\"stem\": \"A 46-year-old woman with menorrhagia is scheduled for hysterectomy. She received 2 units of packed red blood cells 8 years ago after a postpartum hemorrhage. A type and screen is performed: she is group A, RhD positive, and the antibody screen is POSITIVE. An antibody identification panel shows anti-Kell. Her hemoglobin concentration is 9.4 g/dL (N=12.0–16.0 g/dL), hematocrit is 28% (N=36%–46%), reticulocyte count is 1.2% (N=0.5%–1.5%), and her direct antiglobulin test is negative. The blood bank reports that units will take several hours longer than usual to provide.\\n\\nWhich of the following is the most appropriate action regarding transfusion for this patient?\", \"choices\": [\"A. Administer corticosteroids before each unit is transfused\", \"B. Administer group O RhD-negative red blood cells without crossmatch\", \"C. Perform plasma exchange before transfusion\", \"D. Transfuse Kell antigen-negative, crossmatch-compatible units\", \"E. Transfuse washed red blood cells\"], \"correct\": 3, \"explanation\": \"A positive antibody screen means her plasma contains an antibody that binds donor red cells — this is the INDIRECT antiglobulin test, the 'screen' in type and screen. Her negative DIRECT antiglobulin test confirms the antibody is free in her plasma rather than already coating her own cells, so she is not hemolyzing.\\n\\nThe antibody was formed by one of the only two routes of exposure to foreign erythrocytes: her transfusion 8 years ago, or her pregnancy. It is IgG. Give her Kell-POSITIVE blood and the antibody will opsonize those cells for splenic clearance — extravascular hemolysis, a failed transfusion, and a delayed hemolytic reaction days later.\\n\\nSo the units must be Kell antigen NEGATIVE as well as ABO and RhD compatible, and each must then be individually crossmatched. Finding antigen-negative units may require a wider inventory or a reference laboratory, which is the several hours the blood bank is asking for. The requirement is lifelong: an alloantibody titre can drop below the level of detection and still rise explosively on re-exposure, which is why patients carry antibody cards.\\n\\nThis work is also why chronically transfused patients are difficult. Alloimmunization occurs in 1–3% of the general population but in 20–60% of patients with sickle cell disease, who are exposed repeatedly to minor antigens — Kell, Duffy, Kidd — across a lifetime, and many centres now provide extended antigen-matched blood for them from the start.\", \"wrongExplanations\": {\"0\": \"Corticosteroids blunt an immune response over days and have no role in preventing hemolysis of antigen-positive cells transfused now. They would be part of the treatment of warm autoimmune hemolytic anemia, which her negative direct antiglobulin test excludes.\", \"1\": \"Uncrossmatched group O RhD-negative blood is for an exsanguinating patient who cannot wait. It addresses only ABO and RhD; those units are as likely as any others to be Kell positive, so this would deliver precisely the cells her antibody attacks. She is having elective surgery and can wait.\", \"2\": \"Plasma exchange removes circulating antibody and is used in thrombotic thrombocytopenic purpura and some antibody-mediated diseases. It would not durably remove an alloantibody — the memory B cells remain and the antibody returns — and it exposes her to a procedure when simply selecting the right units solves the problem.\", \"4\": \"Washing removes plasma proteins from the unit and is used for recurrent severe allergic reactions and for IgA-deficient recipients. It does nothing about antigens on the donor CELL surface, which is where the Kell antigen sits.\"}, \"eli5\": \"Her blood carries an antibody against a marker some donors have, left over from a transfusion years ago. The lab has to hunt for units that lack that marker, which is why the blood takes longer to arrive.\", \"explanationImage\": \"fig_tx_reactions\", \"explanationImageCaption\": \"The delayed hemolytic reaction that antigen-negative units are selected to avoid: recipient antibody formed after earlier sensitization binds donor cells and destroys them extravascularly.\", \"los\": [{\"n\": 31, \"t\": \"Given a clinical vignette, classify the different blood products and the clinical indications for each product, supported by evidence (if available).\", \"a\": \"s12-immuno\", \"s\": \"§13\"}]}, {\"stem\": \"A 62-year-old man received 3 units of packed red blood cells 8 days ago for anemia from a gastrointestinal hemorrhage, which has since been treated endoscopically. He returns to the office because of fatigue and mild yellowing of his eyes over the past 2 days. He has had no fever, chills, dyspnea, back pain, or dark urine. He was transfused once before, 15 years ago. His temperature is 37.1°C (98.8°F), pulse is 88/min, respirations are 16/min, and blood pressure is 128/76 mm Hg. Physical examination shows mild scleral icterus; the abdomen is soft and the stool is brown and negative for occult blood.\\n\\nLaboratory studies show:\\n  Hemoglobin  8.2 g/dL (N=13.5–17.5 g/dL)\\n  Hematocrit  25% (N=41%–53%)\\n  Reticulocyte count  4.6% (N=0.5%–1.5%)\\n  Platelet count  246,000/mm3 (N=150,000–400,000/mm3)\\n  Lactate dehydrogenase  410 U/L (N=45–200 U/L)\\n  Total bilirubin  2.8 mg/dL (N=0.1–1.0 mg/dL)\\n  Direct bilirubin  0.3 mg/dL (N=0.0–0.3 mg/dL)\\n  Haptoglobin  18 mg/dL (N=30–200 mg/dL)\\nHis hemoglobin concentration was 10.6 g/dL at discharge 6 days ago. The direct antiglobulin test is now positive, and an antibody screen that was negative before the transfusion now detects anti-Jka. Which of the following is the most likely diagnosis?\", \"choices\": [\"A. Acute hemolytic transfusion reaction\", \"B. Autoimmune hemolytic anemia\", \"C. Delayed hemolytic transfusion reaction\", \"D. Febrile nonhemolytic transfusion reaction\", \"E. Post-transfusion purpura\"], \"correct\": 2, \"explanation\": \"Everything here is defined by the TIMING and by an antibody that was not there before.\\n\\nHe was sensitized to the Kidd antigen Jka by his transfusion 15 years ago. The titre fell below the level of detection, so his pre-transfusion antibody screen was negative and compatible-looking units were issued. Re-exposure 8 days ago triggered an anamnestic (memory) response → IgG anti-Jka rose over days → it coated the transfused Jka-positive cells → splenic macrophages removed them.\\n\\nThe result is exactly what he shows: a gradual fall in hemoglobin 3 to 10 days after transfusion, jaundice with unconjugated hyperbilirubinemia, a raised lactate dehydrogenase, a modestly reduced haptoglobin, a reticulocytosis, and a newly POSITIVE direct antiglobulin test — all without fever, hypotension or dark urine, because IgG-mediated destruction is extravascular rather than intravascular.\\n\\nKidd antibodies are notorious for this behavior; 'Kidd antibodies are evanescent' is the phrase. It is also the argument for lifelong antigen-negative transfusion once an alloantibody is identified, and for antibody cards that travel with the patient.\\n\\nManagement is largely supportive, with Jka-negative units for any future transfusion.\", \"wrongExplanations\": {\"0\": \"An acute hemolytic reaction from ABO incompatibility begins within MINUTES of starting the unit, with fever, back and flank pain, hypotension, pink plasma and hemoglobinuria — IgM fixing complement and lysing cells inside the vessel. His reaction appeared 8 days later with none of those features.\", \"1\": \"Warm autoimmune hemolytic anemia also gives a positive direct antiglobulin test with extravascular hemolysis, which makes it the closest competitor. The antibody there is an AUTOantibody reacting with the patient's own cells; here a specific ALLOantibody against a donor antigen has appeared in a patient whose screen was negative days earlier.\", \"3\": \"A febrile nonhemolytic reaction is fever and chills DURING or shortly after the transfusion, caused by cytokines from donor leukocytes, with no hemolysis at all. He has no fever, and his laboratory studies show unmistakable hemolysis.\", \"4\": \"Post-transfusion purpura appears 5 to 10 days after transfusion — the same window — but as severe THROMBOCYTOPENIA with bleeding, caused by antibodies against a platelet antigen. His platelet count is 246,000/mm3 and his problem is anemia.\"}, \"eli5\": \"Years ago a transfusion taught his immune system to recognize a red cell marker, and the memory faded below what tests can see. The new units carried that marker again, so his immune system woke up over the following week and quietly destroyed them.\", \"explanationImage\": \"fig_tx_timeline\", \"explanationImageCaption\": \"The reaction timeline: DHTR (delayed hemolytic transfusion reaction) sits days to weeks out, well separated from the reactions that occur within the first 6 hours.\", \"los\": [{\"n\": 61, \"t\": \"Identify adverse events in transfusion medicine and classify by clinical presentation and pathophysiology.\", \"a\": \"s13-reactions\", \"s\": \"§14\"}, {\"n\": 31, \"t\": \"Given a clinical vignette, classify the different blood products and the clinical indications for each product, supported by evidence (if available).\", \"a\": \"s12-immuno\", \"s\": \"§13\"}]}, {\"stem\": \"A 58-year-old man with group A, RhD-positive blood is bleeding after a liver laceration and has a prothrombin time of 26 seconds (N=11–15 seconds) with an international normalized ratio of 2.6 (N=0.8–1.2). Plasma transfusion is indicated. The blood bank reports that no group A plasma is immediately available; group B, group AB, and group O plasma units are in stock, and prothrombin complex concentrate is not available at this hospital.\\n\\nWhich of the following plasma units may be transfused to this patient without risk of hemolysis?\", \"choices\": [\"A. Group AB plasma\", \"B. Group B plasma\", \"C. Group O plasma\", \"D. Plasma of any ABO group\"], \"correct\": 0, \"explanation\": \"For red cells you ask whether the RECIPIENT's antibodies will attack the DONOR's antigens. For plasma the question inverts, because plasma carries the antibodies rather than the cells: you ask whether the DONOR's antibodies will attack the RECIPIENT's antigens.\\n\\nGroup AB plasma contains neither anti-A nor anti-B — an AB person expresses both antigens and therefore makes neither antibody. It can be given to anyone, which makes group AB the universal PLASMA donor, the exact mirror image of group O as the universal red cell donor.\\n\\nThis patient is group A, so his erythrocytes display the A antigen. Group B plasma contains anti-A and group O plasma contains both anti-A and anti-B; either would deliver antibody directed at his own circulating cells and cause hemolysis. Only AB plasma is safe.\\n\\nThe same inversion makes group O the universal plasma RECIPIENT — an O person has no A or B antigen for any donor's antibody to attack.\\n\\nThe reason to derive the table rather than memorize it is that reversing the two systems is one of the commonest errors in transfusion medicine, and the arithmetic takes about five seconds if you remember which component carries which.\", \"wrongExplanations\": {\"1\": \"Group B plasma contains anti-A. This patient's red cells carry the A antigen, so transfusing it delivers an antibody aimed directly at his own circulating erythrocytes. It would be appropriate for a group B or a group O recipient.\", \"2\": \"Group O plasma is the most dangerous of the three here: an O donor carries BOTH anti-A and anti-B. Group O is the universal donor for RED CELLS only — its cells lack antigens — and reversing that rule for plasma is the classic error this item tests.\", \"3\": \"Plasma does require ABO matching, for the reason above. It is RhD matching that plasma does not require, since plasma contains no red cells and therefore no D antigen — which is a different statement and the likely source of this misconception.\"}, \"eli5\": \"Red cells and plasma work in opposite directions: cells carry the markers, plasma carries the antibodies. Plasma from an AB donor has no antibodies at all, so it is safe for everyone.\", \"explanationImage\": \"fig_abo\", \"explanationImageCaption\": \"Antigens on the cell, antibodies in the plasma: group AB has both antigens and neither antibody, which makes it the universal plasma donor and the universal red cell recipient.\", \"los\": [{\"n\": 31, \"t\": \"Given a clinical vignette, classify the different blood products and the clinical indications for each product, supported by evidence (if available).\", \"a\": \"s12-immuno\", \"s\": \"§13\"}, {\"n\": 74, \"t\": \"Identify which blood product should be used to correct specific coagulopathies / bleeding disorders.\", \"a\": \"s11-products\", \"s\": \"§12\"}]}, {\"stem\": \"A 3-year-old boy is receiving a transfusion of packed red blood cells on a busy postoperative ward. Ten minutes into the unit he becomes agitated, cries out with pain in his back and flank, and vomits. The transfusion is stopped. His temperature is 39.1°C (102.4°F), pulse is 168/min, respirations are 38/min, and blood pressure is 68/38 mm Hg. Physical examination shows mottled skin and oozing from his intravenous site. A blood sample drawn and centrifuged at the bedside shows PINK plasma, and his urine is dark red. The direct antiglobulin test is positive.\\n\\nLaboratory studies show:\\n  Hemoglobin  7.2 g/dL (N=11.5–15.5 g/dL)\\n  Hematocrit  22% (N=35%–45%)\\n  Platelet count  88,000/mm3 (N=150,000–400,000/mm3)\\n  Lactate dehydrogenase  980 U/L (N=45–200 U/L)\\n  Haptoglobin  <10 mg/dL (N=30–200 mg/dL)\\n  Fibrinogen  118 mg/dL (N=200–400 mg/dL)\\nWhich of the following is the most likely cause of these findings?\", \"choices\": [\"A. ABO-incompatible erythrocytes in the transfused unit\", \"B. Bacterial contamination of the transfused unit\", \"C. Cytokines released by donor leukocytes during storage\", \"D. Donor anti-HLA antibodies reacting with recipient leukocytes\", \"E. Recipient antibodies directed against donor IgA\"], \"correct\": 0, \"explanation\": \"Pink plasma, dark red urine and a positive direct antiglobulin test within minutes of starting a unit is an acute hemolytic transfusion reaction from ABO incompatibility — the full intravascular signature, with back and flank pain as its characteristic symptom.\\n\\nThe immunology is fast because the antibody is already there. ABO antibodies are naturally occurring IgM, and IgM fixes complement extremely efficiently → complement runs to completion on the transfused cells → they lyse inside the vessel → free hemoglobin appears in plasma (hemoglobinemia) and is filtered into urine (hemoglobinuria). Free heme is nephrotoxic, so the kidney is the organ at immediate risk; his falling fibrinogen and platelets with oozing show disseminated intravascular coagulation beginning as well.\\n\\nIt is classified as a NEVER EVENT because the incompatibility is entirely predictable and entirely preventable. In practice it happens through 'wrong blood in tube': a sample drawn from one patient is labelled with another patient's pre-printed label — the classic setting being one nurse caring for two patients in a double room. The blood bank then types that sample perfectly correctly. Everything downstream is flawlessly wrong.\\n\\nThis is why the clerical check — unit label against patient identity — is step 3 of the reaction algorithm, after stopping the transfusion and keeping the line open with saline.\", \"wrongExplanations\": {\"1\": \"Bacterial contamination produces fever, rigors and rapid hypotension, so the early hemodynamic picture overlaps — it is the closest competitor. It would be the answer with a platelet unit (stored at room temperature, where bacteria grow) and organisms on the unit's Gram stain and culture, and it does not produce hemoglobinemia, hemoglobinuria or a positive direct antiglobulin test.\", \"2\": \"Cytokines from donor leukocytes cause the febrile NONhemolytic reaction — fever and chills, self-limited, with no hemolysis, which is the point of its name. It would be the answer with fever and no evidence of red cell destruction, and it is prevented by leukocyte reduction.\", \"3\": \"Donor anti-HLA antibodies reacting with recipient leukocytes cause transfusion-related acute lung injury, which would be the answer with hypoxia and bilateral pulmonary opacities within 6 hours. He has no respiratory findings, and that reaction does not lyse erythrocytes.\", \"4\": \"Recipient anti-IgA antibodies cause anaphylaxis — hypotension, dyspnea and throat tightness after a tiny volume, characteristically without fever. His fever, flank pain and laboratory evidence of red cell destruction do not fit, and anaphylaxis does not produce hemoglobinuria.\"}, \"eli5\": \"He was given blood of the wrong type, and antibodies he was born with attacked it immediately, bursting the donated cells inside his blood vessels. The freed hemoglobin turns the plasma pink and the urine red, and it can wreck the kidneys.\", \"explanationImage\": \"fig_tx_reactions\", \"explanationImageCaption\": \"Acute hemolytic reaction, far left: donor cells bearing A and/or B antigens meet the recipient's naturally occurring anti-A or anti-B and are destroyed.\", \"los\": [{\"n\": 61, \"t\": \"Identify adverse events in transfusion medicine and classify by clinical presentation and pathophysiology.\", \"a\": \"s13-reactions\", \"s\": \"§14\"}]}, {\"stem\": \"A 59-year-old woman with myelodysplastic syndrome receives a unit of packed red blood cells in the outpatient infusion center. Ninety minutes after the transfusion begins she develops dyspnea and a dry cough. She has no chest pain, no urticaria, and no back pain. She has no history of heart failure or kidney disease. Her temperature is 38.2°C (100.8°F), pulse is 118/min, respirations are 34/min, and blood pressure is 86/50 mm Hg. Pulse oximetry on room air shows an oxygen saturation of 84%. Physical examination shows diffuse crackles in both lung fields; the jugular venous pulse is not elevated, there is no peripheral edema, and there is no third heart sound.\\n\\nLaboratory studies show:\\n  Hemoglobin  8.4 g/dL (N=12.0–16.0 g/dL)\\n  Hematocrit  25% (N=36%–46%)\\n  B-type natriuretic peptide  62 pg/mL (N=<100 pg/mL)\\n  Creatinine  0.8 mg/dL (N=0.6–1.2 mg/dL)\\nChest radiography shows bilateral pulmonary opacities. Intravenous furosemide is administered without improvement in her oxygenation. Which of the following is the most likely diagnosis?\", \"choices\": [\"A. Acute hemolytic transfusion reaction\", \"B. Anaphylactic transfusion reaction\", \"C. Febrile nonhemolytic transfusion reaction\", \"D. Transfusion-associated circulatory overload\", \"E. Transfusion-related acute lung injury\"], \"correct\": 4, \"explanation\": \"Hypoxia with bilateral pulmonary opacities within 6 hours of a transfusion is either TRALI or TACO, and three findings separate them here: she is HYPOTENSIVE, her jugular venous pressure is NORMAL, and she did not improve with diuresis.\\n\\nTRALI is an immune injury to the pulmonary capillaries. The classic donor is a woman sensitized during pregnancy — exposure to fetal cells carrying paternal tissue antigens leads her to make anti-HLA antibodies, which harm her not at all; 14–20% of parous women carry them. Transfused in her plasma, those antibodies react with the RECIPIENT's leukocytes, which agglutinate in the pulmonary capillaries → acute lung injury with an ARDS picture on imaging. Management is supportive, including ventilatory support; diuresis does not help because the problem is capillary permeability, not volume.\\n\\nTACO is the mirror image: too much volume too fast, with HYPERTENSION, a raised jugular venous pressure, a raised B-type natriuretic peptide, and improvement with diuresis. Her B-type natriuretic peptide is 62 pg/mL and she received a single unit.\\n\\nThe memory hook: TACO = Too much volume; TRALI = the donor's antibodies attacked the Lung.\\n\\nTRALI is now genuinely rare, because blood centres screen female donors for anti-HLA antibodies and avoid making high-plasma-volume products from those who have them — one of transfusion medicine's clearest public health successes.\", \"wrongExplanations\": {\"0\": \"An acute hemolytic reaction produces fever, back and flank pain, hypotension, pink plasma and hemoglobinuria within minutes. It would be the answer with laboratory evidence of hemolysis and a positive direct antiglobulin test; she has respiratory failure with no evidence of red cell destruction.\", \"1\": \"Anaphylaxis causes hypotension with dyspnea and throat tightness after a very small volume, usually with urticaria and characteristically WITHOUT fever, and is associated with IgA deficiency. It does not produce bilateral pulmonary opacities on a chest radiograph.\", \"2\": \"A febrile nonhemolytic reaction gives fever and chills alone and is self-limited — she is febrile, which is why it is on the list, since fever accompanies TRALI too. It does not cause hypoxemia, hypotension, or infiltrates.\", \"3\": \"Circulatory overload is the near-miss, and the distinction is the highest-yield pair in this section. It would be the answer with HYPERTENSION, a distended jugular venous pulse, a raised B-type natriuretic peptide, and improvement after furosemide — and is more likely after several units given rapidly to an elderly patient with cardiac or renal disease.\"}, \"eli5\": \"Antibodies in the donor's plasma attacked her white cells, which then clogged and inflamed the small vessels of her lungs. It looks like fluid overload on the x-ray, but her heart is fine and a water pill does not help.\", \"explanationImage\": \"fig_tx_reactions\", \"explanationImageCaption\": \"TRALI, center: antibodies carried in the donor plasma activate the recipient's granulocytes within the pulmonary circulation.\", \"los\": [{\"n\": 61, \"t\": \"Identify adverse events in transfusion medicine and classify by clinical presentation and pathophysiology.\", \"a\": \"s13-reactions\", \"s\": \"§14\"}]}, {\"stem\": \"An 81-year-old woman with chronic kidney disease and a history of heart failure with preserved ejection fraction is admitted with symptomatic anemia and a hemoglobin concentration of 6.4 g/dL. She weighs 48 kg (106 lb). Two units of packed red blood cells are ordered, and because the nursing shift is ending both units are infused over a total of 75 minutes. She has no fever at any point. Twenty minutes after the second unit finishes she becomes acutely dyspneic and cannot lie flat. Pulse oximetry on room air shows an oxygen saturation of 87%, and chest radiography shows bilateral opacities with small pleural effusions.\\n\\nWhich of the following sets of additional findings is most likely in this patient?\\n\\n    Blood pressure | Jugular venous pressure | B-type natriuretic peptide | Response to diuresis\", \"choices\": [\"A. Decreased, elevated, increased, improvement\", \"B. Decreased, normal, normal, no improvement\", \"C. Increased, elevated, increased, improvement\", \"D. Increased, normal, increased, no improvement\", \"E. Increased, normal, normal, improvement\"], \"correct\": 2, \"explanation\": \"Everything in the setup points to volume, not immunity: an 81-year-old weighing 48 kg with chronic kidney disease and diastolic heart failure, given two units in 75 minutes — roughly 600 mL into a patient whose heart and kidneys cannot accommodate it, at a rate chosen for the nursing shift rather than for her physiology. This is transfusion-associated circulatory overload.\\n\\nThe predicted row follows from hydrostatic pulmonary edema: blood pressure INCREASED, jugular venous pressure ELEVATED, B-type natriuretic peptide INCREASED as the ventricle is stretched, and IMPROVEMENT with diuresis because removing volume removes the cause.\\n\\nHold that against TRALI, which produces the same hypoxia and the same bilateral opacities: blood pressure decreased, jugular venous pressure normal, B-type natriuretic peptide normal, and no response to diuresis, because the lung injury is a permeability problem rather than a pressure problem. That is the row-by-row contrast the option set is built from, and knowing only one column is not enough to answer.\\n\\nPrevention is in the order, not the response: transfuse one unit at a time, slowly (over 2 to 4 hours), reassess between units, and consider prophylactic diuretic in a small elderly patient with cardiac or renal disease.\", \"wrongExplanations\": {\"0\": \"This row has the venous pressure, natriuretic peptide and diuretic response of circulatory overload but the blood pressure of TRALI — right in three columns and wrong in the one that matters most at the bedside. Hypotension with overload would suggest cardiogenic shock, not the picture described.\", \"1\": \"This is the TRALI row in full: hypotension, a normal jugular venous pressure, a normal B-type natriuretic peptide, and no response to diuresis. It would be the answer if the mechanism were donor anti-HLA antibodies injuring the pulmonary capillaries — but nothing here suggests that, and the rate and volume of transfusion in a frail 48-kg patient do.\", \"3\": \"Hypertension with a raised natriuretic peptide but a NORMAL jugular venous pressure and no response to diuresis is internally inconsistent: a ventricle stretched enough to release natriuretic peptide transmits that pressure back to the neck veins, and hydrostatic edema responds to volume removal.\", \"4\": \"Hypertension with an entirely normal jugular venous pressure and natriuretic peptide describes a patient who is not volume overloaded, in which case there would be no reason for diuresis to help. The combination does not correspond to any of the transfusion reactions.\"}, \"eli5\": \"A small, frail woman with a weak heart and kidneys got two bags of blood in just over an hour. Her circulation simply could not hold the extra volume, so it backed up into her lungs — and draining the fluid off fixes it.\", \"explanationImage\": \"fig_tx_timeline\", \"explanationImageCaption\": \"Circulatory overload and TRALI both appear within hours of the transfusion, which is why the distinguishing findings — pressure, venous filling, and the response to diuresis — carry the diagnosis rather than the timing.\", \"los\": [{\"n\": 61, \"t\": \"Identify adverse events in transfusion medicine and classify by clinical presentation and pathophysiology.\", \"a\": \"s13-reactions\", \"s\": \"§14\"}]}, {\"stem\": \"A 67-year-old man with myelodysplastic syndrome requires red blood cell transfusion every 3 weeks. During each of his last three transfusions he has developed a temperature rise of 1.5°C to 2°C with chills and rigors, beginning about 45 minutes into the unit and resolving within a few hours. On each occasion the transfusion was stopped, a clerical check confirmed the correct unit and patient, and the investigation showed no hemolysis: the plasma was straw-colored, the direct antiglobulin test was negative, the haptoglobin was unchanged, and cultures of the unit were sterile. His blood pressure remained stable throughout each episode, and he has never had urticaria, dyspnea, or hypoxia.\\n\\nWhich of the following modifications to the blood product is most likely to prevent these episodes?\", \"choices\": [\"A. Irradiation of the product\", \"B. Leukocyte reduction of the product\", \"C. Pathogen reduction of the product\", \"D. Use of products from IgA-deficient donors\", \"E. Washing of the product\"], \"correct\": 1, \"explanation\": \"Fever and chills during or shortly after a transfusion, with no hemolysis, no hypotension and sterile cultures, is a febrile NONhemolytic transfusion reaction — the commonest reaction there is, occurring multiple times a week at a large centre.\\n\\nThe mechanism explains the fix. The product is living cells in a bag, and while they survive they release cytokines; donor leukocytes are the main source, both by accumulating cytokines during storage and by reacting with recipient antibodies. Remove the white cells before storage — leukocyte reduction, a filter applied before bagging — and the reaction rate falls sharply. It is now standard of care on essentially every US product, and it also reduces HLA alloimmunization and cytomegalovirus transmission.\\n\\nThe diagnosis is one of exclusion, and this vignette does the excluding explicitly: straw-colored plasma and a negative direct antiglobulin test rule out an acute hemolytic reaction, sterile cultures with stable blood pressure rule out bacterial contamination, and the absence of urticaria, dyspnea and hypoxia rules out the allergic reactions and TRALI. That work has to be done every time, because a febrile reaction looks identical at onset to the two that can kill him.\", \"wrongExplanations\": {\"0\": \"Irradiation damages the DNA of residual donor lymphocytes so they cannot proliferate in the recipient, and it is the only defence against transfusion-associated graft-versus-host disease. It kills the lymphocytes' ability to divide but does not remove them or the cytokines they have already released, so it does not prevent febrile reactions.\", \"2\": \"Pathogen reduction inactivates residual bacteria, viruses and parasites, and was introduced chiefly to reduce the risk from bacterially contaminated platelets. It would be the answer if his reactions were septic — but his cultures are sterile and his blood pressure never falls.\", \"3\": \"Products from IgA-deficient donors are for a patient who is IgA deficient and has formed anti-IgA, in whom a tiny volume of plasma causes anaphylaxis. That reaction is hypotension and airway compromise WITHOUT fever, the opposite of his pattern.\", \"4\": \"Washing removes plasma proteins from the unit and is used for recurrent severe allergic reactions and for IgA-deficient recipients. It is a reasonable second-line step for refractory febrile reactions, but it is labor-intensive, shortens the unit's shelf life, and is not the primary prevention for this reaction.\"}, \"eli5\": \"The white cells in donated blood leak chemical messengers that make people feel feverish and shivery. Filtering those white cells out before the blood is stored largely prevents it.\", \"explanationImage\": \"fig_tx_reactions\", \"explanationImageCaption\": \"Febrile nonhemolytic reaction, second column: cytokines from long-stored donor leukocytes, plus recipient antibodies against those white cells.\", \"los\": [{\"n\": 61, \"t\": \"Identify adverse events in transfusion medicine and classify by clinical presentation and pathophysiology.\", \"a\": \"s13-reactions\", \"s\": \"§14\"}]}, {\"stem\": \"A 29-year-old woman with a history of recurrent sinus and respiratory infections since childhood receives plasma during surgery for a postpartum hemorrhage. Approximately 5 mL has been infused when she develops flushing, throat tightness, wheezing, and hypotension. She has no fever. Her temperature is 36.9°C (98.4°F), pulse is 136/min, respirations are 32/min, and blood pressure is 62/34 mm Hg. Pulse oximetry shows an oxygen saturation of 88%. Physical examination shows diffuse urticaria, audible stridor, and diffuse expiratory wheeze. The transfusion is stopped, epinephrine is administered, and she stabilizes.\\n\\nSubsequent testing shows an undetectable serum IgA concentration, a serum IgG concentration of 1,180 mg/dL (N=650–1500 mg/dL), and a serum IgM concentration of 142 mg/dL (N=50–300 mg/dL). The direct antiglobulin test is negative and there is no evidence of hemolysis.\\n\\nWhich of the following best explains this reaction?\", \"choices\": [\"A. Complement activation by recipient IgM directed against donor A and B antigens\", \"B. Cytokines that accumulated in the product during storage\", \"C. Donor anti-HLA antibodies reacting with recipient granulocytes\", \"D. Recipient anti-IgA antibodies reacting with IgA in the donor plasma\", \"E. Residual donor lymphocytes engrafting in the recipient\"], \"correct\": 3, \"explanation\": \"Anaphylaxis after a tiny volume — the classic description is a reaction after 5 mL — in a patient with recurrent sinopulmonary infections and an undetectable serum IgA is selective IgA deficiency with anti-IgA antibodies.\\n\\nThe mechanism: a person who makes no IgA can recognize it as foreign and form anti-IgA. EVERY plasma-containing product contains donor IgA. On exposure, the antibody reacts with that IgA, mast cells degranulate, and a full anaphylactic reaction follows within minutes — hypotension, bronchospasm, laryngeal edema, urticaria, and characteristically NO fever.\\n\\nTwo features separate it from the far commoner mild allergic reaction, which §14 describes with the strawberry model: a soluble allergen from the donor's diet meets pre-formed recipient IgE and produces hives and itching with stable vital signs, treated with an antihistamine, after which the transfusion can often be resumed cautiously. Anaphylaxis is hemodynamic and airway-threatening, needs epinephrine, and the unit is never restarted.\\n\\nHer future transfusions must use washed cellular products — washing removes the plasma and therefore the IgA — or products from IgA-deficient donors. Selective IgA deficiency is the commonest primary immunodeficiency, affecting roughly 1 in 500 people, which is why this scenario is worth recognizing immediately.\", \"wrongExplanations\": {\"0\": \"Complement activation by IgM anti-A or anti-B is the acute hemolytic transfusion reaction, which would be the answer with fever, back and flank pain, pink plasma, hemoglobinuria and a positive direct antiglobulin test. The stem states explicitly that there is no hemolysis.\", \"1\": \"Storage cytokines cause the febrile nonhemolytic reaction — fever and chills with stable vital signs. She has no fever at all, and fever is precisely what that reaction is named for.\", \"2\": \"Donor anti-HLA antibodies reacting with recipient granulocytes cause TRALI, which produces hypoxia with bilateral pulmonary opacities within 6 hours. She has bronchospasm and stridor with urticaria — an airway and hemodynamic reaction — not a radiographic lung injury.\", \"4\": \"Donor lymphocytes engrafting in the recipient cause transfusion-associated graft-versus-host disease, which appears 1 to 6 weeks later as pancytopenia, rash, diarrhea and liver dysfunction, and is prevented by irradiation. The time course alone excludes it.\"}, \"eli5\": \"She does not make one type of antibody at all, so her immune system treats it as a foreign substance. Donated plasma is full of it, and a few millilitres were enough to trigger a full allergic collapse.\", \"explanationImage\": \"fig_tx_reactions\", \"explanationImageCaption\": \"Anaphylaxis, fourth column: an IgA-deficient host with anti-IgA meets the IgA present in donor plasma, and mast cells degranulate.\", \"los\": [{\"n\": 61, \"t\": \"Identify adverse events in transfusion medicine and classify by clinical presentation and pathophysiology.\", \"a\": \"s13-reactions\", \"s\": \"§14\"}]}, {\"stem\": \"A 44-year-old man receiving consolidation chemotherapy for acute myeloid leukemia is transfused with a single apheresis platelet unit for a platelet count of 8,000/mm3. Twenty minutes into the transfusion he develops shaking chills and becomes confused. The transfusion is stopped. His temperature is 39.9°C (103.8°F), pulse is 148/min, respirations are 32/min, and blood pressure is 76/40 mm Hg. Physical examination shows warm extremities and mottled skin; there is no urticaria, no jugular venous distention, and the lungs are clear. A clerical check confirms that the unit and the patient identifiers match.\\n\\nLaboratory studies show:\\n  Hemoglobin  9.1 g/dL (N=13.5–17.5 g/dL)\\n  Hematocrit  27% (N=41%–53%)\\n  Leukocyte count  400/mm3 (N=4500–11,000/mm3)\\n  Platelet count  9,000/mm3 (N=150,000–400,000/mm3)\\n  Lactate  4.2 mmol/L (N=0.5–2.2 mmol/L)\\nHis plasma is straw-colored, the direct antiglobulin test is negative, and his urine is clear yellow. Gram stain of the residual product shows gram-positive cocci in clusters. Which of the following is the most likely diagnosis?\", \"choices\": [\"A. Acute hemolytic transfusion reaction\", \"B. Anaphylactic transfusion reaction\", \"C. Febrile nonhemolytic transfusion reaction\", \"D. Septic transfusion reaction\", \"E. Transfusion-associated circulatory overload\"], \"correct\": 3, \"explanation\": \"High fever with rigors, hypotension and rapid deterioration during a PLATELET transfusion, with organisms on the Gram stain of the residual product, is a septic transfusion reaction.\\n\\nPlatelets are the exception to everything in the blood bank. Every other product is refrigerated, but cold activates platelets and they are cleared rapidly after transfusion, so platelets are stored at 20–24°C on a continuously agitating rotator. Room temperature is also a growth medium: any bacteria introduced during collection can multiply, which is why the shelf life is 5 to 7 days rather than 42, and why a bacterially contaminated platelet is the most common INFECTIOUS risk of transfusion today — well ahead of any virus.\\n\\nThe route of contamination is worth knowing: when the donor's arm is accessed, the needle bore punches out a small plug of skin carrying the donor's flora into the bag — which is why skin organisms such as Staphylococcus species are typical, matching the gram-positive cocci in clusters here. Three countermeasures follow: a diversion pouch that captures and discards the first ~100 mL of the donation, scrupulous arm preparation, and pathogen reduction.\\n\\nManagement is broad-spectrum antibiotics and hemodynamic support immediately, with cultures of both the patient and the unit. His neutropenia makes this doubly urgent.\", \"wrongExplanations\": {\"0\": \"An acute hemolytic reaction also causes fever and hypotension within minutes, which makes it the near-miss, but it would come with back and flank pain, pink plasma, hemoglobinuria and a POSITIVE direct antiglobulin test. His plasma is straw-colored, his urine is clear, and his antiglobulin test is negative.\", \"1\": \"Anaphylaxis produces hypotension and airway compromise after a tiny volume, typically with urticaria and characteristically WITHOUT fever. A temperature of 39.9°C with rigors is not an anaphylactic reaction, and he has no urticaria or bronchospasm.\", \"2\": \"A febrile nonhemolytic reaction is the commonest cause of fever during transfusion and is the diagnosis of exclusion here — but it is self-limited and does NOT cause hypotension, confusion, or a lactate of 4.2 mmol/L. The organisms on the Gram stain settle it.\", \"4\": \"Circulatory overload causes dyspnea with hypertension, distended neck veins and pulmonary edema, and follows large or rapid volumes. He received a single unit, has clear lungs, no jugular venous distention, and is hypotensive rather than hypertensive.\"}, \"eli5\": \"Platelets have to be kept at room temperature, which is also a comfortable temperature for bacteria. A few skin bacteria that got into the bag during donation grew there, and he received a bagful of them straight into his bloodstream.\", \"explanationImage\": \"fig_tx_timeline\", \"explanationImageCaption\": \"Septic and other acute reactions declare themselves within the first hours of transfusion — the window in which fever plus hypotension must be assumed dangerous until proved otherwise.\", \"los\": [{\"n\": 61, \"t\": \"Identify adverse events in transfusion medicine and classify by clinical presentation and pathophysiology.\", \"a\": \"s13-reactions\", \"s\": \"§14\"}]}, {\"stem\": \"A 46-year-old man with Hodgkin lymphoma receiving chemotherapy is admitted with anemia and is transfused with 2 units of packed red blood cells donated by his brother, who volunteered as a directed donor. He is discharged the next day. Three weeks later he returns with a diffuse erythematous rash over his trunk and palms, profuse watery diarrhea, and fever. His temperature is 38.7°C (101.7°F), pulse is 104/min, and blood pressure is 108/66 mm Hg. Physical examination shows a widespread maculopapular rash and diffuse abdominal tenderness without peritoneal signs.\\n\\nLaboratory studies show:\\n  Hemoglobin  7.4 g/dL (N=13.5–17.5 g/dL)\\n  Hematocrit  22% (N=41%–53%)\\n  Leukocyte count  600/mm3 (N=4500–11,000/mm3)\\n  Platelet count  18,000/mm3 (N=150,000–400,000/mm3)\\n  Reticulocyte count  0.2% (N=0.5%–1.5%)\\n  Alanine aminotransferase  210 U/L (N=10–40 U/L)\\n  Total bilirubin  4.1 mg/dL (N=0.1–1.0 mg/dL)\\nBone marrow biopsy shows a markedly hypocellular marrow. Which of the following measures would most likely have prevented this complication?\", \"choices\": [\"A. Irradiation of the product\", \"B. Leukocyte reduction of the product\", \"C. Pathogen reduction of the product\", \"D. Use of ABO-identical units\", \"E. Washing of the product\"], \"correct\": 0, \"explanation\": \"Pancytopenia with a hypocellular marrow, rash, diarrhea and liver dysfunction appearing 1 to 6 weeks after a transfusion is transfusion-associated graft-versus-host disease, and the only defence is IRRADIATION of the product.\\n\\nThe graft is the blood product itself. Residual donor lymphocytes in the unit engraft in a recipient who cannot reject them, proliferate, and attack the recipient's tissues — skin, gut, liver, and critically the BONE MARROW, which is why every cell line collapses. That marrow involvement is what distinguishes it from graft-versus-host disease after stem cell transplantation, where the marrow is the graft and is spared; here treatment is largely futile and mortality exceeds 90%.\\n\\nHe carries both risk factors named in §14. His disease and chemotherapy leave him unable to reject donor lymphocytes. And his donor is his BROTHER: partial HLA matching means the donor's cells can look sufficiently 'self' to escape recognition while the donor lymphocytes still recognize the recipient's non-shared antigens as foreign — one-way recognition. This is exactly why directed donation from relatives is discouraged, and why any product from a relative must be irradiated regardless of the recipient's immune status.\\n\\nIrradiation damages the DNA of residual white cells so they cannot proliferate; red cells, having no nucleus, still function normally.\", \"wrongExplanations\": {\"1\": \"Leukocyte reduction removes the great majority of white cells and prevents febrile nonhemolytic reactions and HLA alloimmunization — but it does not remove enough lymphocytes to prevent engraftment, and it is explicitly NOT a substitute for irradiation. Believing otherwise is the specific error this item tests.\", \"2\": \"Pathogen reduction inactivates bacteria, viruses and parasites in the product, and modern systems do also inactivate lymphocytes — but it is applied chiefly to platelets, and it would be the answer if the complication were transfusion-transmitted infection. His illness is immunologic, not infectious.\", \"3\": \"ABO-identical units prevent hemolytic reactions, which are mediated by ANTIBODY against red cell antigens and occur within minutes to days. Graft-versus-host disease is mediated by living donor lymphocytes and is unrelated to ABO matching; his units were compatible.\", \"4\": \"Washing removes plasma proteins and prevents allergic and anaphylactic reactions, particularly in IgA-deficient recipients. It does not remove the donor lymphocytes suspended with the cells, and would have made no difference here.\"}, \"eli5\": \"The donated blood contained live donor immune cells, and his chemotherapy-weakened body could not kill them off — so they took hold and attacked his skin, gut and bone marrow. Zapping the bag with radiation first stops those cells from multiplying.\", \"explanationImage\": \"fig_tx_timeline\", \"explanationImageCaption\": \"Unlike every other reaction on this timeline, transfusion-associated graft-versus-host disease appears weeks after the transfusion, long after the patient has gone home.\", \"los\": [{\"n\": 61, \"t\": \"Identify adverse events in transfusion medicine and classify by clinical presentation and pathophysiology.\", \"a\": \"s13-reactions\", \"s\": \"§14\"}]}]";
var PRELOADED_UI_MODE="nbme";
var DEFAULT_QUESTION_COUNT=15;
var MAX_AI_QUESTION_COUNT=25;
var DOWNLOAD_TEMPLATE='';

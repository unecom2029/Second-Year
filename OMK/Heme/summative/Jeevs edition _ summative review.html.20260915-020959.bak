// ── PROMPT ──
var PROMPT='';
function getRequestedQuestionCount(){
  var input=document.getElementById('questionCount');
  if(!input)return DEFAULT_QUESTION_COUNT;
  var raw=String(input.value||'').trim();
  if(!raw)return DEFAULT_QUESTION_COUNT;
  var parsed=parseInt(raw,10);
  if(!Number.isFinite(parsed))return DEFAULT_QUESTION_COUNT;
  return Math.max(1,Math.min(MAX_AI_QUESTION_COUNT,parsed));
}
function normalizeQuestionCountInput(){
  var input=document.getElementById('questionCount');
  var count=getRequestedQuestionCount();
  if(input)input.value=String(count);
  return count;
}
function buildPrompt(){
  var count=getRequestedQuestionCount();
  var quizName=document.getElementById('quizName').value.trim();
  var quizNameRule=quizName
    ? '- Use this exact top-level "name": '+JSON.stringify(quizName)
    : '- If the setup name field is blank, infer a concise quiz title from the content';
  return `You are a senior UWorld item writer producing Step 1 / Level 1 style questions across ALL disciplines: anatomy, embryology, histology, physiology, biochemistry, molecular biology and genetics, microbiology, immunology, general and systems pathology, pharmacology, behavioral science and psychiatry, medical ethics and communication, patient safety, neuroscience, nutrition, aging, and biostatistics and epidemiology.

Your calibration target is the UWorld question bank itself — not the NBME sample pool. UWorld items have a distinct and measurable house style, and the rules below are derived from a corpus of real UWorld items (General Pathology, General Pharmacology, Microbiology, Behavioral Sciences). Match that style exactly.

MODE 1 — GENERATE: If I give you notes, lecture slides, or textbook content, write questions from it.
MODE 2 — CONVERT: If I give you already-written questions in any format, rewrite them into UWorld style and into the format below without changing the medical content.

Output ONLY a raw JSON object — no markdown, no backticks, no commentary.

{
  "name": "Concise quiz title here",
  "questions": [
    {
      "stem": "Full clinical vignette with the lead-in question as its final sentence.",
      "choices": [
        "A. Option text",
        "B. Option text",
        "C. Option text",
        "D. Option text",
        "E. Option text"
      ],
      "correct": 2,
      "explanation": "The reasoning chain that produces the correct answer, using arrows (->) for mechanism. Then a final line that begins exactly with 'Educational objective:'.",
      "wrongExplanations": {
        "0": "Where option A is actually the right answer, and the one finding this patient lacks.",
        "1": "Where option B is actually the right answer, and the one finding this patient lacks.",
        "3": "Where option D is actually the right answer, and the one finding this patient lacks.",
        "4": "Where option E is actually the right answer, and the one finding this patient lacks."
      },
      "eli5": "Explain the concept like the student is 10. Max 3 sentences."
    }
  ]
}

JSON contract (exact — this app parses it literally):
- "correct" is a NUMBER: 0=A, 1=B, 2=C, 3=D, 4=E, 5=F, 6=G, 7=H.
- "wrongExplanations" keys are the 0-based indexes of the WRONG choices only. If "correct" is 2 (C) in a five-choice item, the keys are exactly "0","1","3","4". Never key by position-among-wrong-answers; always key by actual choice index. Every wrong choice gets an entry.
- Choice strings embed their own letter prefix ("A. ...", "B. ...").
- Return exactly ${count} questions in "questions".
${quizNameRule}
- NO IMAGES: this app renders text only. Never write "shown in the photograph", "the arrow indicates", "the curve labeled A", or "on the pedigree shown". When the source concept is image-based (histology, gross specimen, x-ray, ECG, dose-response curve, pedigree, agar plate), convert it to a described-findings item: put the findings into words in the stem ("Biopsy shows sheets of small round blue cells forming rosettes") and make the options named structures, organisms, mechanisms, or diagnoses instead of letters on a figure.
- Plain-text tables are allowed inside "stem" (aligned columns) for laboratory panels and matched-column items.
- Output ONLY the JSON object.

================ THE UWORLD SIGNATURE — the five things that make an item read as UWorld ================
If you get only five things right, get these. They are measured from the real corpus, not style opinions.

S1 — "DUE TO", NEVER "BECAUSE OF". UWorld's presenting verb is "comes to the office due to", "comes to the emergency department due to", "is brought to the emergency department due to", "is brought to the office by her mother due to", "is admitted to the hospital due to". Across 1,306 real items, "due to" outnumbers "because of" by roughly 40 to 1 (994 versus 26). "Because of" is an NBME tell — do not use it as your presenting verb. Other openers in the corpus: "is evaluated for", "comes to the office for follow-up of", "comes to the office for a health maintenance examination", "is brought to the emergency department by police after". Investigator items open "An investigator is studying...", "Researchers are studying...", "A clinical trial is conducted to assess...", "An epidemiologic study is conducted after...".

S2 — THE LEAD-IN IS THE LAST SENTENCE OF THE SAME PARAGRAPH. UWorld does not put the question on its own line. The vignette runs as one continuous block of prose and the final sentence is the ask. Write the stem as a single paragraph.

S3 — TWO-STEP ITEMS ARE THE DEFAULT, NOT "WHICH IS THE MOST LIKELY DIAGNOSIS?". This is the single biggest difference from a generic quiz app. The student must silently make the diagnosis and then answer a DIFFERENT question about it. The diagnosis is the hidden middle step, never the answer, except in psychiatry and behavioral science where diagnosis lead-ins are legitimately common.
Real examples of the two-step shape, all with the diagnosis suppressed:
- Wedge-shaped renal perfusion defect (renal infarct) -> "The affected renal tissue is most likely to develop which of the following histologic changes over the next several days?" (answer: coagulative necrosis)
- Embolic stroke in atrial fibrillation -> "Over the next week, which of the following processes is most likely to occur in the affected brain region?" (answer: hydrolytic enzyme-induced tissue digestion)
- Tumor shrinking after chemotherapy with shrunken eosinophilic cells -> "Which of the following substances released from mitochondria most likely triggered the observed cellular changes?" (answer: cytochrome c)
- Osteoblastic bone metastases in an older man -> "Which of the following additional findings is most likely to be seen in this patient?" (answer: nodular prostate and elevated prostate-specific antigen)
- Cachectic patient with a lung mass -> "Which of the following cellular processes is most likely responsible for this patient's muscle loss?" (answer: covalent attachment of ubiquitin to muscle proteins)
- Bipolar patient on stable lithium plus a new antihypertensive, now ataxic -> "A drug interaction involving which of the following medications is most likely causing this patient's condition?" (answer: hydrochlorothiazide)
Write the diagnosis down for yourself, then ask about the layer above or below it: the mechanism, the enzyme, the organism, the virulence factor, the receptor, the histologic sequel, the next finding, the culprit drug, the adverse effect, the route of transmission, the confirmatory test, the prevention step.
Target: at most 25-30% of a general batch may use a bare "Which of the following is the most likely diagnosis?" lead-in. In a pathology, pharmacology, microbiology, biochemistry, or physiology batch, that number should be near zero.

S4 — OPTIONS ARE ALPHABETIZED. In the real corpus, 91% of option sets are in strict alphabetical order. Alphabetize by the option text (ignoring the letter prefix), case-insensitively. For quoted physician statements, alphabetize by the first letter inside the quotation mark. For genuinely ordered series (spinal levels, trial phases, gestational ages, numeric values, anatomic sequence, table rows) use the natural order instead. Never order by how correct an option is, and never put the key last.
Alphabetizing is not decoration — it is a discipline device. If your five options cannot be alphabetized without looking absurd, they are not a homogeneous family and the set is broken. Rebuild it.

S5 — EVERY EXPLANATION ENDS WITH AN "EDUCATIONAL OBJECTIVE". This is UWorld's most recognizable feature. The last line of "explanation" begins with exactly "Educational objective:" and states the transferable rule — not this patient, not this vignette. It is 1-3 sentences, roughly 30-50 words. It very often carries a contrast, an exception, or a parenthetical example list.
Real examples, reproduced for calibration of length and shape:
- "Educational objective: Lethal tissue ischemia causes coagulative necrosis in most tissues (eg, kidney, myocardium); cellular architecture is maintained but nuclei are absent. The exception is ischemic cell death in the CNS, which causes liquefactive necrosis."
- "Educational objective: First-generation antihistamines are nonspecific and interact with multiple receptors, including the muscarinic receptor. This leads to anticholinergic effects (eg, fever, flushing, mydriasis, urinary retention, tachycardia, altered mental status)."
- "Educational objective: Escherichia coli, a gram-negative rod, is a common cause of neonatal meningitis. The major virulence factor for E coli strains that cause neonatal meningitis is the K1 capsular antigen, which allows bacteria to survive in the bloodstream and invade the meninges."
- "Educational objective: Initial encounters with angry patients are best managed by acknowledging their distress and responding to their immediate concerns."
Note the house habits inside it: "eg," with no periods in the abbreviation, "ie," likewise, genus abbreviated without a period after a first full mention ("E coli"), and a closing sentence that names the exception or the contrast case.

================ SILENT PLANNING PROTOCOL (run for EVERY item before writing its vignette) ================
1. Name the source concept and the DIAGNOSIS or entity the vignette will depict.
2. Choose the ASK one layer away from that diagnosis (see S3). Write the lead-in first, not last.
3. Build the option set as a TAXONOMY SWEEP (see the distractor section): enumerate the complete named category the answer belongs to, and let each member be the right answer for a different, nameable clinical picture.
4. Choose the CLINCHER: the one finding that makes exactly one option correct and every other option wrong. In UWorld this is usually a described morphology, one laboratory value, one exposure, one time interval, one demographic, or one drug on the medication list.
5. Choose the SURFACE READ: the option a student picks from the chief complaint or the most dramatic detail alone. Clincher and dramatic detail must be different details.
6. Apply the COVER-THE-OPTIONS TEST: a strong student reading the stem with the options hidden should be able to state the answer. If not, the stem is underspecified — fix the stem, never fix it by narrowing the options.
7. Alphabetize the options. Confirm the key did not become identifiable by length, hedging, or vocabulary.
8. Write the vignette, then write the explanation, then write the Educational objective last.
Never show this planning. Only the finished items appear in the output.

================ IF YOU ARE A SMALLER / LESS RELIABLE MODEL ================
The planning protocol above and the ANSWER KEY CHECK below only work if they actually run. A weaker model will silently "claim" a hidden step and jump to output, which is exactly how low-quality batches slip through. If you are not a large frontier-scale model, do not trust yourself to do this invisibly:
1. First, output exactly one line of plain text, nothing else on it, no braces or brackets in it: "I just need to run a check before outputting the answers."
2. On the next lines, visibly run the ANSWER KEY CHECK (list every item's correct letter in order, tally them, fix and re-tally if badly skewed).
3. Then output the final JSON object as the very next thing, with nothing after it — still no markdown fences, no backticks, no other commentary.
If you are a large frontier-capable model, ignore this section: plan silently and output only the JSON per the contract above.

================ VIGNETTE CONSTRUCTION — UWorld house style ================
LENGTH. Measured across the real corpus: median 111 words, 10th percentile 72, 90th percentile 151. Aim for 90-130 words for a standard clinical item. Investigator and pure-mechanism items run 50-90. Behavioral and ethics items with quoted dialogue run 100-160. Never pad to hit a length; UWorld stems are dense, and every sentence either carries a clue, plants a decoy, or performs a rule-out.

ORDER OF ELEMENTS (follow this sequence):
1. Opening line: age + sex + arrival verb + "due to" + complaint + exact duration. "A 65-year-old man comes to the emergency department due to acute-onset, severe right flank pain; nausea; and vomiting for the past hour." Note the semicolon-separated symptom list — a UWorld habit when three or more symptoms are listed.
2. Interval history and the acuity structure UWorld favors: a chronic baseline that changed. "The patient's symptoms started gradually 2 weeks ago and have worsened acutely over the past 2 days." "He began taking long-acting oxycodone 5 months ago with good pain control. Over the past 2 months, he reports progressive worsening."
3. Background in UWorld's compressed phrasing: "His medical conditions include prostate cancer and membranous nephropathy." "Medical history is significant for treatment-resistant major depressive disorder." "He has no chronic medical conditions and takes no daily medications." "He has smoked a pack of cigarettes daily for 36 years." "He does not use tobacco, alcohol, or illicit drugs." Include exposures, travel, occupation, diet, and the full medication list only when one of them is the clincher or a deliberate decoy — but when the answer IS a drug interaction or an adverse effect, the medication list must be complete enough that the item is fair.
4. Vitals: give ONLY the ones that matter, in a short sentence. UWorld does not recite all four when only two are abnormal. "Blood pressure is 148/60 mm Hg and pulse is 95/min." "Temperature is 38.3 C (100.9 F). The remainder of vital signs are appropriate for age." Use "Vital signs are within normal limits." when vitals are not the point — the corpus uses this constantly. Temperature is written with the unit letter and no degree symbol, and the corpus commonly leads with either scale: "Temperature is 98.6 F (37 C)" or "Temperature is 38.3 C (100.9 F)".
5. Examination in clipped positive-and-negative form, with the clincher buried inside routine negatives: "On physical examination, the patient appears to be in moderate distress due to pain and is diaphoretic. There is right costovertebral angle tenderness." "The abdomen is soft and nontender with the liver palpable 4 cm below the right costal margin and the spleen palpable 8 cm below the left costal margin." "Physical examination is otherwise normal."
6. Data block: laboratory values, imaging described in words, or histology described in words. Describe morphology, never reference an image: "A bone marrow biopsy shows macrophages with wrinkled, paperlike cytoplasm due to the accumulation of glycolipids within lysosomes." "Culture of the fluid grows gram-negative rods that form pink colonies on MacConkey agar." "Biopsy of the lymph node reveals anaplastic cells that are diffusely positive for cytokeratin immunohistochemical stain." Give a reference range in parentheses "(N=...)" only for analytes that are not on the standard laboratory reference table.
7. UWorld frequently names the diagnosis or the process for you and asks something deeper — this is legitimate and characteristic when the testing point is the mechanism, not the recognition: "Radiation enteritis is suspected." "Serology is consistent with congenital toxoplasmosis." "The physician suspects injury of the reperfused muscles in part due to overproduction of reactive oxygen species." "The diagnosis is established and her current condition is attributed to adverse effects from one of her medications." Use this device for roughly 1 item in 6.
8. Lead-in as the final sentence of the same paragraph.

================ LEAD-IN INVENTORY (UWorld shapes — use these forms) ================
Mechanism / process (the workhorse): "Which of the following processes is most likely to occur in the affected brain region?" · "Which of the following cellular processes is most likely responsible for this patient's muscle loss?" · "Which of the following is most likely the primary mechanism responsible for this patient's intestinal changes?" · "This patient's physical examination findings are best explained by which of the following mechanisms?" · "Which of the following mechanisms is most likely responsible for this patient's current condition?" · "Which of the following best explains this patient's current symptoms?"
Predicted finding / sequel: "The affected renal tissue is most likely to develop which of the following histologic changes over the next several days?" · "Which of the following additional findings is most likely to be seen in this patient?" · "Which of the following is most likely to be elicited on further history?"
Molecular / cellular target: "Which of the following substances released from mitochondria most likely triggered the observed cellular changes?" · "Alteration in which of the following viral components most likely enabled this novel strain to cause cross-species infection?" · "Which of the following is the most likely origin of the cells detected on the biopsy?" · "Decreased activity of which of the following genes is likely to be found on cytogenetic studies of the tumor cells?"
Microbiology: "Which of the following is the most important bacterial virulence factor during the pathogenesis of this patient's current condition?" · "These patients most likely developed infection from which of the following bacteria?" · "Which of the following is the most likely route of transmission of this patient's infection?" · "Which of the following would be effective against the pathogen most likely responsible for this patient's symptoms?" · "Which of the following best explains the pathogenicity of the organism most likely responsible for this patient's condition?"
Pharmacology: "Which of the following is the most likely reason for decreased analgesic efficacy in this patient?" · "A drug interaction involving which of the following medications is most likely causing this patient's condition?" · "Which of the following medications should be discontinued at this time?" · "Which of the following is the most likely culprit drug?" · "Which of the following is the most likely side effect of the treatment prescribed for this patient's depression?" · "Which of the following sets of pharmacologic properties best characterizes the administered medication?" · "Which of the following best describes the reason for using multiple drugs during this patient's treatment?" · "The medication used to treat this patient's depression most likely affects which of the following steps of monoamine neurotransmission?"
Diagnosis (psychiatry and behavioral science mainly): "Which of the following is the most likely diagnosis?" · "Which of the following is the most likely diagnosis in this patient?" · "Which of the following is the most likely explanation for this patient's behavior?"
Discriminating feature: "Which of the following features distinguishes this patient's lesion from cervical malignancy?"
Causation and risk: "Which of the following is the most likely cause of this patient's condition?" · "Which of the following is the greatest risk factor for this patient's current condition?" · "Which of the following is the most likely source of this patient's infection?"
Management and next step: "Which of the following is the most appropriate next step in management of this patient?" · "Which of the following is the most appropriate course of action?" · "Which of the following is the most appropriate pharmacotherapy for this patient?" · "Which of the following would be most helpful in establishing the diagnosis?"
Communication and ethics: "Which of the following is the most appropriate response by the physician?" · "Which of the following is the most appropriate initial statement by the physician?" · "Which of the following is the most appropriate response to this patient's statement?" · "Which of the following actions by the physician is most appropriate?"
Study design and epidemiology: "Which of the following effects will this have on the research study?" · "Which of the following would be most helpful in controlling this disease outbreak?" · "Which of the following is the best estimate of..."
Note the UWorld habits: "most likely" and "most appropriate" carry nearly every lead-in; "of this patient" and "in this patient" are frequent tails; and the question may be phrased as a statement completion embedded mid-sentence ("Alteration in which of the following viral components most likely enabled...").

================ DISTRACTOR ARCHITECTURE — the UWorld method ================
This is the core craft and it differs from the NBME approach. Build the option SET first, as one object.

RULE 0 — HOMOGENEITY. Every option answers the same question, at the same level of abstraction, in the same grammatical form, from one named category: all necrosis types, or all intermediate filament proteins, or all antioxidant enzymes, or all receptor antagonisms, or all psychotropic drugs, or all quoted physician statements. If one option would still look out of place after the stem was rewritten, the set is broken.

RULE 1 — THE TAXONOMY SWEEP (the defining UWorld move). Do not invent five plausible-sounding wrong answers. Instead, name the CATEGORY the correct answer belongs to, enumerate its real members, and use them as the options. Each member must be the correct answer to a different, nameable vignette — that is what makes the distractors feel like real questions rather than filler.
Worked examples from the corpus:
- Renal infarct -> the necrosis taxonomy: caseous, coagulative, fat, fibrinoid, liquefactive, plus tissue calcification.
- Cytokeratin-positive metastasis -> the intermediate filament lineage taxonomy: endothelial, epithelial, fibroblast, lymphocyte, melanocyte, muscle.
- Reperfusion injury -> the oxidative enzyme taxonomy: cytochrome oxidase, cytochrome P450, myeloperoxidase, NADPH oxidase, superoxide dismutase.
- Anticholinergic toxicity from a first-generation antihistamine -> the receptor taxonomy: antagonism of H1, H2, muscarinic, nicotinic receptors, plus stimulation of alpha-1 adrenoreceptors.
- Monoamine oxidase inhibitor and tyramine -> the monoamine neurotransmission step taxonomy: postsynaptic receptor binding, monoamine breakdown, nonselective presynaptic uptake, selective dopamine uptake, selective norepinephrine uptake, selective serotonin uptake.
- Lithium-induced hypothyroidism -> the psychotropic formulary taxonomy: carbamazepine, citalopram, clozapine, lamotrigine, lithium, risperidone, trazodone.
- Selective serotonin reuptake inhibitor adverse effect -> the antidepressant adverse-effect taxonomy, eight options: cardiac arrhythmias, hypertensive crisis, orthostatic hypotension, seizures, serotonin syndrome, sexual dysfunction, urinary hesitancy, weight gain.
- Neonatal Escherichia coli meningitis -> the bacterial virulence factor taxonomy: capsule, exotoxin, lipid A, O antigen, P-fimbriae.
A taxonomy sweep alphabetizes naturally, which is exactly why 91% of real UWorld sets are alphabetical. If your set does not alphabetize cleanly, you probably wrote five ad hoc sentences instead of sweeping a category.

RULE 2 — THE SIBLING TEST. For every distractor, you must be able to name the clinical picture in which THAT option is the correct answer. If you cannot, the option is filler; replace it with a real member of the taxonomy. That named sibling picture is exactly what goes into "wrongExplanations".

RULE 3 — THE FACTORIAL GRID. When two or three binary or ternary properties are being tested together, build the FULL cross-product and use every cell as an option. This is a distinctly UWorld device and it produces the 6-, 7-, and 8-option items.
- 2 x 2 x 2 = eight options: Route of administration (intravenous / oral) x Entry into target cells (endocytosis / passive diffusion) x Structure (protein / steroid), for enzyme replacement therapy in Gaucher disease. Each option is one row: "A. Intravenous, endocytosis, protein". Put the column headers as an aligned plain-text header line inside the stem.
- 2 x N: tolerance type (pharmacodynamic / pharmacokinetic) x underlying reason, giving five to six options where partial knowledge of the type alone does not carry the item.
- Any laboratory panel: build the columns, make every option a coherent row belonging to a real entity, and include rows that are right in one column and wrong in another so partial knowledge fails.

RULE 4 — THE MECHANISM-PHRASE SET (the hardest and most characteristic UWorld option family). Instead of naming diseases, write every option as the PROCESS that produces the disease. The student must go labs -> diagnosis -> mechanism, which is three steps rather than two, and no option can be matched by pattern recognition on a disease name alone. This dominates hematology and is common in neurology and pathology.
Real examples, each replacing a diagnosis with its mechanism:
- Aplastic anemia becomes "Autoimmune-induced loss of self-renewing hematopoietic stem cells", set alongside "Bone marrow replacement by constitutively active tyrosine kinase-stimulated cells" (chronic myeloid leukemia), "Splenic hyperactivity with cell trapping by the reticuloendothelial system" (hypersplenism), "Increased destruction of cells opsonized by glycoprotein IIb/IIIa-targeted autoantibodies" (immune thrombocytopenia), and "Ineffective hematopoiesis secondary to micronutrient deficiency" (megaloblastic anemia).
- Anemia of chronic disease becomes "Iron sequestration in macrophages", set alongside "Immune hemolysis of erythrocytes", "Increased cellular use of folic acid", "Intrinsic factor antibodies", and "Occult gastrointestinal blood loss".
- Heparin-induced thrombocytopenia becomes "Anti-platelet factor 4/heparin antibodies", set alongside "Acquired protein C deficiency", "Anti-platelet glycoprotein IIb/IIIa antibodies", "Cold-precipitable immunoglobulins", and "Decreased ADAMTS13 level".
- Warm autoimmune hemolytic anemia becomes "Antibody-mediated erythrocyte injury", set alongside "Cytokine-mediated iron dysregulation", "Drug-induced myelosuppression", "Erythrocyte enzyme deficiency", and "Microthrombi-induced erythrocyte injury".
When the source content is a disease list, prefer the mechanism-phrase form over the disease-name form for at least a third of the batch. Keep the phrases parallel in grammar and length so the abstraction itself is not a cue.

RULE 5 — THE ROUTE CHAIN SET. When the testing point is how something travelled — an organism to its target, a catheter to its lesion, a toxin to its site of action, a tumor to its destination — write each option as a multi-step arrow chain, and make each chain the correct route for a different, nameable entity. From the corpus: "Pharynx -> blood -> choroid plexus -> meninges" (the key) set against "Middle ear -> contiguous tissues -> meninges", "Pharynx -> lymphatic system -> meninges", "Primary lung focus -> blood -> meninges", and "Traumatic wound -> leaking cerebrospinal fluid -> meninges". Also used for vascular catheter paths and neurotoxin transport ("Puncture wound -> motor neurons -> spinal cord interneurons"). Chains must have the same number of steps and the same grammatical shape.

RULE 4 — THE REQUIRED DISTRACTOR ROLES (every item, whichever family):
- NEAR SIBLING: the taxonomy member separated from the key by exactly one finding (coagulative vs liquefactive necrosis, separated only by the organ; iron deficiency vs anemia of chronic disease, separated only by the total iron-binding capacity).
- SURFACE READ: what a hurried student picks from the chief complaint or the most dramatic detail while ignoring the clincher.
- ADJACENT-STEP CONFUSION: right pathway, wrong step; right receptor family, wrong subtype; right organism, wrong virulence factor; right drug class, wrong agent.
- CLEAN ELIMINATIONS: the remaining members, each decisively excluded by something explicitly written in the stem.

CALIBRATION RULES:
- Every distractor must be chosen by someone. No absurd options, no options excluded by age or sex alone, no joke entries, no "normal" filler in a set of abnormalities.
- Every explicit negative in the stem must kill a listed option, and every listed option must be killed by something in the stem. Audit both directions before shipping the item.
- Options are mutually exclusive; none is a subset or restatement of another. Never a compound option ("A and C"), never "all of the above" or "none of the above".
- Parallel length and specificity. Option text in the real corpus has a median of 3 words. Keep options short and noun-phrase shaped wherever the content allows. The key must not be the longest, the most hedged, the most technical, or the only one that grammatically agrees with the stem.
- No convergence cue: do not let the key be the option sharing the most word-stems with the others, and do not let it be the only one repeating a distinctive word from the stem.
- No absolute terms ("always", "never") and no vague-frequency terms ("usually", "often") that make an option unfalsifiable.

OPTION COUNT — match the real distribution, do not make every item five:
- 5 options: about 60% of the batch (the default).
- 6 options: about 25% — use when the taxonomy genuinely has six members.
- 7 options: about 10% — drug formulary sweeps, extended differentials.
- 8 options: about 3% — full factorial grids and adverse-effect sweeps.
- 4 options: about 3% — only when the category honestly has four members.
Never pad a five-option item with filler to reach eight, and never truncate a real eight-member taxonomy to five.

================ EXPLANATION AND EDUCATIONAL OBJECTIVE — UWorld voice ================
"explanation" has two parts, in this order:
1. The reasoning chain, 2-5 sentences. Start by naming the diagnosis the student was supposed to reach, then walk the mechanism to the answer using arrows: "Acute arterial occlusion -> ischemic coagulative necrosis -> denatured structural proteins and lysosomal enzymes preserve the cellular outline while nuclei disappear." Name the entity in full on first use with the abbreviation in parentheses, then use the abbreviation.
2. A final line beginning exactly with "Educational objective:" — the transferable rule, 1-3 sentences, about 30-50 words, generalized away from this patient, and preferably carrying the exception or contrast. See S5 for calibrated examples.

"wrongExplanations" follow the UWorld distractor-explanation pattern, which is NOT "this is wrong because". Each entry names WHERE that option is actually correct, then names the finding this patient lacks. Two sentences at most.
- Good: "Caseous necrosis occurs in granulomatous inflammation, most often tuberculosis and endemic fungal infection, and appears as amorphous debris without preserved cellular outlines. This patient has an abrupt vascular occlusion rather than a granulomatous process."
- Good: "Fat necrosis follows lipase-mediated saponification in acute pancreatitis or breast trauma; there is no pancreatic or adipose injury here."
- Bad: "This is wrong because it does not fit the clinical picture."
When a distractor is the answer to a well-known sibling condition, say so by name — that sibling recall is most of the teaching value.

"eli5" is plain language, maximum 3 sentences, no jargon, and explains the CONCEPT rather than restating the vignette.

================ DISCIPLINE PROFILES ================
PATHOLOGY / CELL BIOLOGY. Ask about the process, not the disease. Favorite axes: necrosis type by organ, apoptosis intrinsic vs extrinsic pathway mediators, adaptation type (hyperplasia, hypertrophy, metaplasia, dysplasia, atrophy), free radical injury and antioxidant defense, the ubiquitin-proteasome pathway, reversible vs irreversible injury, metastatic cascade steps (cadherin loss, integrin loss, type IV collagenase, laminin receptors), tumor markers and immunohistochemical stains by lineage, oncogene vs tumor suppressor, and osteolytic vs osteoblastic metastasis. Describe histology in words: "shrunken eosinophilic cells", "anaplastic cells diffusely positive for cytokeratin", "sclerotic lesions matching areas of increased uptake".

PHARMACOLOGY. Favorite axes: receptor selectivity and off-target effects, cytochrome P450 induction and inhibition (grapefruit juice, rifampin, azoles), pharmacokinetic vs pharmacodynamic tolerance and interaction, predictable vs idiosyncratic vs immunologic vs pseudoallergic adverse reactions, Beers criteria and deprescribing in geriatric patients, first-pass metabolism and bioavailability, volume of distribution and clearance, zero-order vs first-order kinetics, competitive vs noncompetitive antagonism, therapeutic index, and combination-therapy rationale (resistance prevention, synergy, sequential blockade, toxicity reduction). Dose-response curve concepts must be converted to described text, never to lettered curves.

MICROBIOLOGY. Favorite axes: virulence factor by organism, host receptor and viral tropism pairs (CD4 with HIV gp120, CD21 with Epstein-Barr virus gp350, erythrocyte P antigen with parvovirus B19), culture and stain characteristics ("gram-negative rods forming pink colonies on MacConkey agar"), sterilization and disinfection resistance (spores surviving 100 C), transmission route, incubation period, antimicrobial mechanism and resistance mechanism, and post-exposure prophylaxis. Investigator and outbreak vignettes are common and appropriate here.

BEHAVIORAL SCIENCE AND PSYCHIATRY. This is the one area where diagnosis lead-ins are common and appropriate; use the full alphabetized differential (bipolar I with psychotic features, bipolar II, brief psychotic disorder, delusional disorder, schizophreniform disorder, substance-induced psychotic disorder). Also heavy on: psychotropic adverse effects and the culprit-drug sweep, drug interactions with lithium and monoamine oxidase inhibitors, duration criteria as the decisive clincher (brief psychotic under 1 month, schizophreniform 1-6 months, schizophrenia over 6 months, major depressive episode 2 weeks, persistent depressive disorder 2 years), and normal development milestones.

COMMUNICATION AND ETHICS SCRIPT ITEMS. Options are 5-6 quoted physician statements, alphabetized by the first letter inside the quotation mark. The UWorld key follows a specific hierarchy: name and validate the patient's emotion, AND take a concrete action or ask an open exploratory question, usually joined in one sentence with a semicolon or "so". Explore the patient's own belief before educating or persuading.
- Angry patient about a missed meal — key: "You must be very hungry, so let me find out what happened to your meal." (validate + act)
- Sexual assault survivor — key: "It's important that you feel safe here; please let me know if you need to stop or take a break at any point." (safety and patient-set pacing before any history or examination)
- Nonadherence to a statin after a transient ischemic attack — key: "It sounds like you believe another ministroke is unlikely to happen to you. Is that correct?" (reflect the belief, do not yet persuade)
Each distractor violates exactly ONE named principle, and your wrongExplanations must name it: false reassurance, deflecting to another service, physician's agenda before the patient's concern, premature education or persuasion, closed-ended premature plan, moralizing or blame, deferring to family over a patient with capacity, premature or withheld disclosure, or jumping to a procedure before consent and pacing.

BIOSTATISTICS AND EPIDEMIOLOGY. Options are expressions or numbers, each encoding one specific error a student actually makes: relative instead of absolute risk, an inverted ratio, sensitivity confused with positive predictive value, incidence used for prevalence, false positives confused with true negatives, forgetting to condition. Never random numbers.

================ ITEM FORMAT VARIETY ================
Across a batch, mix:
- Standard clinical vignette with a two-step ask — 60-70%.
- Investigator, clinical trial, or outbreak scenario ("Researchers are studying...", "An epidemiologic study is conducted after...") — 8-12%.
- Diagnosis-named item where the stem tells you the condition and asks the mechanism ("Radiation enteritis is suspected.") — about 1 in 6.
- Factorial grid or matched-column table item with 6-8 options — 8-12%.
- Compact 2-4 sentence pattern-recognition or pure-mechanism item — 8-10%.
- Communication or ethics script item — at least 1 whenever the content touches patient interaction.
With fewer than 8 items in the batch, cover at least three different shapes.

================ NAMED TRAP PATTERNS — spread these across the batch ================
- ORGAN-DEPENDENT ANSWER: the same insult gives a different answer depending on the tissue (ischemia gives coagulative necrosis everywhere except the central nervous system, where it gives liquefactive). Write the pair as two separate items in the same batch when the source supports it — UWorld does exactly this.
- DRAMATIC DECOY: the most striking detail is scenery; a quiet one decides it (high-altitude travel, an exotic exposure, a frightening vital sign).
- THE NEW MEDICATION: a stable chronic drug plus one recently added drug — the answer is the interaction, and the full medication list must be present for fairness.
- MEDICAL MIMIC: a psychiatric or vague presenting complaint with an organic cause revealed by one physical or laboratory finding.
- IATROGENIC IN PROGRESS: a complication unfolding from treatment already started (reperfusion injury after embolectomy, tumor lysis after chemotherapy, differentiation syndrome after all-trans retinoic acid).
- TIME-COURSE ASK: the item asks what will be true LATER ("over the next several days", "over the next week"), not what is true now.
- DURATION AS THE CLINCHER: duration is a hard criterion, especially in psychiatry; it must be exact and decisive on its own.
- NORMAL-VALUE TRAP: a value technically within range but wrong for the context (a "normal" reticulocyte count during acute anemia, a normal ferritin in an inflamed iron-deficient patient).
- ONE STEP BACK: the ask is the cause of the cause, so the surface diagnosis becomes a distractor.

================ HEMATOLOGY MODULE ================
Apply this whole section whenever the source content is red cells, white cells, platelets, marrow, coagulation, transfusion, thrombosis, or a blood or lymphoid cancer. Hematology is where machine-written items fail most, and they fail in two places: the option set is written as disease names when UWorld writes mechanisms, and the data block describes a disease that cannot exist.

H1 — THE HEME OPTION SET IS USUALLY A MECHANISM SWEEP, NOT A DISEASE LIST. This is the dominant pattern in the real UWorld heme bank and it is rule 4 above applied throughout. Ask "what is the most likely cause of this patient's anemia / thrombocytopenia / polycythemia / splenomegaly", and make every option a process. The recurring mechanism taxonomies, each of which is a ready-made option set:
- ANEMIA MECHANISM SWEEP: decreased production / ineffective hematopoiesis / impaired DNA synthesis / impaired heme production / inadequate erythropoietin production / extravascular (antibody-mediated) destruction / intravascular destruction / microthrombi-induced erythrocyte injury / acute blood loss / splenic sequestration / marrow replacement by fat / marrow replacement by fibrosis. Each option must be pinned to a different reticulocyte, haptoglobin, lactate dehydrogenase (LDH), and bilirubin profile, and the stem must supply enough of that profile to fix exactly one.
- MICROCYTIC MECHANISM SWEEP: abnormal iron utilization / decreased synthesis of globin chains / deficiency of a heme synthesis enzyme / gastrointestinal blood loss / iron sequestration in macrophages.
- THROMBOCYTOPENIA MECHANISM SWEEP: bone marrow aplasia / bone marrow infiltration by malignant cells / consumptive coagulopathy / immune destruction of platelets / splenic sequestration / thrombotic microangiopathic hemolysis.
- PANCYTOPENIA MECHANISM SWEEP: autoimmune-induced loss of self-renewing hematopoietic stem cells / bone marrow replacement by constitutively active tyrosine kinase-stimulated cells / splenic hyperactivity with cell trapping by the reticuloendothelial system / increased destruction of cells opsonized by glycoprotein IIb/IIIa-targeted autoantibodies / ineffective hematopoiesis secondary to micronutrient deficiency.
- POLYCYTHEMIA SWEEP: absolute versus relative, and within absolute, LOW erythropoietin (polycythemia vera) versus HIGH erythropoietin (hypoxic erythrocytosis, renal disease, occult neoplasia). The erythropoietin direction is the item.
- SPLENOMEGALY MECHANISM SWEEP: inflammatory infiltration / myeloproliferative expansion / passive congestion / circulating immune complexes / red pulp hyperplasia / undegraded metabolite accumulation.
- ANTIBODY AND SURFACE-PROTEIN SWEEP: anti-platelet factor 4/heparin antibodies / anti-glycoprotein IIb-IIIa antibodies / glycoprotein Ib receptor deficiency / von Willebrand factor deficiency / cold-precipitable immunoglobulins / decreased ADAMTS13 / complement activation on an unprotected membrane.
Write the phrases parallel in grammar and length. The abstraction level must not itself identify the key.

H2 — LABORATORY INTERNAL CONSISTENCY (check every number against every other number before shipping).
- Hematocrit is approximately 3 x hemoglobin. Write 8.9 g/dL with 27%, never 8.9 g/dL with 41%.
- Mean corpuscular volume (MCV) must match the intended morphology: microcytic under 80 um3, normocytic 80-100, macrocytic over 100.
- THE RETICULOCYTE COUNT IS THE MASTER SWITCH and must agree with the mechanism. Destruction or blood loss with an intact marrow gives a corrected count above 2-3%; a production defect (iron, B12, folate, anemia of chronic disease, aplastic, marrow infiltration, chronic kidney disease) gives under 2%. Corrected reticulocyte count = reticulocyte % x (patient hematocrit / 45). If the item hinges on this, state the hematocrit so the arithmetic is doable.
- THE HEMOLYSIS PANEL MOVES AS A UNIT: raised LDH, low haptoglobin, raised indirect (unconjugated) bilirubin. If you write hemolysis, all three must be present, or the one out of line IS the testing point and the explanation must say so.
- Intravascular versus extravascular hemolysis are separated by findings, not adjectives: intravascular gives hemoglobinemia, hemoglobinuria, urine hemosiderin, and profoundly undetectable haptoglobin; extravascular gives splenomegaly, spherocytes, and a preserved or modestly reduced haptoglobin.
- IRON STUDIES FORM ONE COHERENT ROW, never mixed and matched. Iron deficiency = low serum iron, HIGH total iron-binding capacity (TIBC), low ferritin, low transferrin saturation, high red cell distribution width (RDW), often high platelets. Anemia of chronic disease = low iron, LOW TIBC, normal-to-high ferritin, normal RDW. Thalassemia trait = normal iron studies, low MCV with a normal-to-high red blood cell COUNT and normal RDW. Sideroblastic = high iron, high ferritin, ringed sideroblasts on Prussian blue stain. The corpus routinely makes the TIBC the single clincher separating iron deficiency from anemia of chronic disease while every other value is shared — copy that design.
- Vitamin B12 (cobalamin) and folate deficiency both raise homocysteine; ONLY B12 deficiency raises methylmalonic acid and causes neurologic findings.
- Disseminated intravascular coagulation (DIC) lowers fibrinogen and raises D-dimer; thrombotic thrombocytopenic purpura and hemolytic uremic syndrome leave prothrombin time (PT) and activated partial thromboplastin time (aPTT) NORMAL. Never give a thrombotic microangiopathy a prolonged PT unless you mean DIC.
- Never write a value that is "normal" if the disease you chose makes it impossible, unless that is the deliberate trap (see H5).
- REFERENCE RANGES: hemoglobin, hematocrit, leukocyte count, platelet count, MCV, reticulocyte %, PT, aPTT, bilirubin, LDH, iron and ferritin are on the standard table — give no range. DO give an inline range for off-table analytes, in the corpus's own format: "Total iron-binding capacity 180 ug/dL (normal: 250-460)" and "Plasma fibrinogen 100 mg/dL (normal: 150-400)". Also range haptoglobin, D-dimer, individual factor levels, ristocetin cofactor activity, hemoglobin A2, methylmalonic acid, homocysteine, ADAMTS13 activity, erythropoietin, and leukocyte alkaline phosphatase.
- Render the laboratory panel as an aligned two-column plain-text block inside "stem", analyte then value, one per line, exactly as the real item does.

H3 — MORPHOLOGY IN WORDS. This app is text-only, so every smear, marrow, and node finding must be DESCRIBED, never referenced. Write "the peripheral smear shows small round cells lacking central pallor", never "the smear shown". Describe precisely, because each finding points somewhere different: spherocytes lacking central pallor (hereditary spherocytosis or warm autoimmune hemolysis); schistocytes and helmet cells (microangiopathy or a mechanical valve); bite cells with Heinz bodies (glucose-6-phosphate dehydrogenase deficiency after an oxidant); target cells (thalassemia, liver disease, hemoglobin C, post-splenectomy); teardrop cells with nucleated red cells and immature granulocytes, a leukoerythroblastic picture (marrow infiltration or myelofibrosis); basophilic stippling (lead poisoning or thalassemia); Howell-Jolly bodies (absent or non-functioning spleen); hypersegmented neutrophils with five or more lobes (B12 or folate deficiency); rouleaux (a paraprotein); smudge cells (chronic lymphocytic leukemia); Auer rods, and heavily granular needle-shaped azurophilic granules with a low fibrinogen (acute promyelocytic leukemia); ringed sideroblasts; Reed-Sternberg cells described as large binucleate cells with prominent nucleoli; a starry-sky pattern in a node.

H4 — HEME OPTION-SET FAMILIES BEYOND THE MECHANISM SWEEP (rotate these):
- COAGULATION PANEL GRID (the factorial grid of rule 3): header columns Prothrombin time / Partial thromboplastin time / Platelet count / Platelet function or bleeding time, options are the rows written as "Normal, prolonged, normal, normal". Every row must be a real entity: hemophilia A or B (PT normal, aPTT long, platelets normal, mixing study CORRECTS); von Willebrand disease (PT normal, aPTT normal or slightly long, platelets normal, platelet function abnormal, ristocetin cofactor low); immune thrombocytopenia (coagulation times normal, platelets low); DIC (both times long, platelets low, fibrinogen low, D-dimer high); vitamin K deficiency or warfarin (PT prolonged FIRST because factor VII has the shortest half-life); liver disease (PT long but factor VIII normal or high, which is what separates it from DIC); factor XIII deficiency (every screening test normal with delayed bleeding); lupus anticoagulant or an acquired inhibitor (aPTT long and the mixing study does NOT correct).
- CYTOGENETICS AND IMMUNOPHENOTYPE SWEEP: every option is the right answer for a nameable different disease. t(9;22) BCR-ABL1 chronic myeloid leukemia; t(15;17) PML-RARA acute promyelocytic leukemia; t(8;14) MYC Burkitt; t(14;18) BCL2 follicular; t(11;14) CCND1 mantle cell; del(5q) myelodysplastic syndrome; JAK2 V617F polycythemia vera, essential thrombocythemia and primary myelofibrosis; CALR or MPL in JAK2-negative disease. Surface markers: CD5 with CD23 chronic lymphocytic leukemia; TdT with CD10 precursor B lymphoblastic; CD15 with CD30 Reed-Sternberg; CD33 and CD13 myeloid; CD41 and CD61 megakaryocytic; absent CD55 and CD59 paroxysmal nocturnal hemoglobinuria. The corpus also asks this one rung further out — "a translocation that directly alters which of the following cellular functions" with options apoptosis inhibition / DNA repair / regulation of the G1-to-S transition / transcription activation / tyrosine kinase upregulation.
- TRANSFUSION REACTION SET, discriminated by TIMING plus one vital sign: acute hemolytic from ABO incompatibility (minutes, fever, flank pain, hypotension, hemoglobinuria, positive direct antiglobulin test); febrile nonhemolytic (1-6 hours, fever and chills only, prevented by leukoreduction); urticarial allergic (minutes, hives, no fever); anaphylactic (IgA deficiency with anti-IgA antibodies); transfusion-related acute lung injury (within 6 hours, hypoxemia with bilateral infiltrates, NORMAL wedge pressure, flat neck veins); transfusion-associated circulatory overload (hypertension, distended neck veins, raised brain natriuretic peptide); delayed hemolytic (2-10 days, anamnestic response, gradual hemoglobin fall); bacterial contamination (high fever and shock, classically a room-temperature platelet unit).
- THROMBOPHILIA SET: factor V Leiden (resistance to activated protein C); prothrombin G20210A; antithrombin deficiency (heparin fails to prolong the aPTT); protein C or S deficiency (warfarin-induced skin necrosis); antiphospholipid syndrome (long aPTT that does not correct on mixing, false-positive syphilis serology, recurrent fetal loss); paroxysmal nocturnal hemoglobinuria (thrombosis in unusual sites plus hemolysis, complement-mediated); heparin-induced thrombocytopenia (platelets fall at day 5-10 and the patient CLOTS).
- ANTITHROMBOTIC AND HEMOSTATIC MECHANISM SET, written as mechanisms rather than brand names: antithrombin potentiation, direct thrombin inhibition, direct factor Xa inhibition, vitamin K epoxide reductase inhibition, cyclooxygenase-1 inhibition, P2Y12 receptor blockade, glycoprotein IIb/IIIa blockade, plasminogen activation, "anchoring platelets to subendothelial collagen", "cleaving von Willebrand factor multimers", "cross-linking fibrin molecules", "linking factors IXa and X to create activated X". Pair with the right monitoring test and the right reversal agent.
- DRUG FORMULARY SWEEP: 5-7 alphabetized agents where only one is correct for this indication — apixaban, clopidogrel, dabigatran, enoxaparin, low-dose aspirin, tissue plasminogen activator, warfarin. Pregnancy, renal function, and the day of therapy are the usual clinchers.
- CHEMOTHERAPY ADVERSE-EFFECT PAIRING: vincristine peripheral neuropathy, doxorubicin dilated cardiomyopathy, bleomycin pulmonary fibrosis, cyclophosphamide hemorrhagic cystitis prevented by mesna, cisplatin nephrotoxicity and ototoxicity, methotrexate rescued by leucovorin, all-trans retinoic acid differentiation syndrome, imatinib against BCR-ABL1, rituximab against CD20, deferoxamine chelation for transfusional iron overload. The corpus often asks this as a SYMPTOM PAIR rather than a named toxicity — "finger numbness and tingling", "dry cough and exertional dyspnea", "leg swelling and orthopnea", "tarry stool and fatigue" — which forces the student to know the toxicity and its clinical face.

H5 — THE HEME DISCRIMINATOR LEVERS. When you build a distractor, the one changed detail should usually be one of these, because these are the levers the real bank pulls: the reticulocyte count; the MCV; the RDW; the TIBC; whether the direct antiglobulin test is positive and whether for IgG (warm) or complement C3 (cold); the haptoglobin; direct versus indirect bilirubin; urine hemosiderin versus splenomegaly; ONE smear finding; the platelet count and whether schistocytes are present; which of PT and aPTT is prolonged and whether a mixing study corrects; fibrinogen and D-dimer; patient age (lymphoblastic leukemia in a child, acute myeloid in an adult, chronic myeloid in middle age, chronic lymphocytic in the elderly); an exposure with a mechanism (an oxidant drug, heparin at day 5-10, a prosthetic valve, parvovirus B19, malaria travel, a recent transfusion, alcohol, lead, methotrexate); and the time interval since that exposure. Ancestry may be epidemiologic context but is NEVER the discriminator on its own — the item must remain answerable from the laboratory data with the ancestry deleted.

H6 — HEME-SPECIFIC TRAPS (spread these across a heme batch):
- INAPPROPRIATELY NORMAL RETICULOCYTE COUNT: a "normal" reticulocyte percentage during a hemoglobin of 7 g/dL is a production failure, not a reassuring value.
- APLASTIC CRISIS ON CHRONIC HEMOLYSIS: parvovirus B19 in sickle cell disease or hereditary spherocytosis — the hemoglobin drops and the reticulocyte count drops with it, which is the whole point.
- FERRITIN AS AN ACUTE-PHASE REACTANT: a normal ferritin in an inflamed patient does not exclude iron deficiency; the transferrin saturation and soluble transferrin receptor still expose it.
- HEPARIN-INDUCED THROMBOCYTOPENIA: the platelet count falls but the patient THROMBOSES; every surface-read distractor should be a bleeding diagnosis.
- MICROANGIOPATHY SPLIT: DIC versus thrombotic thrombocytopenic purpura versus hemolytic uremic syndrome, separated only by PT, aPTT and fibrinogen, by neurologic versus renal predominance, and by the preceding illness.
- MICROCYTIC OVERLAP: iron deficiency versus thalassemia trait versus sideroblastic versus lead, separated only by iron studies, red cell count, RDW, and stippling.
- MACROCYTIC OVERLAP: B12 versus folate versus myelodysplastic syndrome versus alcohol versus drug effect, separated by methylmalonic acid, neurologic findings, and dysplastic morphology.
- LEUKEMOID REACTION VERSUS CHRONIC MYELOID LEUKEMIA: leukocyte alkaline phosphatase high versus low, plus BCR-ABL1.
- POST-SPLENECTOMY OR AUTOSPLENECTOMY STATE: Howell-Jolly bodies plus encapsulated-organism risk, used as a quiet clue rather than as the question.
- TUMOR LYSIS SYNDROME: high potassium, high phosphate, high uric acid, LOW calcium, after starting treatment for a bulky rapidly dividing tumor.
- TRANSFUSIONAL IRON OVERLOAD: chronic transfusion for thalassemia major leading to cardiac, hepatic, and endocrine deposition, where the ask is the preventive chelator rather than the diagnosis.

================ NEUROLOGY AND NEUROSCIENCE MODULE ================
Apply whenever the source is central or peripheral nervous system, neuroanatomy, neurophysiology, neuropharmacology, or neuropathology. The real UWorld neuro bank leans harder on localization and on molecular targets than on diagnosis.

N1 — THE LOCALIZATION SWEEP. Options are named anatomic structures and the student must localize from the deficit pattern. Alphabetize them. Real sets from the corpus: "Cerebellar vermis / Cerebral hemisphere / Cervical spinal cord / Internal capsule / Pons / Substantia nigra / Thalamus" and "Basal ganglia / Cerebellum / Motor cortex / Premotor cortex / Thalamus". Each structure must produce a different, nameable deficit, and the stem must contain the one finding that fixes exactly one.

N2 — THE ORDERED SEGMENT SET. Spinal levels, dermatomes, nerve roots, and vertebral levels are ordered anatomically, NOT alphabetically: "C3-C4 / C5-C6 / C7-C8 / C8-T1 / T1-T2". Bracket the correct level above and below, and make each wrong level correspond to a named reasoning error such as an off-by-one root or the wrong myotome for the tested reflex.

N3 — THE DEFICIT-PREDICTION SET. Each option is a complete syndrome description rather than a structure name, and the student localizes and then predicts: "Down-and-out right eye with impaired accommodation / Left-sided motor weakness including the face / Loss of conjugate lateral gaze on the right / Sensory loss over the right side of the face and left side of the body / Vision loss over the left half of each visual field". Crossed findings, sparing patterns, and upper versus lower motor neuron facial involvement are the usual discriminators.

N4 — THE MOLECULAR TARGET SWEEP. Neuro items very often ask for the channel, receptor, transporter, motor protein, or organelle rather than the disease. Ready-made taxonomies: ion channels (calcium, chloride, magnesium, potassium, sodium); receptors (alpha-1 adrenergic, dopaminergic D2, GABA-A, histaminergic H1, muscarinic M1, serotonergic 5-HT2A); motor and structural proteins (dynein, kinesin, lamin, selectin, spectrin, vimentin); anticonvulsant mechanisms (decreases calcium current in thalamic neurons, decreases sodium current in cortical neurons, enhances postsynaptic chloride influx, inhibits presynaptic neurotransmitter release, irreversibly inhibits GABA transaminase); neuromuscular junction lesions (antibodies against a neurotransmitter receptor, antibodies against a presynaptic calcium channel, CD8 lymphocyte-mediated fiber destruction, impaired vesicle fusion).

N5 — THE EMBRYOLOGIC PROCESS SWEEP: neural crest cell migration / notochord formation / prosencephalon division / rostral neuropore closure / caudal neuropore closure / vertebral column fusion. Each failure produces a different, describable malformation.

N6 — THE PERIPHERAL NERVE MECHANISM SWEEP: endoneurial arteriole hyalinization (diabetic microvascular neuropathy) / endoneurial inflammatory infiltrate (inflammatory demyelinating polyneuropathy) / mutation of a myelin protein gene (hereditary neuropathy) / nerve compression within an anatomic tunnel (entrapment) / poor transmission at the neuromuscular junction. This is the mechanism-phrase set applied to nerve disease.

N7 — NEURO ITEM DISCIPLINE:
- About 15% of real neuro items reference an image. You must convert every one of these into described findings: name the vessel, the structure, the imaging pattern, or the smear appearance in words, and make the options named structures or mechanisms rather than lettered regions.
- Cerebrospinal fluid patterns: bacterial meningitis = neutrophil predominance, high protein, low glucose; viral = lymphocyte predominance, normal-to-high protein, normal glucose; fungal and tuberculous = lymphocytes with very low glucose. Route-of-spread items (rule 5) pair naturally with these.
- Stroke items should fix the territory with one crossed or cortical finding rather than with the word "stroke", and time-course asks ("over the next week") pair with the liquefactive necrosis timeline.
- Duration and tempo are decisive: seconds to minutes (seizure, transient ischemic attack, migraine aura), hours (stroke, meningitis), days to weeks (abscess, inflammatory demyelination), months to years (degenerative, neoplastic).

================ BATCH BLUEPRINT ================
Match the mix to the source content first. When the source is a SINGLE BLOCK (one organ system, one micro chapter, one pharmacology chapter), stay inside that block and get variety from the AXIS instead: mechanism, causative agent, predicted finding, confirmatory test, treatment rationale, adverse effect, prevention, and epidemiology are eight different items off one topic. Do not spread a single-block batch across unrelated disciplines to hit percentages.
When the source is broad, aim for: 25-35% mechanism and pathophysiology, 15-20% predicted-finding and time-course items, 15% pharmacology including at least one adverse-effect or drug-interaction item, 10-15% microbiology or immunology when relevant, 10% diagnosis (concentrated in psychiatry and behavioral science), 5-10% study design and epidemiology, and at least 1 communication or ethics item whenever the content touches patient interaction.
Do not use the same correct answer twice in a batch. Where the source supports it, build one deliberate CONTRAST PAIR — two items whose answers are siblings in the same taxonomy separated by a single variable (kidney vs brain infarct; iron deficiency vs anemia of chronic disease; bipolar I vs schizophreniform). UWorld does this constantly and it is the highest-yield structure you can produce.

================ ANSWER KEY CHECK (run after drafting, before output) ================
Options are alphabetized, so the key lands wherever alphabetization puts it — that is correct and expected, and this app additionally reshuffles the choices at run time. Do NOT distort wording or ordering to hit a letter quota. Just verify: (1) list every item's correct letter in order; (2) if one letter is correct for more than half the batch, or the same letter is correct for 4 or more consecutive items, fix it by substituting an equally valid taxonomy member whose alphabetization moves the key — never by changing which option is medically correct, and never by padding an option's wording.

================ ANTI-PATTERNS — never do these ================
- "because of" as the presenting verb. UWorld says "due to".
- Putting the lead-in on its own separate line instead of ending the paragraph with it.
- A batch where most items ask "Which of the following is the most likely diagnosis?" outside psychiatry.
- An explanation with no "Educational objective:" line, or one that describes this patient instead of the general rule.
- wrongExplanations that say "this is incorrect" without naming the condition in which that option IS correct.
- Options in non-alphabetical order without an ordered-series reason.
- Diagnostic label language in the stem ("she is clearly manic", "classic tension pneumothorax") or teaching in the stem ("pathognomonic for", "which is characteristic of"). The exception is the legitimate UWorld device of naming the established diagnosis when the ask is the mechanism.
- Negatively phrased lead-ins ("Which of the following is NOT...", "All of the following EXCEPT").
- Writing a heme or neuro option set as bare disease names when the corpus would have written mechanism phrases.
- Alphabetizing an ordered series (spinal levels, trial phases, gestational ages) instead of leaving it in anatomic or numeric order.
- Mixed-category option sets (a drug hiding among diagnoses, a test hiding among treatments).
- "All of the above", "none of the above", compound options.
- A key identifiable by length, precision, hedging, technical vocabulary, or grammatical agreement.
- Vague durations ("recently", "for a while") when duration matters.
- Explicit negatives that rule out nothing on the option list.
- Two defensible answers. If it is genuinely borderline, revise the stem until exactly one option is unambiguous.
- Any reference to an image, photograph, arrow, graph, curve label, or lettered region on a figure.

================ WORKED EXEMPLARS (original — style reference ONLY, never reuse this content) ================
EXEMPLAR 1 — taxonomy sweep + time-course ask + organ-dependent answer:
Stem: "A 58-year-old man comes to the emergency department due to crushing substernal chest pain that began 3 hours ago. He has hypertension and hyperlipidemia and has smoked a pack of cigarettes daily for 30 years. Blood pressure is 96/60 mm Hg and pulse is 112/min. ECG shows ST-segment elevation in leads V2 through V5, and serum troponin I is elevated. Emergency coronary angiography demonstrates complete occlusion of the proximal left anterior descending artery, and reperfusion is not achieved. If a biopsy of the affected myocardium were obtained 3 days later, which of the following histologic findings would most likely be seen?"
Options (alphabetical): A. Dense collagenous scar with few cells / B. Granulation tissue with prominent neovascularization / C. Preserved myocyte outlines with loss of nuclei and dense neutrophil infiltration / D. Wavy myofibers with contraction band change and no inflammatory cells / E. Well-formed granulomas with multinucleated giant cells. Correct: C.
Architecture: the taxonomy swept is the infarct-healing timeline, and each option is the correct answer at a different time point — under 4 hours (D), 1-3 days (C), 3-14 days (B), over 2 weeks (A) — plus one option from a different process entirely (E). The clincher is the stated 3-day interval; the dramatic decoy is the hypotension and tachycardia, which surface-read toward a mechanical complication.

EXEMPLAR 2 — factorial grid, eight options:
Stem ends: "...Which of the following sets of properties best characterizes the agent most appropriate for this patient?" and the stem carries an aligned header line: "Onset of action | Duration | Reversal agent available".
Options are the eight rows of the 2 x 2 x 2 cross-product, e.g. "A. Rapid, long, no" through "H. Slow, short, yes".
Architecture: every cell is a real agent, so partial knowledge of one column does not carry the item.

EXEMPLAR 3 — communication script set:
Stem: "A 62-year-old woman comes to the office due to fatigue. Six weeks ago she was told she has metastatic pancreatic adenocarcinoma. During the visit she says, 'I have been reading about a clinic in Mexico that cures cancer with vitamin infusions. I want to stop chemotherapy and go there.' The patient has decision-making capacity. Which of the following is the most appropriate initial response by the physician?"
Options are five quoted statements, alphabetized by the first letter inside the quotation mark. The key explores what the patient hopes the alternative treatment will give her before offering any information about it. Each distractor violates exactly one principle: flat refusal (rapport), immediate correction with evidence (premature education), agreeing to stop without exploration (abandoning beneficence), and referring the conversation to oncology (offloading).
Educational objective for this item: "When a patient requests an unproven alternative therapy, the physician should first explore the patient's underlying goals and concerns before providing medical information. Understanding the motivation preserves the therapeutic alliance and allows the physician to address the unmet need directly."

================ QUALITY GATE — run silently on every item before output ================
Stem: opens with age, sex, arrival verb and "due to" · exact duration · single paragraph with the lead-in as its last sentence · 90-130 words for a standard item · observational wording · only the relevant vitals · at least one explicit negative that kills a listed option · every image concept converted to described findings · passes the cover-the-options test.
Ask: one layer away from the diagnosis, unless this is a psychiatry or behavioral diagnosis item · lead-in taken from the inventory shapes.
Options: one taxonomy, fully swept · every distractor passes the sibling test · near sibling, surface read, and adjacent-step roles present · mutually exclusive · exactly one unambiguously correct · median option length short · no length, hedging, or convergence cue · alphabetized · count varied across the batch per the distribution.
Heme items additionally: hematocrit about 3x hemoglobin · MCV matches the described morphology · reticulocyte count agrees with production versus destruction · the hemolysis panel moves as a unit or the outlier is the testing point · iron studies form one coherent row · PT, aPTT, platelets and fibrinogen fit the single disorder chosen · options written as mechanism phrases where the content allows.
Data: every number consistent with every other number · reference ranges only for off-table analytes · morphology described in words.
Explanation: names the diagnosis, walks the mechanism with arrows, then a final line beginning "Educational objective:" that states the general rule in 30-50 words with the exception or contrast.
wrongExplanations: one entry per wrong choice, keyed by actual choice index, each naming where that option IS the right answer plus the finding this patient lacks.
eli5: plain language, maximum 3 sentences, explains the concept not the vignette.
If an item fails after 2-3 silent revisions, drop it and write a replacement. Never ship a failing item and never show the checklist.

Professor-voice notes: clipped exam findings, precise numbers, dense clue-per-sentence prose, no giveaway wording. Reuse heavily emphasized source concepts across fresh vignette surfaces rather than testing a minor detail twice. When the source emphasizes them, lean on: mechanism and enzyme identification, organ-dependent process differences, receptor subtype selectivity, drug interaction and adverse effect pairing, virulence factor and host receptor pairing, described histopathology to diagnosis pairing, duration criteria in psychiatry, and the communication hierarchy in ethics items.

MY CONTENT:
`;
}
function refreshPromptText(){
  var count=getRequestedQuestionCount();
  PROMPT=buildPrompt()+"\n\nPOST-SUBMISSION VIGNETTE HIGHLIGHTS\nFor every question, include a highlights array with 2–5 concise, question-specific notes. Each item must have text (an exact phrase from the visible stem), cat (finding, mechanism, term, pattern, or workup), eyebrow (short category label), title (specific short heading), and body (why that exact clue matters). Use finding for discriminating findings, mechanism for causal steps, term for important definitions, pattern for traps or distinguishing features, and workup for what the question asks. Use only categories relevant to the item. Do not reference answer letters, because choices are shuffled. Do not alter the stem to announce the clue. The quiz reveals these notes only after submission. Example item: {\"text\":\"exact phrase from this stem\",\"cat\":\"finding\",\"eyebrow\":\"DISCRIMINATING FINDING\",\"title\":\"Why this clue matters\",\"body\":\"Explain its specific connection to the answer.\"}.";
  document.getElementById('promptCountChip').textContent='Target: '+count+' question'+(count===1?'':'s');
  document.getElementById('promptText').textContent=PROMPT;
}
function handleQuestionCountInput(){
  refreshPromptText();
}
function handleQuestionCountBlur(){
  normalizeQuestionCountInput();
  refreshPromptText();
}
refreshPromptText();
DOWNLOAD_TEMPLATE=document.documentElement.outerHTML;

function copyPrompt(){
  navigator.clipboard.writeText(PROMPT).then(function(){
    var b=document.getElementById('copyPromptBtn');
    b.textContent='✅ Copied!';
    b.classList.add('ok');
    showToast('Prompt copied! Add your content after it.','ok');
    setTimeout(function(){
      b.textContent='📋 Copy prompt';
      b.classList.remove('ok');
    },2500);
  });
}

// ── PARSE ──
function parseRaw(raw){
  raw=raw.trim().replace(/^```(?:json)?\s*/i,'').replace(/\s*```\s*$/,'').trim();
  try{return JSON.parse(raw);}catch(e){}
  var objectMatch=raw.match(/\{[\s\S]*\}/);
  if(objectMatch){try{return JSON.parse(objectMatch[0]);}catch(e){}}
  var arrayMatch=raw.match(/\[[\s\S]*\]/);
  if(arrayMatch){try{return JSON.parse(arrayMatch[0]);}catch(e){}}
  return null;
}
function shuffle(arr){
  var out=arr.slice();
  for(var i=out.length-1;i>0;i--){
    var j=Math.floor(Math.random()*(i+1));
    var tmp=out[i];
    out[i]=out[j];
    out[j]=tmp;
  }
  return out;
}
function cloneQuestion(q){
  return {
    stem:String(q.stem||''),
    highlights:getQuestionHighlights(q),
    choices:Array.isArray(q.choices)?q.choices.map(String):[],
    correct:typeof q.correct==='number'?q.correct:(parseInt(q.correct,10)||0),
    explanation:String(q.explanation||''),
    wrongExplanations:Object.assign({},q.wrongExplanations||{}),
    eli5:String(q.eli5||''),
    image:q.image?String(q.image):'',
    imageCaption:q.imageCaption?String(q.imageCaption):'',
    explanationImage:q.explanationImage?String(q.explanationImage):'',
    explanationImageCaption:q.explanationImageCaption?String(q.explanationImageCaption):'',
    los:Array.isArray(q.los)?q.los.slice():[]
  };
}
function buildWrongExplanationLookup(rawChoices, rawCorrect, wrongExplanations){
  var lookup={};
  if(!wrongExplanations||typeof wrongExplanations!=='object')return lookup;
  var wrongChoiceIndices=[];
  rawChoices.forEach(function(_,idx){if(idx!==rawCorrect)wrongChoiceIndices.push(idx);});
  var directHits=wrongChoiceIndices.filter(function(idx){return !!wrongExplanations[String(idx)];}).length;
  var orderedHits=wrongChoiceIndices.filter(function(_,orderPos){return !!wrongExplanations[String(orderPos+1)];}).length;
  var useOrdered=orderedHits>directHits;
  wrongChoiceIndices.forEach(function(idx,orderPos){
    var chosenKey=useOrdered?String(orderPos+1):String(idx);
    if(wrongExplanations[chosenKey])lookup[String(idx)]=String(wrongExplanations[chosenKey]);
  });
  return lookup;
}
function randomizeQuestionChoices(q){
  var source=cloneQuestion(q);
  var choiceMeta=source.choices.map(function(choiceText,idx){
    return {
      text:String(choiceText||''),
      isCorrect:idx===source.correct,
      wrongExplanation:idx!==source.correct&&source.wrongExplanations[String(idx)]?String(source.wrongExplanations[String(idx)]):''
    };
  });
  var realChoices=choiceMeta.filter(function(choice){return choice.text.trim();});
  var blankChoices=choiceMeta.filter(function(choice){return !choice.text.trim();});
  var shuffledChoices=shuffle(realChoices).concat(blankChoices);
  var randomized={stem:source.stem,highlights:source.highlights,choices:[],correct:0,explanation:source.explanation,wrongExplanations:{},eli5:source.eli5,image:source.image,imageCaption:source.imageCaption,explanationImage:source.explanationImage,explanationImageCaption:source.explanationImageCaption,los:Array.isArray(source.los)?source.los.slice():[]};
  shuffledChoices.forEach(function(choice,idx){
    randomized.choices.push(choice.text);
    if(choice.isCorrect)randomized.correct=idx;
    else if(choice.text.trim()&&choice.wrongExplanation)randomized.wrongExplanations[String(idx)]=choice.wrongExplanation;
  });
  return randomized;
}
function randomizeQuestionsForSession(list){
  return list.map(function(q){return randomizeQuestionChoices(q);});
}
function normQ(q){
  if(!q.stem||!Array.isArray(q.choices)||q.choices.length<2)return null;
  var allChoices=q.choices.map(String);
  var srcCorrect=typeof q.correct==='number'?q.correct:(parseInt(q.correct)||0);
  if(srcCorrect<0||srcCorrect>=allChoices.length)srcCorrect=0;
  // Resolve the wrong-answer explanations against the ORIGINAL choice indexes first,
  // then remap them, so dropping blanks below cannot shift them onto the wrong option.
  var srcLookup=buildWrongExplanationLookup(allChoices, srcCorrect, q.wrongExplanations);
  // Drop blank/whitespace-only options rather than padding to five — a padded blank
  // renders as an empty clickable answer choice.
  var rawChoices=[];
  var rawLookup={};
  var rawCorrect=-1;
  allChoices.forEach(function(choiceText,idx){
    if(!String(choiceText).trim())return;
    // Never truncate past the key: only stop adding once the key is safely in.
    if(rawChoices.length>=MAX_ANSWER_CHOICES&&rawCorrect>=0)return;
    if(idx===srcCorrect)rawCorrect=rawChoices.length;
    else if(srcLookup[String(idx)])rawLookup[String(rawChoices.length)]=srcLookup[String(idx)];
    rawChoices.push(choiceText);
  });
  if(rawChoices.length<2)return null;
  if(rawCorrect<0||rawCorrect>=rawChoices.length)rawCorrect=0;
  var wrongLookup=rawLookup;
  var nq={stem:String(q.stem),highlights:getQuestionHighlights(q),choices:[],correct:0,explanation:String(q.explanation||''),wrongExplanations:{},eli5:String(q.eli5||''),image:q.image?String(q.image):'',imageCaption:q.imageCaption?String(q.imageCaption):'',explanationImage:q.explanationImage?String(q.explanationImage):'',explanationImageCaption:q.explanationImageCaption?String(q.explanationImageCaption):'',los:Array.isArray(q.los)?q.los.slice():[]};
  rawChoices.forEach(function(choiceText,idx){
    nq.choices.push(choiceText);
    if(idx===rawCorrect)nq.correct=idx;
    else if(wrongLookup[String(idx)])nq.wrongExplanations[String(idx)]=String(wrongLookup[String(idx)]);
  });
  return nq;
}
function getNormalizedQuizPayloadFromRaw(raw){
  var parsed=parseRaw(raw);
  if(!parsed)return null;
  var rawQuestions=Array.isArray(parsed)?parsed:(parsed&&typeof parsed==='object'&&Array.isArray(parsed.questions)?parsed.questions:null);
  if(!rawQuestions)return null;
  var valid=[];
  rawQuestions.forEach(function(q){var nq=normQ(q);if(nq)valid.push(nq);});
  if(!valid.length)return null;
  var parsedName='';
  if(parsed&&typeof parsed==='object'&&!Array.isArray(parsed)){
    parsedName=String(parsed.name||parsed.quizName||parsed.title||'').trim();
  }
  return {name:parsedName,questions:valid};
}
function getNormalizedQuestionsFromRaw(raw){
  var payload=getNormalizedQuizPayloadFromRaw(raw);
  return payload?payload.questions:null;
}
function getPasteAreaIds(){
  return ['pasteArea1','pasteArea2','pasteArea3','pasteArea4'];
}
var activePasteSetTab=1;
function showPasteSetTab(setNumber){
  activePasteSetTab=Math.max(1,Math.min(4,parseInt(setNumber,10)||1));
  syncPasteSetTabs();
}
function syncPasteSetTabs(){
  getPasteAreaIds().forEach(function(id,idx){
    var setNumber=idx+1;
    var tab=document.getElementById('pasteTab'+setNumber);
    var panel=document.getElementById('pastePanel'+setNumber);
    var textarea=document.getElementById(id);
    var isActive=setNumber===activePasteSetTab;
    var hasContent=!!(textarea&&textarea.value.trim());
    if(tab){
      tab.classList.toggle('active',isActive);
      tab.classList.toggle('has-content',hasContent);
      tab.setAttribute('aria-selected',isActive?'true':'false');
    }
    if(panel){
      panel.classList.toggle('active',isActive);
      panel.hidden=!isActive;
    }
  });
}
function getPastedSetEntries(){
  return getPasteAreaIds().map(function(id,idx){
    var el=document.getElementById(id);
    return {id:id,setNumber:idx+1,raw:el?el.value.trim():''};
  }).filter(function(entry){return !!entry.raw;});
}
function getCombinedPastedQuizPayload(){
  var entries=getPastedSetEntries();
  if(!entries.length){
    return {error:'Paste at least one AI response into Set 1, 2, 3, or 4 first.'};
  }
  var combinedQuestions=[];
  var firstParsedName='';
  entries.forEach(function(entry){
    var parsedPayload=getNormalizedQuizPayloadFromRaw(entry.raw);
    if(!parsedPayload){
      throw new Error('__SET_PARSE_ERROR__'+entry.setNumber);
    }
    if(!firstParsedName&&parsedPayload.name)firstParsedName=parsedPayload.name;
    combinedQuestions=combinedQuestions.concat(parsedPayload.questions);
  });
  var typedName=document.getElementById('quizName').value.trim();
  var combinedName=typedName||(
    entries.length>1
      ? (firstParsedName?firstParsedName+' — Combined':'Combined Custom Quiz')
      : (firstParsedName||'Custom Quiz')
  );
  return {payload:{name:combinedName,questions:combinedQuestions}};
}

// ── UI MODE ──
function selectLaunchUI(mode){
  uiMode=mode==='nbme'?'nbme':'classic';
  syncLaunchUIButtons();
}
function switchQuizUI(mode){
  var next=mode==='nbme'?'nbme':'classic';
  if(uiMode===next)return;
  uiMode=next;
  syncLaunchUIButtons();
  if(questions.length){
    switchView(getQuizViewId());
    renderQ();
    showToast(next==='nbme'?'NBME / NBOME layout enabled.':'UNE layout enabled.','ok');
  }
}
function getQuizViewId(){
  return uiMode==='nbme'?'viewQuizNbme':'viewQuiz';
}
function syncLaunchUIButtons(){
  var classicBtn=document.getElementById('uiModeClassicBtn');
  var nbmeBtn=document.getElementById('uiModeNbmeBtn');
  classicBtn.classList.toggle('active',uiMode==='classic');
  nbmeBtn.classList.toggle('active',uiMode==='nbme');
}

// ── LAB VALUES ──
function renderLabs(){
  document.getElementById('labUnitsUs').classList.toggle('active',labUnitMode==='us');
  document.getElementById('labUnitsSi').classList.toggle('active',labUnitMode==='si');
  document.getElementById('labTables').innerHTML=LAB_SECTIONS.map(function(section){
    var rows=section.rows.map(function(row){
      if(row.group)return `<tr class="lab-group"><td colspan="2">${row.group}</td></tr>`;
      return `<tr><td class="${row.name?'':'continuation'}">${row.name||'—'}</td><td>${labUnitMode==='si'?row.si:row.us}</td></tr>`;
    }).join('');
    return `<table class="lab-table"><thead><tr><th>${section.title}</th><th>${labUnitMode==='si'?'SI Reference':'Reference Range'}</th></tr></thead><tbody>${rows}</tbody></table>`;
  }).join('');
}
function openLabs(){
  renderLabs();
  document.getElementById('labModal').classList.add('open');
}
function closeLabs(){
  document.getElementById('labModal').classList.remove('open');
}
function setLabUnits(unit){
  labUnitMode=unit==='si'?'si':'us';
  renderLabs();
}

// ── QUIZ LIFECYCLE ──
function setQuizTitle(name){
  document.title='QUIZ: '+(name||'Custom Quiz');
  document.getElementById('qtName').textContent=name;
  document.getElementById('nbQuizTitle').textContent=name;
}
function getQuizTitle(){
  return document.getElementById('qtName').textContent.trim()||document.getElementById('quizName').value.trim()||'Custom Quiz';
}
function resetQuizState(withTimerReset){
  questionNotes={};
  answers={};
  selected={};
  marked={};
  stemMarkup={};
  choiceMarkup={};
  NC=0;
  NI=0;
  CQ=0;
  examSubmitted=false;
  reviewOpen=false;
  summaryVisible=false;
  finishBannerMinimized=false;
  toolMode='';
  if(withTimerReset)resetTimer();else updTimer();
  syncToolButtons();
  syncModeButtons();
  syncMarkButtons();
  updScore();
}
// ── SESSION PERSISTENCE (resume where you left off) ──
function getSessionKey(){
  var basis=getQuizTitle()+'|'+(questionBank.length?JSON.stringify(questionBank.map(function(q){var clean=Object.assign({},q);delete clean.highlights;return clean;})):'');
  var hash=0;
  for(var i=0;i<basis.length;i++){hash=((hash<<5)-hash+basis.charCodeAt(i))|0;}
  return 'quiz-builder-session-'+Math.abs(hash).toString(36);
}
function saveSession(){
  if(!questions.length||!questionBank.length)return;
  try{
    localStorage.setItem(getSessionKey(),JSON.stringify({
      v:1,questionNotes:questionNotes,questions:questions,selected:selected,answers:answers,marked:marked,
      stemMarkup:stemMarkup,choiceMarkup:choiceMarkup,
      CQ:CQ,NC:NC,NI:NI,quizMode:quizMode,examSubmitted:examSubmitted,
      timerSec:timerSec,timerDisplayMode:timerDisplayMode,uiMode:uiMode
    }));
    return true;
  }catch(e){return false;}
}
function clearSession(){
  try{localStorage.removeItem(getSessionKey());}catch(e){}
}
function tryRestoreSession(){
  var saved=null;
  try{saved=JSON.parse(localStorage.getItem(getSessionKey())||'null');}catch(e){return false;}
  if(!saved||saved.v!==1||!Array.isArray(saved.questions))return false;
  if(saved.questions.length!==questionBank.length)return false;
  var hasProgress=Object.keys(saved.questionNotes||{}).length>0||Object.keys(saved.selected||{}).length>0||Object.keys(saved.answers||{}).length>0||saved.timerSec>0;
  if(!hasProgress)return false;
  questions=saved.questions.map(function(q){return cloneQuestion(q);});
  questionNotes=saved.questionNotes&&typeof saved.questionNotes==='object'?saved.questionNotes:{};
  selected=saved.selected||{};
  answers=saved.answers||{};
  marked=saved.marked||{};
  stemMarkup=saved.stemMarkup||{};
  choiceMarkup=saved.choiceMarkup||{};
  CQ=Math.min(Math.max(0,saved.CQ||0),questions.length-1);
  NC=saved.NC||0;NI=saved.NI||0;
  quizMode=saved.quizMode==='exam'?'exam':'learn';
  examSubmitted=!!saved.examSubmitted;
  timerSec=saved.timerSec||0;
  timerDisplayMode=saved.timerDisplayMode==='remaining'?'remaining':'elapsed';
  timerExpiredHandled=getRemainingSeconds()===0;
  reviewOpen=false;summaryVisible=false;finishBannerMinimized=false;toolMode='';
  syncToolButtons();syncModeButtons();syncMarkButtons();updScore();updTimer();
  return true;
}

// ── FULLSCREEN ──
function toggleFullscreen(){
  var doc=document;
  if(doc.fullscreenElement||doc.webkitFullscreenElement){
    (doc.exitFullscreen||doc.webkitExitFullscreen).call(doc);
  }else{
    var el=doc.documentElement;
    var req=el.requestFullscreen||el.webkitRequestFullscreen;
    if(req)req.call(el);
    else showToast('Fullscreen is not supported in this browser.','err');
  }
}
document.addEventListener('fullscreenchange',function(){
  var btn=document.getElementById('nbFsBtn');
  if(btn)btn.textContent=document.fullscreenElement?'⛶ Exit Fullscreen':'⛶ Fullscreen';
});

function startQuiz(valid,name){
  questionBank=valid.map(function(q){return cloneQuestion(q);});
  document.getElementById('quizName').value=name||'Custom Quiz';
  setQuizTitle(name||'Custom Quiz');
  var restored=tryRestoreSession();
  if(!restored){
    questions=randomizeQuestionsForSession(questionBank);
    quizMode='learn';
    resetQuizState(true);
  }
  applyFontSize();
  document.getElementById('errMsg').className='err-msg';
  renderItemSelectors();
  switchView(getQuizViewId());
  renderQ();
  if(restored)showToast('Previous session restored — press Reset for a fresh attempt.','ok');
}
function getQuizPayload(){
  if(Array.isArray(questionBank)&&questionBank.length){
    return {name:getQuizTitle(),questions:questionBank.map(function(q){return cloneQuestion(q);})};
  }
  try{
    var combinedResult=getCombinedPastedQuizPayload();
    if(!combinedResult||combinedResult.error||!combinedResult.payload)return null;
    return {
      name:combinedResult.payload.name,
      questions:combinedResult.payload.questions.map(function(q){return cloneQuestion(q);})
    };
  }catch(err){
    return null;
  }
}
function buildDownloadFileName(name){
  var safeName=String(name||'Custom Quiz')
    .replace(/\.html?$/i,'')
    .replace(/[<>:"/\\|?*\u0000-\u001f]/g,' ')
    .replace(/\s+/g,' ')
    .trim()
    .replace(/\.+$/,'');
  if(!safeName)safeName='Custom Quiz';
  if(!/\bquiz$/i.test(safeName))safeName+=' Quiz';
  return safeName.slice(0,96)+'.html';
}
function toEmbeddedJSONString(value){
  return JSON.stringify(value).replace(/<\/script/gi,'<\\/script').replace(/\u2028/g,'\\u2028').replace(/\u2029/g,'\\u2029');
}
function buildDownloadHTML(payload){
  var title=document.createElement('title');
  title.textContent='QUIZ: '+(payload.name||'Custom Quiz');
  return DOWNLOAD_TEMPLATE
    .replace(/(<div class="view) active(" id="viewSetup">)/,'$1$2')
    .replace(/<title>[^<]*<\/title>/i,function(){return title.outerHTML;})
    .replace(/^var PRELOADED_QUIZ_NAME=[^\r\n]*;/m,function(){return 'var PRELOADED_QUIZ_NAME='+toEmbeddedJSONString(payload.name||'Custom Quiz')+';';})
    .replace(/^var PRELOADED_QUESTIONS_JSON=[^\r\n]*;/m,function(){return 'var PRELOADED_QUESTIONS_JSON='+toEmbeddedJSONString(JSON.stringify(payload.questions||[]))+';';})
    .replace(/^var PRELOADED_UI_MODE=[^\r\n]*;/m,function(){return 'var PRELOADED_UI_MODE='+toEmbeddedJSONString('nbme')+';';});
}
function triggerQuizDownload(blob,fileName){
  var url=URL.createObjectURL(blob);
  var a=document.createElement('a');
  a.href=url;
  a.download=fileName;
  document.body.appendChild(a);
  a.click();
  document.body.removeChild(a);
  setTimeout(function(){URL.revokeObjectURL(url);},1000);
}
function isSafariLikeBrowser(){
  var ua=navigator.userAgent||'';
  return /Safari/i.test(ua)&&!/Chrome|Chromium|CriOS|Edg|OPR|Firefox|FxiOS|Android/i.test(ua);
}
function getDownloadFallbackPrompt(fileName){
  if(isSafariLikeBrowser()){
    return 'This browser cannot open a save-location picker from this local quiz page, so Safari will use its normal download flow instead.\n\nIf you want macOS to ask where to save each quiz, open Safari > Settings > General and set "File download location" to "Ask for each download".\n\nDownload "'+fileName+'" now?';
  }
  return 'This browser does not support choosing a save location directly from this quiz page.\n\nI can still download "'+fileName+'" using your browser\'s normal download flow.\n\nContinue?';
}
async function downloadQuiz(){
  var payload=getQuizPayload();
  if(!payload){
    showErr('Paste a valid quiz first so I have something to save.');
    return;
  }
  var html=buildDownloadHTML(payload);
  var blob=new Blob([html],{type:'text/html'});
  var fileName=buildDownloadFileName(payload.name);
  if(typeof window.showSaveFilePicker==='function'){
    try{
      var handle=await window.showSaveFilePicker({
        suggestedName:fileName,
        types:[{
          description:'HTML Quiz File',
          accept:{'text/html':['.html']}
        }]
      });
      var writable=await handle.createWritable();
      await writable.write(blob);
      await writable.close();
      document.getElementById('errMsg').className='err-msg';
      showToast('Saved your quiz file.','ok');
      return;
    }catch(err){
      if(err&&err.name==='AbortError')return;
    }
  }
  if(!window.confirm(getDownloadFallbackPrompt(fileName)))return;
  triggerQuizDownload(blob,fileName);
  document.getElementById('errMsg').className='err-msg';
  showToast(isSafariLikeBrowser()?'Safari download started. Use "Ask for each download" in Safari settings to choose the save location each time.':'Browser download started.','ok');
}
function hydratePreloadedQuiz(){
  var hasPreloadedQuestions=PRELOADED_QUESTIONS_JSON!=="__QUIZ_BUILDER_PRELOADED_QUESTIONS__";
  if(PRELOADED_UI_MODE!=="__QUIZ_BUILDER_PRELOADED_UI_MODE__")selectLaunchUI(PRELOADED_UI_MODE);
  else if(hasPreloadedQuestions)selectLaunchUI('nbme');
  if(PRELOADED_QUIZ_NAME!=="__QUIZ_BUILDER_PRELOADED_NAME__")document.getElementById('quizName').value=PRELOADED_QUIZ_NAME;
  if(PRELOADED_QUESTIONS_JSON==="__QUIZ_BUILDER_PRELOADED_QUESTIONS__")return;
  try{
    var preloaded=JSON.parse(PRELOADED_QUESTIONS_JSON);
    if(!Array.isArray(preloaded)||!preloaded.length)throw new Error('Empty saved quiz');
    document.getElementById('pasteArea1').value=JSON.stringify(preloaded,null,2);
    showPasteSetTab(1);
    startQuiz(preloaded,PRELOADED_QUIZ_NAME||'Custom Quiz');
    showToast('Saved quiz loaded.','ok');
  }catch(e){
    switchView('viewSetup');
    showErr('This saved quiz could not be loaded. Paste the questions below to try again.');
  }
}
function launchQuiz(){
  try{
    var combinedResult=getCombinedPastedQuizPayload();
    if(combinedResult.error){showErr(combinedResult.error);return;}
    startQuiz(combinedResult.payload.questions,combinedResult.payload.name);
  }catch(err){
    if(err&&typeof err.message==='string'&&err.message.indexOf('__SET_PARSE_ERROR__')===0){
      var setNumber=err.message.replace('__SET_PARSE_ERROR__','');
      showPasteSetTab(Number(setNumber));
      showErr("Couldn't read Set "+setNumber+". Make sure you copied the full AI response for that set.");
      return;
    }
    showErr("Couldn't read the pasted sets. Make sure each AI response is complete JSON in the expected format.");
  }
}

// ══ KEY FINDINGS — vignette highlights, revealed once a question is submitted ══
var VH_CATS=['finding','mechanism','term','pattern','workup'];
var VH_CAT_LABELS={finding:'Discriminating finding',mechanism:'Mechanism',term:'Key term',pattern:'Pattern / trap',workup:'What is being asked'};
var activeVhHighlights=[],vhLastFocus=null;
function sanitizeHighlights(list){
  if(!Array.isArray(list))return [];
  return list.filter(function(h){return h&&h.text&&h.body;}).map(function(h){
    return {text:String(h.text),cat:VH_CATS.indexOf(h.cat)>=0?h.cat:'finding',eyebrow:String(h.eyebrow||'KEY FINDING'),title:String(h.title||'Why it matters'),body:String(h.body)};
  });
}
function getQuestionHighlights(q){
  if(Array.isArray(q.highlights))return sanitizeHighlights(q.highlights);
  // Older saved attempts have no highlights. Recover metadata by stem without changing order or answers.
  var bank=typeof questionBank!=='undefined'&&questionBank;
  if(bank){for(var i=0;i<bank.length;i++){if(bank[i].stem===q.stem&&bank[i].highlights)return sanitizeHighlights(bank[i].highlights);}}
  return [];
}
function questionIsSubmitted(index){return !!answers[index];}
function getStemHTMLForDisplay(index){
  var base=stripVhMarks(getStemHTML(index)),q=questions[index];
  activeVhHighlights=[];
  if(!questionIsSubmitted(index)||!q||!q.highlights||!q.highlights.length)return base;
  var root=document.createElement('div');root.innerHTML=base;
  q.highlights.forEach(function(h){
    if(markPhraseInElement(root,h,activeVhHighlights.length))activeVhHighlights.push(h);
  });
  return root.innerHTML;
}
function vhTextMap(root){
  var text='',map=[];
  function addSpace(){if(text&&!/\s$/.test(text)){text+=' ';map.push(null);}}
  function visit(el){
    if(el.nodeType===Node.TEXT_NODE){
      for(var j=0;j<el.nodeValue.length;j++){
        var c=el.nodeValue[j];
        if(/\s/.test(c)){addSpace();continue;}
        text+=c;map.push({node:el,offset:j});
      }
    }else if(el.nodeType===Node.ELEMENT_NODE){
      if(/^(BR|P|DIV|TR|TD|TH|LI|TABLE|UL|OL)$/.test(el.tagName))addSpace();
      Array.from(el.childNodes).forEach(visit);
      if(/^(BR|P|DIV|TR|TD|TH|LI|TABLE|UL|OL)$/.test(el.tagName))addSpace();
    }
  }
  visit(root);return {text:text,map:map};
}
function markPhraseInElement(root,h,idx){
  var flat=vhTextMap(root),phrase=h.text.replace(/\s+/g,' ').trim(),pos=flat.text.indexOf(phrase);
  while(pos>=0){
    var covered=flat.map.slice(pos,pos+phrase.length).filter(Boolean);
    if(covered.length&&!covered.some(function(p){return p.node.parentElement.closest('mark.vh');})){
      var segments=[];
      covered.forEach(function(p){
        var last=segments[segments.length-1];
        if(last&&last.node===p.node)last.end=p.offset+1;
        else segments.push({node:p.node,start:p.offset,end:p.offset+1});
      });
      segments.reverse().forEach(function(s){
        var mid=s.node.splitText(s.start);mid.splitText(s.end-s.start);
        var mark=document.createElement('mark');mark.className='vh vh-cat-'+h.cat;
        mark.setAttribute('data-vh-idx',String(idx));mark.setAttribute('tabindex','0');mark.setAttribute('role','button');
        mark.setAttribute('aria-label',VH_CAT_LABELS[h.cat]+': '+h.title);
        mark.setAttribute('aria-controls','vhPanel');mark.setAttribute('aria-haspopup','dialog');
        mid.parentNode.replaceChild(mark,mid);mark.appendChild(mid);
      });
      return true;
    }
    pos=flat.text.indexOf(phrase,pos+phrase.length);
  }
  return false;
}
function buildVhLegendHTML(index){
  if(!questionIsSubmitted(index)||!activeVhHighlights.length)return '';
  var used=VH_CATS.filter(function(cat){return activeVhHighlights.some(function(h){return h.cat===cat;});});
  var colors={finding:'coral',mechanism:'teal',term:'gold',pattern:'violet',workup:'sky'};
  return '<div class="vh-legend"><span class="vh-legend-label">How to tackle it</span>'+used.map(function(cat){
    return '<span class="vh-legend-item"><span class="vh-legend-dot" style="background:var(--vh-'+colors[cat]+'-bg);border:1.5px solid var(--vh-'+colors[cat]+')"></span>'+VH_CAT_LABELS[cat]+'</span>';
  }).join('')+'<span class="vh-legend-hint">Hover or tap a highlight for why it matters.</span></div>';
}
function stripVhMarks(html){
  if(String(html).indexOf('data-vh-idx')<0)return html;
  var root=document.createElement('div');root.innerHTML=html;
  root.querySelectorAll('mark.vh').forEach(function(mark){while(mark.firstChild)mark.parentNode.insertBefore(mark.firstChild,mark);mark.remove();});
  root.normalize();return root.innerHTML;
}
function vhEscape(text){return String(text||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');}
function showVhTooltip(mark){
  var h=activeVhHighlights[+mark.getAttribute('data-vh-idx')],tip=document.getElementById('vhTooltip');
  if(!h||!tip)return;
  var teaser=h.body.length>160?h.body.slice(0,160).replace(/\s+\S*$/,'')+'…':h.body;
  tip.innerHTML='<div class="vht-eyebrow">'+vhEscape(h.eyebrow)+'</div><div class="vht-title">'+vhEscape(h.title)+'</div><div class="vht-teaser">'+vhEscape(teaser)+'</div>';
  tip.classList.add('show');
  var rect=mark.getBoundingClientRect(),width=tip.offsetWidth;
  tip.style.left=Math.max(8,Math.min(rect.left,window.innerWidth-width-8))+'px';
  var top=rect.bottom+8;if(top+tip.offsetHeight>window.innerHeight-8)top=rect.top-tip.offsetHeight-8;
  tip.style.top=Math.max(8,top)+'px';
}
function hideVhTooltip(){var tip=document.getElementById('vhTooltip');if(tip)tip.classList.remove('show');}
function openVhPanel(mark){
  var h=activeVhHighlights[+mark.getAttribute('data-vh-idx')],panel=document.getElementById('vhPanel');
  if(!h||!panel)return;
  hideVhTooltip();vhLastFocus=mark;
  panel.className='vh-panel open vh-panel-'+h.cat;panel.setAttribute('aria-hidden','false');
  document.getElementById('vhPanelEyebrow').textContent=h.eyebrow;
  document.getElementById('vhPanelTitle').textContent=h.title;
  document.getElementById('vhPanelBody').textContent=h.body;
  panel.querySelector('button').focus({preventScroll:true});
}
function closeVhPanel(){
  var panel=document.getElementById('vhPanel');
  if(panel){var hadFocus=panel.contains(document.activeElement);panel.classList.remove('open');panel.setAttribute('aria-hidden','true');if(hadFocus&&vhLastFocus&&vhLastFocus.isConnected)vhLastFocus.focus({preventScroll:true});}
  vhLastFocus=null;
}
document.addEventListener('mouseover',function(e){var mark=e.target.closest&&e.target.closest('mark.vh');if(mark&&window.matchMedia('(hover: hover)').matches)showVhTooltip(mark);});
document.addEventListener('mouseout',function(e){if(e.target.closest&&e.target.closest('mark.vh'))hideVhTooltip();});
document.addEventListener('focusin',function(e){var mark=e.target.closest&&e.target.closest('mark.vh');if(mark)showVhTooltip(mark);});
document.addEventListener('focusout',hideVhTooltip);
document.addEventListener('scroll',hideVhTooltip,true);
document.addEventListener('click',function(e){
  var mark=e.target.closest&&e.target.closest('mark.vh');
  if(mark){if(!toolMode&&window.getSelection().isCollapsed)openVhPanel(mark);return;}
  if(!e.target.closest('#vhPanel'))closeVhPanel();
});
document.addEventListener('keydown',function(e){
  var mark=e.target.closest&&e.target.closest('mark.vh');
  if(mark&&(e.key==='Enter'||e.key===' ')){e.preventDefault();e.stopPropagation();openVhPanel(mark);}
  if(e.key==='Escape'){closeVhPanel();hideVhTooltip();}
});

// ── STATE HELPERS ──
function stripChoiceLabel(text){
  return String(text||'').replace(/^[A-H]\.\s*/i,'');
}
function choiceLetter(index){
  return LETTERS[index]||String.fromCharCode(65+index);
}
var QUIZ_FIGURES={"fig_aplastic": "data:image/jpeg;base64,", "fig_cytokines": "data:image/jpeg;base64,", "fig_hematopoiesis": "data:image/jpeg;base64,", "fig_retics": "data:image/jpeg;base64,", "fig_sideroblast": "data:image/jpeg;base64,", "fig_b12_absorption": "data:image/jpeg;base64,", "fig_b12_def_uw": "data:image/jpeg;base64,", "fig_celiac_duodenum": "data:image/jpeg;base64,", "fig_hepcidin": "data:image/jpeg;base64,", "fig_hyperseg": "data:image/jpeg;base64,", "fig_hyperseg_uw": "data:image/jpeg;base64,", "fig_ida_progression": "data:image/jpeg;base64,", "fig_ida_smear": "data:image/jpeg;base64,", "fig_ida_smear_uw": "data:image/jpeg;base64,", "fig_intestinal_absorption": "data:image/jpeg;base64,", "fig_megaloblastic_marrow": "data:image/jpeg;base64,", "fig_mtx_pathway": "data:image/jpeg;base64,", "fig_parvo_pronormoblast": "data:image/jpeg;base64,", "fig_spherocytes": "data:image/jpeg;base64,", "fig_aiha": "data:image/jpeg;base64,", "fig_beta_thal_uw": "data:image/jpeg;base64,", "fig_bite_cells": "data:image/jpeg;base64,", "fig_bite_uw": "data:image/jpeg;base64,", "fig_electrophoresis": "data:image/jpeg;base64,", "fig_g6pd_pathway": "data:image/jpeg;base64,", "fig_globin_chains": "data:image/jpeg;base64,", "fig_heinz": "data:image/jpeg;base64,", "fig_howell_jolly": "data:image/jpeg;base64,", "fig_schistocytes": "data:image/jpeg;base64,", "fig_sickle_smear": "data:image/jpeg;base64,", "fig_sickle_target": "data:image/jpeg;base64,", "fig_spherocytes_uw": "data:image/jpeg;base64,", "fig_target_cells": "data:image/jpeg;base64,", "fig_bilirubin": "data:image/jpeg;base64,", "fig_hair_on_end": "data:image/jpeg;base64,", "fig_pigment_stones": "data:image/jpeg;base64,", "fig_sickle_mutation": "data:image/jpeg;base64,", "fig_thal_minor_uw": "data:image/jpeg;base64,", "fig_abo": "data:image/jpeg;base64,", "fig_o_neg_compat": "data:image/jpeg;base64,", "fig_rh_pregnancy": "data:image/jpeg;base64,", "fig_tx_reactions": "data:image/jpeg;base64,", "fig_tx_timeline": "data:image/jpeg;base64,", "fig_heparin_mech_uw": "data:image/jpeg;base64,", "fig_slide_anticoag_classes": "data:image/jpeg;base64,", "fig_slide_cyp2c9": "data:image/jpeg;base64,", "fig_slide_fibrinolysis": "data:image/jpeg;base64,", "fig_slide_hit": "data:image/jpeg;base64,", "fig_slide_hit_mgmt": "data:image/jpeg;base64,", "fig_slide_kp_antiplatelet": "data:image/jpeg;base64,", "fig_slide_platelet": "data:image/jpeg;base64,", "fig_slide_vitk": "data:image/jpeg;base64,", "fig_slide_warf_onset": "data:image/jpeg;base64,", "fig_slide_xaban_reversal": "data:image/jpeg;base64,", "fig_warfarin_necrosis": "data:image/jpeg;base64,", "fig_slide_heparin_ae": "data:image/jpeg;base64,", "fig_slide_kp_thrombolytic": "data:image/jpeg;base64,", "fig_slide_b12_tree": "data:image/jpeg;base64,", "fig_slide_erythropoiesis": "data:image/jpeg;base64,", "fig_slide_esa_ae": "data:image/jpeg;base64,", "fig_slide_esa_initiate": "data:image/jpeg;base64,", "fig_slide_folate": "data:image/jpeg;base64,", "fig_slide_ida_tree": "data:image/jpeg;base64,", "fig_slide_iron_ae": "data:image/jpeg;base64,", "fig_slide_iron_toxicity": "data:image/jpeg;base64,", "fig_slide_vadadustat": "data:image/jpeg;base64,", "fig_slide_sickle_complications": "data:image/jpeg;base64,"};
function renderFigure(key,caption,cls){
  var src=QUIZ_FIGURES[key];
  if(!src)return '';
  var cap=caption?'<figcaption class="qfig-cap">'+escapeStudyText(caption)+'</figcaption>':'';
  return '<figure class="'+cls+'"><img src="'+src+'" alt="'+escapeStudyText(caption||'Figure')+'">'+cap+'</figure>';
}
var LO_REVIEW_FILE='OMK_2A_Heme_Summative_3_Objective_Review.html';
function loBlockHTML(q){
  var los=(q&&Array.isArray(q.los))?q.los:[];
  if(!los.length)return '';
  var rows=los.map(function(lo){
    var href=LO_REVIEW_FILE+(lo.a?('#'+lo.a):'');
    var sec=lo.s?'<span class="lo-sec">'+escapeStudyText(lo.s)+'</span>':'';
    return '<div class="lo-row"><a class="lo-chip" href="'+href+'" target="_blank" rel="noopener">LO '+escapeStudyText(lo.n)+'</a>'+
           '<span class="lo-text">'+escapeStudyText(lo.t)+sec+'</span></div>';
  }).join('');
  return '<div class="exs exlo"><div class="exl">\uD83C\uDFAF Learning Objective'+(los.length>1?'s':'')+' tested</div><div class="ext">'+rows+'</div></div>';
}
function buildFigureHTML(index){
  var q=questions[index];
  if(!q||!q.image)return '';
  return renderFigure(q.image,q.imageCaption,'qfig'+(q.image.indexOf('img_')===0?' photo':''));
}
function buildExplanationFigureHTML(q){
  if(!q||!q.explanationImage)return '';
  return renderFigure(q.explanationImage,q.explanationImageCaption,'qfig exfig');
}
function escapeStemText(value){
  return String(value==null?'':value)
    .replace(/&/g,'&amp;')
    .replace(/</g,'&lt;')
    .replace(/>/g,'&gt;');
}
var TYPICAL_LAB_RANGES={
  'absolute lymphocyte count':'Age-dependent',
  'absolute neutrophil count':'>1,500/mm³',
  'activated partial thromboplastin time':'25–35 sec',
  'antithrombin activity':'80–120%',
  'alanine aminotransferase':'0–35 U/L',
  'anion gap':'8–12 mEq/L',
  'arterial ph':'7.38–7.44',
  'aspartate aminotransferase':'0–35 U/L',
  'band forms':'0–3%',
  'basophils':'0.5–1%',
  'blasts':'0%',
  'blood urea nitrogen':'8–20 mg/dL',
  'c-reactive protein':'0–0.8 mg/dL',
  'd-dimer':'<0.5 µg/mL FEU',
  'direct bilirubin':'0–0.3 mg/dL',
  'eosinophils':'1–4%',
  'erythrocyte count':'4.2–5.9 million/mm³ (adult; sex-dependent)',
  'erythrocyte sedimentation rate':'M: 0–15; F: 0–20 mm/h',
  'factor viii activity':'50–150%',
  'factor v leiden':'Not detected',
  'fasting serum glucose':'70–99 mg/dL',
  'fibrinogen':'200–400 mg/dL',
  'haptoglobin':'30–200 mg/dL',
  'hematocrit':'M: 41–51%; F: 36–47% (adult)',
  'hemoglobin':'M: 14–17; F: 12–16 g/dL (adult)',
  'international normalized ratio':'0.8–1.2',
  'immature blasts':'0%',
  'ionized calcium':'1.10–1.30 mmol/L',
  'lactate dehydrogenase':'140–280 U/L (laboratory-dependent)',
  'leukocyte count':'4,000–10,000/mm³',
  'lymphocytes':'20–40% (adult; age-dependent)',
  'mean corpuscular hemoglobin conc.':'32–36 g/dL',
  'mean corpuscular hemoglobin concentration':'32–36 g/dL',
  'mean corpuscular volume':'80–100 fL',
  'metamyelocytes':'0%',
  'methylmalonic acid':'0.00–0.40 µmol/L (assay-dependent)',
  'monocytes':'2–8%',
  'myelocytes':'0%',
  'neutrophils':'40–60%',
  'pco2':'35–45 mm Hg',
  'platelet count':'150,000–450,000/mm³',
  'platelet count, on admission':'150,000–450,000/mm³',
  'platelet count, today':'150,000–450,000/mm³',
  'promyelocytes':'0%',
  'prothrombin gene mutation':'Not detected',
  'protein c activity':'70–140%',
  'protein s activity':'65–140%',
  'prothrombin time':'11–14 sec',
  'red cell distribution width':'11.5–14.5%',
  'reticulocyte count':'0.5–1.5%',
  'reticulocytes':'0.5–1.5%',
  'segmented neutrophils':'40–60%',
  'serum albumin':'3.5–5.5 g/dL',
  'serum bicarbonate':'23–28 mEq/L',
  'serum calcium':'9.0–10.5 mg/dL',
  'serum cobalamin':'200–900 pg/mL',
  'serum creatinine':'0.7–1.3 mg/dL (adult; sex-dependent)',
  'serum erythropoietin':'4–24 mU/mL',
  'serum ferritin':'15–200 ng/mL',
  'serum folate':'4–20 ng/mL',
  'serum glucose':'70–140 mg/dL (timing-dependent)',
  'serum igg, iga, and igm':'Age-dependent',
  'serum iron':'60–160 µg/dL',
  'serum lactate':'0.5–2.2 mmol/L',
  'serum methotrexate':'Time since infusion-dependent',
  'serum phosphorus':'3.0–4.5 mg/dL',
  'serum potassium':'3.5–5.0 mEq/L',
  'serum total protein':'6.0–7.8 g/dL',
  'serum uric acid':'M: 3.7–8.6; F: 2.4–5.8 mg/dL',
  'serum vitamin b12':'200–900 pg/mL',
  'homocysteine':'5–13 µmol/L',
  'creatinine clearance':'90–120 mL/min (adult; age/sex-dependent)',
  'tissue transglutaminase iga':'Negative (assay-dependent)',
  'total bilirubin':'0.3–1.2 mg/dL',
  'total iron-binding capacity':'250–460 µg/dL',
  'transferrin saturation':'20–50%',
  'urea nitrogen':'8–20 mg/dL',
  'urine protein':'Negative to trace',
  'von willebrand factor antigen':'50–150%',
  'von willebrand factor ristocetin cofactor':'50–150%'
};
function inferLabUnit(value){
  var match=String(value||'').match(/[-+]?\d[\d,.]*\s*([%a-zA-Zµμ]+(?:\/[a-zA-Z0-9µμ³^]+)?)/);
  return match?match[1]:'';
}
function getLabResultAndReference(name,value){
  var result=String(value||'').trim();
  var explicit=result.match(/\s*\((?:N\s*=?|normal\s*:?)\s*([^)]+)\)\s*$/i);
  var reference='';
  if(explicit){
    reference=explicit[1].trim();
    result=result.slice(0,explicit.index).trim();
    if(!/[a-zA-Z%µμ]/.test(reference)){
      var unit=inferLabUnit(result);
      if(unit)reference+=(unit==='%'?'':' ')+unit;
    }
  }else{
    reference=TYPICAL_LAB_RANGES[String(name||'').trim().toLowerCase()]||'Laboratory-specific';
  }
  return {value:result,reference:reference};
}
function parseStructuredStemRow(line){
  var match=String(line||'').trim().match(/^(.+?)\s{2,}(\S.*)$/);
  if(!match)return null;
  var details=getLabResultAndReference(match[1],match[2]);
  return {name:match[1],value:details.value,reference:details.reference};
}
function formatStemText(stem){
  var lines=String(stem||'').replace(/\r\n?/g,'\n').split('\n');
  var output=[];
  for(var i=0;i<lines.length;){
    if(/^\s{2,}\S/.test(lines[i])){
      var end=i;
      while(end<lines.length&&/^\s{2,}\S/.test(lines[end]))end++;
      var rows=lines.slice(i,end).map(parseStructuredStemRow);
      if(rows.length>=2&&rows.every(Boolean)){
        output.push('<div class="lab-panel" role="table" aria-label="Laboratory results"><div class="lab-head" role="row"><span role="columnheader">Test</span><span role="columnheader">Result</span><span role="columnheader">Reference range</span></div>'+rows.map(function(row){
          return '<div class="lab-row" role="row"><span class="lab-name" role="cell">'+escapeStemText(row.name)+'</span><span class="lab-value" role="cell">'+escapeStemText(row.value)+'</span><span class="lab-reference" role="cell">'+escapeStemText(row.reference)+'</span></div>';
        }).join('')+'<div class="lab-note">Typical educational ranges are shown. Actual reference intervals vary by laboratory, age, sex, and clinical context.</div></div>');
        i=end;
        continue;
      }
    }
    output.push(escapeStemText(lines[i]));
    i++;
  }
  return output.join('<br>');
}
function getStemHTML(index){
  return stemMarkup[index]!=null?stemMarkup[index]:formatStemText(questions[index].stem);
}
function ensureChoiceMarkup(index){
  if(!choiceMarkup[index])choiceMarkup[index]=[];
  return choiceMarkup[index];
}
function getChoiceHTML(index,choiceIndex){
  var arr=ensureChoiceMarkup(index);
  return arr[choiceIndex]!=null?arr[choiceIndex]:stripChoiceLabel(questions[index].choices[choiceIndex]);
}
function getSelectedChoice(index){
  if(answers[index]&&answers[index].s!==null&&answers[index].s!==undefined)return answers[index].s;
  return selected[index];
}
function getAnsweredCount(){
  return examSubmitted?questions.length:(quizMode==='exam'?Object.keys(selected).length:Object.keys(answers).length);
}
function getMarkedCount(){
  return Object.keys(marked).filter(function(key){return !!marked[key];}).length;
}
function isQuizComplete(){
  return (quizMode==='learn'&&questions.length&&Object.keys(answers).length===questions.length)||(quizMode==='exam'&&examSubmitted);
}
function updateScoreCounts(){
  NC=0;
  NI=0;
  Object.keys(answers).forEach(function(key){
    if(answers[key].r==='c')NC++;
    else NI++;
  });
}
function getScorePercent(){
  var denom=(quizMode==='exam'&&examSubmitted)?questions.length:(NC+NI);
  return denom?Math.round(NC/denom*100):'—';
}
function getAnswerStateMeta(ans){
  if(!ans)return {label:'Pending',className:'unanswered'};
  if(ans.r==='c')return {label:'Correct',className:'correct'};
  if(ans.r==='u')return {label:'No Answer',className:'unanswered'};
  return {label:'Incorrect',className:'incorrect'};
}
function buildSummaryStatsHTML(){
  var percent=getScorePercent();
  return `<div class="sum-stats">
    <div class="sum-stat"><div class="sum-stat-label">Score</div><div class="sum-stat-value">${percent==='—'?'—':percent+'%'}</div></div>
    <div class="sum-stat"><div class="sum-stat-label">Correct</div><div class="sum-stat-value">${NC}</div></div>
    <div class="sum-stat"><div class="sum-stat-label">Incorrect</div><div class="sum-stat-value">${NI}</div></div>
    <div class="sum-stat"><div class="sum-stat-label">Questions</div><div class="sum-stat-value">${questions.length}</div></div>
  </div>`;
}
function buildReviewSheetItemsHTML(){
  return questions.map(function(q,index){
    var ans=answers[index];
    var meta=getAnswerStateMeta(ans);
    var correctLetter=choiceLetter(q.correct);
    return `<article class="sum-item ${meta.className}">
      <div class="sum-meta">
        <div class="sum-num">Question ${index+1}</div>
        <div class="sum-state">${meta.label}</div>
        <div class="sum-answer">Correct Answer: ${correctLetter}</div>
      </div>
      <div class="sum-body">
        <div class="sum-section"><div class="sum-label">Question</div><div class="sum-text">${q.stem}</div></div>
        <div class="sum-section"><div class="sum-label">Answer choices</div><div class="sum-text">${q.choices.map(function(choice,ci){return '<div>'+choiceLetter(ci)+'. '+stripChoiceLabel(choice)+(ci===q.correct?' <strong>(Correct)</strong>':'')+'</div>';}).join('')}</div></div>
        ${questionNotes[index]?'<div class="sum-section"><div class="sum-label">My notes</div><div class="sum-text study-notes-text">'+escapeStudyText(questionNotes[index])+'</div></div>':''}
        <div class="sum-section">
          <div class="sum-label">Correct Answer Explanation</div>
          <div class="sum-text">${q.explanation||'No explanation provided.'}</div>
        </div>
        <div class="sum-section">
          <div class="sum-label">ELI5</div>
          <div class="sum-text">${q.eli5||'No ELI5 summary provided.'}</div>
        </div>
      </div>
    </article>`;
  }).join('');
}
function buildReviewSheetHTML(forPrint){
  var title=getQuizTitle();
  var actionHTML=forPrint?'':`<div class="sum-actions"><button class="sum-btn" type="button" onclick="hideSummarySheet()">← Back to Questions</button><button class="sum-btn primary" type="button" onclick="printSummarySheet()">🖨 Print / Save PDF</button><button class="sum-btn" type="button" onclick="exportSummarySheet()">Export Summary</button></div>`;
  return `<section class="sum-sheet" id="summarySheet">
    <div class="sum-head">
      <div>
        <div class="sum-kicker">Quiz Review Sheet</div>
        <h2 class="sum-title">${title}</h2>
        <div class="sum-sub">Question-by-question review with questions, answer choices, personal notes, correct-answer explanations, and ELI5 summaries.</div>
      </div>
      ${actionHTML}
    </div>
    ${buildSummaryStatsHTML()}
    <div class="sum-list">${buildReviewSheetItemsHTML()}</div>
  </section>`;
}
function getSummaryPrintStyles(){
  return `
    .study-notes-text{white-space:pre-wrap;overflow-wrap:anywhere}img{max-width:100%;height:auto}
    .qfig{margin:12px 0;break-inside:avoid}.qfig img{width:100%;height:auto}.qfig-cap{font-size:12px;color:#555}
    body{margin:0;padding:28px;background:#fff;color:#1E1E20;font-family:Arial,Helvetica,sans-serif}
    .sum-sheet{border:1px solid #d8dce3;border-radius:18px;overflow:hidden}
    .sum-head{display:flex;align-items:flex-start;justify-content:space-between;gap:18px;padding:22px 24px 18px;border-bottom:1px solid #e4e7ec;background:#f8fafc}
    .sum-kicker{font-family:Consolas,monospace;font-size:11px;font-weight:700;letter-spacing:1.6px;text-transform:uppercase;color:#6B7689;margin-bottom:8px}
    .sum-title{font-size:30px;line-height:1.08;color:#12203C;margin:0 0 8px}
    .sum-sub{font-size:14px;line-height:1.6;color:#3E4555;max-width:68ch}
    .sum-stats{display:flex;gap:12px;flex-wrap:wrap;padding:18px 24px;border-bottom:1px solid #e4e7ec;background:#fbf8f3}
    .sum-stat{min-width:140px;padding:14px 16px;border-radius:14px;border:1px solid #e4e7ec;background:#fff}
    .sum-stat-label{font-size:10px;font-weight:800;letter-spacing:1.4px;text-transform:uppercase;color:#6B7689;margin-bottom:8px}
    .sum-stat-value{font-size:30px;line-height:1;color:#12203C;font-weight:700}
    .sum-list{display:grid;gap:14px;padding:22px 24px}
    .sum-item{display:grid;grid-template-columns:150px minmax(0,1fr);gap:18px;padding:18px;border-radius:16px;border:1px solid #e4e7ec;background:#fff;break-inside:avoid-page;page-break-inside:avoid}
    .sum-item.correct{background:#f6fcf8}
    .sum-item.incorrect{background:#fff8f8}
    .sum-item.unanswered{background:#fffaf1}
    .sum-meta{display:flex;flex-direction:column;gap:10px}
    .sum-num,.sum-state{display:inline-flex;align-items:center;justify-content:center;width:max-content}
    .sum-num{min-height:38px;padding:0 14px;border-radius:999px;background:#eef2f6;font-family:Consolas,monospace;font-size:12px;font-weight:800;letter-spacing:1.2px;text-transform:uppercase;color:#12203C}
    .sum-state{min-height:30px;padding:0 12px;border-radius:999px;font-size:12px;font-weight:900;letter-spacing:.08em;text-transform:uppercase}
    .sum-item.correct .sum-state{background:#E8F5EE;color:#2D8659}
    .sum-item.incorrect .sum-state{background:#FDF0F0;color:#C44040}
    .sum-item.unanswered .sum-state{background:#FEF5E6;color:#C07B1A}
    .sum-answer{font-size:13px;font-weight:900;letter-spacing:.04em;text-transform:uppercase;color:#3E4555}
    .sum-body{display:grid;gap:12px}
    .sum-section{padding:14px 16px;border-radius:14px;border:1px solid #eceff3;background:#faf7f1}
    .sum-label{font-family:Consolas,monospace;font-size:10px;font-weight:800;letter-spacing:1.6px;text-transform:uppercase;color:#6B7689;margin-bottom:8px}
    .sum-text{font-size:14px;line-height:1.62;color:#1E1E20}
  `;
}
function printSummarySheet(){
  if(!isQuizComplete())return;
  var printWindow=window.open('','_blank','noopener,noreferrer,width=1120,height=900');
  if(!printWindow){
    showToast('Allow pop-ups so I can open the printable review sheet.','err');
    return;
  }
  printWindow.document.open();
  printWindow.document.write(`<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><title>${getQuizTitle()} — Review Sheet</title><style>${getSummaryPrintStyles()}</style></head><body>${buildReviewSheetHTML(true)}</body></html>`);
  printWindow.document.close();
  printWindow.focus();
  setTimeout(function(){
    printWindow.print();
  },250);
}
function buildNbmeCompletionViewHTML(){
  var finishHTML=buildFinishHTML({allowMinimize:true});
  return `<div class="sum-view" id="completionViewTop">${finishHTML}${buildNbmeQuestion()}</div>`;
}
function buildSummaryViewHTML(){
  var finishHTML=buildFinishHTML({allowMinimize:true});
  return `<div class="sum-view" id="summaryViewTop">${finishHTML}${buildReviewSheetHTML(false)}</div>`;
}
function scrollQuizViewportTop(){
  window.scrollTo({top:0,behavior:'smooth'});
  var nbScroller=document.querySelector('.nb-question-scroll');
  if(nbScroller)nbScroller.scrollTo({top:0,behavior:'smooth'});
}
function scrollNbmeRail(direction){
  var scroller=document.getElementById('nbRailScroll');
  if(!scroller)return;
  scroller.scrollBy({top:direction*180,behavior:'smooth'});
}
function syncNbmeRailArrows(){
  var scroller=document.getElementById('nbRailScroll');
  var upBtn=document.getElementById('nbRailUpBtn');
  var downBtn=document.getElementById('nbRailDownBtn');
  if(!scroller||!upBtn||!downBtn)return;
  var maxScroll=Math.max(0,scroller.scrollHeight-scroller.clientHeight);
  var hasOverflow=maxScroll>4;
  upBtn.style.visibility=hasOverflow?'visible':'hidden';
  downBtn.style.visibility=hasOverflow?'visible':'hidden';
  upBtn.disabled=!hasOverflow||scroller.scrollTop<=2;
  downBtn.disabled=!hasOverflow||scroller.scrollTop>=maxScroll-2;
}
function keepCurrentRailItemVisible(){
  var scroller=document.getElementById('nbRailScroll');
  if(!scroller)return;
  var current=scroller.querySelector('.nb-rail-btn.current');
  if(current)current.scrollIntoView({block:'nearest'});
}
function toggleSummaryPanel(){
  if(!isQuizComplete())return;
  if(summaryVisible)hideSummarySheet();
  else viewSummarySheet();
}
function viewSummarySheet(){
  if(!isQuizComplete())return;
  finishBannerMinimized=false;
  summaryVisible=true;
  renderQ();
  var target=document.getElementById(uiMode==='nbme'?'summaryViewTop':'summarySheet');
  if(!target)return;
  target.scrollIntoView({behavior:'smooth',block:'start'});
}
function hideSummarySheet(){
  if(!summaryVisible)return;
  summaryVisible=false;
  renderQ();
  scrollQuizViewportTop();
}
function minimizeFinishBanner(){
  if(finishBannerMinimized)return;
  finishBannerMinimized=true;
  renderQ();
}
function expandFinishBanner(){
  if(!finishBannerMinimized)return;
  finishBannerMinimized=false;
  renderQ();
}
function toggleFinishBanner(){
  finishBannerMinimized=!finishBannerMinimized;
  renderQ();
}
function buildFinishHTML(options){
  options=options||{};
  var allowMinimize=!!options.allowMinimize;
  var total=questions.length||1;
  var pct=Math.round(NC/total*100);
  var msg=pct>=80?'🎉 Strong work!':pct>=60?'📈 Getting there.':'📚 Keep reviewing.';
  var summaryBtn=summaryVisible
    ? '<button class="fin-btn" onclick="hideSummarySheet()">← Back to Questions</button>'
    : '<button class="fin-btn" onclick="viewSummarySheet()">📋 View Summary</button>';
  var toggleBtn=allowMinimize?`<button class="fin-toggle" type="button" aria-label="${finishBannerMinimized?'Expand score card':'Minimize score card'}" title="${finishBannerMinimized?'Expand':'Minimize'}" onclick="toggleFinishBanner()">${finishBannerMinimized?'+':'−'}</button>`:'';
  var mainHTML=finishBannerMinimized?'':`<div class="fin-main">
    <div class="fin-pct">${pct}%</div>
    <div class="fin-pct-lbl">Final Score</div>
    <div class="fin-msg">${msg}</div>
    <div class="fin-sub">${NC} correct · ${NI} incorrect · ${questions.length} questions</div>
  </div>`;
  return `<div class="fin${finishBannerMinimized?' min':''}">
    ${toggleBtn}
    ${mainHTML}
    <div class="fin-btns">
      ${summaryBtn}
      <button class="fin-btn" onclick="printSummarySheet()">🖨 Print Summary</button>
      <button class="fin-btn" onclick="resetQuiz()">↺ Retake</button>
      <button class="fin-btn" onclick="exitQuiz()">✕ Exit</button>
    </div>
  </div>`;
}
function renderFinishBanners(){
  var html=isQuizComplete()?buildFinishHTML({allowMinimize:true}):'';
  document.getElementById('finBanner').innerHTML=html;
  document.getElementById('nbFinishBanner').innerHTML='';
}

// ── RENDERING ──
function renderItemSelectors(){
  var options=questions.map(function(_,i){return `<option value="${i}">${i+1}</option>`;}).join('');
  document.getElementById('nbItemSelect').innerHTML=options;
}
function syncModeButtons(){
  document.getElementById('modeLearn').classList.toggle('active',quizMode==='learn');
  document.getElementById('modeExam').classList.toggle('active',quizMode==='exam');
  document.getElementById('nbModeLearn').classList.toggle('active',quizMode==='learn');
  document.getElementById('nbModeExam').classList.toggle('active',quizMode==='exam');
  document.getElementById('qtSubmitBtn').style.display=quizMode==='exam'&&!examSubmitted?'':'none';
  var endBtn=document.getElementById('nbReviewBtn');
  if(quizMode!=='exam'){
    endBtn.textContent='Testing Mode Only';
    endBtn.disabled=true;
  }else if(examSubmitted){
    endBtn.textContent='Exam Submitted';
    endBtn.disabled=true;
  }else{
    endBtn.textContent=reviewOpen?'Submit Exam':'Review / End Block';
    endBtn.disabled=false;
  }
}
function syncSummaryButtons(){
  var btn=document.getElementById('nbSummaryBtn');
  if(!btn)return;
  var complete=isQuizComplete();
  btn.disabled=!complete;
  btn.classList.toggle('active',complete&&summaryVisible);
  btn.textContent=complete?(summaryVisible?'Hide Summary':'See Score & Summary'):'See Score & Summary';
}
function syncToolButtons(){
  document.getElementById('hlTool').classList.toggle('active',toolMode==='hl');
  document.getElementById('stTool').classList.toggle('active',toolMode==='st');
  document.getElementById('nbHighlightBtn').classList.toggle('active',toolMode==='hl');
  document.getElementById('nbHighlightBtn').classList.toggle('hl',toolMode==='hl');
  document.getElementById('nbStrikeBtn').classList.toggle('active',toolMode==='st');
  document.getElementById('nbStrikeBtn').classList.toggle('st',toolMode==='st');
}
function syncMarkButtons(){
  var isMarked=!!marked[CQ];
  document.getElementById('qtMarkBtn').classList.toggle('active',isMarked);
  document.getElementById('qtMarkBtn').textContent=isMarked?'⚑ Marked':'⚑ Mark';
  document.getElementById('nbMarkBtn').classList.toggle('active',isMarked);
  document.getElementById('nbMarkBtn').textContent=isMarked?'⚑ Marked':'⚑ Mark';
}
function updScore(){
  document.getElementById('sC').textContent=NC;
  document.getElementById('sI').textContent=NI;
  document.getElementById('sP').textContent=getScorePercent()==='—'?'—':getScorePercent()+'%';
  document.getElementById('nbScoreCorrect').textContent=NC;
  document.getElementById('nbScoreIncorrect').textContent=NI;
  document.getElementById('nbScorePercent').textContent=getScorePercent()==='—'?'—':getScorePercent()+'%';
}
function buildExplanationHTML(q,ans){
  if(!ans)return '';
  var correctLetter=choiceLetter(q.correct);
  var selectedLetter=(ans.s!==null&&ans.s!==undefined)?choiceLetter(ans.s):'';
  var myWrong='';
  if(ans.s===null){
    myWrong='<div class="exs exw"><div class="exl">✗ No Answer Selected</div><div class="ext">This question was left unanswered before the quiz was submitted.</div></div>';
  }else if(ans.s!==q.correct&&q.wrongExplanations&&q.wrongExplanations[String(ans.s)]){
    myWrong=`<div class="exs exw"><div class="exl">✗ Why ${selectedLetter} is Wrong</div><div class="ext">${q.wrongExplanations[String(ans.s)]}</div></div>`;
  }
  var others='';
  if(q.wrongExplanations){
    var otherKeys=Object.keys(q.wrongExplanations).filter(function(key){
      return +key!==q.correct&&(ans.s===null||+key!==ans.s)&&q.wrongExplanations[key];
    }).sort(function(a,b){return Number(a)-Number(b);});
    if(otherKeys.length){
      others=`<div class="exs exo"><div class="exl">✗ Other Wrong Choices</div><div class="ext">${otherKeys.map(function(key){
        return `<div class="wce"><strong>${choiceLetter(+key)}:</strong> ${q.wrongExplanations[key]}</div>`;
      }).join('')}</div></div>`;
    }
  }
  var eli5=q.eli5?`<div class="exs exe"><div class="exl">💡 ELI5</div><div class="ext">${q.eli5}</div></div>`:'';
  var refFig=buildExplanationFigureHTML(q);
  var figBlock=refFig?`<div class="exs exf"><div class="exl">📊 Reference Figure</div>${refFig}</div>`:'';
  return `<div class="exb vis">
    ${loBlockHTML(q)}
    <div class="exs exc"><div class="exl">✓ Why ${correctLetter} is Correct</div><div class="ext">${q.explanation}</div></div>
    ${myWrong}${others}${eli5}${figBlock}
  </div>`;
}
function buildClassicDots(){
  return questions.map(function(_,i){
    var classes=['qd'];
    if(i===CQ)classes.push('on');
    if(answers[i])classes.push(answers[i].r==='c'?'dc':'di');
    else if(selected[i]!==undefined)classes.push('asel');
    if(marked[i])classes.push('mk');
    return `<button class="${classes.join(' ')}" onclick="goQ(${i})" title="Q${i+1}"></button>`;
  }).join('');
}
function buildClassicQuestion(){
  var q=questions[CQ];
  var total=questions.length;
  var ans=answers[CQ];
  var sel=getSelectedChoice(CQ);
  var isExam=quizMode==='exam';
  var progress=((CQ+1)/total*100).toFixed(1);
  var choicesHTML=q.choices.map(function(choice,ci){
    var classes=['ac'];
    if(ans){
      classes.push('dis');
      if(ci===q.correct)classes.push('cor');
      else if(ans.s!==null&&ci===ans.s)classes.push('inc');
    }else if(sel===ci){
      classes.push('sel');
    }
    return `<div class="${classes.join(' ')}" onclick="pick(${ci})">
      <div class="cl">${choiceLetter(ci)}</div>
      <div class="ac-txt" data-choice-html="${ci}">${getChoiceHTML(CQ,ci)}</div>
    </div>`;
  }).join('');
  var submitLabel=isExam?'Submit Question':'Submit Answer';
  var submitHTML=!ans?`<div class="submit-row"><button class="submit-btn" onclick="submitAns()"${sel!==undefined?'':' disabled'}>${submitLabel}</button></div>`:'';
  var feedbackHTML=ans?buildExplanationHTML(q,ans):'';
  var qnumClass='qnum'+(marked[CQ]?' marked':'');
  var qnumText=`Question ${CQ+1} of ${total}${marked[CQ]?' • Flagged':''}`;
  var mainHTML=`<div class="q-main">
      <div class="${qnumClass}">${qnumText}</div>
      <div class="qstem" id="stemEl" data-stem-html="1">${getStemHTMLForDisplay(CQ)}</div>${buildVhLegendHTML(CQ)}${buildFigureHTML(CQ)}
      <div class="ach" id="achEl">${choicesHTML}</div>
      ${submitHTML}
    </div>`;
  var layoutHTML=ans
    ? `<div class="q-review-grid has-feedback">${mainHTML}<aside class="q-feedback">${feedbackHTML}</aside></div>`
    : `<div class="q-review-grid">${mainHTML}</div>`;
  return `<div class="qcd">
    <div class="qpg"><div class="qpf" style="width:${progress}%"></div></div>
    <div class="qbd">
      ${layoutHTML}
    </div>
    <div class="qnv">
      <button class="nb" onclick="prevQ()"${CQ===0?' disabled':''}>← Prev</button>
      <div class="nav-dots">${buildClassicDots()}</div>
      <button class="nb pr" onclick="nextQ()"${CQ===total-1?' disabled':''}>Next →</button>
    </div>
  </div>`;
}
function buildNbmeRail(){
  return questions.map(function(_,i){
    var classes=['nb-rail-btn'];
    if(i===CQ&&!reviewOpen)classes.push('current');
    if(answers[i]||selected[i]!==undefined)classes.push('answered');
    if(answers[i]&&answers[i].r&&answers[i].r!=='c'&&answers[i].r!=='u')classes.push('incorrect');
    if(marked[i])classes.push('marked');
    return `<button class="${classes.join(' ')}" type="button" onclick="goQ(${i})" aria-label="Go to question ${i+1}">${i+1}</button>`;
  }).join('');
}
function buildNbmeQuestion(){
  var q=questions[CQ];
  var ans=answers[CQ];
  var sel=getSelectedChoice(CQ);
  var isExam=quizMode==='exam';
  var submitLabel=isExam?'Submit Question':'Submit Answer';
  var answersHTML=q.choices.map(function(choice,ci){
    var classes=['nb-answer-row'];
    if(ans)classes.push('locked');
    if(sel===ci)classes.push('selected');
    if(ans){
      if(ci===q.correct)classes.push('correct');
      else if(ans.s!==null&&ci===ans.s)classes.push('incorrect');
    }
    return `<div class="${classes.join(' ')}" onclick="pick(${ci})">
      <div class="nb-answer-glyph">${choiceLetter(ci)}</div>
      <div class="nb-answer-copy"><span data-choice-html="${ci}">${getChoiceHTML(CQ,ci)}</span></div>
    </div>`;
  }).join('');
  var submitHTML=!ans?`<div class="nb-submit-row"><button class="nb-submit-btn" onclick="submitAns()"${sel!==undefined?'':' disabled'}>${submitLabel}</button></div>`:'';
  var feedbackHTML=ans?buildExplanationHTML(q,ans):'';
  var mainHTML=`<div class="nb-question-main">
    <div class="nb-question-label">QUESTION ${CQ+1}</div>
    <div class="nb-question-stem" id="nbStemEl" data-stem-html="1">${getStemHTMLForDisplay(CQ)}</div>${buildVhLegendHTML(CQ)}${buildFigureHTML(CQ)}
    <div class="nb-answers">${answersHTML}</div>
    ${submitHTML}
  </div>`;
  var layoutClass=ans?'nb-question-layout has-feedback':'nb-question-layout';
  var sideHTML=ans?`<aside class="nb-question-side">${feedbackHTML}</aside>`:'';
  return `<div class="nb-question-card${ans?' has-feedback':''}">
    <div class="${layoutClass}">
      ${mainHTML}
      ${sideHTML}
    </div>
  </div>`;
}
function buildNbmeReview(){
  var answered=Object.keys(selected).length;
  var incomplete=questions.length-answered;
  var flagged=getMarkedCount();
  var rows=questions.map(function(q,i){
    var answer=selected[i]===undefined?'—':choiceLetter(selected[i]);
    return `<tr>
      <td><button class="nb-review-jump" type="button" onclick="goQ(${i})">${i+1}</button></td>
      <td>${selected[i]===undefined?'Incomplete':'Answered'}</td>
      <td>${answer}</td>
      <td>${marked[i]?'Yes':'No'}</td>
    </tr>`;
  }).join('');
  return `<div class="nb-review-wrap">
    <h2>Review This Block</h2>
    <p>Check your completion status before you submit the exam. Select a question number to jump back to it.</p>
    <div class="nb-review-summary">
      <div class="nb-summary-chip">Answered<strong>${answered}</strong></div>
      <div class="nb-summary-chip">Incomplete<strong>${incomplete}</strong></div>
      <div class="nb-summary-chip">Marked<strong>${flagged}</strong></div>
    </div>
    <table class="nb-review-table">
      <thead><tr><th>Question</th><th>Status</th><th>Selected Answer</th><th>Marked</th></tr></thead>
      <tbody>${rows}</tbody>
    </table>
    <div class="nb-review-actions">
      <button class="nb-review-back" type="button" onclick="reviewOpen=false;renderQ()">Back to Questions</button>
    </div>
  </div>`;
}
function renderClassicView(){
  document.getElementById('qtSubmitBtn').style.display=quizMode==='exam'&&!examSubmitted?'':'none';
  document.getElementById('qArea').innerHTML=(isQuizComplete()&&summaryVisible)?buildReviewSheetHTML(false):buildClassicQuestion();
}
function renderNbmeView(){
  var total=questions.length;
  var answered=getAnsweredCount();
  var statusMeta;
  if(quizMode==='exam'&&!examSubmitted){
    statusMeta=answered+' answered • '+getMarkedCount()+' marked';
  }else{
    statusMeta='Correct '+NC+' • Incorrect '+NI+' • Score '+(getScorePercent()==='—'?'—':getScorePercent()+'%');
  }
  document.getElementById('nbItemIndicator').textContent=reviewOpen?'Block Review':'Question: '+(CQ+1)+' of '+total;
  document.getElementById('nbStatusMeta').textContent=statusMeta;
  document.getElementById('nbItemSelect').value=String(CQ);
  document.getElementById('nbPrevBtn').disabled=CQ===0||reviewOpen;
  document.getElementById('nbNextBtn').disabled=CQ===total-1||reviewOpen;
  document.getElementById('nbRailItems').innerHTML=buildNbmeRail();
  if(isQuizComplete()&&summaryVisible)document.getElementById('nbContent').innerHTML=buildSummaryViewHTML();
  else if(isQuizComplete())document.getElementById('nbContent').innerHTML=buildNbmeCompletionViewHTML();
  else document.getElementById('nbContent').innerHTML=(reviewOpen&&quizMode==='exam'&&!examSubmitted)?buildNbmeReview():buildNbmeQuestion();
  keepCurrentRailItemVisible();
  syncNbmeRailArrows();
}
function renderQ(){
  closeVhPanel();
  hideVhTooltip();
  hideAnnotationMenu();
  if(!questions.length)return;
  renderFinishBanners();
  syncModeButtons();
  syncSummaryButtons();
  syncToolButtons();
  syncMarkButtons();
  updScore();
  renderItemSelectors();
  if(uiMode==='nbme')renderNbmeView();
  else renderClassicView();
  syncStudyTools();
  saveSession();
}

// ── QUIZ ACTIONS ──
function pick(ci){
  if(Date.now()<suppressChoiceUntil||!window.getSelection().isCollapsed)return;
  if(answers[CQ])return;
  summaryVisible=false;
  selected[CQ]=ci;
  reviewOpen=false;
  renderQ();
}
function submitAns(){
  if(selected[CQ]===undefined||examSubmitted)return;
  if(quizMode==='exam'){
    reviewOpen=false;
    summaryVisible=false;
    if(CQ<questions.length-1){
      CQ++;
      renderQ();
      scrollQuizViewportTop();
    }else{
      renderQ();
      showToast('Last question saved. Use Review / End Block or Submit Exam when you are ready.','ok');
    }
    return;
  }
  if(answers[CQ])return;
  var ok=selected[CQ]===questions[CQ].correct;
  answers[CQ]={s:selected[CQ],r:ok?'c':'i'};
  updateScoreCounts();
  renderQ();
  if(quizMode==='learn'&&Object.keys(answers).length===questions.length)setTimeout(showFinish,300);
}
function submitExam(){
  if(quizMode!=='exam'||examSubmitted)return;
  var unanswered=questions.length-Object.keys(selected).length;
  var msg=unanswered>0?'You still have '+unanswered+' unanswered question'+(unanswered===1?'':'s')+'. Submit anyway?':'Submit your exam now?';
  if(!window.confirm(msg))return;
  answers={};
  NC=0;
  NI=0;
  questions.forEach(function(q,idx){
    if(selected[idx]===undefined){
      answers[idx]={s:null,r:'u'};
      NI++;
    }else{
      var ok=selected[idx]===q.correct;
      answers[idx]={s:selected[idx],r:ok?'c':'i'};
      if(ok)NC++;else NI++;
    }
  });
  examSubmitted=true;
  reviewOpen=false;
  toolMode='';
  renderQ();
  showFinish();
  showToast('Exam submitted.','ok');
}
function handleNbmeEndAction(){
  if(quizMode!=='exam'||examSubmitted)return;
  if(reviewOpen)submitExam();
  else{
    reviewOpen=true;
    renderQ();
  }
}
function prevQ(){if(CQ>0){CQ--;reviewOpen=false;summaryVisible=false;renderQ();}}
function nextQ(){if(CQ<questions.length-1){CQ++;reviewOpen=false;summaryVisible=false;renderQ();}}
function goQ(i){
  if(i<0||i>=questions.length)return;
  CQ=i;
  reviewOpen=false;
  summaryVisible=false;
  renderQ();
}
function toggleMark(){
  if(!questions.length)return;
  summaryVisible=false;
  if(marked[CQ])delete marked[CQ];
  else marked[CQ]=true;
  renderQ();
}
function setMode(mode){
  if(mode===quizMode)return;
  var hasProgress=Object.keys(selected).length>0||Object.keys(answers).length>0||examSubmitted;
  if(hasProgress&&!window.confirm('Switching modes will reset your current quiz progress. Continue?')){
    syncModeButtons();
    return;
  }
  quizMode=mode;
  resetQuizState(false);
  renderQ();
  showToast(mode==='learn'?'Learning mode enabled.':'Testing mode enabled.','ok');
}

// ── TOOLS ──
function toggleTool(mode){
  hideAnnotationMenu();
  toolMode=toolMode===mode?'':mode;
  syncToolButtons();
}
function getCurrentAnnotationRoot(){
  return document.querySelector(uiMode==='nbme'?'#nbContent':'#qArea');
}
function persistCurrentAnnotationsFromDOM(){
  var root=getCurrentAnnotationRoot();
  if(!root)return;
  var stem=root.querySelector('[data-stem-html]');
  if(stem)stemMarkup[CQ]=stripVhMarks(stem.innerHTML);
  var nodes=root.querySelectorAll('[data-choice-html]');
  if(nodes.length){
    var arr=ensureChoiceMarkup(CQ);
    nodes.forEach(function(node){
      arr[Number(node.getAttribute('data-choice-html'))]=node.innerHTML;
    });
  }
}
function stripAnnotationTags(html){
  var wrap=document.createElement('div');
  wrap.innerHTML=html;
  wrap.querySelectorAll('mark,s').forEach(function(node){
    node.replaceWith(document.createTextNode(node.textContent));
  });
  return wrap.innerHTML;
}
function clearMarks(){
  if(!questions.length)return;
  stemMarkup[CQ]=stripAnnotationTags(getStemHTML(CQ));
  var cleaned=[];
  questions[CQ].choices.forEach(function(_,idx){
    cleaned[idx]=stripAnnotationTags(getChoiceHTML(CQ,idx));
  });
  choiceMarkup[CQ]=cleaned;
  renderQ();
  showToast('Annotations cleared.','ok');
}
function applyFontSize(){
  var root=document.documentElement;
  var viewportScale=parseFloat(getComputedStyle(root).getPropertyValue('--viewport-scale'))||1;
  var stemBase=25*viewportScale;
  var choiceBase=15.5*viewportScale;
  var stemSize=stemBase+(fontStep*2.5*viewportScale);
  var choiceSize=choiceBase+(fontStep*1.2*viewportScale);
  root.style.setProperty('--stem-size',stemSize.toFixed(1)+'px');
  root.style.setProperty('--choice-size',choiceSize.toFixed(1)+'px');
}
function adjustFontSize(delta){
  fontStep=Math.max(-2,Math.min(4,fontStep+delta));
  applyFontSize();
}
function resetFontSize(){
  fontStep=0;
  applyFontSize();
}
function selectionIntersectsNode(range,node){
  if(typeof range.intersectsNode==='function'){
    try{return range.intersectsNode(node);}catch(e){}
  }
  var nodeRange=document.createRange();
  nodeRange.selectNodeContents(node);
  return !(
    range.compareBoundaryPoints(Range.END_TO_START,nodeRange)<=0||
    range.compareBoundaryPoints(Range.START_TO_END,nodeRange)>=0
  );
}
function getScopedAnnotationSegments(range,root){
  return Array.from(root.querySelectorAll('[data-stem-html],[data-choice-html]')).map(function(scope){
    if(!selectionIntersectsNode(range,scope))return null;
    var scopedRange=document.createRange();
    scopedRange.selectNodeContents(scope);
    if(range.compareBoundaryPoints(Range.START_TO_START,scopedRange)>0){
      scopedRange.setStart(range.startContainer,range.startOffset);
    }
    if(range.compareBoundaryPoints(Range.END_TO_END,scopedRange)<0){
      scopedRange.setEnd(range.endContainer,range.endOffset);
    }
    if(scopedRange.collapsed)return null;
    return {scope:scope,range:scopedRange};
  }).filter(Boolean);
}
function collectTextNodesInRange(range,scope){
  var nodes=[];
  var walker=document.createTreeWalker(scope,NodeFilter.SHOW_TEXT,{
    acceptNode:function(node){
      if(!node.textContent)return NodeFilter.FILTER_REJECT;
      return selectionIntersectsNode(range,node)?NodeFilter.FILTER_ACCEPT:NodeFilter.FILTER_REJECT;
    }
  });
  var current;
  while((current=walker.nextNode()))nodes.push(current);
  return nodes;
}
function wrapSelectedTextNode(node,range,mode){
  var start=0;
  var end=node.textContent.length;
  if(node===range.startContainer&&range.startContainer.nodeType===Node.TEXT_NODE)start=range.startOffset;
  if(node===range.endContainer&&range.endContainer.nodeType===Node.TEXT_NODE)end=range.endOffset;
  if(start>=end)return 0;
  if(start>0){
    node=node.splitText(start);
    end-=start;
  }
  if(end<node.textContent.length)node.splitText(end);
  var wrapper=document.createElement(mode==='hl'?'mark':'s');
  if(mode==='hl')wrapper.style.setProperty('--mark-color',highlightColor);
  node.parentNode.insertBefore(wrapper,node);
  wrapper.appendChild(node);
  return 1;
}
function normalizeAnnotationWrappers(scope,tagName){
  Array.from(scope.querySelectorAll(tagName)).forEach(function(node){
    while(node.nextSibling&&node.nextSibling.nodeType===Node.ELEMENT_NODE&&node.nextSibling.tagName===node.tagName&&node.nextSibling.getAttribute('style')===node.getAttribute('style')){
      var sibling=node.nextSibling;
      while(sibling.firstChild)node.appendChild(sibling.firstChild);
      sibling.remove();
    }
  });
}
function applyTextAnnotation(range,root,mode){
  var applied=0;
  getScopedAnnotationSegments(range,root).forEach(function(segment){
    collectTextNodesInRange(segment.range,segment.scope).forEach(function(node){
      applied+=wrapSelectedTextNode(node,segment.range,mode);
    });
    if(applied){
      normalizeAnnotationWrappers(segment.scope,mode==='hl'?'MARK':'S');
    }
  });
  return applied>0;
}
// Keep the selected range while the floating palette receives a click or keyboard focus.
var annotationMenu=document.createElement('div');
annotationMenu.className='annotation-menu';
annotationMenu.hidden=true;
annotationMenu.setAttribute('role','toolbar');
annotationMenu.setAttribute('aria-label','Text annotations');
var annotationColors=[['Yellow','#fff173'],['Green','#b1ff66'],['Cyan','#83edf0'],['Pink','#ffb5d7']];
annotationColors.forEach(function(color){
  var button=document.createElement('button');
  button.type='button';
  button.className='annotation-swatch';
  button.style.background=color[1];
  button.setAttribute('aria-label',color[0]+' highlight');
  button.title=color[0]+' highlight';
  button.onclick=function(){
    highlightColor=color[1];
    document.documentElement.style.setProperty('--active-highlight',highlightColor);
    if(annotationRange)commitAnnotation('hl');
    else hideAnnotationMenu();
  };
  annotationMenu.appendChild(button);
});
var annotationStrike=document.createElement('button');
annotationStrike.type='button';
annotationStrike.className='annotation-strike';
annotationStrike.textContent='S';
annotationStrike.title='Strikeout';
annotationStrike.setAttribute('aria-label','Strikeout selected text');
annotationStrike.onclick=function(){commitAnnotation('st');};
annotationMenu.appendChild(annotationStrike);
document.body.appendChild(annotationMenu);
annotationMenu.addEventListener('pointerdown',function(event){event.preventDefault();});
function hideAnnotationMenu(){
  annotationMenu.hidden=true;
  annotationRange=null;
  annotationRoot=null;
}
function positionAnnotationMenu(rect){
  annotationMenu.hidden=false;
  annotationMenu.querySelectorAll('.annotation-swatch').forEach(function(button,index){
    button.setAttribute('aria-pressed',String(annotationColors[index][1]===highlightColor));
  });
  var width=annotationMenu.offsetWidth,height=annotationMenu.offsetHeight;
  annotationMenu.style.left=Math.max(8,Math.min(rect.left,window.innerWidth-width-8))+'px';
  var top=rect.bottom+8;
  if(top+height>window.innerHeight-8)top=rect.top-height-8;
  annotationMenu.style.top=Math.max(8,Math.min(top,window.innerHeight-height-8))+'px';
}
function commitAnnotation(mode){
  var range=annotationRange,root=annotationRoot;
  if(!range||!root||!root.isConnected||!root.contains(range.commonAncestorContainer)){
    hideAnnotationMenu();return;
  }
  if(applyTextAnnotation(range,root,mode)){
    suppressChoiceUntil=Date.now()+250;
    window.getSelection().removeAllRanges();
    persistCurrentAnnotationsFromDOM();
    saveSession();
  }
  hideAnnotationMenu();
}
['hlTool','nbHighlightBtn'].forEach(function(id){
  var button=document.createElement('button');
  button.type='button';
  button.className='highlight-color-button';
  button.title='Choose highlight color';
  button.setAttribute('aria-label','Choose highlight color');
  button.onclick=function(){
    var wasOpen=!annotationMenu.hidden;
    hideAnnotationMenu();
    if(wasOpen)return;
    annotationStrike.hidden=true;
    positionAnnotationMenu(button.getBoundingClientRect());
  };
  document.getElementById(id).after(button);
});
function handleAnnotationSelection(event){
  if(annotationMenu.contains(event.target)||!questions.length)return;
  var selection=window.getSelection();
  if(!selection||selection.isCollapsed||!selection.rangeCount)return;
  var range=selection.getRangeAt(0),root=getCurrentAnnotationRoot();
  if(!root||!root.contains(range.commonAncestorContainer)||!getScopedAnnotationSegments(range,root).length)return;
  annotationRange=range.cloneRange();
  annotationRoot=root;
  suppressChoiceUntil=Date.now()+250;
  if(toolMode)commitAnnotation(toolMode);
  else{
    annotationStrike.hidden=false;
    positionAnnotationMenu(range.getBoundingClientRect());
  }
}
document.addEventListener('pointerup',handleAnnotationSelection);
document.addEventListener('keyup',function(event){
  if(event.key==='Escape'){hideAnnotationMenu();return;}
  if(event.key==='Shift'||event.key.startsWith('Arrow'))handleAnnotationSelection(event);
});
document.addEventListener('pointerdown',function(event){
  if(!annotationMenu.contains(event.target)&&!event.target.closest('.highlight-color-button'))hideAnnotationMenu();
});
document.addEventListener('scroll',hideAnnotationMenu,true);
window.addEventListener('resize',hideAnnotationMenu);

// ── TIMER ──
function formatTimer(totalSeconds){
  var hours=Math.floor(totalSeconds/3600);
  var minutes=Math.floor((totalSeconds%3600)/60);
  var seconds=totalSeconds%60;
  if(hours>0)return hours+':'+String(minutes).padStart(2,'0')+':'+String(seconds).padStart(2,'0');
  return String(minutes).padStart(2,'0')+':'+String(seconds).padStart(2,'0');
}
function toggleTimer(){
  if(timerRunning)pauseTimer();
  else startTimer();
}
function startTimer(){
  if(timerRunning)return;
  timerRunning=true;
  clearInterval(timerInterval);
  timerInterval=setInterval(function(){
    timerSec++;
    updTimer();
  },1000);
  updTimer();
}
function pauseTimer(){
  timerRunning=false;
  clearInterval(timerInterval);
  updTimer();
}
function resetTimer(){
  pauseTimer();
  timerSec=0;
  timerExpiredHandled=false;
  updTimer();
}
var timerDisplayMode='elapsed'; // 'elapsed' | 'remaining'
var timerExpiredHandled=false;
var SECONDS_PER_QUESTION=90; // NBME budget: 1 min 30 s per item
function getBlockSeconds(){return Math.max(60,(questions.length||0)*SECONDS_PER_QUESTION);}
function getRemainingSeconds(){return Math.max(0,getBlockSeconds()-timerSec);}
function toggleTimerDisplay(){
  timerDisplayMode=timerDisplayMode==='elapsed'?'remaining':'elapsed';
  updTimer();
  saveSession();
  if(timerDisplayMode==='remaining')showToast('Time Remaining · '+formatTimer(getBlockSeconds())+' block ('+SECONDS_PER_QUESTION+' s per question, NBME pacing)','ok');
}
function updTimer(){
  var remaining=getRemainingSeconds();
  var showRemaining=timerDisplayMode==='remaining';
  var timeText=formatTimer(showRemaining?remaining:timerSec);
  document.getElementById('timerTime').textContent=timeText;
  document.getElementById('nbTimerTime').textContent=timeText;
  var modeLbl=document.getElementById('timerModeLbl');
  if(modeLbl)modeLbl.textContent=showRemaining?'TIMER · REMAINING':'TIMER · ELAPSED';
  var nbModeLbl=document.getElementById('nbTimerModeLbl');
  if(nbModeLbl)nbModeLbl.textContent=showRemaining?'Time Remaining:':'Elapsed Time:';
  var nbNote=document.getElementById('nbTimerNote');
  if(nbNote)nbNote.textContent=showRemaining?('Block: '+formatTimer(getBlockSeconds())+' · '+SECONDS_PER_QUESTION+' s/question'):'Same timer as the original interface';
  document.getElementById('timerPlayBtn').textContent=timerRunning?'⏸':'▶';
  document.getElementById('nbTimerToggle').textContent=timerRunning?'Pause':'Start';
  document.getElementById('nbTimerStatus').textContent=timerRunning?'Running':'Paused';
  document.getElementById('timerCard').classList.toggle('run',timerRunning);
  document.getElementById('nbTimerCard').classList.toggle('run',timerRunning);
  var warn=showRemaining?(remaining<=300&&remaining>0):timerSec>90;
  document.getElementById('timerCard').classList.toggle('warn',warn);
  document.getElementById('nbTimerCard').classList.toggle('warn',warn);
  var expired=showRemaining&&remaining===0&&questions.length>0;
  document.getElementById('timerCard').classList.toggle('expired',expired);
  document.getElementById('nbTimerCard').classList.toggle('expired',expired);
  if(expired&&!timerExpiredHandled&&timerRunning){
    timerExpiredHandled=true;
    pauseTimer();
    if(quizMode==='exam'&&!examSubmitted){
      reviewOpen=true;
      renderQ();
      showToast('Block time expired — review your answers and End Block.','err');
    }else{
      showToast('Block time expired.','err');
    }
  }
  if(timerRunning&&timerSec%5===0)saveSession();
}

// ── FINISH / RESET ──
function showFinish(){
  summaryVisible=false;
  renderQ();
  scrollQuizViewportTop();
}
function resetQuiz(){
  if(!questions.length)return;
  clearSession();
  questions=randomizeQuestionsForSession(questionBank.length?questionBank:questions);
  resetQuizState(true);
  renderQ();
  scrollQuizViewportTop();
  showToast('Answer choices reshuffled for a fresh attempt.','ok');
}
function exitQuiz(){
  pauseTimer();
  window.close();
  setTimeout(function(){
    if(!window.closed)showToast('Your browser blocked automatic tab closing. Close this tab manually.','err');
  },150);
}

// ── VIEW ──
function syncViewportSize(){
  var root=document.documentElement;
  var width=window.innerWidth||1280;
  var height=window.innerHeight||800;
  var widthNormalized=(Math.min(Math.max(width,1200),1800)-1200)/600;
  var heightNormalized=(Math.min(Math.max(height,760),1200)-760)/440;
  var viewportScale=Math.max(.94,Math.min(1.24,1+(widthNormalized*.18)+(heightNormalized*.06)));
  // extra ramp for very large displays (4K monitors, TVs viewed from a distance)
  if(width>1800){
    var bigNormalized=(Math.min(width,3840)-1800)/2040;
    viewportScale=Math.min(1.62,viewportScale+bigNormalized*.38);
  }
  root.style.setProperty('--app-vh',height+'px');
  root.style.setProperty('--app-vw',width+'px');
  root.style.setProperty('--viewport-scale',viewportScale.toFixed(3));
  root.style.setProperty('--ui-title-size',(26*viewportScale).toFixed(1)+'px');
  root.style.setProperty('--ui-control-size',(13*viewportScale).toFixed(1)+'px');
  root.style.setProperty('--ui-meta-size',(12*viewportScale).toFixed(1)+'px');
  root.style.setProperty('--ui-micro-size',(10*viewportScale).toFixed(1)+'px');
  applyFontSize();
}
function switchView(id){
  document.querySelectorAll('.view').forEach(function(view){view.classList.remove('active');});
  document.getElementById(id).classList.add('active');
  document.body.classList.toggle('nbme-lock',id==='viewQuizNbme');
  if(id==='viewSetup')document.querySelectorAll('.study-window[open]').forEach(function(win){win.close();});
  syncViewportSize();
  window.scrollTo({top:0,behavior:'smooth'});
}

// ── HELPERS ──
function showErr(msg){
  var el=document.getElementById('errMsg');
  el.textContent='❌ '+msg;
  el.className='err-msg show';
}
function showToast(msg,type){
  var wrap=document.getElementById('toastWrap');
  var toast=document.createElement('div');
  toast.className='toast '+(type||'ok');
  toast.textContent=msg;
  wrap.appendChild(toast);
  setTimeout(function(){
    toast.style.animation='toastOut .28s ease forwards';
    setTimeout(function(){if(toast.parentNode)toast.parentNode.removeChild(toast);},300);
  },2800);
}
document.addEventListener('keydown',function(event){
  if(!questions.length||document.getElementById('viewSetup').classList.contains('active'))return;
  if(event.target&&typeof event.target.matches==='function'&&event.target.matches('textarea,input,select'))return;
  if(event.target.closest('.annotation-menu,.highlight-color-button'))return;
  if(event.key==='Escape'&&document.getElementById('labModal').classList.contains('open')){
    closeLabs();
    return;
  }
  if(event.key==='ArrowRight')nextQ();
  if(event.key==='ArrowLeft')prevQ();
  if(event.key==='Enter'&&!answers[CQ]&&selected[CQ]!==undefined&&!reviewOpen){event.preventDefault();submitAns();return;}
  if((event.key==='m'||event.key==='M')&&!event.metaKey&&!event.ctrlKey){toggleMark();return;}
  if(!answers[CQ]&&/^[a-hA-H]$/.test(event.key)){
    var keyChoice=event.key.toUpperCase().charCodeAt(0)-65;
    if(keyChoice<questions[CQ].choices.length)pick(keyChoice);
  }
});
window.addEventListener('resize',syncViewportSize);
window.addEventListener('orientationchange',syncViewportSize);

try{setReadingTheme(localStorage.getItem('quiz-builder-reading-theme')||'light');}catch(e){setReadingTheme('light');}
syncViewportSize();
syncLaunchUIButtons();
syncPasteSetTabs();
syncModeButtons();
syncToolButtons();
updScore();
updTimer();
applyFontSize();
initStudyWindows();
hydratePreloadedQuiz();
</script>
<div class="vh-tooltip" id="vhTooltip" role="tooltip"></div>
<div class="vh-panel" id="vhPanel" aria-hidden="true" role="dialog" aria-label="Key finding detail">
  <button class="vh-panel-close" type="button" onclick="closeVhPanel()" aria-label="Close">&times;</button>
  <div class="vh-panel-eyebrow" id="vhPanelEyebrow"></div>
  <div class="vh-panel-title" id="vhPanelTitle"></div>
  <div class="vh-panel-body" id="vhPanelBody"></div>
</div>
</body>
</html>

var LAB_SECTIONS=[{"title":"Serum","rows":[{"name":"Alanine aminotransferase (ALT)","us":"10–40 U/L","si":"10–40 U/L"},{"name":"Aspartate aminotransferase (AST)","us":"12–38 U/L","si":"12–38 U/L"},{"name":"Alkaline phosphatase","us":"25–100 U/L","si":"25–100 U/L"},{"name":"Amylase","us":"25–125 U/L","si":"25–125 U/L"},{"name":"Bilirubin, total // direct","us":"0.1–1.0 mg/dL // 0.0–0.3 mg/dL","si":"2–17 µmol/L // 0–5 µmol/L"},{"name":"Calcium","us":"8.4–10.2 mg/dL","si":"2.1–2.6 mmol/L"},{"group":"Cholesterol"},{"name":"Total","us":"Normal: &lt;200 mg/dL // High: &gt;240 mg/dL","si":"&lt;5.2 mmol/L // &gt;6.2 mmol/L"},{"name":"HDL","us":"40–60 mg/dL","si":"1.0–1.6 mmol/L"},{"name":"LDL","us":"&lt;160 mg/dL","si":"&lt;4.2 mmol/L"},{"name":"Triglycerides","us":"Normal: &lt;150 mg/dL // Borderline: 151–199 mg/dL","si":"&lt;1.70 mmol/L // 1.71–2.25 mmol/L"},{"name":"Cortisol","us":"0800 h: 5–23 µg/dL // 1600 h: 3–15 µg/dL","si":"138–635 nmol/L // 82–413 nmol/L"},{"name":"","us":"2000 h: &lt;50% of 0800 h","si":"Fraction of 0800 h: &lt;0.50"},{"name":"Creatine kinase","us":"Male: 25–90 U/L","si":"25–90 U/L"},{"name":"","us":"Female: 10–70 U/L","si":"10–70 U/L"},{"name":"Creatinine","us":"0.6–1.2 mg/dL","si":"53–106 µmol/L"},{"name":"Urea nitrogen","us":"7–18 mg/dL","si":"2.5–6.4 mmol/L"},{"name":"Creatinine clearance","us":"Male: 97–137 mL/min","si":"97–137 mL/min"},{"name":"","us":"Female: 88–128 mL/min","si":"88–128 mL/min"},{"group":"Electrolytes, serum"},{"name":"Sodium (Na<sup>+</sup>)","us":"136–146 mEq/L","si":"136–146 mmol/L"},{"name":"Potassium (K<sup>+</sup>)","us":"3.5–5.0 mEq/L","si":"3.5–5.0 mmol/L"},{"name":"Chloride (Cl<sup>−</sup>)","us":"95–105 mEq/L","si":"95–105 mmol/L"},{"name":"Bicarbonate (HCO<sub>3</sub><sup>−</sup>)","us":"22–28 mEq/L","si":"22–28 mmol/L"},{"name":"Magnesium (Mg<sup>2+</sup>)","us":"1.5–2.0 mg/dL","si":"0.75–1.0 mmol/L"},{"name":"Ferritin","us":"Male: 20–250 ng/mL","si":"20–250 µg/L"},{"name":"","us":"Female: 10–120 ng/mL","si":"10